@page
@model YuktiraERP.Web.Pages.CRM.Contact.EditModel
@{ ViewData["Title"] = "Edit Contact"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-warning text-dark"><h5 class="mb-0"><i class="bi bi-pencil me-2"></i>Edit Contact</h5></div>
<div class="card-body">
<form method="post">
<input type="hidden" asp-for="Contact.Id" />
<div class="row mb-3"><div class="col-md-6"><label asp-for="Contact.ContactId" class="form-label"></label><input asp-for="Contact.ContactId" class="form-control" type="text" /></div><div class="col-md-6"><label asp-for="Contact.Name" class="form-label"></label><input asp-for="Contact.Name" class="form-control" type="text" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="Contact.Email" class="form-label"></label><input asp-for="Contact.Email" class="form-control" type="text" /></div><div class="col-md-6"><label asp-for="Contact.Phone" class="form-label"></label><input asp-for="Contact.Phone" class="form-control" type="text" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="Contact.Company" class="form-label"></label><input asp-for="Contact.Company" class="form-control" type="text" /></div><div class="col-md-6"><label asp-for="Contact.Status" class="form-label"></label><input asp-for="Contact.Status" class="form-control" type="text" /></div></div>
<div class="d-flex gap-2"><button type="submit" class="btn btn-warning"><i class="bi bi-save me-1"></i>Update</button><a href="/CRM/Contact/List" class="btn btn-outline-secondary"><i class="bi bi-x me-1"></i>Cancel</a></div>
</form>
</div></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

