@page
@model YuktiraERP.Web.Pages.CRM.Contact.DisplayModel
@using YuktiraERP.Infrastructure.Data.Entities
@{ ViewData["Title"] = "Contact Details"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-info text-white"><h5 class="mb-0"><i class="bi bi-eye me-2"></i>Contact Details</h5></div>
<div class="card-body">
<dl class="row mb-0"><dt class="col-sm-4">ContactId</dt><dd class="col-sm-8">@(Model.Contact.ContactId)</dd><dt class="col-sm-4">Name</dt><dd class="col-sm-8">@(Model.Contact.Name)</dd><dt class="col-sm-4">Email</dt><dd class="col-sm-8">@(Model.Contact.Email)</dd><dt class="col-sm-4">Phone</dt><dd class="col-sm-8">@(Model.Contact.Phone)</dd><dt class="col-sm-4">Company</dt><dd class="col-sm-8">@(Model.Contact.Company)</dd><dt class="col-sm-4">Status</dt><dd class="col-sm-8">@(Model.Contact.Status)</dd></dl>
</div>
<div class="card-footer">
<a href="/CRM/Contact/List" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
<a href="/CRM/Contact/Edit?id=@(Model.Contact.Id)" class="btn btn-warning"><i class="bi bi-pencil me-1"></i>Edit</a>
</div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

