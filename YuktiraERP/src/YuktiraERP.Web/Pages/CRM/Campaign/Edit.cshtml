@page
@model YuktiraERP.Web.Pages.CRM.Campaign.EditModel
@{ ViewData["Title"] = "Edit Campaign"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-warning text-dark"><h5 class="mb-0"><i class="bi bi-pencil me-2"></i>Edit Campaign</h5></div>
<div class="card-body">
<form method="post">
<input type="hidden" asp-for="Campaign.Id" />
<div class="row mb-3"><div class="col-md-6"><label asp-for="Campaign.CampaignId" class="form-label"></label><input asp-for="Campaign.CampaignId" class="form-control" type="text" /></div><div class="col-md-6"><label asp-for="Campaign.Name" class="form-label"></label><input asp-for="Campaign.Name" class="form-control" type="text" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="Campaign.Type" class="form-label"></label><input asp-for="Campaign.Type" class="form-control" type="text" /></div><div class="col-md-6"><label asp-for="Campaign.StartDate" class="form-label"></label><input asp-for="Campaign.StartDate" class="form-control" type="datetime-local" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="Campaign.EndDate" class="form-label"></label><input asp-for="Campaign.EndDate" class="form-control" type="datetime-local" /></div><div class="col-md-6"><label asp-for="Campaign.Budget" class="form-label"></label><input asp-for="Campaign.Budget" class="form-control" type="number" step="0.01" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="Campaign.Status" class="form-label"></label><input asp-for="Campaign.Status" class="form-control" type="text" /></div><div class="col-md-6"></div></div>
<div class="d-flex gap-2"><button type="submit" class="btn btn-warning"><i class="bi bi-save me-1"></i>Update</button><a href="/CRM/Campaign/List" class="btn btn-outline-secondary"><i class="bi bi-x me-1"></i>Cancel</a></div>
</form>
</div></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

