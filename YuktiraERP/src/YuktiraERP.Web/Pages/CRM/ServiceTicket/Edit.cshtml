@page
@model YuktiraERP.Web.Pages.CRM.ServiceTicket.EditModel
@{ ViewData["Title"] = "Edit ServiceTicket"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-warning text-dark"><h5 class="mb-0"><i class="bi bi-pencil me-2"></i>Edit ServiceTicket</h5></div>
<div class="card-body">
<form method="post">
<input type="hidden" asp-for="Ticket.Id" />
<div class="row mb-3"><div class="col-md-6"><label asp-for="Ticket.TicketId" class="form-label"></label><input asp-for="Ticket.TicketId" class="form-control" type="text" /></div><div class="col-md-6"><label asp-for="Ticket.CustomerName" class="form-label"></label><input asp-for="Ticket.CustomerName" class="form-control" type="text" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="Ticket.Subject" class="form-label"></label><input asp-for="Ticket.Subject" class="form-control" type="text" /></div><div class="col-md-6"><label asp-for="Ticket.Priority" class="form-label"></label><input asp-for="Ticket.Priority" class="form-control" type="text" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="Ticket.Status" class="form-label"></label><input asp-for="Ticket.Status" class="form-control" type="text" /></div><div class="col-md-6"><label asp-for="Ticket.CreatedDate" class="form-label"></label><input asp-for="Ticket.CreatedDate" class="form-control" type="datetime-local" /></div></div>
<div class="d-flex gap-2"><button type="submit" class="btn btn-warning"><i class="bi bi-save me-1"></i>Update</button><a href="/CRM/ServiceTicket/List" class="btn btn-outline-secondary"><i class="bi bi-x me-1"></i>Cancel</a></div>
</form>
</div></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

