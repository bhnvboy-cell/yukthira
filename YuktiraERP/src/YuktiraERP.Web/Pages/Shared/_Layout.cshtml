@inject YuktiraERP.Core.Interfaces.IModuleCatalog ModuleCatalog
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#2563eb" />
    <link rel="manifest" href="~/manifest.json" />
    <link rel="icon" type="image/svg+xml" href="~/images/icon.svg" />
    <title>@ViewData["Title"] - Yuktira ERP</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/yuktira.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <a href="#main-content" class="skip-to-content" id="skipToContent">@L["SkipToContent"]</a>
    <div class="app-layout">
        @if (Context.User?.Identity?.IsAuthenticated == true)
        {
            <nav class="hybrid-sidebar" id="appSidebar" role="navigation" aria-label="Main navigation" tabindex="0">
                <div class="sidebar-header">
                    <svg class="bi bi-cpu" aria-hidden="true"><use href="/images/sprite.svg#bi-cpu"></use></svg>
                    <span class="sidebar-text">Yuktira</span>
                </div>

                <div class="sidebar-body">
                    @{
                        string? lastCat = null;
                        foreach (var m in ModuleCatalog.Modules)
                        {
                            if (m.Category != lastCat)
                            {
                                <div class="nav-category sidebar-text" role="presentation">@m.Category</div>
                                lastCat = m.Category;
                            }
                            <a href="@m.BaseRoute" class="nav-item" title="@m.Name" aria-label="@m.Name module"><svg class="bi @m.Icon" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#@m.Icon"></use></svg><span class="sidebar-text">@m.Code</span></a>
                        }
                    }
                </div>

                <div class="sidebar-footer">
                    <button type="button" class="theme-toggle" id="sidebarThemeToggle" role="switch" aria-checked="false" title="Toggle light / dark mode" aria-label="Toggle light / dark mode">
                        <svg class="bi bi-sun theme-icon-light" aria-hidden="true"><use href="/images/sprite.svg#bi-sun"></use></svg>
                        <svg class="bi bi-moon-stars theme-icon-dark" aria-hidden="true"><use href="/images/sprite.svg#bi-moon-stars"></use></svg>
                        <span class="theme-toggle-label sidebar-text">Light mode</span>
                    </button>
                    <div class="sidebar-user">
                        <div class="avatar" aria-hidden="true">@(Context.User.Identity.Name?.Substring(0,1).ToUpper()??"U")</div>
                        <span class="sidebar-username sidebar-text">@Context.User.Identity.Name</span>
                    </div>
                </div>
            </nav>

            <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

            <div class="app-main-area">
                <header class="top-bar" role="banner">
                    <button type="button" class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle navigation menu"><svg class="bi bi-list" aria-hidden="true"><use href="/images/sprite.svg#bi-list"></use></svg></button>
                    <div class="top-bar-center">
                        <div class="top-bar-search">
                            <svg class="bi bi-search" aria-hidden="true"><use href="/images/sprite.svg#bi-search"></use></svg>
                            <input type="text" id="globalSearch" placeholder="@L["SearchPlaceholder"]" autocomplete="off" aria-label="Search transactions">
                            <button type="button" class="top-bar-search-btn" id="globalSearchBtn" title="Execute (Enter)" aria-label="Execute search"><span class="btn-go-text">Go</span><span class="btn-go-enter">&#x23CE;</span></button>
                            <div id="globalSearchResults" class="search-results" style="display:none" role="listbox" aria-label="Search results"></div>
                        </div>
                    </div>
                    <div class="top-bar-right">
                        <div class="erp-zoom-control" id="erpZoomControl" role="group" aria-label="Screen zoom level">
                            <button type="button" class="erp-zoom-trigger" id="erpZoomTrigger" title="Screen zoom" aria-haspopup="listbox" aria-expanded="false">
                                <svg class="bi bi-aspect-ratio" aria-hidden="true"><use href="/images/sprite.svg#bi-aspect-ratio"></use></svg>
                                <span class="erp-zoom-label" id="erpZoomLabel">100%</span>
                                <svg class="bi bi-chevron-down" aria-hidden="true"><use href="/images/sprite.svg#bi-chevron-down"></use></svg>
                            </button>
                            <div class="erp-zoom-dropdown" id="erpZoomDropdown" role="listbox" aria-label="Select zoom level">
                                <button type="button" class="erp-zoom-option" data-zoom="0.8" role="option">80%<span class="erp-zoom-tag">Compact</span></button>
                                <button type="button" class="erp-zoom-option" data-zoom="0.9" role="option">90%<span class="erp-zoom-tag">Dense</span></button>
                                <button type="button" class="erp-zoom-option" data-zoom="1.0" role="option">100%<span class="erp-zoom-tag">Standard</span></button>
                                <button type="button" class="erp-zoom-option" data-zoom="1.1" role="option">110%<span class="erp-zoom-tag">Large</span></button>
                                <button type="button" class="erp-zoom-option" data-zoom="1.2" role="option">120%<span class="erp-zoom-tag">Extra Large</span></button>
                            </div>
                        </div>
                        <button type="button" class="top-bar-icon" id="darkModeToggle" title="@L["ToggleDarkMode"]" aria-label="@L["ToggleDarkMode"]"><svg class="bi bi-moon-stars" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-moon-stars"></use></svg></button>
                        <a href="/Notifications" class="top-bar-icon" title="@L["Notifications"]" aria-label="@L["Notifications"]">
                            <svg class="bi bi-bell" aria-hidden="true"><use href="/images/sprite.svg#bi-bell"></use></svg>
                            <span class="badge bg-danger" id="notifCount" style="display:none" aria-live="polite">0</span>
                        </a>
                        <a href="/Dashboard" class="top-bar-icon" title="@L["Home"]" aria-label="@L["Home"]"><svg class="bi bi-grid-3x3-gap" aria-hidden="true"><use href="/images/sprite.svg#bi-grid-3x3-gap"></use></svg></a>
                        <a href="/Settings" class="top-bar-icon" title="@L["Settings"]" aria-label="@L["Settings"]"><svg class="bi bi-gear" aria-hidden="true"><use href="/images/sprite.svg#bi-gear"></use></svg></a>
                        <form asp-controller="Home" asp-action="SetLanguage" method="post" class="top-bar-icon lang-form" style="margin:0;display:inline-flex">
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                            <select name="culture" onchange="this.form.submit()" class="lang-select" title="@L["SelectLanguage"]" aria-label="@L["SelectLanguage"]">
                                <option value="en" selected="@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en")">EN</option>
                                <option value="hi" selected="@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "hi")">HI</option>
                                <option value="ta" selected="@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ta")">TA</option>
                                <option value="te" selected="@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "te")">TE</option>
                                <option value="fr" selected="@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fr")">FR</option>
                                <option value="es" selected="@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "es")">ES</option>
                            </select>
                        </form>
                        <a href="#" class="top-bar-icon" id="printBtn" title="@L["Print"] (Ctrl+P)" aria-label="@L["Print"]"><svg class="bi bi-printer" aria-hidden="true"><use href="/images/sprite.svg#bi-printer"></use></svg></a>
                        <a href="/Auth/Logout" class="top-bar-icon text-danger" title="@L["Logout"]" aria-label="@L["Logout"]"><svg class="bi bi-box-arrow-right" aria-hidden="true"><use href="/images/sprite.svg#bi-box-arrow-right"></use></svg></a>
                    </div>
                </header>
                <main class="app-main" id="main-content" role="main">
                    @RenderBody()
                </main>
            </div>
        }
        else
        {
            <main class="app-main" style="padding:0 !important;min-height:100vh" id="main-content" role="main">
                @RenderBody()
            </main>
        }
    </div>
    <link rel="stylesheet" href="~/css/tcode-engine.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/enterprise-form.css" asp-append-version="true" />
    <script>
        window.YuktiraConfig = {
            tenantId: '@(Context.Items["TenantId"] ?? "")',
            currencyCode: '@(Context.Items["TenantCurrencyCode"] ?? "INR")',
            currencySymbol: '@(Context.Items["TenantCurrencySymbol"] ?? "₹")',
            locale: '@(System.Globalization.CultureInfo.CurrentCulture.Name)'
        };
    </script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/lib/jquery/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/sortablejs/Sortable.min.js" asp-append-version="true"></script>
    <script src="~/lib/signalr/signalr.min.js" asp-append-version="true"></script>
    <script src="~/js/yuktira.js"></script>
    <script src="~/js/enterprise-form.js" asp-append-version="true"></script>
    <script>
        // ── Theme engine (Light + Dark only) ──
        (function() {
            var THEMES = ['modern', 'dark'];
            function applyTheme(theme) {
                if (THEMES.indexOf(theme) === -1) theme = 'modern';
                document.documentElement.setAttribute('data-theme', theme);
                localStorage.setItem('yuktira_theme', theme);
                var dark = theme === 'dark';
                var dt = document.getElementById('darkModeToggle');
                if (dt) {
                    dt.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
                    var dtUse = dt.querySelector('use');
                    if (dtUse) dtUse.setAttribute('href', '/images/sprite.svg#' + (dark ? 'bi-sun' : 'bi-moon-stars'));
                }
                var st = document.getElementById('sidebarThemeToggle');
                if (st) {
                    st.setAttribute('aria-checked', dark ? 'true' : 'false');
                    var lbl = st.querySelector('.theme-toggle-label');
                    if (lbl) lbl.textContent = dark ? 'Dark mode' : 'Light mode';
                }
                document.querySelectorAll('.settings-theme-card').forEach(function(c) {
                    c.classList.toggle('active', c.getAttribute('data-theme') === theme);
                });
            }
            function toggleTheme() {
                var cur = document.documentElement.getAttribute('data-theme');
                applyTheme(cur === 'dark' ? 'modern' : 'dark');
            }
            var saved = localStorage.getItem('yuktira_theme');
            if (THEMES.indexOf(saved) === -1) {
                saved = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'modern';
            }
            applyTheme(saved);
            var darkToggle = document.getElementById('darkModeToggle');
            if (darkToggle) darkToggle.addEventListener('click', toggleTheme);
            var sideToggle = document.getElementById('sidebarThemeToggle');
            if (sideToggle) sideToggle.addEventListener('click', toggleTheme);
            window.yuktiraApplyTheme = applyTheme;
        })();

        // ── System preference detection ──
        (function() {
            var mq = window.matchMedia('(prefers-color-scheme: dark)');
            mq.addEventListener('change', function(e) {
                if (!localStorage.getItem('yuktira_theme')) {
                    document.documentElement.setAttribute('data-theme', e.matches ? 'dark' : 'modern');
                }
            });
        })();

        // ── Sidebar active link ──
        (function() {
            var path = window.location.pathname;
            document.querySelectorAll('.nav-item').forEach(function(el) {
                var href = el.getAttribute('href');
                if (href && (path === href || path.startsWith(href + '/'))) {
                    el.classList.add('active');
                }
            });
        })();

        // ── Sidebar keyboard navigation ──
        (function() {
            var sidebar = document.getElementById('appSidebar');
            if (!sidebar) return;
            sidebar.addEventListener('keydown', function(e) {
                var items = Array.from(sidebar.querySelectorAll('.nav-item'));
                var current = document.activeElement;
                var idx = items.indexOf(current);
                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    var next = idx < items.length - 1 ? idx + 1 : 0;
                    items[next].focus();
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    var prev = idx > 0 ? idx - 1 : items.length - 1;
                    items[prev].focus();
                } else if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    if (current && current.classList.contains('nav-item')) {
                        window.location.href = current.getAttribute('href');
                    }
                }
            });
        })();

        // ── Notification badge ──
        (function() {
            var badge = document.getElementById('notifCount');
            if (badge) {
                fetch('/api/v1/notifications/unread-count').then(function(r) { return r.json(); }).then(function(d) {
                    if (d.count > 0) {
                        badge.textContent = d.count > 99 ? '99+' : d.count;
                        badge.style.display = '';
                    }
                });
            }
        })();

        // ── Global search (Ctrl+K) ──
        var searchTimeout;
        function doGlobalSearch() {
            var val = $('#globalSearch').val().trim().toUpperCase();
            var results = $('#globalSearchResults');
            if (val.length < 2) { results.hide(); return; }
            $.get('/Transactions/Search?q=' + encodeURIComponent(val), function(data) {
                var html = '';
                data.forEach(function(t) {
                    var route = t.route && t.route !== '#' ? t.route : '/Transactions/Engine/' + encodeURIComponent(t.code);
                    html += '<button type="button" class="list-group-item list-group-item-action d-flex align-items-center gap-2 py-2" role="option" onclick="window.location.href=\'' + route + '\'">';
                    html += '<svg class="bi ' + t.icon + ' text-primary" aria-hidden="true"><use href="/images/sprite.svg#' + t.icon + '"></use></svg>';
                    html += '<div class="small"><strong>' + t.code + '</strong> <span class="text-muted">- ' + t.name + '</span></div>';
                    html += '</button>';
                });
                if (!data.length) html = '<div class="list-group-item text-muted small">No matches found</div>';
                results.html(html).show();
            });
        }
        $('#globalSearch').on('input', function() {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(doGlobalSearch, 150);
        });
        $('#globalSearchBtn').on('click', function() { doGlobalSearch(); $('#globalSearch').focus(); });
        $('#globalSearch').on('keydown', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                var first = $('#globalSearchResults button:first');
                if (first.length) {
                    var m = first.attr('onclick').match(/'([^']+)'/);
                    if (m) window.location.href = m[1];
                } else {
                    doGlobalSearch();
                }
            }
        });

        $(document).on('keydown', function(e) {
            if ((e.ctrlKey || e.metaKey) && e.key === 'k') { e.preventDefault(); $('#globalSearch').focus(); }
            if (e.key === 'Escape') { $('#globalSearch').val(''); $('#globalSearchResults').hide(); closeSidebar(); }
        });

        // ── Print / Save as PDF ──
        $('#printBtn').on('click', function(e) {
            e.preventDefault();
            $('.table-responsive, [style*="overflow-x:auto"]').each(function() {
                $(this).addClass('print-expanded');
            });
            window.print();
        });

        $(document).on('keydown', function(e) {
            if ((e.ctrlKey || e.metaKey) && e.key === 'p' && !e.shiftKey) { e.preventDefault(); $('#printBtn').click(); }
        });

        // ── Screen Zoom / Density Control ──
        (function() {
            var trigger = document.getElementById('erpZoomTrigger');
            var dropdown = document.getElementById('erpZoomDropdown');
            var label = document.getElementById('erpZoomLabel');
            if (!trigger || !dropdown || !label) return;

            var STORAGE_KEY = 'yuktira_grid_zoom';
            var options = dropdown.querySelectorAll('.erp-zoom-option');

            function applyZoom(scale) {
                document.documentElement.style.setProperty('--erp-content-scale', scale);
                document.documentElement.style.fontSize = (scale * 100) + '%';
                label.textContent = Math.round(scale * 100) + '%';
                options.forEach(function(opt) {
                    opt.classList.toggle('erp-zoom-active', parseFloat(opt.dataset.zoom) === scale);
                });
            }

            // Load saved zoom
            var saved = parseFloat(localStorage.getItem(STORAGE_KEY));
            if (!isNaN(saved) && saved >= 0.8 && saved <= 1.2) {
                applyZoom(saved);
            }

            // Toggle dropdown
            trigger.addEventListener('click', function(e) {
                e.stopPropagation();
                var isOpen = dropdown.classList.contains('erp-zoom-open');
                dropdown.classList.toggle('erp-zoom-open', !isOpen);
                trigger.setAttribute('aria-expanded', !isOpen);
            });

            // Select zoom level
            options.forEach(function(opt) {
                opt.addEventListener('click', function() {
                    var scale = parseFloat(this.dataset.zoom);
                    localStorage.setItem(STORAGE_KEY, scale);
                    applyZoom(scale);
                    dropdown.classList.remove('erp-zoom-open');
                    trigger.setAttribute('aria-expanded', 'false');
                });
            });

            // Close on outside click
            document.addEventListener('click', function(e) {
                if (!e.target.closest('.erp-zoom-control')) {
                    dropdown.classList.remove('erp-zoom-open');
                    trigger.setAttribute('aria-expanded', 'false');
                }
            });

            // Keyboard: arrow keys inside dropdown
            trigger.addEventListener('keydown', function(e) {
                if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
                    e.preventDefault();
                    dropdown.classList.add('erp-zoom-open');
                    trigger.setAttribute('aria-expanded', 'true');
                    var items = Array.from(options);
                    var activeIdx = items.findIndex(function(i) { return i.classList.contains('erp-zoom-active'); });
                    var next = e.key === 'ArrowDown'
                        ? (activeIdx < items.length - 1 ? activeIdx + 1 : 0)
                        : (activeIdx > 0 ? activeIdx - 1 : items.length - 1);
                    items[next].focus();
                } else if (e.key === 'Escape') {
                    dropdown.classList.remove('erp-zoom-open');
                    trigger.setAttribute('aria-expanded', 'false');
                }
            });
        })();

        // ── Mobile sidebar drawer ──
        function openSidebar() {
            $('#appSidebar').addClass('sidebar-open');
            $('#sidebarBackdrop').addClass('show');
            $('body').addClass('sidebar-lock');
        }
        function closeSidebar() {
            $('#appSidebar').removeClass('sidebar-open');
            $('#sidebarBackdrop').removeClass('show');
            $('body').removeClass('sidebar-lock');
        }
        $('#sidebarToggle').on('click', function() {
            if ($('#appSidebar').hasClass('sidebar-open')) { closeSidebar(); } else { openSidebar(); }
        });
        $('#sidebarBackdrop').on('click', closeSidebar);
        $(document).on('click', '.nav-item', function() {
            if (window.innerWidth <= 991) closeSidebar();
        });

        $(document).on('click', function(e) {
            if (!$(e.target).closest('.top-bar-search').length) $('#globalSearchResults').hide();
        });
    </script>

    <script>
        // ── Unregister old service worker and clear cache ──
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.getRegistrations().then(function(regs) {
                regs.forEach(function(r) { r.unregister(); });
            });
        }
        if ('caches' in window) {
            caches.keys().then(function(keys) { keys.forEach(function(k) { caches.delete(k); }); });
        }
    </script>
    <!-- Session Timeout Warning Modal (SAP-style) -->
    @if (Context.User?.Identity?.IsAuthenticated == true)
    {
    <div id="sessionTimeoutModal" class="session-timeout-overlay" style="display:none">
        <div class="session-timeout-dialog">
            <div class="session-timeout-icon">
                <svg class="bi bi-clock-history" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-clock-history"></use></svg>
            </div>
            <h3>@L["SessionExpiring"]</h3>
            <p>Your session will expire in <span id="timeoutCountdown">60</span> seconds.</p>
            <p class="session-timeout-sub">@L["SessionContinueQ"]</p>
            <div class="session-timeout-actions">
                <button type="button" class="btn-timeout btn-timeout-continue" id="sessionContinueBtn">
                    <svg class="bi bi-play-circle" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-play-circle"></use></svg> @L["ContinueSession"]
                </button>
                <button type="button" class="btn-timeout btn-timeout-logoff" id="sessionLogoffBtn">
                    <svg class="bi bi-box-arrow-right" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-box-arrow-right"></use></svg> @L["LogOff"]
                </button>
            </div>
            <div class="session-timeout-progress">
                <div class="session-timeout-progress-bar" id="timeoutProgressBar"></div>
            </div>
        </div>
    </div>
    }

    <script>
        // ── Session Timeout Manager (SAP-style) ──
        (function() {
            var sessionTimer = null;
            var warningTimer = null;
            var countdownInterval = null;
            var countdownSeconds = 60;
            var isWarningActive = false;
            var modal = document.getElementById('sessionTimeoutModal');
            if (!modal) return;

            var settings = JSON.parse(localStorage.getItem('yuktira_settings') || '{}');
            var timeoutMinutes = settings.sessionTimeoutMinutes || 30;
            var warningBeforeSeconds = settings.warningBeforeSeconds || 60;
            var totalSessionMs = timeoutMinutes * 60 * 1000;
            var warningMs = totalSessionMs - (warningBeforeSeconds * 1000);

            function resetSessionTimer() {
                clearTimeout(sessionTimer);
                clearTimeout(warningTimer);
                clearInterval(countdownInterval);
                isWarningActive = false;
                modal.style.display = 'none';

                warningTimer = setTimeout(function() { showWarning(); }, warningMs);
                sessionTimer = setTimeout(function() { window.location.href = '/Auth/Logout?reason=timeout'; }, totalSessionMs);
            }

            function showWarning() {
                isWarningActive = true;
                countdownSeconds = warningBeforeSeconds;
                var countdownEl = document.getElementById('timeoutCountdown');
                var progressEl = document.getElementById('timeoutProgressBar');
                modal.style.display = 'flex';
                countdownEl.textContent = countdownSeconds;
                progressEl.style.width = '100%';
                var startTime = Date.now();
                var totalMs = warningBeforeSeconds * 1000;

                countdownInterval = setInterval(function() {
                    countdownSeconds = countdownSeconds - 1;
                    countdownEl.textContent = countdownSeconds;
                    var elapsed = Date.now() - startTime;
                    var pct = Math.max(0, ((totalMs - elapsed) / totalMs) * 100);
                    progressEl.style.width = pct + '%';
                    if (countdownSeconds === 0 || countdownSeconds < 1) {
                        clearInterval(countdownInterval);
                        window.location.href = '/Auth/Logout?reason=timeout';
                    }
                }, 1000);
            }

            function continueSession() {
                clearInterval(countdownInterval);
                modal.style.display = 'none';
                isWarningActive = false;
                resetSessionTimer();
            }

            function logoff() { window.location.href = '/Auth/Logout?reason=manual'; }

            document.getElementById('sessionContinueBtn').addEventListener('click', continueSession);
            document.getElementById('sessionLogoffBtn').addEventListener('click', logoff);

            ['mousemove', 'keydown', 'click', 'scroll', 'touchstart'].forEach(function(evt) {
                document.addEventListener(evt, function() {
                    if (!isWarningActive) resetSessionTimer();
                }, { passive: true });
            });

            resetSessionTimer();
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
