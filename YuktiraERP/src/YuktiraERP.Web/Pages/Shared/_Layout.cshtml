@inject YuktiraERP.Core.Interfaces.IModuleCatalog ModuleCatalog
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#2563eb" />
    <link rel="manifest" href="~/manifest.json" />
    <link rel="icon" type="image/svg+xml" href="~/images/icon.svg" />
    <title>@ViewData["Title"] - Yuktira ERP</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/yuktira.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <a href="#main-content" class="skip-to-content" id="skipToContent">@L["SkipToContent"]</a>
    <div class="app-layout">
        @if (Context.User?.Identity?.IsAuthenticated == true)
        {
            <nav class="hybrid-sidebar" id="appSidebar" role="navigation" aria-label="Main navigation" tabindex="0">
                <div class="sidebar-header">
                    <i class="bi bi-cpu" aria-hidden="true"></i>
                    <span class="sidebar-text">Yuktira</span>
                </div>

                <div class="sidebar-body">
                    @{
                        string? lastCat = null;
                        foreach (var m in ModuleCatalog.Modules)
                        {
                            if (m.Category != lastCat)
                            {
                                <div class="nav-category sidebar-text" role="presentation">@m.Category</div>
                                lastCat = m.Category;
                            }
                            <a href="@m.BaseRoute" class="nav-item" title="@m.Name" aria-label="@m.Name module"><i class="bi @m.Icon" aria-hidden="true"></i><span class="sidebar-text">@m.Code</span></a>
                        }
                    }
                </div>

                <div class="sidebar-footer">
                    <div class="theme-dots" id="sidebarThemeDots" role="radiogroup" aria-label="Theme selection">
                        <button class="theme-btn" data-theme="modern" title="Modern theme" aria-label="Modern theme" role="radio" aria-checked="false"><span class="theme-label">Modern</span></button>
                        <button class="theme-btn" data-theme="classic" title="Classical theme" aria-label="Classical theme" role="radio" aria-checked="false"><span class="theme-label">Classical</span></button>
                        <button class="theme-btn" data-theme="minimal" title="Minimal theme" aria-label="Minimal theme" role="radio" aria-checked="false"><span class="theme-label">Minimal</span></button>
                        <button class="theme-btn" data-theme="futuristic" title="Futuristic theme" aria-label="Futuristic theme" role="radio" aria-checked="false"><span class="theme-label">Futuristic</span></button>
                    </div>
                    <div class="sidebar-text" style="display:flex;align-items:center;gap:8px;flex:1;min-width:0">
                        <div class="avatar" style="width:24px;height:24px;border-radius:50%;background:linear-gradient(135deg,var(--accent-light),var(--accent));display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:700;color:#fff;flex-shrink:0" aria-hidden="true">@(Context.User.Identity.Name?.Substring(0,1).ToUpper()??"U")</div>
                        <span style="font-size:12px;color:var(--sidebar-text-hover);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@Context.User.Identity.Name</span>
                    </div>
                </div>
            </nav>

            <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

            <div class="app-main-area">
                <header class="top-bar" role="banner">
                    <button type="button" class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle navigation menu"><i class="bi bi-list" aria-hidden="true"></i></button>
                    <div class="top-bar-center">
                        <div class="top-bar-search">
                            <i class="bi bi-search" aria-hidden="true"></i>
                            <input type="text" id="globalSearch" placeholder="@L["SearchPlaceholder"]" autocomplete="off" aria-label="Search transactions">
                            <button type="button" class="top-bar-search-btn" id="globalSearchBtn" title="Search" aria-label="Search"><i class="bi bi-arrow-right"></i></button>
                            <div id="globalSearchResults" class="search-results" style="display:none" role="listbox" aria-label="Search results"></div>
                        </div>
                    </div>
                    <div class="top-bar-right">
                        <button type="button" class="top-bar-icon" id="darkModeToggle" title="@L["ToggleDarkMode"]" aria-label="@L["ToggleDarkMode"]"><i class="bi bi-moon-stars"></i></button>
                        <a href="/Notifications" class="top-bar-icon" title="@L["Notifications"]" aria-label="@L["Notifications"]">
                            <i class="bi bi-bell" aria-hidden="true"></i>
                            <span class="badge bg-danger" id="notifCount" style="display:none" aria-live="polite">0</span>
                        </a>
                        <a href="/Dashboard" class="top-bar-icon" title="@L["Home"]" aria-label="@L["Home"]"><i class="bi bi-grid-3x3-gap" aria-hidden="true"></i></a>
                        <a href="/Settings" class="top-bar-icon" title="@L["Settings"]" aria-label="@L["Settings"]"><i class="bi bi-gear" aria-hidden="true"></i></a>
                        <form asp-controller="Home" asp-action="SetLanguage" method="post" class="top-bar-icon lang-form" style="margin:0;display:inline-flex">
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                            <select name="culture" onchange="this.form.submit()" class="lang-select" title="@L["SelectLanguage"]" aria-label="@L["SelectLanguage"]">
                                <option value="en" selected="@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en")">EN</option>
                                <option value="hi" selected="@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "hi")">HI</option>
                                <option value="ta" selected="@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ta")">TA</option>
                                <option value="te" selected="@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "te")">TE</option>
                                <option value="fr" selected="@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fr")">FR</option>
                                <option value="es" selected="@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "es")">ES</option>
                            </select>
                        </form>
                        <a href="#" class="top-bar-icon" id="printBtn" title="@L["Print"]" aria-label="@L["Print"]"><i class="bi bi-printer" aria-hidden="true"></i></a>
                        <a href="/Auth/Logout" class="top-bar-icon text-danger" title="@L["Logout"]" aria-label="@L["Logout"]"><i class="bi bi-box-arrow-right" aria-hidden="true"></i></a>
                    </div>
                </header>
                <main class="app-main" id="main-content" role="main">
                    @RenderBody()
                </main>
            </div>
        }
        else
        {
            <main class="app-main" style="padding:0 !important;min-height:100vh" id="main-content" role="main">
                @RenderBody()
            </main>
        }
    </div>
    <link rel="stylesheet" href="~/css/tcode-engine.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/enterprise-form.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script src="~/js/yuktira.js"></script>
    <script src="~/js/enterprise-form.js" asp-append-version="true"></script>
    <script>
        // ── Theme engine ──
        (function() {
            var saved = localStorage.getItem('yuktira_theme');
            if (!saved) saved = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'modern';
            document.documentElement.setAttribute('data-theme', saved);
            document.querySelectorAll('.theme-btn').forEach(function(btn) {
                if (btn.getAttribute('data-theme') === saved) {
                    btn.style.borderColor = '#fff';
                    btn.setAttribute('aria-checked', 'true');
                }
                btn.addEventListener('click', function() {
                    var theme = this.getAttribute('data-theme');
                    document.documentElement.setAttribute('data-theme', theme);
                    localStorage.setItem('yuktira_theme', theme);
                    document.querySelectorAll('.theme-btn').forEach(function(b) {
                        b.style.borderColor = 'transparent';
                        b.setAttribute('aria-checked', 'false');
                    });
                    this.style.borderColor = '#fff';
                    this.setAttribute('aria-checked', 'true');
                    document.getElementById('darkModeToggle').setAttribute('aria-label',
                        theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
                });
            });

            // Dark mode toggle button
            var darkToggle = document.getElementById('darkModeToggle');
            if (darkToggle) {
                darkToggle.addEventListener('click', function() {
                    var current = document.documentElement.getAttribute('data-theme');
                    var next = current === 'dark' ? 'modern' : 'dark';
                    document.documentElement.setAttribute('data-theme', next);
                    localStorage.setItem('yuktira_theme', next);
                    document.querySelectorAll('.theme-btn').forEach(function(b) {
                        b.style.borderColor = b.getAttribute('data-theme') === next ? '#fff' : 'transparent';
                        b.setAttribute('aria-checked', b.getAttribute('data-theme') === next ? 'true' : 'false');
                    });
                });
            }
        })();

        // ── System preference detection ──
        (function() {
            var mq = window.matchMedia('(prefers-color-scheme: dark)');
            mq.addEventListener('change', function(e) {
                if (!localStorage.getItem('yuktira_theme')) {
                    document.documentElement.setAttribute('data-theme', e.matches ? 'dark' : 'modern');
                }
            });
        })();

        // ── Sidebar active link ──
        (function() {
            var path = window.location.pathname;
            document.querySelectorAll('.nav-item').forEach(function(el) {
                var href = el.getAttribute('href');
                if (href && (path === href || path.startsWith(href + '/'))) {
                    el.classList.add('active');
                }
            });
        })();

        // ── Sidebar keyboard navigation ──
        (function() {
            var sidebar = document.getElementById('appSidebar');
            if (!sidebar) return;
            sidebar.addEventListener('keydown', function(e) {
                var items = Array.from(sidebar.querySelectorAll('.nav-item'));
                var current = document.activeElement;
                var idx = items.indexOf(current);
                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    var next = idx < items.length - 1 ? idx + 1 : 0;
                    items[next].focus();
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    var prev = idx > 0 ? idx - 1 : items.length - 1;
                    items[prev].focus();
                } else if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    if (current && current.classList.contains('nav-item')) {
                        window.location.href = current.getAttribute('href');
                    }
                }
            });
        })();

        // ── Notification badge ──
        (function() {
            var badge = document.getElementById('notifCount');
            if (badge) {
                fetch('/api/v1/notifications/unread-count').then(function(r) { return r.json(); }).then(function(d) {
                    if (d.count > 0) {
                        badge.textContent = d.count > 99 ? '99+' : d.count;
                        badge.style.display = '';
                    }
                });
            }
        })();

        // ── Global search (Ctrl+K) ──
        var searchTimeout;
        function doGlobalSearch() {
            var val = $('#globalSearch').val().trim().toUpperCase();
            var results = $('#globalSearchResults');
            if (val.length < 2) { results.hide(); return; }
            $.get('/Transactions/Search?q=' + encodeURIComponent(val), function(data) {
                var html = '';
                data.forEach(function(t) {
                    var route = t.route && t.route !== '#' ? t.route : '/Transactions/Engine/' + encodeURIComponent(t.code);
                    html += '<button type="button" class="list-group-item list-group-item-action d-flex align-items-center gap-2 py-2" role="option" onclick="window.location.href=\'' + route + '\'">';
                    html += '<i class="bi ' + t.icon + ' text-primary" aria-hidden="true"></i>';
                    html += '<div class="small"><strong>' + t.code + '</strong> <span class="text-muted">- ' + t.name + '</span></div>';
                    html += '</button>';
                });
                if (!data.length) html = '<div class="list-group-item text-muted small">No matches found</div>';
                results.html(html).show();
            });
        }
        $('#globalSearch').on('input', function() {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(doGlobalSearch, 150);
        });
        $('#globalSearchBtn').on('click', function() { doGlobalSearch(); $('#globalSearch').focus(); });
        $('#globalSearch').on('keydown', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                var first = $('#globalSearchResults button:first');
                if (first.length) {
                    var m = first.attr('onclick').match(/'([^']+)'/);
                    if (m) window.location.href = m[1];
                } else {
                    doGlobalSearch();
                }
            }
        });

        $(document).on('keydown', function(e) {
            if ((e.ctrlKey || e.metaKey) && e.key === 'k') { e.preventDefault(); $('#globalSearch').focus(); }
            if (e.key === 'Escape') { $('#globalSearch').val(''); $('#globalSearchResults').hide(); closeSidebar(); }
        });

        // ── Print / Save as PDF ──
        $('#printBtn').on('click', function(e) {
            e.preventDefault();
            $('.table-responsive, [style*="overflow-x:auto"]').each(function() {
                $(this).addClass('print-expanded');
            });
            window.print();
        });

        $(document).on('keydown', function(e) {
            if ((e.ctrlKey || e.metaKey) && e.key === 'p' && !e.shiftKey) { e.preventDefault(); $('#printBtn').click(); }
        });

        // ── Mobile sidebar drawer ──
        function openSidebar() {
            $('#appSidebar').addClass('sidebar-open');
            $('#sidebarBackdrop').addClass('show');
            $('body').addClass('sidebar-lock');
        }
        function closeSidebar() {
            $('#appSidebar').removeClass('sidebar-open');
            $('#sidebarBackdrop').removeClass('show');
            $('body').removeClass('sidebar-lock');
        }
        $('#sidebarToggle').on('click', function() {
            if ($('#appSidebar').hasClass('sidebar-open')) { closeSidebar(); } else { openSidebar(); }
        });
        $('#sidebarBackdrop').on('click', closeSidebar);
        $(document).on('click', '.nav-item', function() {
            if (window.innerWidth <= 991) closeSidebar();
        });

        $(document).on('click', function(e) {
            if (!$(e.target).closest('.top-bar-search').length) $('#globalSearchResults').hide();
        });
    </script>

    <script>
        // ── PWA: service worker registration ──
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', function() {
                navigator.serviceWorker.register('/sw.js').catch(function(err) {
                    console.warn('Service worker registration failed', err);
                });
            });
        }
    </script>
    <!-- Session Timeout Warning Modal (SAP-style) -->
    @if (Context.User?.Identity?.IsAuthenticated == true)
    {
    <div id="sessionTimeoutModal" class="session-timeout-overlay" style="display:none">
        <div class="session-timeout-dialog">
            <div class="session-timeout-icon">
                <i class="bi bi-clock-history"></i>
            </div>
            <h3>@L["SessionExpiring"]</h3>
            <p>Your session will expire in <span id="timeoutCountdown">60</span> seconds.</p>
            <p class="session-timeout-sub">@L["SessionContinueQ"]</p>
            <div class="session-timeout-actions">
                <button type="button" class="btn-timeout btn-timeout-continue" id="sessionContinueBtn">
                    <i class="bi bi-play-circle"></i> @L["ContinueSession"]
                </button>
                <button type="button" class="btn-timeout btn-timeout-logoff" id="sessionLogoffBtn">
                    <i class="bi bi-box-arrow-right"></i> @L["LogOff"]
                </button>
            </div>
            <div class="session-timeout-progress">
                <div class="session-timeout-progress-bar" id="timeoutProgressBar"></div>
            </div>
        </div>
    </div>
    }

    <script>
        // ── Session Timeout Manager (SAP-style) ──
        (function() {
            var sessionTimer = null;
            var warningTimer = null;
            var countdownInterval = null;
            var countdownSeconds = 60;
            var isWarningActive = false;
            var modal = document.getElementById('sessionTimeoutModal');
            if (!modal) return;

            var settings = JSON.parse(localStorage.getItem('yuktira_settings') || '{}');
            var timeoutMinutes = settings.sessionTimeoutMinutes || 30;
            var warningBeforeSeconds = settings.warningBeforeSeconds || 60;
            var totalSessionMs = timeoutMinutes * 60 * 1000;
            var warningMs = totalSessionMs - (warningBeforeSeconds * 1000);

            function resetSessionTimer() {
                clearTimeout(sessionTimer);
                clearTimeout(warningTimer);
                clearInterval(countdownInterval);
                isWarningActive = false;
                modal.style.display = 'none';

                warningTimer = setTimeout(function() { showWarning(); }, warningMs);
                sessionTimer = setTimeout(function() { window.location.href = '/Auth/Logout?reason=timeout'; }, totalSessionMs);
            }

            function showWarning() {
                isWarningActive = true;
                countdownSeconds = warningBeforeSeconds;
                var countdownEl = document.getElementById('timeoutCountdown');
                var progressEl = document.getElementById('timeoutProgressBar');
                modal.style.display = 'flex';
                countdownEl.textContent = countdownSeconds;
                progressEl.style.width = '100%';
                var startTime = Date.now();
                var totalMs = warningBeforeSeconds * 1000;

                countdownInterval = setInterval(function() {
                    countdownSeconds = countdownSeconds - 1;
                    countdownEl.textContent = countdownSeconds;
                    var elapsed = Date.now() - startTime;
                    var pct = Math.max(0, ((totalMs - elapsed) / totalMs) * 100);
                    progressEl.style.width = pct + '%';
                    if (countdownSeconds === 0 || countdownSeconds < 1) {
                        clearInterval(countdownInterval);
                        window.location.href = '/Auth/Logout?reason=timeout';
                    }
                }, 1000);
            }

            function continueSession() {
                clearInterval(countdownInterval);
                modal.style.display = 'none';
                isWarningActive = false;
                resetSessionTimer();
            }

            function logoff() { window.location.href = '/Auth/Logout?reason=manual'; }

            document.getElementById('sessionContinueBtn').addEventListener('click', continueSession);
            document.getElementById('sessionLogoffBtn').addEventListener('click', logoff);

            ['mousemove', 'keydown', 'click', 'scroll', 'touchstart'].forEach(function(evt) {
                document.addEventListener(evt, function() {
                    if (!isWarningActive) resetSessionTimer();
                }, { passive: true });
            });

            resetSessionTimer();
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
