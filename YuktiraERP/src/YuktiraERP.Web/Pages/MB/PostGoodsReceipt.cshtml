@page
@model YuktiraERP.Web.Pages.MB.PostGoodsReceiptModel
@{ ViewData["Title"] = "MB01 - Goods Receipt"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><i class="bi bi-arrow-down-circle me-2"></i>MB01 - Goods Receipt</h3>
            <span class="badge">MT 101</span>
        </div>
        <div class="actions">
            <button type="submit" form="grForm" class="zqm-btn" style="background:#4caf50;border-color:#4caf50"><i class="bi bi-check-circle me-1"></i>Post Receipt</button>
            <button type="button" class="zqm-btn" onclick="document.getElementById('grForm').reset()"><i class="bi bi-x-circle me-1"></i>Clear</button>
            <a asp-page="/MB/Index" class="zqm-btn zqm-btn-back"><i class="bi bi-arrow-left me-1"></i>Back</a>
        </div>
    </div>

    <div id="alertBox" class="zqm-alert"></div>

    <div class="zqm-filter">
        <div class="zqm-section-title"><i class="bi bi-gear me-1"></i>Document Header</div>
        <form method="post" id="grForm">
            <div class="zqm-row cols-4">
                <div class="zqm-field"><label>Posting Date</label><input asp-for="Request.PostingDate" type="date" /></div>
                <div class="zqm-field"><label>Document Date</label><input asp-for="Request.DocumentDate" type="date" /></div>
                <div class="zqm-field"><label>Reference <span class="sub">(PO Number)</span></label><input asp-for="Request.Reference" placeholder="PO Number" /></div>
                <div class="zqm-field"><label>Header Text</label><input asp-for="Request.HeaderText" /></div>
            </div>
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Plant</label><input asp-for="Request.Plant" placeholder="1000" /></div>
                <div class="zqm-field"><label>Storage Location</label><input asp-for="Request.StorageLocation" /></div>
                <div class="zqm-field"><label>Movement Type</label><div class="zqm-ro">101 - GR for PO</div></div>
            </div>

            <div class="zqm-section-title" style="margin-top:12px"><i class="bi bi-table me-1"></i>Line Items</div>
            <div class="zqm-table-wrap">
                <table class="zqm-table" id="lineItems">
                    <thead>
                        <tr>
                            <th style="width:40px">#</th>
                            <th style="min-width:130px">Material Code</th>
                            <th style="min-width:160px">Material Name</th>
                            <th style="min-width:90px">Quantity</th>
                            <th style="min-width:70px">UOM</th>
                            <th style="min-width:100px">Unit Price</th>
                            <th style="min-width:100px">Batch</th>
                            <th style="min-width:100px">PO Number</th>
                            <th style="width:40px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>1</td>
                            <td><input name="Request.Lines[0].MaterialCode" class="zqm-field-input" style="width:100%;padding:5px 8px;border:1px solid #ccc;border-radius:3px;font-size:0.82rem" /></td>
                            <td><input name="Request.Lines[0].MaterialName" class="zqm-field-input" style="width:100%;padding:5px 8px;border:1px solid #ccc;border-radius:3px;font-size:0.82rem" /></td>
                            <td><input name="Request.Lines[0].Quantity" type="number" step="0.001" style="width:100%;padding:5px 8px;border:1px solid #ccc;border-radius:3px;font-size:0.82rem" /></td>
                            <td><input name="Request.Lines[0].UOM" value="EA" style="width:100%;padding:5px 8px;border:1px solid #ccc;border-radius:3px;font-size:0.82rem" /></td>
                            <td><input name="Request.Lines[0].UnitPrice" type="number" step="0.01" style="width:100%;padding:5px 8px;border:1px solid #ccc;border-radius:3px;font-size:0.82rem" /></td>
                            <td><input name="Request.Lines[0].BatchNumber" style="width:100%;padding:5px 8px;border:1px solid #ccc;border-radius:3px;font-size:0.82rem" /></td>
                            <td><input name="Request.Lines[0].PurchaseOrderNo" style="width:100%;padding:5px 8px;border:1px solid #ccc;border-radius:3px;font-size:0.82rem" /></td>
                            <td><button type="button" class="zqm-act" style="color:#c62828;border-color:#ffcdd2" onclick="this.closest('tr').remove()"><i class="bi bi-x"></i></button></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div style="margin-top:8px">
                <button type="button" class="zqm-btn" onclick="addLine()"><i class="bi bi-plus me-1"></i>Add Line</button>
            </div>
        </form>
    </div>

    @if (Model.Result != null)
    {
        <div class="zqm-results" style="margin-top:0">
            <div class="zqm-results-header"><h4><i class="bi bi-check-circle me-1"></i>Posting Result</h4></div>
            <div style="padding:16px">
                @if (Model.Result.Success)
                {
                    <div class="zqm-row cols-4">
                        <div style="padding:10px;background:#e8f5e9;border:1px solid #c8e6c9;border-radius:4px"><label style="font-size:0.68rem;font-weight:600;color:#2e7d32;text-transform:uppercase">Document Number</label><div style="font-size:1.1rem;font-weight:700;color:#1b5e20">@Model.Result.DocumentNumber</div></div>
                        <div style="padding:10px;background:#e3f2fd;border:1px solid #90caf9;border-radius:4px"><label style="font-size:0.68rem;font-weight:600;color:#1565c0;text-transform:uppercase">Movement Type</label><div style="font-size:1.1rem;font-weight:700;color:#0d47a1">@Model.Result.MovementType</div></div>
                        <div style="padding:10px;background:#e3f2fd;border:1px solid #90caf9;border-radius:4px"><label style="font-size:0.68rem;font-weight:600;color:#1565c0;text-transform:uppercase">Total Quantity</label><div style="font-size:1.1rem;font-weight:700;color:#0d47a1">@Model.Result.TotalQuantity</div></div>
                        <div style="padding:10px;background:#e3f2fd;border:1px solid #90caf9;border-radius:4px"><label style="font-size:0.68rem;font-weight:600;color:#1565c0;text-transform:uppercase">Total Value</label><div style="font-size:1.1rem;font-weight:700;color:#0d47a1">@Model.Result.TotalValue.ToString("N2")</div></div>
                    </div>
                    @if (Model.Result.InspectionLotNumber != null)
                    {
                        <div style="margin-top:8px;padding:8px 12px;background:#fff3e0;border:1px solid #ffe0b2;border-radius:4px;font-size:0.85rem"><i class="bi bi-clipboard-check me-1" style="color:#e65100"></i><strong>Inspection Lot:</strong> @Model.Result.InspectionLotNumber</div>
                    }
                    @if (Model.Result.StockImpacts.Any())
                    {
                        <div class="zqm-table-wrap" style="margin-top:12px">
                            <table class="zqm-table">
                                <thead><tr><th>Material</th><th>Plant</th><th>SLoc</th><th>Before</th><th>After</th></tr></thead>
                                <tbody>
                                    @foreach (var impact in Model.Result.StockImpacts)
                                    {
                                        <tr><td>@impact.MaterialCode</td><td>@impact.Plant</td><td>@impact.StorageLocation</td><td>@impact.QuantityBefore</td><td style="font-weight:600">@impact.QuantityAfter</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
                else
                {
                    <div style="padding:12px;background:#ffcdd2;border:1px solid #ef9a9a;border-radius:4px;color:#c62828;font-size:0.85rem">
                        @foreach (var err in Model.Result.Errors) { <div>@err</div> }
                    </div>
                }
            </div>
        </div>
    }
</div>

<script>
function addLine() {
    var tbody = document.querySelector('#lineItems tbody');
    var idx = tbody.rows.length;
    var s = 'padding:5px 8px;border:1px solid #ccc;border-radius:3px;font-size:0.82rem;width:100%';
    var row = '<tr><td>' + (idx+1) + '</td>' +
        '<td><input name="Request.Lines['+idx+'].MaterialCode" style="'+s+'" /></td>' +
        '<td><input name="Request.Lines['+idx+'].MaterialName" style="'+s+'" /></td>' +
        '<td><input name="Request.Lines['+idx+'].Quantity" type="number" step="0.001" style="'+s+'" /></td>' +
        '<td><input name="Request.Lines['+idx+'].UOM" value="EA" style="'+s+'" /></td>' +
        '<td><input name="Request.Lines['+idx+'].UnitPrice" type="number" step="0.01" style="'+s+'" /></td>' +
        '<td><input name="Request.Lines['+idx+'].BatchNumber" style="'+s+'" /></td>' +
        '<td><input name="Request.Lines['+idx+'].PurchaseOrderNo" style="'+s+'" /></td>' +
        '<td><button type="button" class="zqm-act" style="color:#c62828;border-color:#ffcdd2" onclick="this.closest(\'tr\').remove()"><i class="bi bi-x"></i></button></td></tr>';
    tbody.insertAdjacentHTML('beforeend', row);
}
</script>
