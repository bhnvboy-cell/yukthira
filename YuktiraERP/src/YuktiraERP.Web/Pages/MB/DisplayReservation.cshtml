@page
@model YuktiraERP.Web.Pages.MB.DisplayReservationModel
@{ ViewData["Title"] = "MB23/24 - Display Reservation"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><svg class="bi bi-bookmark me-2" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-bookmark"></use></svg>MB23/24 - Display Reservation</h3>
            <span class="badge">Search</span>
        </div>
        <div class="actions">
            <a asp-page="/MB/Index" class="zqm-btn zqm-btn-back"><svg class="bi bi-arrow-left me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-arrow-left"></use></svg>Back</a>
        </div>
    </div>

    <div id="alertBox" class="zqm-alert"></div>

    <div class="zqm-filter">
        <div class="zqm-section-title"><svg class="bi bi-funnel me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-funnel"></use></svg>Search Criteria</div>
        <form method="get">
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Material Code</label><input asp-for="MaterialCode" placeholder="Optional" /></div>
                <div class="zqm-field"><label>Plant</label><input asp-for="Plant" placeholder="Optional" /></div>
                <div class="zqm-field" style="display:flex;align-items:end;gap:8px">
                    <button type="submit" class="zqm-btn" style="background:#1565c0;border-color:#1565c0"><svg class="bi bi-search me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-search"></use></svg>Search</button>
                </div>
            </div>
        </form>
    </div>

    @if (Model.Reservations != null && Model.Reservations.Any())
    {
        <div class="zqm-results">
            <div class="zqm-results-header">
                <h4><svg class="bi bi-list-ul me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-list-ul"></use></svg>Reservations</h4>
                <span class="count">@Model.Reservations.Count found</span>
            </div>
            <div class="zqm-table-wrap">
                <table class="zqm-table">
                    <thead>
                        <tr>
                            <th>Reservation #</th>
                            <th>Date</th>
                            <th>Plant</th>
                            <th>Total Reserved</th>
                            <th>Total Issued</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Reservations)
                        {
                            <tr>
                                <td style="font-weight:600;color:#1565c0">@r.ReservationNumber</td>
                                <td>@r.RequirementDate.ToString("dd/MM/yyyy")</td>
                                <td>@r.Plant</td>
                                <td>@r.TotalReservedQuantity</td>
                                <td>@r.TotalIssuedQuantity</td>
                                <td><span class="zqm-badge @(r.Status == "Active" ? "passed" : "closed")">@r.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (Model.Reservations != null)
    {
        <div class="zqm-results">
            <div class="zqm-empty"><svg class="bi bi-inbox" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-inbox"></use></svg><div>No reservations found matching criteria.</div></div>
        </div>
    }
</div>
