@page
@model YuktiraERP.Web.Pages.MB.MB5LReconciliationModel
@{ ViewData["Title"] = "MB5L - MM/FI Reconciliation"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><i class="bi bi-balance me-2"></i>MB5L - MM/FI Reconciliation</h3>
            <span class="badge">Report</span>
        </div>
        <div class="actions">
            <button type="submit" form="mb5lForm" class="zqm-btn" style="background:#1565c0;border-color:#1565c0"><i class="bi bi-search me-1"></i>Search</button>
            <a asp-page="/MB/Index" class="zqm-btn zqm-btn-back"><i class="bi bi-arrow-left me-1"></i>Back</a>
        </div>
    </div>

    <div class="zqm-filter">
        <div class="zqm-section-title"><i class="bi bi-funnel me-1"></i>Filters</div>
        <form method="get" id="mb5lForm">
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Material Code</label><input asp-for="MaterialCode" placeholder="Optional" /></div>
                <div class="zqm-field"><label>Plant</label><input asp-for="Plant" placeholder="Optional" /></div>
                <div></div>
            </div>
        </form>
    </div>

    @if (Model.Data != null && Model.Data.Any())
    {
        <div class="zqm-results">
            <div class="zqm-results-header">
                <h4><i class="bi bi-balance me-1"></i>Reconciliation Results</h4>
                <span class="count">@Model.Data.Count items</span>
            </div>
            <div class="zqm-table-wrap">
                <table class="zqm-table">
                    <thead>
                        <tr>
                            <th>Material</th>
                            <th>Plant</th>
                            <th>SLoc</th>
                            <th>MM Qty</th>
                            <th>MM Value</th>
                            <th>FI Debit</th>
                            <th>FI Credit</th>
                            <th>FI Balance</th>
                            <th>Difference</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Data)
                        {
                            <tr>
                                <td style="font-weight:600">@r.MaterialCode</td>
                                <td>@r.Plant</td>
                                <td>@r.StorageLocation</td>
                                <td>@r.MmStockQuantity</td>
                                <td>@r.MmStockValue.ToString("N2")</td>
                                <td>@r.FiGlDebit.ToString("N2")</td>
                                <td>@r.FiGlCredit.ToString("N2")</td>
                                <td style="font-weight:600">@r.FiGlBalance.ToString("N2")</td>
                                <td style="font-weight:700;color:@(r.IsReconciled ? "#2e7d32" : "#c62828")">@r.Difference.ToString("N2")</td>
                                <td>
                                    @if (r.IsReconciled) { <span class="zqm-badge passed">Reconciled</span> }
                                    else { <span class="zqm-badge failed">Discrepancy</span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (Model.Data != null)
    {
        <div class="zqm-results">
            <div class="zqm-empty"><i class="bi bi-inbox"></i><div>No data found matching criteria.</div></div>
        </div>
    }
</div>
