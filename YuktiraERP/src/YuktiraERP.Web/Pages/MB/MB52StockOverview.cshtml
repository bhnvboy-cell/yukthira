@page
@model YuktiraERP.Web.Pages.MB.MB52StockOverviewModel
@{ ViewData["Title"] = "MB52 - Stock Overview"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><i class="bi bi-bar-chart me-2"></i>MB52 - Warehouse Stock Overview</h3>
            <span class="badge">Report</span>
        </div>
        <div class="actions">
            <button type="submit" form="mb52Form" class="zqm-btn" style="background:#1565c0;border-color:#1565c0"><i class="bi bi-search me-1"></i>Search</button>
            <a asp-page="/MB/Index" class="zqm-btn zqm-btn-back"><i class="bi bi-arrow-left me-1"></i>Back</a>
        </div>
    </div>

    <div class="zqm-filter">
        <div class="zqm-section-title"><i class="bi bi-funnel me-1"></i>Filters</div>
        <form method="get" id="mb52Form">
            <div class="zqm-row cols-4">
                <div class="zqm-field"><label>Material Code</label><input asp-for="Filter.MaterialCode" /></div>
                <div class="zqm-field"><label>Plant</label><input asp-for="Filter.Plant" /></div>
                <div class="zqm-field"><label>Storage Location</label><input asp-for="Filter.StorageLocation" /></div>
                <div class="zqm-field">
                    <label>Group By</label>
                    <select asp-for="Filter.GroupBy">
                        <option value="0">Material</option>
                        <option value="1">Plant</option>
                        <option value="2">Storage Location</option>
                        <option value="3">Batch</option>
                    </select>
                </div>
            </div>
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Batch</label><input asp-for="Filter.BatchNumber" /></div>
                <div class="zqm-field" style="display:flex;align-items:end;gap:16px">
                    <label style="display:flex;align-items:center;gap:5px;font-size:0.82rem;font-weight:500;cursor:pointer"><input asp-for="Filter.IncludeZeroStock" style="accent-color:#1565c0" /> Include Zero Stock</label>
                </div>
                <div></div>
            </div>
        </form>
    </div>

    @if (Model.Stocks != null && Model.Stocks.Any())
    {
        <div class="zqm-results">
            <div class="zqm-results-header">
                <h4><i class="bi bi-bar-chart me-1"></i>Stock Overview</h4>
                <span class="count">@Model.Stocks.Count items</span>
            </div>
            <div class="zqm-table-wrap">
                <table class="zqm-table">
                    <thead>
                        <tr>
                            <th>Material</th>
                            <th>Name</th>
                            <th>Plant</th>
                            <th>SLoc</th>
                            <th>Unrestricted</th>
                            <th>QI</th>
                            <th>Blocked</th>
                            <th>Total</th>
                            <th>MAP</th>
                            <th>Value</th>
                            <th>UOM</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.Stocks)
                        {
                            <tr>
                                <td style="font-weight:600">@s.MaterialCode</td>
                                <td>@s.MaterialName</td>
                                <td>@s.Plant</td>
                                <td>@s.StorageLocation</td>
                                <td>@s.UnrestrictedQty</td>
                                <td>@s.QualityInspectionQty</td>
                                <td>@s.BlockedQty</td>
                                <td style="font-weight:700">@s.TotalQty</td>
                                <td>@s.UnitPrice.ToString("N2")</td>
                                <td style="font-weight:600">@s.TotalValue.ToString("N2")</td>
                                <td>@s.UOM</td>
                                <td>
                                    @if (s.IsBelowMinStock) { <span class="zqm-badge danger">Below Min</span> }
                                    else if (s.IsAboveMaxStock) { <span class="zqm-badge warning">Above Max</span> }
                                    else { <span class="zqm-badge passed">OK</span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (Model.Stocks != null)
    {
        <div class="zqm-results">
            <div class="zqm-empty"><i class="bi bi-inbox"></i><div>No stock found matching criteria.</div></div>
        </div>
    }
</div>
