@page
@model YuktiraERP.Web.Pages.MB.MB51ReportModel
@{ ViewData["Title"] = "MB51 - Material Document List"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><i class="bi bi-list-ul me-2"></i>MB51 - Material Document List</h3>
            <span class="badge">Report</span>
        </div>
        <div class="actions">
            <button type="submit" form="mb51Form" class="zqm-btn" style="background:#1565c0;border-color:#1565c0"><i class="bi bi-search me-1"></i>Search</button>
            <a asp-page="/MB/Index" class="zqm-btn zqm-btn-back"><i class="bi bi-arrow-left me-1"></i>Back</a>
        </div>
    </div>

    <div class="zqm-filter">
        <div class="zqm-section-title"><i class="bi bi-funnel me-1"></i>Filters</div>
        <form method="get" id="mb51Form">
            <div class="zqm-row cols-4">
                <div class="zqm-field"><label>Material Code</label><input asp-for="Filter.MaterialCode" /></div>
                <div class="zqm-field"><label>Plant</label><input asp-for="Filter.Plant" /></div>
                <div class="zqm-field"><label>Movement Type</label><input asp-for="Filter.MovementType" type="number" /></div>
                <div class="zqm-field"><label>Document Number</label><input asp-for="Filter.DocumentNumber" /></div>
            </div>
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Posting Date From</label><input asp-for="Filter.PostingDateFrom" type="date" /></div>
                <div class="zqm-field"><label>Posting Date To</label><input asp-for="Filter.PostingDateTo" type="date" /></div>
                <div></div>
            </div>
        </form>
    </div>

    @if (Model.Documents != null && Model.Documents.Any())
    {
        <div class="zqm-results">
            <div class="zqm-results-header">
                <h4><i class="bi bi-list-ul me-1"></i>Results</h4>
                <span class="count">@Model.Documents.Count documents</span>
            </div>
            <div class="zqm-table-wrap">
                <table class="zqm-table">
                    <thead>
                        <tr>
                            <th>Doc #</th>
                            <th>Posting Date</th>
                            <th>Mvt Type</th>
                            <th>Material</th>
                            <th>Plant</th>
                            <th>SLoc</th>
                            <th>Batch</th>
                            <th>Qty</th>
                            <th>UOM</th>
                            <th>Value</th>
                            <th>Bucket</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in Model.Documents)
                        {
                            <tr>
                                <td><a href="/MB/DisplayMaterialDocument?DocumentNumber=@doc.DocumentNumber" style="color:#1565c0;font-weight:600;text-decoration:none">@doc.DocumentNumber</a></td>
                                <td>@doc.PostingDate.ToString("dd/MM/yyyy")</td>
                                <td><span class="zqm-badge info">@doc.MovementType</span></td>
                                <td>@doc.MaterialCode</td>
                                <td>@doc.Plant</td>
                                <td>@doc.StorageLocation</td>
                                <td>@(doc.BatchNumber ?? "-")</td>
                                <td>@doc.Quantity</td>
                                <td>@doc.UOM</td>
                                <td style="font-weight:600">@doc.TotalValue.ToString("N2")</td>
                                <td>@doc.StockBucket</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (Model.Documents != null)
    {
        <div class="zqm-results">
            <div class="zqm-empty"><i class="bi bi-inbox"></i><div>No documents found matching criteria.</div></div>
        </div>
    }
</div>
