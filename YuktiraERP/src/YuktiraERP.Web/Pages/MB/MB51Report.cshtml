@page
@model YuktiraERP.Web.Pages.MB.MB51ReportModel
@{
    ViewData["Title"] = "MB51 - Material Document List";
}
<div class="row justify-content-center">
<div class="col-lg-10">
<h4 class="mb-3"><i class="bi bi-list-ul me-2"></i>MB51 - Material Document List</h4>

<div class="card shadow-sm mb-3">
    <div class="card-header bg-warning text-dark"><h6 class="mb-0">Filters</h6></div>
    <div class="card-body">
        <form method="get">
        <div class="row mb-2">
            <div class="col-md-3">
                <label class="form-label">Material Code</label>
                <input asp-for="Filter.MaterialCode" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Plant</label>
                <input asp-for="Filter.Plant" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Movement Type</label>
                <input asp-for="Filter.MovementType" type="number" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Document Number</label>
                <input asp-for="Filter.DocumentNumber" class="form-control" />
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-md-3">
                <label class="form-label">Posting Date From</label>
                <input asp-for="Filter.PostingDateFrom" type="date" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Posting Date To</label>
                <input asp-for="Filter.PostingDateTo" type="date" class="form-control" />
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-primary"><i class="bi bi-search me-1"></i>Search</button>
                <a href="/MB/Index" class="btn btn-secondary ms-2">Back</a>
            </div>
        </div>
        </form>
    </div>
</div>

@if (Model.Documents != null && Model.Documents.Any())
{
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-success text-white"><h6 class="mb-0">Results (@Model.Documents.Count documents)</h6></div>
        <div class="card-body table-responsive">
            <table class="table table-bordered table-sm table-hover" id="mb51Table">
                <thead class="table-light">
                    <tr>
                        <th>Doc #</th>
                        <th>Posting Date</th>
                        <th>Mvt Type</th>
                        <th>Material</th>
                        <th>Plant</th>
                        <th>SLoc</th>
                        <th>Batch</th>
                        <th>Qty</th>
                        <th>UOM</th>
                        <th>Value</th>
                        <th>Bucket</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var doc in Model.Documents)
                    {
                        <tr>
                            <td><a href="/MB/DisplayMaterialDocument?DocumentNumber=@doc.DocumentNumber">@doc.DocumentNumber</a></td>
                            <td>@doc.PostingDate.ToString("dd/MM/yyyy")</td>
                            <td>@doc.MovementType</td>
                            <td>@doc.MaterialCode</td>
                            <td>@doc.Plant</td>
                            <td>@doc.StorageLocation</td>
                            <td>@(doc.BatchNumber ?? "-")</td>
                            <td>@doc.Quantity</td>
                            <td>@doc.UOM</td>
                            <td>@doc.TotalValue.ToString("N2")</td>
                            <td>@doc.StockBucket</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else if (Model.Documents != null)
{
    <div class="alert alert-info">No documents found matching criteria.</div>
}
</div>
</div>
