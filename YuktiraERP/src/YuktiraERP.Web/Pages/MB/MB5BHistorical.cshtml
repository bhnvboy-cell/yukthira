@page
@model YuktiraERP.Web.Pages.MB.MB5BHistoricalModel
@{ ViewData["Title"] = "MB5B - Historical Stock Values"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><i class="bi bi-calendar-range me-2"></i>MB5B - Historical Stock Values</h3>
            <span class="badge">Report</span>
        </div>
        <div class="actions">
            <button type="submit" form="mb5bForm" class="zqm-btn" style="background:#1565c0;border-color:#1565c0"><i class="bi bi-search me-1"></i>Search</button>
            <a asp-page="/MB/Index" class="zqm-btn zqm-btn-back"><i class="bi bi-arrow-left me-1"></i>Back</a>
        </div>
    </div>

    <div class="zqm-filter">
        <div class="zqm-section-title"><i class="bi bi-funnel me-1"></i>Filters</div>
        <form method="get" id="mb5bForm">
            <div class="zqm-row cols-4">
                <div class="zqm-field"><label>Material Code <span class="sub">(required)</span></label><input asp-for="MaterialCode" required /></div>
                <div class="zqm-field"><label>Plant <span class="sub">(required)</span></label><input asp-for="Plant" required /></div>
                <div class="zqm-field"><label>From Date</label><input asp-for="FromDate" type="date" /></div>
                <div class="zqm-field"><label>To Date</label><input asp-for="ToDate" type="date" /></div>
            </div>
        </form>
    </div>

    @if (Model.Data != null)
    {
        <div class="zqm-results">
            <div class="zqm-results-header">
                <h4><i class="bi bi-calendar-range me-1"></i>Historical Stock - @Model.Data.MaterialCode @Model.Data.Plant</h4>
                <span class="count">@Model.Data.DailyMovements.Count movements</span>
            </div>
            <div style="padding:16px">
                <div class="zqm-section-title"><i class="bi bi-graph-up me-1"></i>Summary</div>
                <div class="zqm-row cols-4">
                    <div style="padding:10px;background:#e3f2fd;border:1px solid #90caf9;border-radius:4px"><label style="font-size:0.68rem;font-weight:600;color:#1565c0;text-transform:uppercase">Opening Qty</label><div style="font-size:1rem;font-weight:700;color:#0d47a1">@Model.Data.OpeningQuantity</div></div>
                    <div style="padding:10px;background:#e8f5e9;border:1px solid #c8e6c9;border-radius:4px"><label style="font-size:0.68rem;font-weight:600;color:#2e7d32;text-transform:uppercase">Receipts</label><div style="font-size:1rem;font-weight:700;color:#1b5e20">@Model.Data.ReceiptQuantity</div></div>
                    <div style="padding:10px;background:#ffcdd2;border:1px solid #ef9a9a;border-radius:4px"><label style="font-size:0.68rem;font-weight:600;color:#c62828;text-transform:uppercase">Issues</label><div style="font-size:1rem;font-weight:700;color:#b71c1c">@Model.Data.IssueQuantity</div></div>
                    <div style="padding:10px;background:#f3e5f5;border:1px solid #ce93d8;border-radius:4px"><label style="font-size:0.68rem;font-weight:600;color:#7b1fa2;text-transform:uppercase">Closing Qty</label><div style="font-size:1rem;font-weight:700;color:#4a148c">@Model.Data.ClosingQuantity</div></div>
                </div>

                @if (Model.Data.DailyMovements.Any())
                {
                    <div class="zqm-section-title" style="margin-top:16px"><i class="bi bi-table me-1"></i>Daily Movements</div>
                    <div class="zqm-table-wrap">
                        <table class="zqm-table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Mvt Type</th>
                                    <th>Description</th>
                                    <th>Qty</th>
                                    <th>Value</th>
                                    <th>Running Balance</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in Model.Data.DailyMovements)
                                {
                                    <tr>
                                        <td>@m.Date.ToString("dd/MM/yyyy")</td>
                                        <td><span class="zqm-badge info">@m.MovementType</span></td>
                                        <td>@m.Description</td>
                                        <td>@m.Quantity</td>
                                        <td>@m.Value.ToString("N2")</td>
                                        <td style="font-weight:600">@m.RunningBalance</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</div>
