@page
@model YuktiraERP.Web.Pages.WM.StorageLocation.CreateModel
@{ ViewData["Title"] = "Create Storage Location"; }

<div class="ent-form-wrapper">
    <div class="ent-org-banner">
        <div class="banner-icon"><svg class="bi bi-geo-alt" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-geo-alt"></use></svg></div>
        <div class="banner-info">
            <h5>Create Storage Location</h5>
            <span>OX09 — Storage Location Master</span>
        </div>
        <div class="banner-meta">
            Plant: 1000
        </div>
    </div>

    <form method="post">
        <input type="hidden" asp-for="Location.Status" value="Active" />

        <div class="ent-form-tabs">
            <button type="button" class="ent-form-tab active" data-tab="general">
                <svg class="bi bi-geo-alt tab-icon" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-geo-alt"></use></svg> General Data
            </button>
            <button type="button" class="ent-form-tab" data-tab="capacity">
                <svg class="bi bi-speedometer2 tab-icon" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-speedometer2"></use></svg> Capacity & Layout
            </button>
            <button type="button" class="ent-form-tab" data-tab="settings">
                <svg class="bi bi-sliders tab-icon" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-sliders"></use></svg> Settings
            </button>
        </div>

        <!-- ═══ TAB: General Data ═══ -->
        <div class="ent-form-panel active" data-panel="general">
            <div class="ent-section">
                <div class="ent-section-header"><svg class="bi bi-geo-alt" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-geo-alt"></use></svg><h6>Location Identification</h6></div>
                <div class="ent-field-grid cols-3">
                    <div class="ent-field">
                        <label>Location Code</label>
                        <input asp-for="Location.Code" class="form-control" placeholder="Auto-generated" />
                    </div>
                    <div class="ent-field" style="grid-column: span 2">
                        <label>Name <span class="required">*</span></label>
                        <input asp-for="Location.Name" class="form-control" placeholder="Storage location name" />
                        <span asp-validation-for="Location.Name" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="ent-section">
                <div class="ent-section-header"><svg class="bi bi-diagram-3" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-diagram-3"></use></svg><h6>Classification</h6></div>
                <div class="ent-field-grid cols-3">
                    <div class="ent-field">
                        <label>Type <span class="required">*</span></label>
                        <select asp-for="Location.Type" class="form-select">
                            <option value="Warehouse">Warehouse</option>
                            <option value="Rack">Rack</option>
                            <option value="Cold Storage">Cold Storage</option>
                            <option value="Yard">Yard</option>
                            <option value="Bonded">Bonded Warehouse</option>
                            <option value="Hazmat">Hazardous Storage</option>
                        </select>
                    </div>
                    <div class="ent-field">
                        <label>Plant</label>
                        <select class="form-select">
                            <option value="1000">1000 — Main Plant</option>
                            <option value="2000">2000 — Secondary Plant</option>
                        </select>
                    </div>
                    <div class="ent-field">
                        <label>Storage Section</label>
                        <select class="form-select">
                            <option value="A">Section A — Receiving</option>
                            <option value="B">Section B — Bulk Storage</option>
                            <option value="C">Section C — Pick Area</option>
                            <option value="D">Section D — Shipping</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══ TAB: Capacity & Layout ═══ -->
        <div class="ent-form-panel" data-panel="capacity">
            <div class="ent-section">
                <div class="ent-section-header"><svg class="bi bi-speedometer2" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-speedometer2"></use></svg><h6>Capacity Planning</h6></div>
                <div class="ent-field-grid cols-3">
                    <div class="ent-field">
                        <label>Max Capacity (units)</label>
                        <input asp-for="Location.Capacity" class="form-control" min="0" step="1" />
                        <span asp-validation-for="Location.Capacity" class="text-danger"></span>
                    </div>
                    <div class="ent-field">
                        <label>Weight Capacity (kg)</label>
                        <input type="number" class="form-control" min="0" step="1" value="0" />
                    </div>
                    <div class="ent-field">
                        <label>Volume Capacity (m³)</label>
                        <input type="number" class="form-control" min="0" step="0.01" value="0" />
                    </div>
                </div>
            </div>
            <div class="ent-section">
                <div class="ent-section-header"><svg class="bi bi-box" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-box"></use></svg><h6>Bin Layout</h6></div>
                <div class="ent-field-grid cols-3">
                    <div class="ent-field">
                        <label>Number of Rows</label>
                        <input type="number" class="form-control" min="1" value="1" />
                    </div>
                    <div class="ent-field">
                        <label>Number of Columns</label>
                        <input type="number" class="form-control" min="1" value="1" />
                    </div>
                    <div class="ent-field">
                        <label>Number of Levels</label>
                        <input type="number" class="form-control" min="1" value="1" />
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══ TAB: Settings ═══ -->
        <div class="ent-form-panel" data-panel="settings">
            <div class="ent-section">
                <div class="ent-section-header"><svg class="bi bi-sliders" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-sliders"></use></svg><h6>Operational Settings</h6></div>
                <div class="ent-field-grid cols-3">
                    <div class="ent-field">
                        <label>Status</label>
                        <select asp-for="Location.Status" class="form-select">
                            <option value="Active">Active</option>
                            <option value="Full">Full</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>
                    <div class="ent-field">
                        <label>Storage Strategy</label>
                        <select class="form-select">
                            <option value="FIFO">FIFO — First In, First Out</option>
                            <option value="LIFO">LIFO — Last In, First Out</option>
                            <option value="FEFO">FEFO — First Expire, First Out</option>
                        </select>
                    </div>
                    <div class="ent-field">
                        <label>Putaway Strategy</label>
                        <select class="form-select">
                            <option value="Fixed">Fixed Bin</option>
                            <option value="Open">Open Storage</option>
                            <option value="Near">Near Pick Area</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="ent-section">
                <div class="ent-section-header"><svg class="bi bi-toggle-on" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-toggle-on"></use></svg><h6>Features</h6></div>
                <div class="ent-field-grid cols-3">
                    <div class="ent-field">
                        <label>Batch Management</label>
                        <select class="form-select">
                            <option value="No">No</option>
                            <option value="Yes">Yes — Required</option>
                        </select>
                    </div>
                    <div class="ent-field">
                        <label>Serial Number Management</label>
                        <select class="form-select">
                            <option value="No">No</option>
                            <option value="Yes">Yes — Required</option>
                        </select>
                    </div>
                    <div class="ent-field">
                        <label>Quality Inspection</label>
                        <select class="form-select">
                            <option value="No">No</option>
                            <option value="Yes">Yes — On Receipt</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="ent-form-footer">
            <div class="footer-info">
                <svg class="bi bi-shield-check me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-shield-check"></use></svg>Storage locations are SOX-audit logged
            </div>
            <div class="footer-actions">
                <a asp-page="/WM/Index" class="btn btn-outline-secondary"><svg class="bi bi-x me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-x"></use></svg>Cancel</a>
                <button type="submit" class="btn btn-primary"><svg class="bi bi-save me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-save"></use></svg>Save Location</button>
            </div>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
