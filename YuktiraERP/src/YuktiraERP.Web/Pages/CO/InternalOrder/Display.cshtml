@page
@model YuktiraERP.Web.Pages.CO.InternalOrder.DisplayModel
@using YuktiraERP.Infrastructure.Data.Entities
@{ ViewData["Title"] = "InternalOrder Details"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-info text-white"><h5 class="mb-0"><i class="bi bi-eye me-2"></i>InternalOrder Details</h5></div>
<div class="card-body">
<dl class="row mb-0"><dt class="col-sm-4">OrderNumber</dt><dd class="col-sm-8">@(Model.Order.OrderNumber)</dd><dt class="col-sm-4">Name</dt><dd class="col-sm-8">@(Model.Order.Name)</dd><dt class="col-sm-4">CostCenter</dt><dd class="col-sm-8">@(Model.Order.CostCenter)</dd><dt class="col-sm-4">PlannedCost</dt><dd class="col-sm-8">@(Model.Order.PlannedCost)</dd><dt class="col-sm-4">ActualCost</dt><dd class="col-sm-8">@(Model.Order.ActualCost)</dd><dt class="col-sm-4">StartDate</dt><dd class="col-sm-8">@(Model.Order.StartDate)</dd><dt class="col-sm-4">EndDate</dt><dd class="col-sm-8">@(Model.Order.EndDate)</dd><dt class="col-sm-4">Status</dt><dd class="col-sm-8">@(Model.Order.Status)</dd></dl>
</div>
<div class="card-footer">
<a href="/CO/InternalOrder/List" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
<a href="/CO/InternalOrder/Edit?id=@(Model.Order.Id)" class="btn btn-warning"><i class="bi bi-pencil me-1"></i>Edit</a>
</div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

