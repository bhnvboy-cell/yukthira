@page
@model YuktiraERP.Web.Pages.CO.InternalOrder.EditModel
@{ ViewData["Title"] = "Edit InternalOrder"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-warning text-dark"><h5 class="mb-0"><i class="bi bi-pencil me-2"></i>Edit InternalOrder</h5></div>
<div class="card-body">
<form method="post">
<input type="hidden" asp-for="Order.Id" />
<div class="row mb-3"><div class="col-md-6"><label asp-for="Order.OrderNumber" class="form-label"></label><input asp-for="Order.OrderNumber" class="form-control" type="text" /></div><div class="col-md-6"><label asp-for="Order.Name" class="form-label"></label><input asp-for="Order.Name" class="form-control" type="text" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="Order.CostCenter" class="form-label"></label><input asp-for="Order.CostCenter" class="form-control" type="text" /></div><div class="col-md-6"><label asp-for="Order.PlannedCost" class="form-label"></label><input asp-for="Order.PlannedCost" class="form-control" type="number" step="0.01" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="Order.ActualCost" class="form-label"></label><input asp-for="Order.ActualCost" class="form-control" type="number" step="0.01" /></div><div class="col-md-6"><label asp-for="Order.StartDate" class="form-label"></label><input asp-for="Order.StartDate" class="form-control" type="datetime-local" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="Order.EndDate" class="form-label"></label><input asp-for="Order.EndDate" class="form-control" type="datetime-local" /></div><div class="col-md-6"><label asp-for="Order.Status" class="form-label"></label><input asp-for="Order.Status" class="form-control" type="text" /></div></div>
<div class="d-flex gap-2"><button type="submit" class="btn btn-warning"><i class="bi bi-save me-1"></i>Update</button><a href="/CO/InternalOrder/List" class="btn btn-outline-secondary"><i class="bi bi-x me-1"></i>Cancel</a></div>
</form>
</div></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

