@page
@model YuktiraERP.Web.Pages.MM.MigoModel
@{
    ViewData["Title"] = "MIGO - Goods Movement";
}
<div class="row justify-content-center">
<div class="col-lg-11">
<h4 class="mb-3"><i class="bi bi-arrow-left-right me-2"></i>MIGO - Goods Movement</h4>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success py-2">@Model.SuccessMessage</div>
}
@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger py-2">@Model.Error</div>
}

<!-- Header Section -->
<div class="card shadow-sm mb-3">
    <div class="card-header bg-primary text-white"><h6 class="mb-0">Header</h6></div>
    <div class="card-body">
        <form method="post" asp-page-handler="Post">
        <div class="row mb-2">
            <div class="col-md-3">
                <label class="form-label">Movement Type</label>
                <select asp-for="Request.MovementType" class="form-select" asp-items="Model.MovementTypeOptions">
                    <option value="">-- Select --</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Special Stock Indicator</label>
                <select asp-for="Request.SpecialStockIndicator" class="form-select">
                    <option value="">None</option>
                    <option value="E">E - Sales Order Stock</option>
                    <option value="Q">Q - Project Stock</option>
                    <option value="K">K - Consignment</option>
                    <option value="M">M - Subcontracting</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Posting Date</label>
                <input asp-for="Request.PostingDate" type="date" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Document Date</label>
                <input asp-for="Request.DocumentDate" type="date" class="form-control" />
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-md-3">
                <label class="form-label">Plant</label>
                <input asp-for="Request.Plant" class="form-control" placeholder="Plant code" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Storage Location</label>
                <input asp-for="Request.StorageLocation" class="form-control" placeholder="SLoc code" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Reference</label>
                <input asp-for="Request.Reference" class="form-control" placeholder="PO/SO/Order ref" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Header Text</label>
                <input asp-for="Request.HeaderText" class="form-control" placeholder="Description" />
            </div>
        </div>

        <!-- Line Items -->
        <hr />
        <h6>Line Items</h6>
        <table class="table table-bordered table-sm" id="lineItems">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Material Code</th>
                    <th>Material Name</th>
                    <th>Quantity</th>
                    <th>UOM</th>
                    <th>Unit Price</th>
                    <th>Plant</th>
                    <th>SLoc</th>
                    <th>Batch</th>
                    <th>Stock Type</th>
                    <th>PO Number</th>
                    <th>Cost Center</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Request.Lines.Any())
                {
                    @for (int i = 0; i < Model.Request.Lines.Count; i++)
                    {
                        <tr>
                            <td>@(i + 1)</td>
                            <td><input asp-for="Request.Lines[i].MaterialCode" class="form-control form-control-sm" /></td>
                            <td><input asp-for="Request.Lines[i].MaterialName" class="form-control form-control-sm" /></td>
                            <td><input asp-for="Request.Lines[i].Quantity" type="number" step="0.001" class="form-control form-control-sm" /></td>
                            <td><input asp-for="Request.Lines[i].UOM" class="form-control form-control-sm" value="EA" /></td>
                            <td><input asp-for="Request.Lines[i].UnitPrice" type="number" step="0.01" class="form-control form-control-sm" /></td>
                            <td><input asp-for="Request.Lines[i].Plant" class="form-control form-control-sm" /></td>
                            <td><input asp-for="Request.Lines[i].StorageLocation" class="form-control form-control-sm" /></td>
                            <td><input asp-for="Request.Lines[i].BatchNo" class="form-control form-control-sm" /></td>
                            <td>
                                <select asp-for="Request.Lines[i].StockType" class="form-select form-select-sm">
                                    <option value="FREE">FREE</option>
                                    <option value="QI">QI</option>
                                    <option value="BLOCKED">BLOCKED</option>
                                    <option value="CONSIGNMENT">CONSIGNMENT</option>
                                </select>
                            </td>
                            <td><input asp-for="Request.Lines[i].PurchaseOrderNo" class="form-control form-control-sm" /></td>
                            <td><input asp-for="Request.Lines[i].CostCenter" class="form-control form-control-sm" /></td>
                            <td><button type="button" class="btn btn-danger btn-sm" onclick="this.closest('tr').remove()">X</button></td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td>1</td>
                        <td><input name="Request.Lines[0].MaterialCode" class="form-control form-control-sm" /></td>
                        <td><input name="Request.Lines[0].MaterialName" class="form-control form-control-sm" /></td>
                        <td><input name="Request.Lines[0].Quantity" type="number" step="0.001" class="form-control form-control-sm" /></td>
                        <td><input name="Request.Lines[0].UOM" class="form-control form-control-sm" value="EA" /></td>
                        <td><input name="Request.Lines[0].UnitPrice" type="number" step="0.01" class="form-control form-control-sm" /></td>
                        <td><input name="Request.Lines[0].Plant" class="form-control form-control-sm" /></td>
                        <td><input name="Request.Lines[0].StorageLocation" class="form-control form-control-sm" /></td>
                        <td><input name="Request.Lines[0].BatchNo" class="form-control form-control-sm" /></td>
                        <td>
                            <select name="Request.Lines[0].StockType" class="form-select form-select-sm">
                                <option value="FREE">FREE</option>
                                <option value="QI">QI</option>
                                <option value="BLOCKED">BLOCKED</option>
                                <option value="CONSIGNMENT">CONSIGNMENT</option>
                            </select>
                        </td>
                        <td><input name="Request.Lines[0].PurchaseOrderNo" class="form-control form-control-sm" /></td>
                        <td><input name="Request.Lines[0].CostCenter" class="form-control form-control-sm" /></td>
                        <td><button type="button" class="btn btn-danger btn-sm" onclick="this.closest('tr').remove()">X</button></td>
                    </tr>
                }
            </tbody>
        </table>
        <button type="button" class="btn btn-outline-secondary btn-sm mb-2" onclick="addLine()">+ Add Line</button>

        <div class="d-flex gap-2 mt-3">
            <button type="submit" asp-page-handler="Validate" class="btn btn-outline-primary"><i class="bi bi-check-circle me-1"></i>Check</button>
            <button type="submit" asp-page-handler="Simulate" class="btn btn-outline-info"><i class="bi bi-play-circle me-1"></i>Simulate</button>
            <button type="submit" asp-page-handler="Post" class="btn btn-primary"><i class="bi bi-send me-1"></i>Post</button>
            <a asp-page="/MM/Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
        </form>
    </div>
</div>

<!-- Validation Result -->
@if (Model.ValidationResult != null)
{
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-info text-white"><h6 class="mb-0">Validation Result</h6></div>
        <div class="card-body">
            <p><strong>Valid:</strong> <span class="badge @(Model.ValidationResult.IsValid ? "bg-success" : "bg-danger")">@(Model.ValidationResult.IsValid ? "Yes" : "No")</span></p>
            @if (Model.ValidationResult.Errors.Any())
            {
                <div class="text-danger"><strong>Errors:</strong>
                    <ul class="mb-0">@foreach (var e in Model.ValidationResult.Errors) { <li>@e</li> }</ul>
                </div>
            }
            @if (Model.ValidationResult.Warnings.Any())
            {
                <div class="text-warning"><strong>Warnings:</strong>
                    <ul class="mb-0">@foreach (var w in Model.ValidationResult.Warnings) { <li>@w</li> }</ul>
                </div>
            }
            @if (Model.ValidationResult.Info.Any())
            {
                <div class="text-info"><strong>Info:</strong>
                    <ul class="mb-0">@foreach (var i in Model.ValidationResult.Info) { <li>@i</li> }</ul>
                </div>
            }
        </div>
    </div>
}

<!-- Simulation Result -->
@if (Model.SimulationResult != null)
{
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-info text-white"><h6 class="mb-0">Workflow Simulation</h6></div>
        <div class="card-body">
            <p><strong>Would Succeed:</strong> <span class="badge @(Model.SimulationResult.WouldSucceed ? "bg-success" : "bg-danger")">@(Model.SimulationResult.WouldSucceed ? "Yes" : "No")</span></p>
            @if (Model.SimulationResult.Steps.Any())
            {
                <table class="table table-sm">
                    <thead><tr><th>Order</th><th>Step</th><th>Type</th><th>Passed</th><th>Message</th></tr></thead>
                    <tbody>
                        @foreach (var step in Model.SimulationResult.Steps)
                        {
                            <tr>
                                <td>@step.StepOrder</td>
                                <td>@step.StepName</td>
                                <td>@step.StepType</td>
                                <td><span class="badge @(step.Passed ? "bg-success" : "bg-danger")">@(step.Passed ? "Yes" : "No")</span></td>
                                <td>@step.Message</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

<!-- Post Result -->
@if (Model.PostResult != null && Model.PostResult.Success)
{
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-success text-white"><h6 class="mb-0">Document Posted</h6></div>
        <div class="card-body">
            <p><strong>Document Number:</strong> @Model.PostResult.DocumentNumber</p>
            <p><strong>Document ID:</strong> @Model.PostResult.DocumentId</p>
            @if (Model.PostResult.Trace.Any())
            {
                <table class="table table-sm">
                    <thead><tr><th>Doc Number</th><th>Mvt Type</th><th>Description</th><th>Status</th><th>Timestamp</th></tr></thead>
                    <tbody>
                        @foreach (var t in Model.PostResult.Trace)
                        {
                            <tr>
                                <td>@t.DocumentNumber</td>
                                <td>@t.MovementType</td>
                                <td>@t.Description</td>
                                <td><span class="badge bg-success">@t.Status</span></td>
                                <td>@t.Timestamp</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

<!-- Reversal Section -->
<div class="card shadow-sm mb-3">
    <div class="card-header bg-warning"><h6 class="mb-0">Reverse Document</h6></div>
    <div class="card-body">
        <form method="post" asp-page-handler="Reverse">
        <div class="row mb-2">
            <div class="col-md-4">
                <label class="form-label">Document ID to Reverse</label>
                <input asp-for="ReverseDocumentId" class="form-control" placeholder="GUID" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Reason</label>
                <input asp-for="ReverseReason" class="form-control" placeholder="Reversal reason" />
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-warning"><i class="bi bi-arrow-counterclockwise me-1"></i>Reverse</button>
            </div>
        </div>
        </form>
    </div>
</div>

</div>
</div>

<script>
function addLine() {
    var tbody = document.querySelector('#lineItems tbody');
    var idx = tbody.rows.length;
    var row = '<tr>' +
        '<td>' + (idx + 1) + '</td>' +
        '<td><input name="Request.Lines[' + idx + '].MaterialCode" class="form-control form-control-sm" /></td>' +
        '<td><input name="Request.Lines[' + idx + '].MaterialName" class="form-control form-control-sm" /></td>' +
        '<td><input name="Request.Lines[' + idx + '].Quantity" type="number" step="0.001" class="form-control form-control-sm" /></td>' +
        '<td><input name="Request.Lines[' + idx + '].UOM" class="form-control form-control-sm" value="EA" /></td>' +
        '<td><input name="Request.Lines[' + idx + '].UnitPrice" type="number" step="0.01" class="form-control form-control-sm" /></td>' +
        '<td><input name="Request.Lines[' + idx + '].Plant" class="form-control form-control-sm" /></td>' +
        '<td><input name="Request.Lines[' + idx + '].StorageLocation" class="form-control form-control-sm" /></td>' +
        '<td><input name="Request.Lines[' + idx + '].BatchNo" class="form-control form-control-sm" /></td>' +
        '<td><select name="Request.Lines[' + idx + '].StockType" class="form-select form-select-sm"><option value="FREE">FREE</option><option value="QI">QI</option><option value="BLOCKED">BLOCKED</option><option value="CONSIGNMENT">CONSIGNMENT</option></select></td>' +
        '<td><input name="Request.Lines[' + idx + '].PurchaseOrderNo" class="form-control form-control-sm" /></td>' +
        '<td><input name="Request.Lines[' + idx + '].CostCenter" class="form-control form-control-sm" /></td>' +
        '<td><button type="button" class="btn btn-danger btn-sm" onclick="this.closest(\'tr\').remove()">X</button></td>' +
        '</tr>';
    tbody.insertAdjacentHTML('beforeend', row);
}
</script>
