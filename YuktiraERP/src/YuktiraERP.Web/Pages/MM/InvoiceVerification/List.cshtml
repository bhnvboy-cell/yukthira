@page
@model YuktiraERP.Web.Pages.MM.InvoiceVerification.ListModel
@{ ViewData["Title"] = "InvoiceVerification List"; }
<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-list-ul me-2"></i>InvoiceVerification Records</h2>
        <a href="/MM/InvoiceVerification/Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-circle me-1"></i>New InvoiceVerification</a>
    </div>
    <div class="card shadow-sm">
        <div class="card-body p-0" style="overflow-x:auto">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light"><tr><th>InvoiceNumber</th><th>Date</th><th>PoNumber</th><th>VendorName</th><th>Amount</th><th style="width:160px">Actions</th></tr></thead>
                <tbody>
                    @if (Model.Items.Count == 0) {
                        <tr><td colspan="8" class="text-center text-muted py-4">No records found</td></tr>
                    }
                    @foreach (var item in Model.Items) {
                        <tr>
                            <td>@item.InvoiceNumber</td><td>@item.Date</td><td>@item.PoNumber</td><td>@item.VendorName</td><td>@item.Amount</td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a href="/MM/InvoiceVerification/Display?id=@item.Id" class="btn btn-outline-info" title="View"><i class="bi bi-eye"></i></a>
                                    <a href="/MM/InvoiceVerification/Edit?id=@item.Id" class="btn btn-outline-warning" title="Edit"><i class="bi bi-pencil"></i></a>
                                    <form method="post" asp-page-handler="Delete" style="display:inline" onsubmit="return confirm('Delete this record?')">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

