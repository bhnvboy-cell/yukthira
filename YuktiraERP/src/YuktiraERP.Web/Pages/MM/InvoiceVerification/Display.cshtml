@page
@model YuktiraERP.Web.Pages.MM.InvoiceVerification.DisplayModel
@using YuktiraERP.Infrastructure.Data.Entities
@{ ViewData["Title"] = "Invoice Verification Details"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-info text-white"><h5 class="mb-0"><i class="bi bi-eye me-2"></i>Invoice Verification Details</h5></div>
<div class="card-body">
@{
    var variance = Model.Invoice.MatchedAmount != 0 ? Math.Abs(Model.Invoice.Amount - Model.Invoice.MatchedAmount) / Model.Invoice.MatchedAmount * 100 : 0;
    var matchBadge = variance <= 5 ? "bg-success" : "bg-danger";
    var matchText = variance <= 5 ? "Within Tolerance (<=5%)" : "Exceeds Tolerance (>5%)";
}
<dl class="row mb-0">
<dt class="col-sm-4">Invoice Number</dt><dd class="col-sm-8">@(Model.Invoice.InvoiceNumber)</dd>
<dt class="col-sm-4">Date</dt><dd class="col-sm-8">@(Model.Invoice.Date.ToString("yyyy-MM-dd"))</dd>
<dt class="col-sm-4">PO Number</dt><dd class="col-sm-8">@(Model.Invoice.PoNumber)</dd>
<dt class="col-sm-4">Vendor</dt><dd class="col-sm-8">@(Model.Invoice.VendorName)</dd>
<dt class="col-sm-4">Invoice Amount</dt><dd class="col-sm-8">@(Model.Invoice.Amount.ToString("C"))</dd>
<dt class="col-sm-4">Matched Amount</dt><dd class="col-sm-8">@(Model.Invoice.MatchedAmount.ToString("C"))</dd>
<dt class="col-sm-4">Variance</dt><dd class="col-sm-8">@variance.ToString("F2")%</dd>
<dt class="col-sm-4">Status</dt>
<dd class="col-sm-8"><span class="badge @(Model.Invoice.Status == "Matched" ? "bg-success" : Model.Invoice.Status == "Variance" ? "bg-warning" : Model.Invoice.Status == "Approved" ? "bg-primary" : "bg-secondary")">@(Model.Invoice.Status)</span></dd>
<dt class="col-sm-4">Match Result</dt><dd class="col-sm-8"><span class="badge @matchBadge">@matchText</span></dd>
</dl>
</div>
<div class="card-footer">
<a href="/MM/InvoiceVerification/List" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
<a href="/MM/InvoiceVerification/Edit?id=@(Model.Invoice.Id)" class="btn btn-warning"><i class="bi bi-pencil me-1"></i>Edit</a>
</div>
</div></div>
</div></div>
