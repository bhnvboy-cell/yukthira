@page
@model YuktiraERP.Web.Pages.MM.InvoiceVerification.EditModel
@{ ViewData["Title"] = "Edit Invoice Verification"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-warning text-dark"><h5 class="mb-0"><i class="bi bi-pencil me-2"></i>Edit Invoice Verification</h5></div>
<div class="card-body">
<form method="post">
<input type="hidden" asp-for="Invoice.Id" />
<div class="row mb-3">
<div class="col-md-4"><label asp-for="Invoice.InvoiceNumber" class="form-label"></label><input asp-for="Invoice.InvoiceNumber" class="form-control" readonly /></div>
<div class="col-md-4"><label asp-for="Invoice.PoNumber" class="form-label"></label><input asp-for="Invoice.PoNumber" class="form-control" /></div>
<div class="col-md-4"><label asp-for="Invoice.Date" class="form-label"></label><input asp-for="Invoice.Date" class="form-control" type="date" /></div>
</div>
<div class="row mb-3">
<div class="col-md-4"><label asp-for="Invoice.VendorName" class="form-label"></label><input asp-for="Invoice.VendorName" class="form-control" /></div>
<div class="col-md-4"><label asp-for="Invoice.Amount" class="form-label"></label><input asp-for="Invoice.Amount" class="form-control" type="number" step="0.01" /></div>
<div class="col-md-4"><label asp-for="Invoice.MatchedAmount" class="form-label"></label><input asp-for="Invoice.MatchedAmount" class="form-control" type="number" step="0.01" readonly /></div>
</div>
<div class="row mb-3">
<div class="col-md-4"><label asp-for="Invoice.Status" class="form-label"></label><select asp-for="Invoice.Status" class="form-select"><option value="Pending">Pending</option><option value="Matched">Matched</option><option value="Variance">Variance</option><option value="Approved">Approved</option><option value="Rejected">Rejected</option></select></div>
<div class="col-md-4">
<label class="form-label">Variance</label>
@{ var variance = Model.Invoice.MatchedAmount != 0 ? Math.Abs(Model.Invoice.Amount - Model.Invoice.MatchedAmount) / Model.Invoice.MatchedAmount * 100 : 0; }
<input value="@variance.ToString("F2")%" class="form-control" readonly />
</div>
<div class="col-md-4">
<label class="form-label">Match Status</label>
<input value="@(variance <= 5 ? "Within Tolerance" : "Exceeds Tolerance")" class="form-control @(variance <= 5 ? "text-success" : "text-danger")" readonly />
</div>
</div>
<div class="d-flex gap-2">
<button type="submit" class="btn btn-warning"><i class="bi bi-save me-1"></i>Update</button>
<a href="/MM/InvoiceVerification/List" class="btn btn-outline-secondary"><i class="bi bi-x me-1"></i>Cancel</a>
</div>
</form>
</div></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
