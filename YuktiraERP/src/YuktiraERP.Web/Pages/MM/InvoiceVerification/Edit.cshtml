@page
@model YuktiraERP.Web.Pages.MM.InvoiceVerification.EditModel
@{ ViewData["Title"] = "Edit InvoiceVerification"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-warning text-dark"><h5 class="mb-0"><i class="bi bi-pencil me-2"></i>Edit InvoiceVerification</h5></div>
<div class="card-body">
<form method="post">
<input type="hidden" asp-for="Invoice.Id" />
<div class="row mb-3"><div class="col-md-6"><label asp-for="Invoice.InvoiceNumber" class="form-label"></label><input asp-for="Invoice.InvoiceNumber" class="form-control" type="text" /></div><div class="col-md-6"><label asp-for="Invoice.Date" class="form-label"></label><input asp-for="Invoice.Date" class="form-control" type="datetime-local" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="Invoice.PoNumber" class="form-label"></label><input asp-for="Invoice.PoNumber" class="form-control" type="text" /></div><div class="col-md-6"><label asp-for="Invoice.VendorName" class="form-label"></label><input asp-for="Invoice.VendorName" class="form-control" type="text" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="Invoice.Amount" class="form-label"></label><input asp-for="Invoice.Amount" class="form-control" type="number" step="0.01" /></div><div class="col-md-6"><label asp-for="Invoice.MatchedAmount" class="form-label"></label><input asp-for="Invoice.MatchedAmount" class="form-control" type="number" step="0.01" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="Invoice.Status" class="form-label"></label><input asp-for="Invoice.Status" class="form-control" type="text" /></div><div class="col-md-6"></div></div>
<div class="d-flex gap-2"><button type="submit" class="btn btn-warning"><i class="bi bi-save me-1"></i>Update</button><a href="/MM/InvoiceVerification/List" class="btn btn-outline-secondary"><i class="bi bi-x me-1"></i>Cancel</a></div>
</form>
</div></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

