@page
@model YuktiraERP.Web.Pages.MM.StockListModel
@using YuktiraERP.Infrastructure.Data.Entities
@{ ViewData["Title"] = "Stock List (MB52)"; }
<div class="d-flex justify-content-between align-items-center mb-3">
<h2><i class="bi bi-boxes me-2"></i>Stock List</h2>
<button type="button" class="btn btn-outline-secondary btn-sm" onclick="document.querySelectorAll('.inline-edit-col').forEach(c=>c.style.display=c.style.display==='none'?'':'none')" title="Toggle inline editing"><i class="bi bi-pencil-square me-1"></i>Inline Edit</button>
</div>
<div class="card"><div class="card-body">
<div class="table-responsive">
<table class="table table-hover table-sm datatable" id="stockTable">
<thead><tr><th>Bin</th><th>Material</th><th>Lot</th><th class="inline-edit-col" style="display:none">Quantity</th><th>UOM</th><th class="inline-edit-col" style="display:none">Value</th><th class="inline-edit-col" style="display:none">Min Stock</th><th class="inline-edit-col" style="display:none">Max Stock</th></tr></thead>
<tbody>
@foreach (var s in Model.StockItems)
{
<tr data-id="@s.Id" data-entity="StockItemEntity" data-module="MM">
<td>@s.Bin</td><td>@s.MaterialName</td><td>@s.Lot</td>
<td class="inline-edit-col" style="display:none" data-field="Quantity" data-type="number">@s.Quantity</td>
<td>@s.UOM</td>
<td class="inline-edit-col" style="display:none" data-field="Value" data-type="number">@s.Value.ToString("C2")</td>
<td class="inline-edit-col" style="display:none" data-field="MinStock" data-type="number">@s.MinStock</td>
<td class="inline-edit-col" style="display:none" data-field="MaxStock" data-type="number">@s.MaxStock</td>
</tr>
}
</tbody></table>
</div></div></div>
@section Scripts {
<script src="~/js/inline-edit.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    InlineEdit.initTable(document.getElementById('stockTable'));
});
</script>
}
