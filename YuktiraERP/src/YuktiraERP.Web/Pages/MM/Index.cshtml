@page
@model YuktiraERP.Web.Pages.MM.IndexModel
@using YuktiraERP.Web.ViewModels
@{
    ViewData["Title"] = "Materials Management";

    var allMaterials = Model.Materials;
    var allVendors = Model.Vendors;
    var allPRs = Model.PurchaseRequisitions;
    var allPOs = Model.PurchaseOrders;
    var allGRNs = Model.GoodsReceipts;
    var allStock = Model.StockItems;
    var allBatches = Model.Batches;
    var allInvoices = Model.InvoiceVerifications;

    var vm = new ModuleLayoutViewModel
    {
        ModuleTitle = "Materials Management",
        ModuleCode = "MM",
        Kpis = new List<KpiCard>
        {
            new() { Label = "Total Materials", Value = allMaterials.Count.ToString(), Subtext = "Active master data", Type = "blue" },
            new() { Label = "Vendors", Value = allVendors.Count.ToString(), Subtext = "Registered suppliers", Type = "teal" },
            new() { Label = "Open PRs", Value = allPRs.Count(p => p.Status == "Draft" || p.Status == "Pending").ToString(), Subtext = "Awaiting approval", Type = "amber" },
            new() { Label = "Open POs", Value = allPOs.Count(p => p.Status != "Completed" && p.Status != "Cancelled").ToString(), Subtext = "In process", Type = "green" },
            new() { Label = "Stock Items", Value = allStock.Count.ToString(), Subtext = "Inventory positions", Type = "purple" },
            new() { Label = "Batches", Value = allBatches.Count.ToString(), Subtext = "Tracked lots", Type = "red" }
        },
        Tabs = new List<TabItem>
        {
            new() { Key = "materials", Label = "Materials", Count = allMaterials.Count,
                PrimaryAction = new PrimaryAction { Label = "Create Material", Href = "/MM/Material/Create", Icon = "bi-plus-lg" } },
            new() { Key = "vendors", Label = "Vendors", Count = allVendors.Count,
                PrimaryAction = new PrimaryAction { Label = "Create Vendor", Href = "/MM/Vendor/Create", Icon = "bi-plus-lg" } },
            new() { Key = "pr", Label = "Purchase Requisitions", Count = allPRs.Count,
                PrimaryAction = new PrimaryAction { Label = "Create Requisition", Href = "/MM/PR/Create", Icon = "bi-plus-lg" } },
            new() { Key = "po", Label = "Purchase Orders", Count = allPOs.Count,
                PrimaryAction = new PrimaryAction { Label = "Create Purchase Order", Href = "/MM/PO/Create", Icon = "bi-plus-lg" } },
            new() { Key = "grn", Label = "Goods Receipts", Count = allGRNs.Count,
                PrimaryAction = new PrimaryAction { Label = "Create Goods Receipt", Href = "/MM/GRN/Create", Icon = "bi-plus-lg" } },
            new() { Key = "stock", Label = "Stock Overview", Count = allStock.Count },
            new() { Key = "batches", Label = "Batches", Count = allBatches.Count },
            new() { Key = "invoices", Label = "Invoice Verification", Count = allInvoices.Count,
                PrimaryAction = new PrimaryAction { Label = "Post Invoice", Href = "/MM/InvoiceVerification/Create", Icon = "bi-plus-lg" } }
        },
        ActiveTab = "materials",
        GridTabs = new List<GridTab>
        {
            new()
            {
                Key = "materials",
                Columns = new List<GridColumn>
                {
                    new() { Key = "code", Label = "Material #", Align = "left" },
                    new() { Key = "name", Label = "Description", Align = "left" },
                    new() { Key = "type", Label = "Type", Align = "center" },
                    new() { Key = "uom", Label = "UOM", Align = "center" },
                    new() { Key = "stock", Label = "Stock", Align = "right" },
                    new() { Key = "price", Label = "Price", Type = "currency", Align = "right" },
                    new() { Key = "status", Label = "Status", Type = "status", Align = "center" }
                },
                Rows = allMaterials.Select(m => new Dictionary<string, string?>
                {
                    { "id", m.Id.ToString() },
                    { "code", m.Code },
                    { "name", m.Name },
                    { "type", m.Type },
                    { "uom", m.UOM },
                    { "stock", m.Stock.ToString() },
                    { "price", m.Price.ToString() },
                    { "status", m.Status }
                }).ToList(),
                ViewHref = r => $"/MM/Material/Display?id={r["id"]}",
                EditHref = r => $"/MM/Material/Edit?id={r["id"]}"
            },
            new()
            {
                Key = "vendors",
                Columns = new List<GridColumn>
                {
                    new() { Key = "code", Label = "Vendor Code", Align = "left" },
                    new() { Key = "name", Label = "Name", Align = "left" },
                    new() { Key = "taxId", Label = "Tax ID", Align = "left" },
                    new() { Key = "paymentTerms", Label = "Payment Terms", Align = "center" },
                    new() { Key = "phone", Label = "Phone", Align = "left" },
                    new() { Key = "status", Label = "Status", Type = "status", Align = "center" }
                },
                Rows = allVendors.Select(v => new Dictionary<string, string?>
                {
                    { "id", v.Id.ToString() },
                    { "code", v.Code },
                    { "name", v.Name },
                    { "taxId", v.TaxId },
                    { "paymentTerms", v.PaymentTerms },
                    { "phone", v.Phone },
                    { "status", v.Status }
                }).ToList(),
                ViewHref = r => $"/MM/Vendor/Display?id={r["id"]}",
                EditHref = r => $"/MM/Vendor/Edit?id={r["id"]}"
            },
            new()
            {
                Key = "pr",
                Columns = new List<GridColumn>
                {
                    new() { Key = "prNumber", Label = "PR Number", Align = "left" },
                    new() { Key = "itemName", Label = "Item", Align = "left" },
                    new() { Key = "requestor", Label = "Requestor", Align = "left" },
                    new() { Key = "quantity", Label = "Qty", Align = "right" },
                    new() { Key = "totalAmount", Label = "Amount", Type = "currency", Align = "right" },
                    new() { Key = "status", Label = "Status", Type = "status", Align = "center" },
                    new() { Key = "date", Label = "Date", Type = "date", Align = "left" }
                },
                Rows = allPRs.Select(p => new Dictionary<string, string?>
                {
                    { "id", p.Id.ToString() },
                    { "prNumber", p.PrNumber },
                    { "itemName", p.ItemName },
                    { "requestor", p.Requestor },
                    { "quantity", p.Quantity },
                    { "totalAmount", p.TotalAmount.ToString() },
                    { "status", p.Status },
                    { "date", p.Date.ToString("yyyy-MM-dd") }
                }).ToList(),
                ViewHref = r => $"/MM/PR/Display?id={r["id"]}",
                EditHref = r => $"/MM/PR/Edit?id={r["id"]}"
            },
            new()
            {
                Key = "po",
                Columns = new List<GridColumn>
                {
                    new() { Key = "poNumber", Label = "PO Number", Align = "left" },
                    new() { Key = "vendorName", Label = "Vendor", Align = "left" },
                    new() { Key = "itemName", Label = "Item", Align = "left" },
                    new() { Key = "totalAmount", Label = "Amount", Type = "currency", Align = "right" },
                    new() { Key = "status", Label = "Status", Type = "status", Align = "center" },
                    new() { Key = "date", Label = "Date", Type = "date", Align = "left" }
                },
                Rows = allPOs.Select(p => new Dictionary<string, string?>
                {
                    { "id", p.Id.ToString() },
                    { "poNumber", p.PoNumber },
                    { "vendorName", p.VendorName },
                    { "itemName", p.ItemName },
                    { "totalAmount", p.TotalAmount.ToString() },
                    { "status", p.Status },
                    { "date", p.Date.ToString("yyyy-MM-dd") }
                }).ToList(),
                ViewHref = r => $"/MM/PO/Display?id={r["id"]}",
                EditHref = r => $"/MM/PO/Edit?id={r["id"]}"
            },
            new()
            {
                Key = "grn",
                Columns = new List<GridColumn>
                {
                    new() { Key = "grnNumber", Label = "GRN Number", Align = "left" },
                    new() { Key = "poNumber", Label = "PO Reference", Align = "left" },
                    new() { Key = "materialName", Label = "Material", Align = "left" },
                    new() { Key = "qtyReceived", Label = "Qty Received", Align = "right" },
                    new() { Key = "qtyAccepted", Label = "Qty Accepted", Align = "right" },
                    new() { Key = "status", Label = "Status", Type = "status", Align = "center" },
                    new() { Key = "date", Label = "Date", Type = "date", Align = "left" }
                },
                Rows = allGRNs.Select(g => new Dictionary<string, string?>
                {
                    { "id", g.Id.ToString() },
                    { "grnNumber", g.GrnNumber },
                    { "poNumber", g.PoNumber },
                    { "materialName", g.MaterialName },
                    { "qtyReceived", g.QtyReceived },
                    { "qtyAccepted", g.QtyAccepted },
                    { "status", g.Status },
                    { "date", g.Date.ToString("yyyy-MM-dd") }
                }).ToList(),
                ViewHref = r => $"/MM/GRN/Display?id={r["id"]}",
                EditHref = r => $"/MM/GRN/Edit?id={r["id"]}"
            },
            new()
            {
                Key = "stock",
                Columns = new List<GridColumn>
                {
                    new() { Key = "bin", Label = "Bin", Align = "left" },
                    new() { Key = "materialName", Label = "Material", Align = "left" },
                    new() { Key = "lot", Label = "Lot", Align = "center" },
                    new() { Key = "quantity", Label = "Quantity", Align = "right" },
                    new() { Key = "uom", Label = "UOM", Align = "center" },
                    new() { Key = "value", Label = "Value", Type = "currency", Align = "right" },
                    new() { Key = "minMax", Label = "Min / Max", Align = "center" }
                },
                Rows = allStock.Select(s => new Dictionary<string, string?>
                {
                    { "id", s.Id.ToString() },
                    { "bin", s.Bin },
                    { "materialName", s.MaterialName },
                    { "lot", s.Lot },
                    { "quantity", s.Quantity.ToString() },
                    { "uom", s.UOM },
                    { "value", s.Value.ToString() },
                    { "minMax", $"{s.MinStock} / {s.MaxStock}" }
                }).ToList(),
                ViewHref = null,
                EditHref = null
            },
            new()
            {
                Key = "batches",
                Columns = new List<GridColumn>
                {
                    new() { Key = "batchNumber", Label = "Batch #", Align = "left" },
                    new() { Key = "materialName", Label = "Material", Align = "left" },
                    new() { Key = "quantity", Label = "Quantity", Align = "right" },
                    new() { Key = "manufacturingDate", Label = "Mfg Date", Type = "date", Align = "left" },
                    new() { Key = "expiryDate", Label = "Expiry", Type = "date", Align = "left" },
                    new() { Key = "status", Label = "Status", Type = "status", Align = "center" }
                },
                Rows = allBatches.Select(b => new Dictionary<string, string?>
                {
                    { "id", b.Id.ToString() },
                    { "batchNumber", b.BatchNumber },
                    { "materialName", b.MaterialName },
                    { "quantity", b.Quantity.ToString() },
                    { "manufacturingDate", b.ManufacturingDate.ToString("yyyy-MM-dd") },
                    { "expiryDate", b.ExpiryDate?.ToString("yyyy-MM-dd") ?? "" },
                    { "status", b.Status }
                }).ToList(),
                ViewHref = r => $"/MM/Batch/Display?id={r["id"]}",
                EditHref = null
            },
            new()
            {
                Key = "invoices",
                Columns = new List<GridColumn>
                {
                    new() { Key = "invoiceNumber", Label = "Invoice #", Align = "left" },
                    new() { Key = "vendorName", Label = "Vendor", Align = "left" },
                    new() { Key = "poNumber", Label = "PO Reference", Align = "left" },
                    new() { Key = "amount", Label = "Amount", Type = "currency", Align = "right" },
                    new() { Key = "matchedAmount", Label = "Matched", Type = "currency", Align = "right" },
                    new() { Key = "status", Label = "Status", Type = "status", Align = "center" },
                    new() { Key = "date", Label = "Date", Type = "date", Align = "left" }
                },
                Rows = allInvoices.Select(i => new Dictionary<string, string?>
                {
                    { "id", i.Id.ToString() },
                    { "invoiceNumber", i.InvoiceNumber },
                    { "vendorName", i.VendorName },
                    { "poNumber", i.PoNumber },
                    { "amount", i.Amount.ToString() },
                    { "matchedAmount", i.MatchedAmount.ToString() },
                    { "status", i.Status },
                    { "date", i.Date.ToString("yyyy-MM-dd") }
                }).ToList(),
                ViewHref = r => $"/MM/InvoiceVerification/Display?id={r["id"]}",
                EditHref = r => $"/MM/InvoiceVerification/Edit?id={r["id"]}"
            }
        }
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/module-layout.css" asp-append-version="true" />
}

<partial name="_ModuleLayout" model="vm" />

@section Scripts {
    <script src="~/js/module-layout.js" asp-append-version="true"></script>
}
