@page
@model YuktiraERP.Web.Pages.MM.GoodsIssueModel
@{ ViewData["Title"] = "Goods Issue (MB1A)"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-secondary text-white"><h5 class="mb-0"><i class="bi bi-box-arrow-right me-2"></i>Goods Issue</h5></div>
<div class="card-body">
@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger py-2">@Model.Error</div>
}
<form method="post">
<div class="row mb-3">
<div class="col-md-6"><label asp-for="Reference" class="form-label">Reference</label><input asp-for="Reference" class="form-control" placeholder="Order/Ref number" /></div>
<div class="col-md-6"><label asp-for="MaterialName" class="form-label">Material</label><input asp-for="MaterialName" class="form-control" placeholder="Material name or code" /></div>
</div>
<div class="row mb-3">
<div class="col-md-4"><label asp-for="Quantity" class="form-label">Quantity Issued</label><input asp-for="Quantity" type="number" step="0.001" min="0" class="form-control" /></div>
<div class="col-md-4"><label asp-for="Reason" class="form-label">Reason</label><select asp-for="Reason" class="form-select"><option>Production</option><option>Scrap</option><option>Return to Vendor</option><option>Sample</option><option>Internal Use</option></select></div>
</div>
<div class="d-flex gap-2"><button type="submit" class="btn btn-secondary"><i class="bi bi-save me-1"></i>Issue</button><a asp-page="/MM/Index" class="btn btn-outline-secondary">Cancel</a></div>
</form>
</div></div>
</div></div>