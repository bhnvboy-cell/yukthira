@page
@model YuktiraERP.Web.Pages.MM.PO.DisplayModel
@using YuktiraERP.Infrastructure.Data.Entities
@{ ViewData["Title"] = "Purchase Order Details"; }
<div class="row justify-content-center"><div class="col-lg-10">
<div class="card shadow-sm"><div class="card-header bg-info text-white"><h5 class="mb-0"><i class="bi bi-eye me-2"></i>Purchase Order Details</h5></div>
<div class="card-body">
<dl class="row mb-0">
<dt class="col-sm-3">PO Number</dt><dd class="col-sm-3">@Model.Order.PoNumber</dd>
<dt class="col-sm-3">Date</dt><dd class="col-sm-3">@Model.Order.Date.ToString("yyyy-MM-dd")</dd>
<dt class="col-sm-3">Vendor</dt><dd class="col-sm-3">@Model.Order.VendorName (@Model.Order.VendorCode)</dd>
<dt class="col-sm-3">Department</dt><dd class="col-sm-3">@Model.Order.DepartmentKey</dd>
<dt class="col-sm-3">Cost Center</dt><dd class="col-sm-3">@Model.Order.CostCenter</dd>
<dt class="col-sm-3">Payment Terms</dt><dd class="col-sm-3">@Model.Order.PaymentTerms</dd>
<dt class="col-sm-3">Incoterms</dt><dd class="col-sm-3">@(string.IsNullOrEmpty(Model.Order.Incoterms) ? "-" : Model.Order.Incoterms)</dd>
<dt class="col-sm-3">Status</dt><dd class="col-sm-3"><span class="badge @(Model.Order.Status == "APPROVED" ? "bg-success" : Model.Order.Status == "REJECTED" ? "bg-danger" : "bg-secondary")">@Model.Order.Status</span></dd>
<dt class="col-sm-3">Total Amount</dt><dd class="col-sm-3">@Model.Order.TotalAmount.ToString("C")</dd>
<dt class="col-sm-3">Item Count</dt><dd class="col-sm-3">@Model.Order.ItemCount</dd>
<dt class="col-sm-3">Release Status</dt><dd class="col-sm-3">@(string.IsNullOrEmpty(Model.Order.ReleaseStatus) ? "-" : Model.Order.ReleaseStatus)</dd>
</dl>

@if (Model.Items.Any())
{
<h6 class="mt-3">Line Items</h6>
<table class="table table-sm table-bordered">
<thead><tr><th>#</th><th>Material</th><th>Code</th><th>Qty</th><th>UOM</th><th>Unit Price</th><th>Total</th><th>Recv'd</th><th>Invoiced</th><th>Status</th></tr></thead>
<tbody>
@foreach (var item in Model.Items)
{
<tr><td>@item.LineNumber</td><td>@item.MaterialName</td><td>@item.MaterialCode</td><td>@item.Quantity</td><td>@item.UOM</td><td>@item.UnitPrice.ToString("C")</td><td>@item.TotalPrice.ToString("C")</td><td>@item.ReceivedQty</td><td>@item.InvoicedQty</td><td><span class="badge bg-secondary">@item.Status</span></td></tr>
}
</tbody>
</table>
}
</div>
<div class="card-footer">
<a asp-page="/MM/Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
<a asp-page="/MM/PO/Edit" asp-route-id="@Model.Order.Id" class="btn btn-warning"><i class="bi bi-pencil me-1"></i>Edit</a>
@if (Model.Order.Status == "Draft" || Model.Order.Status == "Pending Approval")
{
<form method="post" asp-page-handler="SubmitForApproval" style="display:inline">
<input type="hidden" name="poId" value="@Model.Order.Id" />
<button type="submit" class="btn btn-success"><i class="bi bi-send me-1"></i>Submit for Approval</button>
</form>
}
</div>
</div></div>
</div></div>
