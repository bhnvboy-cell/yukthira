@page
@model YuktiraERP.Web.Pages.MM.Vendor.CreateModel
@{ ViewData["Title"] = "Create Vendor Master"; }

<div class="ent-form-wrapper">
    <div class="ent-org-banner">
        <div class="banner-icon"><i class="bi bi-building"></i></div>
        <div class="banner-info">
            <h5>Create Vendor Master</h5>
            <span>FK01 — Vendor Master Data</span>
        </div>
        <div class="banner-meta">
            Purchasing Org: PO01<br />Company Code: 1000
        </div>
    </div>

    <form method="post">
        <input type="hidden" asp-for="Vendor.Status" value="Active" />

        <div class="ent-form-tabs">
            <button type="button" class="ent-form-tab active" data-tab="general">
                <i class="bi bi-person-vcard tab-icon"></i> General Data
            </button>
            <button type="button" class="ent-form-tab" data-tab="purchasing">
                <i class="bi bi-cart tab-icon"></i> Purchasing
            </button>
            <button type="button" class="ent-form-tab" data-tab="accounting">
                <i class="bi bi-calculator tab-icon"></i> Accounting & Payment
            </button>
        </div>

        <!-- ═══ TAB: General Data ═══ -->
        <div class="ent-form-panel active" data-panel="general">
            <div class="ent-section">
                <div class="ent-section-header"><i class="bi bi-person-vcard"></i><h6>Vendor Identification</h6></div>
                <div class="ent-field-grid cols-3">
                    <div class="ent-field">
                        <label>Vendor Code</label>
                        <input asp-for="Vendor.Code" class="form-control" placeholder="Auto-generated" />
                    </div>
                    <div class="ent-field" style="grid-column: span 2">
                        <label>Name <span class="required">*</span></label>
                        <input asp-for="Vendor.Name" class="form-control" placeholder="Company name" required />
                    </div>
                </div>
            </div>
            <div class="ent-section">
                <div class="ent-section-header"><i class="bi bi-telephone"></i><h6>Contact & Address</h6></div>
                <div class="ent-field-grid cols-3">
                    <div class="ent-field">
                        <label>Phone</label>
                        <input asp-for="Vendor.Phone" class="form-control" placeholder="+1 (555) 000-0000" />
                    </div>
                    <div class="ent-field">
                        <label>Email</label>
                        <input type="email" class="form-control" placeholder="vendor@example.com" />
                    </div>
                    <div class="ent-field">
                        <label>Fax</label>
                        <input type="text" class="form-control" placeholder="+1 (555) 000-0001" />
                    </div>
                </div>
                <div class="ent-field-grid cols-2" style="margin-top:0.75rem">
                    <div class="ent-field">
                        <label>Street Address</label>
                        <input type="text" class="form-control" placeholder="123 Main St" />
                    </div>
                    <div class="ent-field">
                        <label>City / State / ZIP</label>
                        <input type="text" class="form-control" placeholder="City, State 00000" />
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══ TAB: Purchasing ═══ -->
        <div class="ent-form-panel" data-panel="purchasing">
            <div class="ent-section">
                <div class="ent-section-header"><i class="bi bi-cart-check"></i><h6>Purchasing Organization</h6></div>
                <div class="ent-field-grid cols-3">
                    <div class="ent-field">
                        <label>Purchasing Organization</label>
                        <select class="form-select">
                            <option value="">-- Select --</option>
                            <option value="PO01">PO01 — Plant Purchasing</option>
                            <option value="PO02">PO02 — Corporate Purchasing</option>
                        </select>
                    </div>
                    <div class="ent-field">
                        <label>Purchasing Group</label>
                        <select class="form-select">
                            <option value="">-- Select --</option>
                            <option value="001">001 — Raw Materials</option>
                            <option value="002">002 — Packaging</option>
                            <option value="003">003 — MRO</option>
                        </select>
                    </div>
                    <div class="ent-field">
                        <label>Order Currency</label>
                        <select class="form-select">
                            <option value="USD">USD — US Dollar</option>
                            <option value="INR">INR — Indian Rupee</option>
                            <option value="EUR">EUR — Euro</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="ent-section">
                <div class="ent-section-header"><i class="bi bi-truck"></i><h6>Delivery & Terms</h6></div>
                <div class="ent-field-grid cols-3">
                    <div class="ent-field">
                        <label>Incoterms</label>
                        <select class="form-select">
                            <option value="">-- Select --</option>
                            <option value="FOB">FOB — Free on Board</option>
                            <option value="CIF">CIF — Cost, Insurance & Freight</option>
                            <option value="EXW">EXW — Ex Works</option>
                            <option value="DDP">DDP — Delivered Duty Paid</option>
                            <option value="CFR">CFR — Cost & Freight</option>
                        </select>
                    </div>
                    <div class="ent-field">
                        <label>Lead Time (days)</label>
                        <input type="number" class="form-control" min="0" value="14" />
                    </div>
                    <div class="ent-field">
                        <label>Minimum Order Value</label>
                        <input type="number" class="form-control" min="0" step="0.01" value="0" />
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══ TAB: Accounting & Payment ═══ -->
        <div class="ent-form-panel" data-panel="accounting">
            <div class="ent-section">
                <div class="ent-section-header"><i class="bi bi-credit-card"></i><h6>Payment Information</h6></div>
                <div class="ent-field-grid cols-3">
                    <div class="ent-field">
                        <label>Payment Terms <span class="required">*</span></label>
                        <select asp-for="Vendor.PaymentTerms" class="form-select">
                            <option value="Net 30">Net 30</option>
                            <option value="Net 45">Net 45</option>
                            <option value="Net 60">Net 60</option>
                            <option value="Net 90">Net 90</option>
                            <option value="Due on Receipt">Due on Receipt</option>
                            <option value="2/10 Net 30">2/10 Net 30</option>
                            <option value="COD">COD — Cash on Delivery</option>
                        </select>
                    </div>
                    <div class="ent-field">
                        <label>Payment Method</label>
                        <select class="form-select">
                            <option value="">-- Select --</option>
                            <option value="BT">Bank Transfer (Wire)</option>
                            <option value="CH">Check</option>
                            <option value="CC">Credit Card</option>
                            <option value="DD">Direct Debit</option>
                            <option value="LC">Letter of Credit</option>
                        </select>
                    </div>
                    <div class="ent-field">
                        <label>Reconciliation Account</label>
                        <select class="form-select">
                            <option value="211000">211000 — AP Trade</option>
                            <option value="211100">211100 — AP Intercompany</option>
                            <option value="211200">211200 — AP Withholding Tax</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="ent-section">
                <div class="ent-section-header"><i class="bi bi-receipt"></i><h6>Tax & Compliance</h6></div>
                <div class="ent-field-grid cols-3">
                    <div class="ent-field">
                        <label>Tax ID / GSTIN</label>
                        <input asp-for="Vendor.TaxId" class="form-control" placeholder="e.g. 22AAAAA0000A1Z5" />
                    </div>
                    <div class="ent-field">
                        <label>Tax Type</label>
                        <select class="form-select">
                            <option value="VAT">VAT</option>
                            <option value="GST">GST</option>
                            <option value="WHT">Withholding Tax</option>
                            <option value="EXEMPT">Exempt</option>
                        </select>
                    </div>
                    <div class="ent-field">
                        <label>Dunning Procedure</label>
                        <select class="form-select">
                            <option value="1">1 — Standard</option>
                            <option value="2">2 — Escalated</option>
                            <option value="3">3 — Legal</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="ent-section">
                <div class="ent-section-header"><i class="bi bi-toggle-on"></i><h6>Status</h6></div>
                <div class="ent-field-grid cols-2">
                    <div class="ent-field">
                        <label>Vendor Status</label>
                        <select asp-for="Vendor.Status" class="form-select">
                            <option value="Active">Active</option>
                            <option value="On Hold">On Hold</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>
                    <div class="ent-field">
                        <label>Quality Rating</label>
                        <select class="form-select">
                            <option value="A">A — Excellent</option>
                            <option value="B">B — Good</option>
                            <option value="C">C — Satisfactory</option>
                            <option value="D">D — Needs Improvement</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="ent-form-footer">
            <div class="footer-info">
                <i class="bi bi-shield-check me-1"></i>All changes are SOX-audit logged
            </div>
            <div class="footer-actions">
                <a asp-page="/MM/Index" class="btn btn-outline-secondary"><i class="bi bi-x me-1"></i>Cancel</a>
                <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Save Vendor</button>
            </div>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
