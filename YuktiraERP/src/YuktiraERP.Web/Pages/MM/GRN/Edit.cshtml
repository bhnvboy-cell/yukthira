@page
@model YuktiraERP.Web.Pages.MM.GRN.EditModel
@{ ViewData["Title"] = "Edit GoodsReceipt"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-warning text-dark"><h5 class="mb-0"><i class="bi bi-pencil me-2"></i>Edit GoodsReceipt</h5></div>
<div class="card-body">
<form method="post">
<input type="hidden" asp-for="Receipt.Id" />
<div class="row mb-3"><div class="col-md-6"><label asp-for="Receipt.GrnNumber" class="form-label"></label><input asp-for="Receipt.GrnNumber" class="form-control" type="text" /></div><div class="col-md-6"><label asp-for="Receipt.Date" class="form-label"></label><input asp-for="Receipt.Date" class="form-control" type="datetime-local" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="Receipt.PoNumber" class="form-label"></label><input asp-for="Receipt.PoNumber" class="form-control" type="text" /></div><div class="col-md-6"><label asp-for="Receipt.MaterialName" class="form-label"></label><input asp-for="Receipt.MaterialName" class="form-control" type="text" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="Receipt.QtyReceived" class="form-label"></label><input asp-for="Receipt.QtyReceived" class="form-control" type="text" /></div><div class="col-md-6"><label asp-for="Receipt.QtyAccepted" class="form-label"></label><input asp-for="Receipt.QtyAccepted" class="form-control" type="text" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="Receipt.Status" class="form-label"></label><input asp-for="Receipt.Status" class="form-control" type="text" /></div><div class="col-md-6"></div></div>
<div class="d-flex gap-2"><button type="submit" class="btn btn-warning"><i class="bi bi-save me-1"></i>Update</button><a href="/MM/GRN/List" class="btn btn-outline-secondary"><i class="bi bi-x me-1"></i>Cancel</a></div>
</form>
</div></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

