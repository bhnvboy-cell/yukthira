@page
@model YuktiraERP.Web.Pages.MM.GRN.EditModel
@{ ViewData["Title"] = "Edit Goods Receipt"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-warning text-dark"><h5 class="mb-0"><i class="bi bi-pencil me-2"></i>Edit Goods Receipt</h5></div>
<div class="card-body">
<form method="post">
<input type="hidden" asp-for="Receipt.Id" />
<div class="row mb-3">
<div class="col-md-4"><label asp-for="Receipt.GrnNumber" class="form-label"></label><input asp-for="Receipt.GrnNumber" class="form-control" readonly /></div>
<div class="col-md-4"><label asp-for="Receipt.Date" class="form-label"></label><input asp-for="Receipt.Date" class="form-control" type="date" /></div>
<div class="col-md-4"><label asp-for="Receipt.PoNumber" class="form-label"></label><input asp-for="Receipt.PoNumber" class="form-control" /></div>
</div>
<div class="row mb-3">
<div class="col-md-6"><label asp-for="Receipt.MaterialName" class="form-label"></label><input asp-for="Receipt.MaterialName" class="form-control" /></div>
<div class="col-md-3"><label asp-for="Receipt.QtyReceived" class="form-label"></label><input asp-for="Receipt.QtyReceived" class="form-control" /></div>
<div class="col-md-3"><label asp-for="Receipt.QtyAccepted" class="form-label"></label><input asp-for="Receipt.QtyAccepted" class="form-control" /></div>
</div>
<div class="row mb-3">
<div class="col-md-4"><label asp-for="Receipt.Status" class="form-label"></label><select asp-for="Receipt.Status" class="form-select"><option>Inspection Pending</option><option>Posted</option><option>Returned</option></select></div>
<div class="col-md-4"><label class="form-label">Batch Number</label><input name="BatchNumber" class="form-control" value="@Model.BatchNumber" /></div>
<div class="col-md-4"><label class="form-label">Storage Location</label><input name="StorageLocation" class="form-control" value="@Model.StorageLocation" /></div>
</div>
<div class="d-flex gap-2">
<button type="submit" class="btn btn-warning"><i class="bi bi-save me-1"></i>Update</button>
<a href="/MM/GRN/List" class="btn btn-outline-secondary"><i class="bi bi-x me-1"></i>Cancel</a>
</div>
</form>
</div></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
