@page
@model YuktiraERP.Web.Pages.MM.GRN.DisplayModel
@using YuktiraERP.Infrastructure.Data.Entities
@{ ViewData["Title"] = "GoodsReceipt Details"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-info text-white"><h5 class="mb-0"><i class="bi bi-eye me-2"></i>GoodsReceipt Details</h5></div>
<div class="card-body">
<dl class="row mb-0"><dt class="col-sm-4">GrnNumber</dt><dd class="col-sm-8">@(Model.Receipt.GrnNumber)</dd><dt class="col-sm-4">Date</dt><dd class="col-sm-8">@(Model.Receipt.Date)</dd><dt class="col-sm-4">PoNumber</dt><dd class="col-sm-8">@(Model.Receipt.PoNumber)</dd><dt class="col-sm-4">MaterialName</dt><dd class="col-sm-8">@(Model.Receipt.MaterialName)</dd><dt class="col-sm-4">QtyReceived</dt><dd class="col-sm-8">@(Model.Receipt.QtyReceived)</dd><dt class="col-sm-4">QtyAccepted</dt><dd class="col-sm-8">@(Model.Receipt.QtyAccepted)</dd><dt class="col-sm-4">Status</dt><dd class="col-sm-8">@(Model.Receipt.Status)</dd></dl>
</div>
<div class="card-footer">
<a href="/MM/GRN/List" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
<a href="/MM/GRN/Edit?id=@(Model.Receipt.Id)" class="btn btn-warning"><i class="bi bi-pencil me-1"></i>Edit</a>
</div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

