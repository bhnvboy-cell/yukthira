@page
@model YuktiraERP.Web.Pages.MM.Batch.ListModel
@using YuktiraERP.Infrastructure.Data.Entities
@{ ViewData["Title"] = "Batch Management"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-upc-scan me-2"></i>Batch Management</h2>
    <div>
        <a asp-page="/MM/Batch/Create" class="btn btn-primary"><i class="bi bi-plus"></i> New Batch</a>
        <a asp-page="/MM/Batch/Recall" class="btn btn-outline-danger"><i class="bi bi-exclamation-triangle"></i> Recalls</a>
    </div>
</div>
<div class="card shadow-sm"><div class="card-body">
    <div class="table-responsive">
        <table class="table table-hover table-sm datatable">
            <thead><tr><th>Batch #</th><th>Material</th><th>Mfg Date</th><th>Expiry</th><th>Qty</th><th>Consumed</th><th>UOM</th><th>Location</th><th>Status</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var b in Model.Batches)
                {
                    <tr>
                        <td><a asp-page="/MM/Batch/Display" asp-route-id="@b.Id">@b.BatchNumber</a></td>
                        <td>@b.MaterialName</td>
                        <td>@b.ManufacturingDate.ToString("d")</td>
                        <td>@(b.ExpiryDate?.ToString("d") ?? "N/A")</td>
                        <td>@b.Quantity</td>
                        <td>@b.QuantityConsumed</td>
                        <td>@b.UnitOfMeasure</td>
                        <td>@b.StorageLocationName</td>
                        <td>
                            @if (b.Status == "ACTIVE") { <span class="badge bg-success">Active</span> }
                            else if (b.Status == "EXPIRED") { <span class="badge bg-danger">Expired</span> }
                            else if (b.Status == "RECALLED") { <span class="badge bg-warning text-dark">Recalled</span> }
                            else if (b.Status == "CONSUMED") { <span class="badge bg-info">Consumed</span> }
                            else { <span class="badge bg-secondary">@b.Status</span> }
                        </td>
                        <td>
                            <a asp-page="/MM/Batch/Display" asp-route-id="@b.Id" class="bi bi-eye me-2 text-decoration-none"></a>
                            <a asp-page="/MM/Batch/Edit" asp-route-id="@b.Id" class="bi bi-pencil me-2 text-decoration-none"></a>
                            <a asp-page="/MM/Batch/Traceability" asp-route-id="@b.Id" class="bi bi-diagram-3 text-decoration-none" title="Trace"></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div></div>
