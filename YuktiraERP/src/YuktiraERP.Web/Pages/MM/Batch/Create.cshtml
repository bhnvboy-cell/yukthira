@page
@model YuktiraERP.Web.Pages.MM.Batch.CreateModel
@using YuktiraERP.Infrastructure.Data.Entities
@{ ViewData["Title"] = "Create Batch"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-primary text-white"><h5 class="mb-0"><i class="bi bi-plus-circle me-2"></i>Create Batch</h5></div>
<div class="card-body">
<form method="post">
<div class="row mb-3">
    <div class="col-md-4"><label asp-for="Batch.BatchNumber" class="form-label">Batch Number</label><input asp-for="Batch.BatchNumber" class="form-control" placeholder="e.g. B-2026-001" /><span asp-validation-for="Batch.BatchNumber" class="text-danger small"></span></div>
    <div class="col-md-8"><label class="form-label">Material</label><select asp-for="Batch.MaterialId" class="form-select"><option value="">-- Select Material --</option></select></div>
</div>
<div class="row mb-3">
    <div class="col-md-6"><label asp-for="Batch.ManufacturingDate" class="form-label">Manufacturing Date</label><input asp-for="Batch.ManufacturingDate" type="date" class="form-control" /><span asp-validation-for="Batch.ManufacturingDate" class="text-danger small"></span></div>
    <div class="col-md-6"><label asp-for="Batch.ExpiryDate" class="form-label">Expiry Date</label><input asp-for="Batch.ExpiryDate" type="date" class="form-control" /></div>
</div>
<div class="row mb-3">
    <div class="col-md-4"><label asp-for="Batch.ShelfLifeDays" class="form-label">Shelf Life (Days)</label><input asp-for="Batch.ShelfLifeDays" class="form-control" min="0" /></div>
    <div class="col-md-4"><label asp-for="Batch.Quantity" class="form-label">Quantity</label><input asp-for="Batch.Quantity" class="form-control" min="0" step="0.01" /><span asp-validation-for="Batch.Quantity" class="text-danger small"></span></div>
    <div class="col-md-4"><label asp-for="Batch.UnitOfMeasure" class="form-label">UOM</label><select asp-for="Batch.UnitOfMeasure" class="form-select"><option value="EA">Each</option><option value="KG">Kilogram</option><option value="LB">Pound</option><option value="L">Liter</option><option value="M">Meter</option></select></div>
</div>
<div class="row mb-3">
    <div class="col-md-6"><label class="form-label">Storage Location</label><select asp-for="Batch.StorageLocationId" class="form-select"><option value="">-- Select Location --</option></select></div>
    <div class="col-md-6"><label class="form-label">Supplier</label><select asp-for="Batch.SupplierId" class="form-select"><option value="">-- Select Supplier --</option></select></div>
</div>
<div class="row mb-3">
    <div class="col-md-12"><label asp-for="Batch.Notes" class="form-label">Notes</label><textarea asp-for="Batch.Notes" class="form-control" rows="2"></textarea></div>
</div>
<div class="d-flex gap-2"><button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Save</button><a asp-page="/MM/Batch/List" class="btn btn-outline-secondary"><i class="bi bi-x me-1"></i>Cancel</a></div>
</form>
</div></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
