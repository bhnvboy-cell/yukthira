@page
@model YuktiraERP.Web.Pages.MM.Batch.EditModel
@{ ViewData["Title"] = "Edit Batch"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-warning text-dark"><h5 class="mb-0"><i class="bi bi-pencil me-2"></i>Edit Batch</h5></div>
<div class="card-body">
<form method="post">
<input type="hidden" asp-for="Batch.Id" />
<div class="row mb-3">
    <div class="col-md-4"><label asp-for="Batch.BatchNumber" class="form-label">Batch Number</label><input asp-for="Batch.BatchNumber" class="form-control" /></div>
    <div class="col-md-8"><label asp-for="Batch.MaterialName" class="form-label">Material Name</label><input asp-for="Batch.MaterialName" class="form-control" /></div>
</div>
<div class="row mb-3">
    <div class="col-md-6"><label asp-for="Batch.ManufacturingDate" class="form-label">Manufacturing Date</label><input asp-for="Batch.ManufacturingDate" type="date" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="Batch.ExpiryDate" class="form-label">Expiry Date</label><input asp-for="Batch.ExpiryDate" type="date" class="form-control" /></div>
</div>
<div class="row mb-3">
    <div class="col-md-4"><label asp-for="Batch.ShelfLifeDays" class="form-label">Shelf Life (Days)</label><input asp-for="Batch.ShelfLifeDays" class="form-control" /></div>
    <div class="col-md-4"><label asp-for="Batch.Quantity" class="form-label">Quantity</label><input asp-for="Batch.Quantity" class="form-control" /></div>
    <div class="col-md-4"><label asp-for="Batch.UnitOfMeasure" class="form-label">UOM</label><input asp-for="Batch.UnitOfMeasure" class="form-control" /></div>
</div>
<div class="row mb-3">
    <div class="col-md-4"><label asp-for="Batch.QuantityConsumed" class="form-label">Quantity Consumed</label><input asp-for="Batch.QuantityConsumed" class="form-control" /></div>
    <div class="col-md-4"><label asp-for="Batch.StorageLocationName" class="form-label">Storage Location</label><input asp-for="Batch.StorageLocationName" class="form-control" /></div>
    <div class="col-md-4"><label asp-for="Batch.Status" class="form-label">Status</label><select asp-for="Batch.Status" class="form-select"><option value="ACTIVE">Active</option><option value="EXPIRED">Expired</option><option value="RECALLED">Recalled</option><option value="CONSUMED">Consumed</option></select></div>
</div>
<div class="row mb-3">
    <div class="col-md-6"><label asp-for="Batch.SupplierName" class="form-label">Supplier</label><input asp-for="Batch.SupplierName" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="Batch.Notes" class="form-label">Notes</label><input asp-for="Batch.Notes" class="form-control" /></div>
</div>
<div class="d-flex gap-2"><button type="submit" class="btn btn-warning"><i class="bi bi-save me-1"></i>Update</button><a asp-page="/MM/Batch/List" class="btn btn-outline-secondary"><i class="bi bi-x me-1"></i>Cancel</a></div>
</form>
</div></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
