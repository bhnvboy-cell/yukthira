@page
@model YuktiraERP.Web.Pages.MM.PR.ConvertToPoModel
@{ ViewData["Title"] = "Convert PR to PO"; }
<div class="row justify-content-center"><div class="col-lg-10">
<div class="card shadow-sm"><div class="card-header bg-success text-white"><h5 class="mb-0"><i class="bi bi-arrow-right-circle me-2"></i>Convert Purchase Requisition to Purchase Order</h5></div>
<div class="card-body">
@if (Model.Preview != null)
{
<div class="alert alert-info">
<strong>PR:</strong> @Model.Preview.PrNumber | <strong>Items:</strong> @Model.Preview.TotalItems | <strong>Total:</strong> @Model.Preview.TotalAmount.ToString("C")
</div>

<form method="post">
<input type="hidden" name="prId" value="@Model.Preview.PrId" />
<div class="row mb-3">
<div class="col-md-4"><label class="form-label">Vendor Name *</label><input name="VendorName" class="form-control" required /></div>
<div class="col-md-4"><label class="form-label">Vendor Code</label><input name="VendorCode" class="form-control" /></div>
<div class="col-md-4"><label class="form-label">Payment Terms</label><select name="PaymentTerms" class="form-select"><option>Net 30</option><option>Net 60</option><option>Net 90</option><option>Due on Receipt</option></select></div>
</div>
<div class="row mb-3">
<div class="col-md-4"><label class="form-label">Incoterms</label><input name="Incoterms" class="form-control" placeholder="e.g., FOB" /></div>
<div class="col-md-4"><label class="form-label">Delivery Date</label><input name="DeliveryDate" class="form-control" type="date" /></div>
<div class="col-md-4"><label class="form-label">Plant</label><input name="Plant" class="form-control" /></div>
</div>
<div class="row mb-3">
<div class="col-md-12"><label class="form-label">Notes</label><textarea name="Notes" class="form-control" rows="2"></textarea></div>
</div>

<h6>Select Items to Convert</h6>
<table class="table table-sm table-bordered">
<thead><tr><th><input type="checkbox" id="selectAll" checked /></th><th>#</th><th>Material</th><th>Code</th><th>Qty</th><th>UOM</th><th>Unit Price</th><th>Total</th><th>Status</th></tr></thead>
<tbody>
@foreach (var item in Model.Preview.Items)
{
<tr>
<td><input type="checkbox" name="SelectedItemIds" value="@item.Id" checked class="item-check" /></td>
<td>@item.LineNumber</td><td>@item.MaterialName</td><td>@item.MaterialCode</td><td>@item.Quantity</td><td>@item.UOM</td><td>@item.UnitPrice.ToString("C")</td><td>@item.TotalPrice.ToString("C")</td><td><span class="badge bg-secondary">@item.Status</span></td>
</tr>
}
</tbody>
</table>

<div class="d-flex gap-2">
<button type="submit" class="btn btn-success"><i class="bi bi-check-circle me-1"></i>Convert to PO</button>
<a href="/MM/PR/Display?id=@Model.Preview.PrId" class="btn btn-outline-secondary">Cancel</a>
</div>
</form>
}
else
{
<div class="text-center py-4">
<p class="text-muted">Loading PR details...</p>
</div>
}
</div></div>
</div></div>

@section Scripts {
<script>
document.getElementById('selectAll')?.addEventListener('change', function() {
    document.querySelectorAll('.item-check').forEach(cb => cb.checked = this.checked);
});
</script>
}
