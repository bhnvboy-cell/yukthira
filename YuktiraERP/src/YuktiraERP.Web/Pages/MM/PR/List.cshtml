@page
@model YuktiraERP.Web.Pages.MM.PR.ListModel
@{ ViewData["Title"] = "Purchase Requisition List"; }
<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-list-ul me-2"></i>Purchase Requisitions</h2>
        <a href="/MM/PR/Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-circle me-1"></i>New PR</a>
    </div>
    @if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
    <div class="card shadow-sm">
        <div class="card-body p-0" style="overflow-x:auto">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light"><tr><th>PR Number</th><th>Date</th><th>Requestor</th><th>Department</th><th>Items</th><th>Total</th><th>Status</th><th style="width:200px">Actions</th></tr></thead>
                <tbody>
                    @if (Model.Items.Count == 0) {
                        <tr><td colspan="8" class="text-center text-muted py-4">No records found</td></tr>
                    }
                    @foreach (var item in Model.Items) {
                        <tr>
                            <td>@item.PrNumber</td><td>@item.Date.ToString("yyyy-MM-dd")</td><td>@item.Requestor</td>
                            <td><span class="badge bg-secondary">@(item.DepartmentKey ?? "-")</span></td>
                            <td>@item.ItemCount</td><td>@item.TotalAmount.ToString("C")</td>
                            <td><span class="badge @(item.Status == "APPROVED" ? "bg-success" : item.Status == "REJECTED" ? "bg-danger" : item.Status == "PENDING_APPROVAL" ? "bg-warning" : item.Status == "CONVERTED" ? "bg-info" : "bg-secondary")">@item.Status</span></td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a href="/MM/PR/Display?id=@item.Id" class="btn btn-outline-info" title="View"><i class="bi bi-eye"></i></a>
                                    <a href="/MM/PR/Edit?id=@item.Id" class="btn btn-outline-warning" title="Edit"><i class="bi bi-pencil"></i></a>
                                    @if (item.Status == "APPROVED")
                                    {
                                        <a href="/MM/PR/ConvertToPo?id=@item.Id" class="btn btn-outline-success" title="Convert to PO"><i class="bi bi-arrow-right"></i></a>
                                    }
                                    <form method="post" asp-page-handler="Delete" style="display:inline" onsubmit="return confirm('Delete this record?')">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
