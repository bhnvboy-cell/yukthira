@page
@model YuktiraERP.Web.Pages.MM.PR.DisplayModel
@using YuktiraERP.Infrastructure.Data.Entities
@{ ViewData["Title"] = "PurchaseRequisition Details"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-info text-white"><h5 class="mb-0"><i class="bi bi-eye me-2"></i>PurchaseRequisition Details</h5></div>
<div class="card-body">
<dl class="row mb-0"><dt class="col-sm-4">PrNumber</dt><dd class="col-sm-8">@(Model.Requisition.PrNumber)</dd><dt class="col-sm-4">Date</dt><dd class="col-sm-8">@(Model.Requisition.Date)</dd><dt class="col-sm-4">Requestor</dt><dd class="col-sm-8">@(Model.Requisition.Requestor)</dd><dt class="col-sm-4">ItemName</dt><dd class="col-sm-8">@(Model.Requisition.ItemName)</dd><dt class="col-sm-4">Quantity</dt><dd class="col-sm-8">@(Model.Requisition.Quantity)</dd><dt class="col-sm-4">Amount</dt><dd class="col-sm-8">@(Model.Requisition.Amount)</dd><dt class="col-sm-4">Status</dt><dd class="col-sm-8">@(Model.Requisition.Status)</dd></dl>
</div>
<div class="card-footer">
<a href="/MM/PR/List" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
<a href="/MM/PR/Edit?id=@(Model.Requisition.Id)" class="btn btn-warning"><i class="bi bi-pencil me-1"></i>Edit</a>
</div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

