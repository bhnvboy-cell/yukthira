@page
@model YuktiraERP.Web.Pages.AI.NLQuery.IndexModel
@{ ViewData["Title"] = "Natural Language Query"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><i class="bi bi-chat-dots me-2"></i>Natural Language Query</h3>
            <span class="badge">NL2SQL</span>
        </div>
        <div class="actions">
            <a asp-page="/AI/Index" class="zqm-btn zqm-btn-back"><i class="bi bi-arrow-left me-1"></i>Back</a>
        </div>
    </div>

    <div class="zqm-filter">
        <div class="zqm-section-title"><i class="bi bi-pencil me-1"></i>Query Input</div>
        <form method="post">
            <div class="zqm-field" style="margin-bottom:12px">
                <label>Enter your question in natural language</label>
                <textarea asp-for="Query" rows="4" placeholder="e.g. Show me all inspection lots with critical defects from plant 1000" style="width:100%;padding:12px;border:1px solid #ccc;border-radius:4px;font-size:0.9rem;resize:vertical;font-family:inherit"></textarea>
            </div>
            <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
                <button type="submit" class="zqm-btn" style="background:#1565c0;color:#fff;border-color:#1565c0"><i class="bi bi-play-fill me-1"></i>Execute</button>
                <div style="display:flex;gap:4px;flex-wrap:wrap">
                    <button type="button" class="zqm-btn" onclick="fillQuery('Show me all inspection lots with critical defects from plant 1000')">Defects by plant</button>
                    <button type="button" class="zqm-btn" onclick="fillQuery('Show current stock levels for all materials across warehouses')">Stock overview</button>
                    <button type="button" class="zqm-btn" onclick="fillQuery('Show all open purchase orders pending delivery')">Open POs</button>
                    <button type="button" class="zqm-btn" onclick="fillQuery('Show overdue deliveries with vendor details')">Overdue deliveries</button>
                </div>
            </div>
        </form>
    </div>

    <div id="alertBox" class="zqm-alert"></div>

    @if (!string.IsNullOrEmpty(Model.TranslatedSQL))
    {
        <div class="zqm-results">
            <div class="zqm-results-header">
                <h4><i class="bi bi-code-slash me-1"></i>Translated SQL</h4>
                <span class="count">@Model.ExecutionTime ms | @Model.RowCount rows</span>
            </div>
            <div style="padding:16px">
                <div style="background:#1a237e;color:#e8eaf6;padding:14px 16px;border-radius:4px;font-family:'Courier New',monospace;font-size:0.85rem;white-space:pre-wrap;line-height:1.5;position:relative">
                    <span style="position:absolute;top:8px;right:12px;font-size:0.7rem;color:#90caf9;text-transform:uppercase">SQL</span>
                    @Model.TranslatedSQL
                </div>
            </div>
        </div>

        @if (Model.ResultRows != null && Model.ResultRows.Any())
        {
            <div class="zqm-results">
                <div class="zqm-results-header">
                    <h4><i class="bi bi-table me-1"></i>Query Results</h4>
                    <span class="count">@Model.RowCount rows returned</span>
                </div>
                <div class="zqm-table-wrap">
                    <table class="zqm-table">
                        <thead>
                            <tr>
                                @if (Model.ResultColumns != null)
                                {
                                    @foreach (var col in Model.ResultColumns)
                                    {
                                        <th>@col</th>
                                    }
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.ResultRows)
                            {
                                <tr>
                                    @foreach (var val in row)
                                    {
                                        <td>@(val ?? "-")</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="zqm-footer"><span>Total: @Model.RowCount rows | Execution time: @Model.ExecutionTime ms</span><div></div></div>
            </div>
        }
        else
        {
            <div class="zqm-results">
                <div style="padding:20px;text-align:center;color:#666"><i class="bi bi-info-circle" style="font-size:1.5rem;display:block;margin-bottom:8px"></i>Query executed successfully but returned no results.</div>
            </div>
        }
    }

    <div class="zqm-empty" id="emptyState"><i class="bi bi-chat-dots"></i><div>Enter a natural language question and click Execute to translate and run the query</div></div>
</div>

@section Scripts {
<script>
function fillQuery(text) {
    document.getElementById('Query').value = text;
}
function show(msg, type) { var el = document.getElementById('alertBox'); el.style.display = 'block'; el.className = 'zqm-alert ' + type; el.textContent = msg; }
</script>
}
