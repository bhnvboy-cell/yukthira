@page
@model YuktiraERP.Web.Pages.AI.Vision.BatchInspectionModel
@{ ViewData["Title"] = "Batch Vision Inspection"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><i class="bi bi-images me-2"></i>Batch Vision Inspection</h3>
            <span class="badge">ZQM-V02</span>
        </div>
        <div class="actions">
            <a asp-page="/AI/Index" class="zqm-btn zqm-btn-back"><i class="bi bi-arrow-left me-1"></i>Back</a>
        </div>
    </div>

    <div class="zqm-filter">
        <div class="zqm-section-title"><i class="bi bi-funnel me-1"></i>Batch Parameters</div>
        <form method="post" enctype="multipart/form-data" id="batchForm">
            <div class="zqm-row cols-2">
                <div class="zqm-field">
                    <label>Upload Images (Multiple)</label>
                    <input type="file" name="ImageFiles" accept="image/*" multiple asp-for="ImageFiles" style="display:block;width:100%;padding:8px;border:1px solid #ccc;border-radius:4px;background:#fff" />
                </div>
                <div class="zqm-field"><label>Material Code</label><input asp-for="MaterialCode" placeholder="e.g. MAT-001" /></div>
            </div>
            <div class="zqm-row cols-2">
                <div class="zqm-field">
                    <label>Plant</label>
                    <select asp-for="Plant">
                        <option value="">Select Plant</option>
                        <option value="1000">1000 - Manufacturing</option>
                        <option value="2000">2000 - Warehouse</option>
                        <option value="3000">3000 - Quality</option>
                    </select>
                </div>
                <div class="zqm-field"><label>Inspection Lot Number</label><input asp-for="InspectionLotNumber" placeholder="e.g. IL-20260001" /></div>
            </div>
            <div style="margin-top:10px">
                <button type="submit" class="zqm-btn" style="background:#1565c0;color:#fff;border-color:#1565c0"><i class="bi bi-play-fill me-1"></i>Run Batch Inspection</button>
            </div>
        </form>
    </div>

    <div id="alertBox" class="zqm-alert"></div>

    @if (Model.Results != null && Model.Results.Any())
    {
        <div class="zqm-results">
            <div class="zqm-results-header">
                <h4><i class="bi bi-table me-1"></i>Batch Results</h4>
                <span class="count">@Model.Results.Count images</span>
            </div>

            <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:1px;background:#e0e0e0;border-bottom:1px solid #e0e0e0">
                <div style="background:#fff;padding:12px;text-align:center">
                    <div style="font-size:1.3rem;font-weight:700;color:#1a237e">@Model.TotalCount</div>
                    <div style="font-size:0.7rem;color:#777;text-transform:uppercase">Total</div>
                </div>
                <div style="background:#fff;padding:12px;text-align:center">
                    <div style="font-size:1.3rem;font-weight:700;color:#2e7d32">@Model.PassedCount</div>
                    <div style="font-size:0.7rem;color:#777;text-transform:uppercase">Passed</div>
                </div>
                <div style="background:#fff;padding:12px;text-align:center">
                    <div style="font-size:1.3rem;font-weight:700;color:#c62828">@Model.FailedCount</div>
                    <div style="font-size:0.7rem;color:#777;text-transform:uppercase">Failed</div>
                </div>
                <div style="background:#fff;padding:12px;text-align:center">
                    <div style="font-size:1.3rem;font-weight:700;color:#f57c00">@Model.WarningCount</div>
                    <div style="font-size:0.7rem;color:#777;text-transform:uppercase">Warnings</div>
                </div>
                <div style="background:#fff;padding:12px;text-align:center">
                    <div style="font-size:1.3rem;font-weight:700;color:#1565c0">@Model.PassRate.ToString("F1")%</div>
                    <div style="font-size:0.7rem;color:#777;text-transform:uppercase">Pass Rate</div>
                </div>
            </div>

            <div class="zqm-table-wrap">
                <table class="zqm-table">
                    <thead><tr><th>#</th><th>Image</th><th>Severity</th><th>Defect Type</th><th>Confidence</th><th>Action</th><th>NC Required</th></tr></thead>
                    <tbody>
                        @{ var idx = 0; }
                        @foreach (var r in Model.Results)
                        {
                            idx++;
                            <tr>
                                <td>@idx</td>
                                <td><strong>@r.ImageName</strong></td>
                                <td><span class="zqm-badge @(r.Severity == "Critical" ? "danger" : r.Severity == "High" ? "warning" : r.Severity == "Medium" ? "info" : "passed")">@r.Severity</span></td>
                                <td>@r.DefectType</td>
                                <td>@r.ConfidencePct.ToString("F1")%</td>
                                <td><span class="zqm-badge @(r.IsPassed ? "passed" : "failed")">@(r.IsPassed ? "PASS" : "FAIL")</span></td>
                                <td>
                                    @if (r.NCRequired)
                                    {
                                        <span class="zqm-badge danger">NC Required</span>
                                    }
                                    else
                                    {
                                        <span class="zqm-badge passed">No NC</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="zqm-footer"><span>Total: @Model.Results.Count images inspected</span><div></div></div>
        </div>
    }

    <div class="zqm-empty" id="emptyState"><i class="bi bi-images"></i><div>Upload images and run batch inspection to see results</div></div>
</div>

@section Scripts {
<script>
function show(msg, type) { var el = document.getElementById('alertBox'); el.style.display = 'block'; el.className = 'zqm-alert ' + type; el.textContent = msg; }
</script>
}
