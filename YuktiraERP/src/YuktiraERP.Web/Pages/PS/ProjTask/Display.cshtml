@page
@model YuktiraERP.Web.Pages.PS.ProjTask.DisplayModel
@using YuktiraERP.Infrastructure.Data.Entities
@{ ViewData["Title"] = "ProjectTask Details"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-info text-white"><h5 class="mb-0"><i class="bi bi-eye me-2"></i>ProjectTask Details</h5></div>
<div class="card-body">
<dl class="row mb-0"><dt class="col-sm-4">TaskCode</dt><dd class="col-sm-8">@(Model.ProjTask.TaskCode)</dd><dt class="col-sm-4">Name</dt><dd class="col-sm-8">@(Model.ProjTask.Name)</dd><dt class="col-sm-4">ProjectCode</dt><dd class="col-sm-8">@(Model.ProjTask.ProjectCode)</dd><dt class="col-sm-4">AssignedTo</dt><dd class="col-sm-8">@(Model.ProjTask.AssignedTo)</dd><dt class="col-sm-4">PlannedHours</dt><dd class="col-sm-8">@(Model.ProjTask.PlannedHours)</dd><dt class="col-sm-4">ActualHours</dt><dd class="col-sm-8">@(Model.ProjTask.ActualHours)</dd><dt class="col-sm-4">StartDate</dt><dd class="col-sm-8">@(Model.ProjTask.StartDate)</dd><dt class="col-sm-4">EndDate</dt><dd class="col-sm-8">@(Model.ProjTask.EndDate)</dd><dt class="col-sm-4">Status</dt><dd class="col-sm-8">@(Model.ProjTask.Status)</dd></dl>
</div>
<div class="card-footer">
<a href="/PS/ProjTask/List" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
<a href="/PS/ProjTask/Edit?id=@(Model.ProjTask.Id)" class="btn btn-warning"><i class="bi bi-pencil me-1"></i>Edit</a>
</div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

