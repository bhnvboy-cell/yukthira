@page
@model YuktiraERP.Web.Pages.PS.ProjTask.EditModel
@{ ViewData["Title"] = "Edit ProjectTask"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-warning text-dark"><h5 class="mb-0"><i class="bi bi-pencil me-2"></i>Edit ProjectTask</h5></div>
<div class="card-body">
<form method="post">
<input type="hidden" asp-for="ProjTask.Id" />
<div class="row mb-3"><div class="col-md-6"><label asp-for="ProjTask.TaskCode" class="form-label"></label><input asp-for="ProjTask.TaskCode" class="form-control" type="text" /></div><div class="col-md-6"><label asp-for="ProjTask.Name" class="form-label"></label><input asp-for="ProjTask.Name" class="form-control" type="text" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="ProjTask.ProjectCode" class="form-label"></label><input asp-for="ProjTask.ProjectCode" class="form-control" type="text" /></div><div class="col-md-6"><label asp-for="ProjTask.AssignedTo" class="form-label"></label><input asp-for="ProjTask.AssignedTo" class="form-control" type="text" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="ProjTask.PlannedHours" class="form-label"></label><input asp-for="ProjTask.PlannedHours" class="form-control" type="number" step="0.01" /></div><div class="col-md-6"><label asp-for="ProjTask.ActualHours" class="form-label"></label><input asp-for="ProjTask.ActualHours" class="form-control" type="number" step="0.01" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="ProjTask.StartDate" class="form-label"></label><input asp-for="ProjTask.StartDate" class="form-control" type="datetime-local" /></div><div class="col-md-6"><label asp-for="ProjTask.EndDate" class="form-label"></label><input asp-for="ProjTask.EndDate" class="form-control" type="datetime-local" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="ProjTask.Status" class="form-label"></label><input asp-for="ProjTask.Status" class="form-control" type="text" /></div><div class="col-md-6"></div></div>
<div class="d-flex gap-2"><button type="submit" class="btn btn-warning"><i class="bi bi-save me-1"></i>Update</button><a href="/PS/ProjTask/List" class="btn btn-outline-secondary"><i class="bi bi-x me-1"></i>Cancel</a></div>
</form>
</div></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

