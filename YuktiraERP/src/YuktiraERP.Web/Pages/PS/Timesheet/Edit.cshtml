@page
@model YuktiraERP.Web.Pages.PS.Timesheet.EditModel
@{ ViewData["Title"] = "Edit TimesheetEntry"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-warning text-dark"><h5 class="mb-0"><i class="bi bi-pencil me-2"></i>Edit TimesheetEntry</h5></div>
<div class="card-body">
<form method="post">
<input type="hidden" asp-for="Entry.Id" />
<div class="row mb-3"><div class="col-md-6"><label asp-for="Entry.EmployeeName" class="form-label"></label><input asp-for="Entry.EmployeeName" class="form-control" type="text" /></div><div class="col-md-6"><label asp-for="Entry.ProjectCode" class="form-label"></label><input asp-for="Entry.ProjectCode" class="form-control" type="text" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="Entry.TaskCode" class="form-label"></label><input asp-for="Entry.TaskCode" class="form-control" type="text" /></div><div class="col-md-6"><label asp-for="Entry.Date" class="form-label"></label><input asp-for="Entry.Date" class="form-control" type="datetime-local" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="Entry.Hours" class="form-label"></label><input asp-for="Entry.Hours" class="form-control" type="number" step="0.01" /></div><div class="col-md-6"><label asp-for="Entry.Description" class="form-label"></label><input asp-for="Entry.Description" class="form-control" type="text" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="Entry.Status" class="form-label"></label><input asp-for="Entry.Status" class="form-control" type="text" /></div><div class="col-md-6"></div></div>
<div class="d-flex gap-2"><button type="submit" class="btn btn-warning"><i class="bi bi-save me-1"></i>Update</button><a href="/PS/Timesheet/List" class="btn btn-outline-secondary"><i class="bi bi-x me-1"></i>Cancel</a></div>
</form>
</div></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

