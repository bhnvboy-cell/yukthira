@page
@model YuktiraERP.Web.Pages.PS.Timesheet.DisplayModel
@using YuktiraERP.Infrastructure.Data.Entities
@{ ViewData["Title"] = "TimesheetEntry Details"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-info text-white"><h5 class="mb-0"><i class="bi bi-eye me-2"></i>TimesheetEntry Details</h5></div>
<div class="card-body">
<dl class="row mb-0"><dt class="col-sm-4">EmployeeName</dt><dd class="col-sm-8">@(Model.Entry.EmployeeName)</dd><dt class="col-sm-4">ProjectCode</dt><dd class="col-sm-8">@(Model.Entry.ProjectCode)</dd><dt class="col-sm-4">TaskCode</dt><dd class="col-sm-8">@(Model.Entry.TaskCode)</dd><dt class="col-sm-4">Date</dt><dd class="col-sm-8">@(Model.Entry.Date)</dd><dt class="col-sm-4">Hours</dt><dd class="col-sm-8">@(Model.Entry.Hours)</dd><dt class="col-sm-4">Description</dt><dd class="col-sm-8">@(Model.Entry.Description)</dd><dt class="col-sm-4">Status</dt><dd class="col-sm-8">@(Model.Entry.Status)</dd></dl>
</div>
<div class="card-footer">
<a href="/PS/Timesheet/List" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
<a href="/PS/Timesheet/Edit?id=@(Model.Entry.Id)" class="btn btn-warning"><i class="bi bi-pencil me-1"></i>Edit</a>
</div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

