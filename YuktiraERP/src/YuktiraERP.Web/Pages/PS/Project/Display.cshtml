@page "{id:guid}"
@model YuktiraERP.Web.Pages.PS.Project.DisplayModel
@{
    ViewData["Title"] = "Display Project";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><svg class="bi bi-diagram-3 me-2" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-diagram-3"></use></svg>Project: @Model.Project.ProjectCode</h2>
    <a asp-page="/PS/Index" class="btn btn-outline-secondary btn-sm"><svg class="bi bi-arrow-left" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-arrow-left"></use></svg> Back</a>
</div>
<div class="card"><div class="card-body">
    <table class="table table-bordered">
        <tr><th style="width:200px">Project Code</th><td>@Model.Project.ProjectCode</td></tr>
        <tr><th>Name</th><td>@Model.Project.Name</td></tr>
        <tr><th>Manager</th><td>@Model.Project.Manager</td></tr>
        <tr><th>Department</th><td>@Model.Project.Department</td></tr>
        <tr><th>Budget</th><td>@Model.Project.Budget.ToString("C2")</td></tr>
        <tr><th>Spent</th><td>@Model.Project.Spent.ToString("C2")</td></tr>
        <tr><th>Start Date</th><td>@Model.Project.StartDate.ToString("d")</td></tr>
        <tr><th>End Date</th><td>@(Model.Project.EndDate == default ? "--" : Model.Project.EndDate.ToString("d"))</td></tr>
        <tr><th>Status</th><td><span class="badge @(Model.Project.Status=="Active"?"bg-success":"bg-warning")">@Model.Project.Status</span></td></tr>
    </table>
</div></div>
