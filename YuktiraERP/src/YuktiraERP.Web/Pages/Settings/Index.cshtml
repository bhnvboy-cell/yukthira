@page
@model YuktiraERP.Web.Pages.Settings.IndexModel
@{ ViewData["Title"] = "Settings"; Layout = "_Layout"; }

<h2><i class="bi bi-gear"></i> Settings</h2>
<hr class="mb-4" />

<!-- Theme Selection -->
<div class="card mb-4">
    <div class="card-header fw-semibold"><i class="bi bi-palette"></i> Theme</div>
    <div class="card-body">
        <p class="text-muted mb-3">Choose your preferred layout style.</p>
        <div class="settings-theme-grid">
            <div class="settings-theme-card" data-theme="modern" onclick="selectTheme('modern')">
                <div class="settings-theme-preview"><i class="bi bi-window-stack text-white"></i></div>
                <div class="settings-theme-name">Modern</div>
                <div class="settings-theme-desc">Clean, rounded, light with blue-teal accents</div>
            </div>
            <div class="settings-theme-card" data-theme="classic" onclick="selectTheme('classic')">
                <div class="settings-theme-preview"><i class="bi bi-window text-white"></i></div>
                <div class="settings-theme-name">Classical</div>
                <div class="settings-theme-desc">Compact, sharp edges, professional blue tones</div>
            </div>
            <div class="settings-theme-card" data-theme="futuristic" onclick="selectTheme('futuristic')">
                <div class="settings-theme-preview"><i class="bi bi-cpu text-white"></i></div>
                <div class="settings-theme-name">Futuristic</div>
                <div class="settings-theme-desc">Dark, gold accents, premium feel</div>
            </div>
        </div>
    </div>
</div>

<!-- Session Timeout -->
<div class="card mb-4">
    <div class="card-header fw-semibold"><i class="bi bi-clock-history"></i> Session Timeout</div>
    <div class="card-body">
        <p class="text-muted mb-3">Configure automatic logout after inactivity. A warning will appear before expiry.</p>
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label fw-semibold">Session Duration (minutes)</label>
                <select id="sessionTimeoutMinutes" class="form-select" onchange="saveTimeoutSettings()">
                    <option value="5">5 minutes</option>
                    <option value="10">10 minutes</option>
                    <option value="15">15 minutes</option>
                    <option value="30" selected>30 minutes</option>
                    <option value="60">1 hour</option>
                    <option value="120">2 hours</option>
                    <option value="240">4 hours</option>
                    <option value="480">8 hours</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold">Warning Before (seconds)</label>
                <select id="warningBeforeSeconds" class="form-select" onchange="saveTimeoutSettings()">
                    <option value="30">30 seconds</option>
                    <option value="60" selected>60 seconds</option>
                    <option value="90">90 seconds</option>
                    <option value="120">2 minutes</option>
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <div id="timeoutStatus" class="text-success small d-none">
                    <i class="bi bi-check-circle"></i> Saved
                </div>
            </div>
        </div>
    </div>
</div>

<!-- General -->
<div class="card mb-4">
    <div class="card-header fw-semibold"><i class="bi bi-sliders"></i> General</div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label fw-semibold">Language</label>
                <select id="settingLanguage" class="form-select" onchange="saveGeneralSettings()">
                    <option value="en" selected>English</option>
                    <option value="hi">Hindi</option>
                    <option value="ta">Tamil</option>
                    <option value="te">Telugu</option>
                    <option value="fr">French</option>
                    <option value="es">Spanish</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold">Sidebar Behavior</label>
                <select id="settingSidebar" class="form-select" onchange="saveGeneralSettings()">
                    <option value="hover" selected>Expand on hover</option>
                    <option value="collapsed">Always collapsed</option>
                    <option value="expanded">Always expanded</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold">Animations</label>
                <select id="settingAnimations" class="form-select" onchange="saveGeneralSettings()">
                    <option value="full" selected>Full animations</option>
                    <option value="reduced">Reduced motion</option>
                    <option value="none">No animations</option>
                </select>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    (function() {
        var s = JSON.parse(localStorage.getItem('yuktira_settings') || '{}');
        var theme = localStorage.getItem('yuktira_theme') || 'modern';
        document.querySelectorAll('.settings-theme-card').forEach(function(c) {
            if (c.getAttribute('data-theme') === theme) c.classList.add('active');
        });
        if (s.sessionTimeoutMinutes) document.getElementById('sessionTimeoutMinutes').value = s.sessionTimeoutMinutes;
        if (s.warningBeforeSeconds) document.getElementById('warningBeforeSeconds').value = s.warningBeforeSeconds;
        if (s.language) document.getElementById('settingLanguage').value = s.language;
        if (s.sidebar) document.getElementById('settingSidebar').value = s.sidebar;
        if (s.animations) document.getElementById('settingAnimations').value = s.animations;
    })();

    function selectTheme(theme) {
        document.documentElement.setAttribute('data-theme', theme);
        localStorage.setItem('yuktira_theme', theme);
        document.querySelectorAll('.settings-theme-card').forEach(function(c) {
            c.classList.toggle('active', c.getAttribute('data-theme') === theme);
        });
        document.querySelectorAll('.theme-btn').forEach(function(b) {
            b.style.borderColor = b.getAttribute('data-theme') === theme ? '#fff' : 'transparent';
            b.setAttribute('aria-checked', b.getAttribute('data-theme') === theme ? 'true' : 'false');
        });
    }

    function saveTimeoutSettings() {
        var s = JSON.parse(localStorage.getItem('yuktira_settings') || '{}');
        s.sessionTimeoutMinutes = parseInt(document.getElementById('sessionTimeoutMinutes').value);
        s.warningBeforeSeconds = parseInt(document.getElementById('warningBeforeSeconds').value);
        localStorage.setItem('yuktira_settings', JSON.stringify(s));
        showSaved();
    }

    function saveGeneralSettings() {
        var s = JSON.parse(localStorage.getItem('yuktira_settings') || '{}');
        s.language = document.getElementById('settingLanguage').value;
        s.sidebar = document.getElementById('settingSidebar').value;
        s.animations = document.getElementById('settingAnimations').value;
        localStorage.setItem('yuktira_settings', JSON.stringify(s));
        if (s.animations === 'none') document.documentElement.style.setProperty('--transition-speed', '0s');
        else document.documentElement.style.removeProperty('--transition-speed');
        showSaved();
    }

    function showSaved() {
        var el = document.getElementById('timeoutStatus');
        el.classList.remove('d-none');
        setTimeout(function() { el.classList.add('d-none'); }, 2000);
    }
</script>
}
