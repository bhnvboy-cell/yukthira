@page
@model YuktiraERP.Web.Pages.LIMS.Instrument.EditModel
@{ ViewData["Title"] = "Edit Instrument"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-warning text-dark"><h5 class="mb-0"><svg class="bi bi-pencil me-2" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-pencil"></use></svg>Edit Instrument</h5></div>
<div class="card-body">
<form method="post">
<input type="hidden" asp-for="Instrument.Id" />
<div class="row mb-3"><div class="col-md-6"><label asp-for="Instrument.Code" class="form-label"></label><input asp-for="Instrument.Code" class="form-control" type="text" /></div><div class="col-md-6"><label asp-for="Instrument.Name" class="form-label"></label><input asp-for="Instrument.Name" class="form-control" type="text" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="Instrument.Type" class="form-label"></label><input asp-for="Instrument.Type" class="form-control" type="text" /></div><div class="col-md-6"><label asp-for="Instrument.LastCalibration" class="form-label"></label><input asp-for="Instrument.LastCalibration" class="form-control" type="datetime-local" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="Instrument.NextCalibration" class="form-label"></label><input asp-for="Instrument.NextCalibration" class="form-control" type="datetime-local" /></div><div class="col-md-6"><label asp-for="Instrument.Status" class="form-label"></label><input asp-for="Instrument.Status" class="form-control" type="text" /></div></div>
<div class="d-flex gap-2"><button type="submit" class="btn btn-warning"><svg class="bi bi-save me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-save"></use></svg>Update</button><a href="/LIMS/Instrument/List" class="btn btn-outline-secondary"><svg class="bi bi-x me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-x"></use></svg>Cancel</a></div>
</form>
</div></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

