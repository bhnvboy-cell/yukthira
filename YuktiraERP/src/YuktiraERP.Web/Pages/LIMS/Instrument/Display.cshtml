@page
@model YuktiraERP.Web.Pages.LIMS.Instrument.DisplayModel
@using YuktiraERP.Infrastructure.Data.Entities
@{ ViewData["Title"] = "Instrument Details"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-info text-white"><h5 class="mb-0"><svg class="bi bi-eye me-2" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-eye"></use></svg>Instrument Details</h5></div>
<div class="card-body">
<dl class="row mb-0"><dt class="col-sm-4">Code</dt><dd class="col-sm-8">@(Model.Instrument.Code)</dd><dt class="col-sm-4">Name</dt><dd class="col-sm-8">@(Model.Instrument.Name)</dd><dt class="col-sm-4">Type</dt><dd class="col-sm-8">@(Model.Instrument.Type)</dd><dt class="col-sm-4">LastCalibration</dt><dd class="col-sm-8">@(Model.Instrument.LastCalibration)</dd><dt class="col-sm-4">NextCalibration</dt><dd class="col-sm-8">@(Model.Instrument.NextCalibration)</dd><dt class="col-sm-4">Status</dt><dd class="col-sm-8">@(Model.Instrument.Status)</dd></dl>
</div>
<div class="card-footer">
<a href="/LIMS/Instrument/List" class="btn btn-outline-secondary"><svg class="bi bi-arrow-left me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-arrow-left"></use></svg>Back</a>
<a href="/LIMS/Instrument/Edit?id=@(Model.Instrument.Id)" class="btn btn-warning"><svg class="bi bi-pencil me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-pencil"></use></svg>Edit</a>
</div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

