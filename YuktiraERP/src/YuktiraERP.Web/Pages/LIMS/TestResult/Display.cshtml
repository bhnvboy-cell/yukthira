@page
@model YuktiraERP.Web.Pages.LIMS.TestResult.DisplayModel
@using YuktiraERP.Infrastructure.Data.Entities
@{ ViewData["Title"] = "TestResult Details"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-info text-white"><h5 class="mb-0"><svg class="bi bi-eye me-2" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-eye"></use></svg>TestResult Details</h5></div>
<div class="card-body">
<dl class="row mb-0"><dt class="col-sm-4">ResultId</dt><dd class="col-sm-8">@(Model.Result.ResultId)</dd><dt class="col-sm-4">SampleId</dt><dd class="col-sm-8">@(Model.Result.SampleId)</dd><dt class="col-sm-4">TestName</dt><dd class="col-sm-8">@(Model.Result.TestName)</dd><dt class="col-sm-4">Result</dt><dd class="col-sm-8">@(Model.Result.Result)</dd><dt class="col-sm-4">Specification</dt><dd class="col-sm-8">@(Model.Result.Specification)</dd><dt class="col-sm-4">Status</dt><dd class="col-sm-8">@(Model.Result.Status)</dd></dl>
</div>
<div class="card-footer">
<a href="/LIMS/TestResult/List" class="btn btn-outline-secondary"><svg class="bi bi-arrow-left me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-arrow-left"></use></svg>Back</a>
<a href="/LIMS/TestResult/Edit?id=@(Model.Result.Id)" class="btn btn-warning"><svg class="bi bi-pencil me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-pencil"></use></svg>Edit</a>
</div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

