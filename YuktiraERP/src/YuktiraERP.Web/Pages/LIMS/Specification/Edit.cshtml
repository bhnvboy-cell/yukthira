@page
@model YuktiraERP.Web.Pages.LIMS.Specification.EditModel
@{ ViewData["Title"] = "Edit Specification"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-warning text-dark"><h5 class="mb-0"><i class="bi bi-pencil me-2"></i>Edit Specification</h5></div>
<div class="card-body">
<form method="post">
<input type="hidden" asp-for="Spec.Id" />
<div class="row mb-3"><div class="col-md-6"><label asp-for="Spec.SpecId" class="form-label"></label><input asp-for="Spec.SpecId" class="form-control" type="text" /></div><div class="col-md-6"><label asp-for="Spec.MaterialName" class="form-label"></label><input asp-for="Spec.MaterialName" class="form-control" type="text" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="Spec.Characteristic" class="form-label"></label><input asp-for="Spec.Characteristic" class="form-control" type="text" /></div><div class="col-md-6"><label asp-for="Spec.MinValue" class="form-label"></label><input asp-for="Spec.MinValue" class="form-control" type="text" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="Spec.MaxValue" class="form-label"></label><input asp-for="Spec.MaxValue" class="form-control" type="text" /></div><div class="col-md-6"><label asp-for="Spec.Status" class="form-label"></label><input asp-for="Spec.Status" class="form-control" type="text" /></div></div>
<div class="d-flex gap-2"><button type="submit" class="btn btn-warning"><i class="bi bi-save me-1"></i>Update</button><a href="/LIMS/Specification/List" class="btn btn-outline-secondary"><i class="bi bi-x me-1"></i>Cancel</a></div>
</form>
</div></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

