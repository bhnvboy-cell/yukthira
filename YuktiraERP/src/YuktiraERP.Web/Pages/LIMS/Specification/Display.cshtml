@page
@model YuktiraERP.Web.Pages.LIMS.Specification.DisplayModel
@using YuktiraERP.Infrastructure.Data.Entities
@{ ViewData["Title"] = "Specification Details"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-info text-white"><h5 class="mb-0"><i class="bi bi-eye me-2"></i>Specification Details</h5></div>
<div class="card-body">
<dl class="row mb-0"><dt class="col-sm-4">SpecId</dt><dd class="col-sm-8">@(Model.Spec.SpecId)</dd><dt class="col-sm-4">MaterialName</dt><dd class="col-sm-8">@(Model.Spec.MaterialName)</dd><dt class="col-sm-4">Characteristic</dt><dd class="col-sm-8">@(Model.Spec.Characteristic)</dd><dt class="col-sm-4">MinValue</dt><dd class="col-sm-8">@(Model.Spec.MinValue)</dd><dt class="col-sm-4">MaxValue</dt><dd class="col-sm-8">@(Model.Spec.MaxValue)</dd><dt class="col-sm-4">Status</dt><dd class="col-sm-8">@(Model.Spec.Status)</dd></dl>
</div>
<div class="card-footer">
<a href="/LIMS/Specification/List" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
<a href="/LIMS/Specification/Edit?id=@(Model.Spec.Id)" class="btn btn-warning"><i class="bi bi-pencil me-1"></i>Edit</a>
</div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

