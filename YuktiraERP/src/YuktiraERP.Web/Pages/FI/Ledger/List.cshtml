@page
@model YuktiraERP.Web.Pages.FI.Ledger.ListModel
@{ ViewData["Title"] = "JournalEntry List"; }
<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-list-ul me-2"></i>JournalEntry Records</h2>
        <div>
            <button type="button" class="btn btn-outline-secondary btn-sm me-2" onclick="document.querySelectorAll('.inline-edit-col').forEach(c=>c.style.display=c.style.display==='none'?'':'none')" title="Toggle inline editing"><i class="bi bi-pencil-square me-1"></i>Inline Edit</button>
            <a href="/FI/Ledger/Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-circle me-1"></i>New JournalEntry</a>
        </div>
    </div>
    <div class="card shadow-sm">
        <div class="card-body p-0" style="overflow-x:auto">
            <table class="table table-hover mb-0 align-middle" id="ledgerTable">
                <thead class="table-light"><tr><th>DocumentNumber</th><th>EntryDate</th><th>Account</th><th class="inline-edit-col" style="display:none">Debit</th><th class="inline-edit-col" style="display:none">Credit</th><th style="width:160px">Actions</th></tr></thead>
                <tbody>
                    @if (Model.Items.Count == 0) {
                        <tr><td colspan="6" class="text-center text-muted py-4">No records found</td></tr>
                    }
                    @foreach (var item in Model.Items) {
                        <tr data-id="@item.Id" data-entity="JournalEntryEntity" data-module="FI">
                            <td>@item.DocumentNumber</td>
                            <td>@item.EntryDate</td>
                            <td data-field="Account">@item.Account</td>
                            <td class="inline-edit-col" style="display:none" data-field="Debit" data-type="number">@(item.Debit?.ToString("C2") ?? "0.00")</td>
                            <td class="inline-edit-col" style="display:none" data-field="Credit" data-type="number">@(item.Credit?.ToString("C2") ?? "0.00")</td>
                            <td class="actions-cell">
                                <div class="btn-group btn-group-sm">
                                    <a href="/FI/Ledger/Display?id=@item.Id" class="btn btn-outline-info" title="View"><i class="bi bi-eye"></i></a>
                                    <a href="/FI/Ledger/Edit?id=@item.Id" class="btn btn-outline-warning" title="Edit"><i class="bi bi-pencil"></i></a>
                                    <form method="post" asp-page-handler="Delete" style="display:inline" onsubmit="return confirm('Delete this record?')">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@section Scripts {
<script src="~/js/inline-edit.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    InlineEdit.initTable(document.getElementById('ledgerTable'));
});
</script>
}
