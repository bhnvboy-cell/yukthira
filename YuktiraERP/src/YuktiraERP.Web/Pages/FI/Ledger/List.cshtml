@page
@model YuktiraERP.Web.Pages.FI.Ledger.ListModel
@{ ViewData["Title"] = "Journal Entries"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><svg class="bi bi-list-ul me-2" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-list-ul"></use></svg>Journal Entries</h3>
            <span class="badge">@Model.Items.Count records</span>
        </div>
        <div class="actions">
            <a asp-page="/FI/Ledger/Create" class="zqm-btn" style="background:#4caf50;border-color:#4caf50"><svg class="bi bi-plus-circle me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-plus-circle"></use></svg>New Entry</a>
            <a asp-page="/FI/Index" class="zqm-btn zqm-btn-back"><svg class="bi bi-arrow-left me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-arrow-left"></use></svg>Back</a>
        </div>
    </div>

    <div class="zqm-filter">
        <div class="zqm-section-title"><svg class="bi bi-funnel me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-funnel"></use></svg>Search</div>
        <div class="zqm-row cols-3">
            <div class="zqm-field"><label>Document #</label><input id="searchDoc" placeholder="Filter by doc #" oninput="filterTable()" /></div>
            <div class="zqm-field"><label>Account</label><input id="searchAccount" placeholder="Filter by account..." oninput="filterTable()" /></div>
            <div class="zqm-field"><label>Reference</label><input id="searchRef" placeholder="Filter by reference..." oninput="filterTable()" /></div>
        </div>
    </div>

    <div class="zqm-results">
        <div class="zqm-results-header"><h4>Journal Entries</h4><span class="count" id="resultCount">@Model.Items.Count items</span></div>
        <div class="zqm-table-wrap">
            <table class="zqm-table" id="ledgerTable">
                <thead><tr><th>Document #</th><th>Entry Date</th><th>Account</th><th>Debit</th><th>Credit</th><th>Reference</th><th>Actions</th></tr></thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr><td colspan="7" class="zqm-empty"><svg class="bi bi-inbox" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-inbox"></use></svg><div>No journal entries found</div></td></tr>
                    }
                    @foreach (var item in Model.Items)
                    {
                        <tr data-doc="@item.DocumentNumber" data-account="@item.Account" data-ref="@item.Reference">
                            <td style="font-weight:600;color:#1565c0">@item.DocumentNumber</td>
                            <td>@item.EntryDate.ToString("yyyy-MM-dd")</td>
                            <td>@item.Account</td>
                            <td>@(item.Debit?.ToString("C2") ?? "--")</td>
                            <td>@(item.Credit?.ToString("C2") ?? "--")</td>
                            <td>@item.Reference</td>
                            <td>
                                <a asp-page="/FI/Ledger/Display" asp-route-id="@item.Id" class="zqm-act" title="View"><svg class="bi bi-eye" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-eye"></use></svg></a>
                                <a asp-page="/FI/Ledger/Edit" asp-route-id="@item.Id" class="zqm-act" title="Edit"><svg class="bi bi-pencil" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-pencil"></use></svg></a>
                                <form method="post" asp-page-handler="Delete" style="display:inline" onsubmit="return confirm('Delete this entry?')">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="zqm-act" title="Delete"><svg class="bi bi-trash" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-trash"></use></svg></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
function filterTable() {
    var doc = document.getElementById('searchDoc').value.toLowerCase();
    var account = document.getElementById('searchAccount').value.toLowerCase();
    var ref = document.getElementById('searchRef').value.toLowerCase();
    var rows = document.querySelectorAll('#ledgerTable tbody tr[data-doc]');
    var count = 0;
    rows.forEach(function(r) {
        var match = (!doc || r.dataset.doc.toLowerCase().indexOf(doc) > -1) &&
                    (!account || r.dataset.account.toLowerCase().indexOf(account) > -1) &&
                    (!ref || (r.dataset.ref || '').toLowerCase().indexOf(ref) > -1);
        r.style.display = match ? '' : 'none';
        if (match) count++;
    });
    document.getElementById('resultCount').textContent = count + ' items';
}
</script>

@section Scripts {
<script src="~/js/inline-edit.js"></script>
<script>document.addEventListener('DOMContentLoaded', function() { InlineEdit.initTable(document.getElementById('ledgerTable')); });</script>
}
