@page
@model YuktiraERP.Web.Pages.FI.Ledger.CreateModel
@{ ViewData["Title"] = "Create Journal Entry"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><i class="bi bi-plus-circle me-2"></i>New Journal Entry</h3>
            <span class="badge">FI-GL</span>
        </div>
        <div class="actions">
            <button type="submit" form="createForm" class="zqm-btn" style="background:#4caf50;border-color:#4caf50"><i class="bi bi-check-circle me-1"></i>Save Entry</button>
            <button type="button" class="zqm-btn" onclick="document.getElementById('createForm').reset()"><i class="bi bi-x-circle me-1"></i>Clear</button>
            <a asp-page="/FI/Ledger/List" class="zqm-btn zqm-btn-back"><i class="bi bi-arrow-left me-1"></i>Back</a>
        </div>
    </div>

    <div class="zqm-filter">
        <form method="post" id="createForm">
            <div class="zqm-section-title"><i class="bi bi-journal-text me-1"></i>Journal Entry Details</div>
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Account <span style="color:#c62828">*</span></label><input asp-for="Entry.Account" placeholder="1100 - Cash" required /></div>
                <div class="zqm-field"><label>Debit</label><input asp-for="Entry.Debit" type="number" step="0.01" min="0" placeholder="0.00" /></div>
                <div class="zqm-field"><label>Credit</label><input asp-for="Entry.Credit" type="number" step="0.01" min="0" placeholder="0.00" /></div>
            </div>
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Reference</label><input asp-for="Entry.Reference" placeholder="Document reference" /></div>
                <div class="zqm-field"><label>Entry Date <span style="color:#c62828">*</span></label><input asp-for="Entry.EntryDate" type="date" required /></div>
                <div class="zqm-field"><label>Document Number</label><div class="zqm-ro">Auto-generated</div></div>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
