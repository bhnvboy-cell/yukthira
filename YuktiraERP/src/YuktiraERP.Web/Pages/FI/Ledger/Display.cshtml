@page
@model YuktiraERP.Web.Pages.FI.Ledger.DisplayModel
@using YuktiraERP.Infrastructure.Data.Entities
@{ ViewData["Title"] = "JournalEntry Details"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-info text-white"><h5 class="mb-0"><i class="bi bi-eye me-2"></i>JournalEntry Details</h5></div>
<div class="card-body">
<dl class="row mb-0"><dt class="col-sm-4">DocumentNumber</dt><dd class="col-sm-8">@(Model.Entry.DocumentNumber)</dd><dt class="col-sm-4">EntryDate</dt><dd class="col-sm-8">@(Model.Entry.EntryDate)</dd><dt class="col-sm-4">Account</dt><dd class="col-sm-8">@(Model.Entry.Account)</dd><dt class="col-sm-4">Debit</dt><dd class="col-sm-8">@(Model.Entry.Debit)</dd><dt class="col-sm-4">Credit</dt><dd class="col-sm-8">@(Model.Entry.Credit)</dd><dt class="col-sm-4">Reference</dt><dd class="col-sm-8">@(Model.Entry.Reference)</dd></dl>
</div>
<div class="card-footer">
<a href="/FI/Ledger/List" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
<a href="/FI/Ledger/Edit?id=@(Model.Entry.Id)" class="btn btn-warning"><i class="bi bi-pencil me-1"></i>Edit</a>
</div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

