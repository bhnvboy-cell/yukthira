@page
@model YuktiraERP.Web.Pages.FI.Ledger.DisplayModel
@using YuktiraERP.Infrastructure.Data.Entities
@{ ViewData["Title"] = "Journal Entry Details"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><i class="bi bi-eye me-2"></i>Journal Entry Details</h3>
            <span class="badge">@Model.Entry.DocumentNumber</span>
        </div>
        <div class="actions">
            <a asp-page="/FI/Ledger/Edit" asp-route-id="@Model.Entry.Id" class="zqm-btn" style="background:#ff9800;border-color:#ff9800"><i class="bi bi-pencil me-1"></i>Edit</a>
            <a asp-page="/FI/Ledger/List" class="zqm-btn zqm-btn-back"><i class="bi bi-arrow-left me-1"></i>Back</a>
        </div>
    </div>

    <div class="zqm-results">
        <div class="zqm-results-header"><h4>General Information</h4></div>
        <div style="padding:16px">
            <div class="zqm-row cols-3">
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Document Number</label><div class="zqm-ro" style="font-weight:600;color:#1565c0">@Model.Entry.DocumentNumber</div></div>
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Entry Date</label><div class="zqm-ro">@Model.Entry.EntryDate.ToString("yyyy-MM-dd")</div></div>
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Account</label><div class="zqm-ro" style="font-weight:600">@Model.Entry.Account</div></div>
            </div>
            <div class="zqm-row cols-3" style="margin-top:8px">
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Debit</label><div class="zqm-ro" style="font-weight:600">@(Model.Entry.Debit?.ToString("C2") ?? "--")</div></div>
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Credit</label><div class="zqm-ro" style="font-weight:600">@(Model.Entry.Credit?.ToString("C2") ?? "--")</div></div>
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Reference</label><div class="zqm-ro">@Model.Entry.Reference</div></div>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
