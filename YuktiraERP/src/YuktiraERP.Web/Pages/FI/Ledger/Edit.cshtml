@page
@model YuktiraERP.Web.Pages.FI.Ledger.EditModel
@{ ViewData["Title"] = "Edit JournalEntry"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-warning text-dark"><h5 class="mb-0"><i class="bi bi-pencil me-2"></i>Edit JournalEntry</h5></div>
<div class="card-body">
<form method="post">
<input type="hidden" asp-for="Entry.Id" />
<div class="row mb-3"><div class="col-md-6"><label asp-for="Entry.DocumentNumber" class="form-label"></label><input asp-for="Entry.DocumentNumber" class="form-control" type="text" /></div><div class="col-md-6"><label asp-for="Entry.EntryDate" class="form-label"></label><input asp-for="Entry.EntryDate" class="form-control" type="datetime-local" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="Entry.Account" class="form-label"></label><input asp-for="Entry.Account" class="form-control" type="text" /></div><div class="col-md-6"><label asp-for="Entry.Debit" class="form-label"></label><input asp-for="Entry.Debit" class="form-control" type="number" step="0.01" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="Entry.Credit" class="form-label"></label><input asp-for="Entry.Credit" class="form-control" type="number" step="0.01" /></div><div class="col-md-6"><label asp-for="Entry.Reference" class="form-label"></label><input asp-for="Entry.Reference" class="form-control" type="text" /></div></div>
<div class="d-flex gap-2"><button type="submit" class="btn btn-warning"><i class="bi bi-save me-1"></i>Update</button><a href="/FI/Ledger/List" class="btn btn-outline-secondary"><i class="bi bi-x me-1"></i>Cancel</a></div>
</form>
</div></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

