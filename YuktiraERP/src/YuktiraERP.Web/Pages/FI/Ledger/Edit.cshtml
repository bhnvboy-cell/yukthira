@page
@model YuktiraERP.Web.Pages.FI.Ledger.EditModel
@{ ViewData["Title"] = "Edit Journal Entry"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><i class="bi bi-pencil me-2"></i>Edit Journal Entry</h3>
            <span class="badge">@Model.Entry.DocumentNumber</span>
        </div>
        <div class="actions">
            <button type="submit" form="editForm" class="zqm-btn" style="background:#4caf50;border-color:#4caf50"><i class="bi bi-check-circle me-1"></i>Update Entry</button>
            <a asp-page="/FI/Ledger/List" class="zqm-btn zqm-btn-back"><i class="bi bi-arrow-left me-1"></i>Back to List</a>
        </div>
    </div>

    <div class="zqm-filter">
        <form method="post" id="editForm">
            <input type="hidden" asp-for="Entry.Id" />
            <div class="zqm-section-title"><i class="bi bi-journal-text me-1"></i>Journal Entry Data</div>
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Document Number</label><input asp-for="Entry.DocumentNumber" /></div>
                <div class="zqm-field"><label>Entry Date</label><input asp-for="Entry.EntryDate" type="date" /></div>
                <div class="zqm-field"><label>Account <span style="color:#c62828">*</span></label><input asp-for="Entry.Account" required /></div>
            </div>
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Debit</label><input asp-for="Entry.Debit" type="number" step="0.01" min="0" /></div>
                <div class="zqm-field"><label>Credit</label><input asp-for="Entry.Credit" type="number" step="0.01" min="0" /></div>
                <div class="zqm-field"><label>Reference</label><input asp-for="Entry.Reference" /></div>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
