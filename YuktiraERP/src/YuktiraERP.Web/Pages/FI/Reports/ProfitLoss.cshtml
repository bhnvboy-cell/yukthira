@page
@model YuktiraERP.Web.Pages.FI.Reports.ProfitLossModel
@{ ViewData["Title"] = "Profit & Loss (F.02)"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><i class="bi bi-file-earmark-bar-graph me-2"></i>Profit & Loss Statement</h3>
            <span class="badge">F.02</span>
        </div>
        <div class="actions">
            <a asp-page="/FI/Index" class="zqm-btn zqm-btn-back"><i class="bi bi-arrow-left me-1"></i>Back</a>
        </div>
    </div>

    <div class="zqm-filter">
        <form method="get">
            <div class="zqm-section-title"><i class="bi bi-calendar me-1"></i>Report Period</div>
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Period</label><input type="month" name="Period" value="@Model.Period" /></div>
                <div class="zqm-field" style="display:flex;align-items:flex-end"><button type="submit" class="zqm-btn" style="background:#1565c0;border-color:#1565c0;height:34px"><i class="bi bi-search me-1"></i>Generate Report</button></div>
                <div></div>
            </div>
        </form>
    </div>

    <div class="zqm-results">
        <div class="zqm-results-header"><h4>Profit & Loss — @Model.Period</h4></div>
        <div style="padding:20px">
            <div class="zqm-alert info" style="display:block"><i class="bi bi-info-circle me-1"></i>Profit & Loss statement will be available after period-end posting. Data for @Model.Period is not yet finalized.</div>
        </div>
    </div>
</div>
