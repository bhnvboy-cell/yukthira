@page
@model YuktiraERP.Web.Pages.FI.AR.PaymentModel
@{ ViewData["Title"] = "AR Payment (F-28)"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><i class="bi bi-credit-card me-2"></i>Record AR Payment</h3>
            <span class="badge">F-28</span>
        </div>
        <div class="actions">
            <button type="submit" form="createForm" class="zqm-btn" style="background:#4caf50;border-color:#4caf50"><i class="bi bi-check-circle me-1"></i>Post Payment</button>
            <a asp-page="/FI/Index" class="zqm-btn zqm-btn-back"><i class="bi bi-arrow-left me-1"></i>Back</a>
        </div>
    </div>

    <div class="zqm-filter">
        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <div class="zqm-alert success" style="display:block"><i class="bi bi-check-circle me-1"></i>@Model.Message</div>
        }

        <form method="post" id="createForm">
            <div class="zqm-section-title"><i class="bi bi-person me-1"></i>Customer Information</div>
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Customer Name <span style="color:#c62828">*</span></label><input asp-for="CustomerName" required /></div>
                <div class="zqm-field"><label>Payment Amount <span style="color:#c62828">*</span></label><input asp-for="Amount" type="number" step="0.01" min="0" required /></div>
                <div class="zqm-field"><label>Payment Date <span style="color:#c62828">*</span></label><input asp-for="PaymentDate" type="date" required /></div>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
