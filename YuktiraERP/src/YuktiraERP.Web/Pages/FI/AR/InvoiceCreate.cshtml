@page
@model YuktiraERP.Web.Pages.FI.AR.InvoiceCreateModel
@{ ViewData["Title"] = "AR Invoice (FB70)"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><i class="bi bi-receipt-cutoff me-2"></i>AR Invoice</h3>
            <span class="badge">FB70 — Quick</span>
        </div>
        <div class="actions">
            <button type="submit" form="createForm" class="zqm-btn" style="background:#4caf50;border-color:#4caf50"><i class="bi bi-check-circle me-1"></i>Post Invoice</button>
            <a asp-page="/FI/Index" class="zqm-btn zqm-btn-back"><i class="bi bi-arrow-left me-1"></i>Back</a>
        </div>
    </div>

    <div class="zqm-filter">
        <form method="post" id="createForm">
            <div class="zqm-section-title"><i class="bi bi-receipt me-1"></i>Invoice Details</div>
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Customer Name <span style="color:#c62828">*</span></label><input asp-for="Entry.CustomerName" required /></div>
                <div class="zqm-field"><label>Amount <span style="color:#c62828">*</span></label><input asp-for="Entry.Amount" type="number" step="0.01" min="0" required /></div>
                <div class="zqm-field"><label>Received Amount</label><input asp-for="Entry.ReceivedAmount" type="number" step="0.01" value="0" /></div>
            </div>
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Invoice Date <span style="color:#c62828">*</span></label><input asp-for="Entry.Date" type="date" required /></div>
                <div class="zqm-field"><label>Status</label><select asp-for="Entry.Status"><option value="Open">Open</option><option value="Paid">Paid</option><option value="Cancelled">Cancelled</option></select></div>
                <div></div>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
