@page
@model YuktiraERP.Web.Pages.FI.AP.PaymentModel
@{ ViewData["Title"] = "AP Payment (F-03)"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><svg class="bi bi-credit-card me-2" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-credit-card"></use></svg>Record AP Payment</h3>
            <span class="badge">F-03</span>
        </div>
        <div class="actions">
            <button type="submit" form="createForm" class="zqm-btn" style="background:#4caf50;border-color:#4caf50"><svg class="bi bi-check-circle me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-check-circle"></use></svg>Post Payment</button>
            <a asp-page="/FI/Index" class="zqm-btn zqm-btn-back"><svg class="bi bi-arrow-left me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-arrow-left"></use></svg>Back</a>
        </div>
    </div>

    <div class="zqm-filter">
        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <div class="zqm-alert success" style="display:block"><svg class="bi bi-check-circle me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-check-circle"></use></svg>@Model.Message</div>
        }

        <form method="post" id="createForm">
            <div class="zqm-section-title"><svg class="bi bi-building me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-building"></use></svg>Vendor Information</div>
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Vendor Name <span style="color:#c62828">*</span></label><input asp-for="VendorName" required /></div>
                <div class="zqm-field"><label>Payment Amount <span style="color:#c62828">*</span></label><input asp-for="Amount" type="number" step="0.01" min="0" required /></div>
                <div class="zqm-field"><label>Payment Date <span style="color:#c62828">*</span></label><input asp-for="PaymentDate" type="date" required /></div>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
