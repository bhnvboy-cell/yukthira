@page
@model YuktiraERP.Web.Pages.FI.AP.CreateModel
@{ ViewData["Title"] = "Create Accounts Payable Entry"; }

<div class="ent-form-wrapper">
    <div class="ent-org-banner">
        <div class="banner-icon"><i class="bi bi-cash-stack"></i></div>
        <div class="banner-info">
            <h5>Create Accounts Payable Entry</h5>
            <span>FB60 — Enter Vendor Invoice</span>
        </div>
        <div class="banner-meta">
            Company Code: 1000<br />Fiscal Year: @DateTime.UtcNow.Year
        </div>
    </div>

    <form method="post">
        <input type="hidden" asp-for="Entry.Status" value="Open" />

        <div class="ent-form-tabs">
            <button type="button" class="ent-form-tab active" data-tab="invoice">
                <i class="bi bi-receipt tab-icon"></i> Invoice Header
            </button>
            <button type="button" class="ent-form-tab" data-tab="accounting">
                <i class="bi bi-journal-text tab-icon"></i> Accounting
            </button>
            <button type="button" class="ent-form-tab" data-tab="payment">
                <i class="bi bi-credit-card tab-icon"></i> Payment Terms
            </button>
        </div>

        <!-- ═══ TAB: Invoice Header ═══ -->
        <div class="ent-form-panel active" data-panel="invoice">
            <div class="ent-section">
                <div class="ent-section-header"><i class="bi bi-receipt"></i><h6>Invoice Information</h6></div>
                <div class="ent-field-grid cols-3">
                    <div class="ent-field">
                        <label>Document Number</label>
                        <input class="form-control" value="Auto-generated" readonly />
                    </div>
                    <div class="ent-field">
                        <label>Invoice Number</label>
                        <input type="text" class="form-control" placeholder="Vendor invoice #" />
                    </div>
                    <div class="ent-field">
                        <label>Invoice Date</label>
                        <input asp-for="Entry.Date" class="form-control" type="date" />
                    </div>
                </div>
            </div>
            <div class="ent-section">
                <div class="ent-section-header"><i class="bi bi-building"></i><h6>Vendor Information</h6></div>
                <div class="ent-field-grid cols-3">
                    <div class="ent-field">
                        <label>Vendor Name <span class="required">*</span></label>
                        <input asp-for="Entry.VendorName" class="form-control" placeholder="Vendor company name" />
                    </div>
                    <div class="ent-field">
                        <label>Vendor Code</label>
                        <input type="text" class="form-control" placeholder="e.g. V-001" />
                    </div>
                    <div class="ent-field">
                        <label>Purchase Order Ref</label>
                        <input type="text" class="form-control" placeholder="PO-2024-..." />
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══ TAB: Accounting ═══ -->
        <div class="ent-form-panel" data-panel="accounting">
            <div class="ent-section">
                <div class="ent-section-header"><i class="bi bi-calculator"></i><h6>Amounts & Currency</h6></div>
                <div class="ent-field-grid cols-3">
                    <div class="ent-field">
                        <label>Gross Amount <span class="required">*</span></label>
                        <input asp-for="Entry.Amount" class="form-control" min="0" step="0.01" placeholder="0.00" />
                    </div>
                    <div class="ent-field">
                        <label>Paid Amount</label>
                        <input asp-for="Entry.PaidAmount" class="form-control" min="0" step="0.01" value="0" />
                    </div>
                    <div class="ent-field">
                        <label>Currency</label>
                        <select class="form-select">
                            <option value="USD">USD — US Dollar</option>
                            <option value="INR">INR — Indian Rupee</option>
                            <option value="EUR">EUR — Euro</option>
                            <option value="GBP">GBP — British Pound</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="ent-section">
                <div class="ent-section-header"><i class="bi bi-journal-text"></i><h6>GL Account Assignment</h6></div>
                <div class="ent-field-grid cols-3">
                    <div class="ent-field">
                        <label>G/L Account (Expense)</label>
                        <select class="form-select">
                            <option value="">-- Select --</option>
                            <option value="500000">500000 — Material Expense</option>
                            <option value="510000">510000 — MRO Expense</option>
                            <option value="520000">520000 — Services</option>
                            <option value="600000">600000 — Overhead</option>
                        </select>
                    </div>
                    <div class="ent-field">
                        <label>Cost Center</label>
                        <select class="form-select">
                            <option value="">-- Select --</option>
                            <option value="CC-1000">CC-1000 — Production</option>
                            <option value="CC-2000">CC-2000 — Administration</option>
                            <option value="CC-3000">CC-3000 — R&D</option>
                        </select>
                    </div>
                    <div class="ent-field">
                        <label>Tax Code</label>
                        <select class="form-select">
                            <option value="V0">V0 — Standard Tax</option>
                            <option value="V1">V1 — Reduced Tax</option>
                            <option value="V2">V2 — Zero Tax</option>
                            <option value="EX">EX — Exempt</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══ TAB: Payment Terms ═══ -->
        <div class="ent-form-panel" data-panel="payment">
            <div class="ent-section">
                <div class="ent-section-header"><i class="bi bi-credit-card"></i><h6>Payment Terms & Due</h6></div>
                <div class="ent-field-grid cols-3">
                    <div class="ent-field">
                        <label>Payment Terms</label>
                        <select class="form-select">
                            <option value="Net 30">Net 30</option>
                            <option value="Net 45">Net 45</option>
                            <option value="Net 60">Net 60</option>
                            <option value="Due on Receipt">Due on Receipt</option>
                        </select>
                    </div>
                    <div class="ent-field">
                        <label>Due Date</label>
                        <input type="date" class="form-control" />
                    </div>
                    <div class="ent-field">
                        <label>Payment Method</label>
                        <select class="form-select">
                            <option value="BT">Bank Transfer</option>
                            <option value="CH">Check</option>
                            <option value="DD">Direct Debit</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="ent-section">
                <div class="ent-section-header"><i class="bi bi-toggle-on"></i><h6>Status</h6></div>
                <div class="ent-field-grid cols-2">
                    <div class="ent-field">
                        <label>Entry Status</label>
                        <select asp-for="Entry.Status" class="form-select">
                            <option value="Open">Open</option>
                            <option value="Partially Paid">Partially Paid</option>
                            <option value="Paid">Paid</option>
                        </select>
                    </div>
                    <div class="ent-field">
                        <label>Reference / Note</label>
                        <input type="text" class="form-control" placeholder="Additional reference" />
                    </div>
                </div>
            </div>
        </div>

        <div class="ent-form-footer">
            <div class="footer-info">
                <i class="bi bi-shield-check me-1"></i>AP entries are SOX-audit logged
            </div>
            <div class="footer-actions">
                <a asp-page="/FI/Index" class="btn btn-outline-secondary"><i class="bi bi-x me-1"></i>Cancel</a>
                <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Save AP Entry</button>
            </div>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
