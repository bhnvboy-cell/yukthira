@page
@model YuktiraERP.Web.Pages.FI.AP.CreateModel
@{ ViewData["Title"] = "Create Accounts Payable Entry"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><i class="bi bi-cash-stack me-2"></i>New AP Entry</h3>
            <span class="badge">FB60</span>
        </div>
        <div class="actions">
            <button type="submit" form="createForm" class="zqm-btn" style="background:#4caf50;border-color:#4caf50"><i class="bi bi-check-circle me-1"></i>Save AP Entry</button>
            <button type="button" class="zqm-btn" onclick="document.getElementById('createForm').reset()"><i class="bi bi-x-circle me-1"></i>Clear</button>
            <a asp-page="/FI/Index" class="zqm-btn zqm-btn-back"><i class="bi bi-arrow-left me-1"></i>Back</a>
        </div>
    </div>

    <div class="zqm-filter">
        <form method="post" id="createForm">
            <input type="hidden" asp-for="Entry.Status" value="Open" />

            <div class="zqm-tabs" id="apTabs">
                <button type="button" class="zqm-tab-btn active" data-tab="tab-invoice"><i class="bi bi-receipt me-1"></i>Invoice Header</button>
                <button type="button" class="zqm-tab-btn" data-tab="tab-accounting"><i class="bi bi-journal-text me-1"></i>Accounting</button>
                <button type="button" class="zqm-tab-btn" data-tab="tab-payment"><i class="bi bi-credit-card me-1"></i>Payment Terms</button>
            </div>

            <!-- Tab: Invoice Header -->
            <div class="zqm-tab-panel active" id="tab-invoice" style="padding-top:12px">
                <div class="zqm-section-title"><i class="bi bi-receipt me-1"></i>Invoice Information</div>
                <div class="zqm-row cols-3">
                    <div class="zqm-field"><label>Document Number</label><div class="zqm-ro">Auto-generated</div></div>
                    <div class="zqm-field"><label>Invoice Number</label><input type="text" placeholder="Vendor invoice #" /></div>
                    <div class="zqm-field"><label>Invoice Date</label><input asp-for="Entry.Date" type="date" /></div>
                </div>
                <div class="zqm-section-title" style="margin-top:12px"><i class="bi bi-building me-1"></i>Vendor Information</div>
                <div class="zqm-row cols-3">
                    <div class="zqm-field"><label>Vendor Name <span style="color:#c62828">*</span></label><input asp-for="Entry.VendorName" placeholder="Vendor company name" required /></div>
                    <div class="zqm-field"><label>Vendor Code</label><input type="text" placeholder="e.g. V-001" /></div>
                    <div class="zqm-field"><label>Purchase Order Ref</label><input type="text" placeholder="PO-2024-..." /></div>
                </div>
            </div>

            <!-- Tab: Accounting -->
            <div class="zqm-tab-panel" id="tab-accounting" style="padding-top:12px">
                <div class="zqm-section-title"><i class="bi bi-calculator me-1"></i>Amounts & Currency</div>
                <div class="zqm-row cols-3">
                    <div class="zqm-field"><label>Gross Amount <span style="color:#c62828">*</span></label><input asp-for="Entry.Amount" min="0" step="0.01" placeholder="0.00" required /></div>
                    <div class="zqm-field"><label>Paid Amount</label><input asp-for="Entry.PaidAmount" min="0" step="0.01" value="0" /></div>
                    <div class="zqm-field"><label>Currency</label><select><option value="USD">USD - US Dollar</option><option value="INR">INR - Indian Rupee</option><option value="EUR">EUR - Euro</option><option value="GBP">GBP - British Pound</option></select></div>
                </div>
                <div class="zqm-section-title" style="margin-top:12px"><i class="bi bi-journal-text me-1"></i>GL Account Assignment</div>
                <div class="zqm-row cols-3">
                    <div class="zqm-field"><label>G/L Account (Expense)</label><select><option value="">-- Select --</option><option value="500000">500000 - Material Expense</option><option value="510000">510000 - MRO Expense</option><option value="520000">520000 - Services</option><option value="600000">600000 - Overhead</option></select></div>
                    <div class="zqm-field"><label>Cost Center</label><select><option value="">-- Select --</option><option value="CC-1000">CC-1000 - Production</option><option value="CC-2000">CC-2000 - Administration</option><option value="CC-3000">CC-3000 - R&D</option></select></div>
                    <div class="zqm-field"><label>Tax Code</label><select><option value="V0">V0 - Standard Tax</option><option value="V1">V1 - Reduced Tax</option><option value="V2">V2 - Zero Tax</option><option value="EX">EX - Exempt</option></select></div>
                </div>
            </div>

            <!-- Tab: Payment Terms -->
            <div class="zqm-tab-panel" id="tab-payment" style="padding-top:12px">
                <div class="zqm-section-title"><i class="bi bi-credit-card me-1"></i>Payment Terms & Due</div>
                <div class="zqm-row cols-3">
                    <div class="zqm-field"><label>Payment Terms</label><select><option value="Net 30">Net 30</option><option value="Net 45">Net 45</option><option value="Net 60">Net 60</option><option value="Due on Receipt">Due on Receipt</option></select></div>
                    <div class="zqm-field"><label>Due Date</label><input type="date" /></div>
                    <div class="zqm-field"><label>Payment Method</label><select><option value="BT">Bank Transfer</option><option value="CH">Check</option><option value="DD">Direct Debit</option></select></div>
                </div>
                <div class="zqm-section-title" style="margin-top:12px"><i class="bi bi-toggle-on me-1"></i>Status</div>
                <div class="zqm-row cols-2">
                    <div class="zqm-field"><label>Entry Status</label><select asp-for="Entry.Status"><option value="Open">Open</option><option value="Partially Paid">Partially Paid</option><option value="Paid">Paid</option></select></div>
                    <div class="zqm-field"><label>Reference / Note</label><input type="text" placeholder="Additional reference" /></div>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
document.querySelectorAll('#apTabs .zqm-tab-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
        document.querySelectorAll('#apTabs .zqm-tab-btn').forEach(function(b) { b.classList.remove('active'); });
        document.querySelectorAll('#createForm .zqm-tab-panel').forEach(function(p) { p.classList.remove('active'); });
        btn.classList.add('active');
        document.getElementById(btn.dataset.tab).classList.add('active');
    });
});
</script>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
