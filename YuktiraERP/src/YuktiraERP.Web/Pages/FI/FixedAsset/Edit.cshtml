@page
@model YuktiraERP.Web.Pages.FI.FixedAsset.EditModel
@{ ViewData["Title"] = "Edit Fixed Asset"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><svg class="bi bi-pencil me-2" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-pencil"></use></svg>Edit Fixed Asset</h3>
            <span class="badge">@Model.Asset.AssetCode</span>
        </div>
        <div class="actions">
            <button type="submit" form="editForm" class="zqm-btn" style="background:#4caf50;border-color:#4caf50"><svg class="bi bi-check-circle me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-check-circle"></use></svg>Update Asset</button>
            <a asp-page="/FI/FixedAsset/List" class="zqm-btn zqm-btn-back"><svg class="bi bi-arrow-left me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-arrow-left"></use></svg>Back to List</a>
        </div>
    </div>

    <div class="zqm-filter">
        <form method="post" id="editForm">
            <input type="hidden" asp-for="Asset.Id" />
            <div class="zqm-section-title"><svg class="bi bi-info-circle me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-info-circle"></use></svg>Asset Data</div>
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Asset Code</label><input asp-for="Asset.AssetCode" /></div>
                <div class="zqm-field" style="grid-column:span 2"><label>Asset Name</label><input asp-for="Asset.AssetName" /></div>
            </div>
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Category</label><input asp-for="Asset.Category" /></div>
                <div class="zqm-field"><label>Purchase Date</label><input asp-for="Asset.PurchaseDate" type="date" /></div>
                <div class="zqm-field"><label>Status</label><select asp-for="Asset.Status"><option value="Active">Active</option><option value="Under Maintenance">Under Maintenance</option><option value="Disposed">Disposed</option></select></div>
            </div>
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Acquisition Cost</label><input asp-for="Asset.Cost" type="number" step="0.01" min="0" /></div>
                <div class="zqm-field"><label>Salvage Value</label><input asp-for="Asset.SalvageValue" type="number" step="0.01" min="0" /></div>
                <div class="zqm-field"><label>Useful Life (Years)</label><input asp-for="Asset.UsefulLifeYears" type="number" min="1" max="50" /></div>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
