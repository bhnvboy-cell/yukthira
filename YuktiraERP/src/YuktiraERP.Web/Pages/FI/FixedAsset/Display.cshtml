@page
@model YuktiraERP.Web.Pages.FI.FixedAsset.DisplayModel
@using YuktiraERP.Infrastructure.Data.Entities
@{ ViewData["Title"] = "FixedAsset Details"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-info text-white"><h5 class="mb-0"><i class="bi bi-eye me-2"></i>FixedAsset Details</h5></div>
<div class="card-body">
<dl class="row mb-0"><dt class="col-sm-4">AssetCode</dt><dd class="col-sm-8">@(Model.Asset.AssetCode)</dd><dt class="col-sm-4">AssetName</dt><dd class="col-sm-8">@(Model.Asset.AssetName)</dd><dt class="col-sm-4">Category</dt><dd class="col-sm-8">@(Model.Asset.Category)</dd><dt class="col-sm-4">PurchaseDate</dt><dd class="col-sm-8">@(Model.Asset.PurchaseDate)</dd><dt class="col-sm-4">Cost</dt><dd class="col-sm-8">@(Model.Asset.Cost)</dd><dt class="col-sm-4">SalvageValue</dt><dd class="col-sm-8">@(Model.Asset.SalvageValue)</dd><dt class="col-sm-4">UsefulLifeYears</dt><dd class="col-sm-8">@(Model.Asset.UsefulLifeYears)</dd><dt class="col-sm-4">Status</dt><dd class="col-sm-8">@(Model.Asset.Status)</dd></dl>
</div>
<div class="card-footer">
<a href="/FI/FixedAsset/List" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
<a href="/FI/FixedAsset/Edit?id=@(Model.Asset.Id)" class="btn btn-warning"><i class="bi bi-pencil me-1"></i>Edit</a>
</div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

