@page
@model YuktiraERP.Web.Pages.FI.FixedAsset.DisplayModel
@using YuktiraERP.Infrastructure.Data.Entities
@{ ViewData["Title"] = "Fixed Asset Details"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><i class="bi bi-eye me-2"></i>Fixed Asset Details</h3>
            <span class="badge">@Model.Asset.AssetCode</span>
        </div>
        <div class="actions">
            <a asp-page="/FI/FixedAsset/Edit" asp-route-id="@Model.Asset.Id" class="zqm-btn" style="background:#ff9800;border-color:#ff9800"><i class="bi bi-pencil me-1"></i>Edit</a>
            <a asp-page="/FI/FixedAsset/List" class="zqm-btn zqm-btn-back"><i class="bi bi-arrow-left me-1"></i>Back</a>
        </div>
    </div>

    <div class="zqm-results">
        <div class="zqm-results-header"><h4>General Information</h4><span class="zqm-badge @(Model.Asset.Status=="Active"?"passed":"warning")">@Model.Asset.Status</span></div>
        <div style="padding:16px">
            <div class="zqm-row cols-3">
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Asset Code</label><div class="zqm-ro" style="font-weight:600;color:#1565c0">@Model.Asset.AssetCode</div></div>
                <div style="grid-column:span 2"><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Asset Name</label><div class="zqm-ro" style="font-weight:600">@Model.Asset.AssetName</div></div>
            </div>
            <div class="zqm-row cols-3" style="margin-top:8px">
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Category</label><div class="zqm-ro">@Model.Asset.Category</div></div>
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Purchase Date</label><div class="zqm-ro">@Model.Asset.PurchaseDate.ToString("yyyy-MM-dd")</div></div>
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Status</label><div class="zqm-ro"><span class="zqm-badge @(Model.Asset.Status=="Active"?"passed":"warning")">@Model.Asset.Status</span></div></div>
            </div>
            <div class="zqm-row cols-3" style="margin-top:8px">
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Acquisition Cost</label><div class="zqm-ro" style="font-weight:600;font-size:1rem">@Model.Asset.Cost.ToString("C0")</div></div>
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Salvage Value</label><div class="zqm-ro">@Model.Asset.SalvageValue.ToString("C0")</div></div>
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Useful Life (Years)</label><div class="zqm-ro">@Model.Asset.UsefulLifeYears</div></div>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
