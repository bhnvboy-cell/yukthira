@page
@model YuktiraERP.Web.Pages.SD.Customer.CreateModel
@{ ViewData["Title"] = "Create Customer Master"; }

<div class="ent-form-wrapper">
    <div class="ent-org-banner">
        <div class="banner-icon"><i class="bi bi-people"></i></div>
        <div class="banner-info">
            <h5>Create Customer Master</h5>
            <span>XD01 — Customer Master Data</span>
        </div>
        <div class="banner-meta">
            Sales Org: SO01<br />Company Code: 1000
        </div>
    </div>

    <form method="post">
        <input type="hidden" asp-for="Customer.Status" value="Active" />

        <div class="ent-form-tabs">
            <button type="button" class="ent-form-tab active" data-tab="general">
                <i class="bi bi-person-vcard tab-icon"></i> General Data
            </button>
            <button type="button" class="ent-form-tab" data-tab="sales">
                <i class="bi bi-graph-up tab-icon"></i> Sales Area
            </button>
            <button type="button" class="ent-form-tab" data-tab="finance">
                <i class="bi bi-calculator tab-icon"></i> Financial
            </button>
        </div>

        <!-- ═══ TAB: General Data ═══ -->
        <div class="ent-form-panel active" data-panel="general">
            <div class="ent-section">
                <div class="ent-section-header"><i class="bi bi-person"></i><h6>Customer Identification</h6></div>
                <div class="ent-field-grid cols-3">
                    <div class="ent-field">
                        <label>Customer Code</label>
                        <input asp-for="Customer.Code" class="form-control" placeholder="Auto-generated" />
                    </div>
                    <div class="ent-field" style="grid-column: span 2">
                        <label>Name <span class="required">*</span></label>
                        <input asp-for="Customer.Name" class="form-control" placeholder="Company name" required />
                    </div>
                </div>
            </div>
            <div class="ent-section">
                <div class="ent-section-header"><i class="bi bi-telephone"></i><h6>Contact & Address</h6></div>
                <div class="ent-field-grid cols-3">
                    <div class="ent-field">
                        <label>Phone</label>
                        <input asp-for="Customer.Phone" class="form-control" placeholder="+1 (555) 000-0000" />
                    </div>
                    <div class="ent-field">
                        <label>Email</label>
                        <input type="email" class="form-control" placeholder="contact@company.com" />
                    </div>
                    <div class="ent-field">
                        <label>Website</label>
                        <input type="url" class="form-control" placeholder="https://company.com" />
                    </div>
                </div>
                <div class="ent-field-grid cols-2" style="margin-top:0.75rem">
                    <div class="ent-field">
                        <label>Street Address</label>
                        <input type="text" class="form-control" placeholder="123 Main St" />
                    </div>
                    <div class="ent-field">
                        <label>City / State / ZIP</label>
                        <input type="text" class="form-control" placeholder="City, State 00000" />
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══ TAB: Sales Area ═══ -->
        <div class="ent-form-panel" data-panel="sales">
            <div class="ent-section">
                <div class="ent-section-header"><i class="bi bi-diagram-3"></i><h6>Sales Organization</h6></div>
                <div class="ent-field-grid cols-3">
                    <div class="ent-field">
                        <label>Sales Organization</label>
                        <select class="form-select">
                            <option value="SO01">SO01 — Domestic Sales</option>
                            <option value="SO02">SO02 — Export Sales</option>
                        </select>
                    </div>
                    <div class="ent-field">
                        <label>Distribution Channel</label>
                        <select class="form-select">
                            <option value="10">10 — Direct Sales</option>
                            <option value="20">20 — Wholesale</option>
                            <option value="30">30 — Retail</option>
                        </select>
                    </div>
                    <div class="ent-field">
                        <label>Division</label>
                        <select class="form-select">
                            <option value="01">01 — Main Division</option>
                            <option value="02">02 — Secondary</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="ent-section">
                <div class="ent-section-header"><i class="bi bi-truck"></i><h6>Shipping & Delivery</h6></div>
                <div class="ent-field-grid cols-3">
                    <div class="ent-field">
                        <label>Shipping Conditions</label>
                        <select class="form-select">
                            <option value="Standard">Standard</option>
                            <option value="Express">Express</option>
                            <option value="Economy">Economy</option>
                        </select>
                    </div>
                    <div class="ent-field">
                        <label>Delivery Priority</label>
                        <select class="form-select">
                            <option value="Normal">Normal</option>
                            <option value="High">High</option>
                            <option value="Urgent">Urgent</option>
                        </select>
                    </div>
                    <div class="ent-field">
                        <label>Incoterms</label>
                        <select class="form-select">
                            <option value="FOB">FOB</option>
                            <option value="CIF">CIF</option>
                            <option value="EXW">EXW</option>
                            <option value="DDP">DDP</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══ TAB: Financial ═══ -->
        <div class="ent-form-panel" data-panel="finance">
            <div class="ent-section">
                <div class="ent-section-header"><i class="bi bi-credit-card"></i><h6>Payment & Credit</h6></div>
                <div class="ent-field-grid cols-3">
                    <div class="ent-field">
                        <label>Payment Terms <span class="required">*</span></label>
                        <select asp-for="Customer.PaymentTerms" class="form-select">
                            <option value="Net 30">Net 30</option>
                            <option value="Net 45">Net 45</option>
                            <option value="Net 60">Net 60</option>
                            <option value="Net 90">Net 90</option>
                            <option value="Due on Receipt">Due on Receipt</option>
                            <option value="2/10 Net 30">2/10 Net 30</option>
                        </select>
                    </div>
                    <div class="ent-field">
                        <label>Credit Limit</label>
                        <input asp-for="Customer.CreditLimit" class="form-control" min="0" step="0.01" placeholder="0.00" />
                    </div>
                    <div class="ent-field">
                        <label>Reconciliation Account</label>
                        <select class="form-select">
                            <option value="113100">113100 — AR Trade</option>
                            <option value="113200">113200 — AR Intercompany</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="ent-section">
                <div class="ent-section-header"><i class="bi bi-receipt"></i><h6>Tax & Risk</h6></div>
                <div class="ent-field-grid cols-3">
                    <div class="ent-field">
                        <label>Tax Classification</label>
                        <select class="form-select">
                            <option value="TAXABLE">Taxable</option>
                            <option value="EXEMPT">Tax Exempt</option>
                            <option value="ZERO">Zero Rated</option>
                        </select>
                    </div>
                    <div class="ent-field">
                        <label>Credit Rating</label>
                        <select class="form-select">
                            <option value="A">A — Excellent</option>
                            <option value="B">B — Good</option>
                            <option value="C">C — Fair</option>
                            <option value="D">D — Risk</option>
                        </select>
                    </div>
                    <div class="ent-field">
                        <label>Customer Status</label>
                        <select asp-for="Customer.Status" class="form-select">
                            <option value="Active">Active</option>
                            <option value="Credit Hold">Credit Hold</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="ent-form-footer">
            <div class="footer-info">
                <i class="bi bi-shield-check me-1"></i>All changes are SOX-audit logged
            </div>
            <div class="footer-actions">
                <a asp-page="/SD/Index" class="btn btn-outline-secondary"><i class="bi bi-x me-1"></i>Cancel</a>
                <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Save Customer</button>
            </div>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
