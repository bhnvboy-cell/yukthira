@page
@model YuktiraERP.Web.Pages.SD.Customer.EditModel
@{ ViewData["Title"] = "Edit Customer"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><i class="bi bi-pencil me-2"></i>Edit Customer</h3>
            <span class="badge">@Model.Customer.Code</span>
        </div>
        <div class="actions">
            <button type="submit" form="editForm" class="zqm-btn" style="background:#4caf50;border-color:#4caf50"><i class="bi bi-check-circle me-1"></i>Update Customer</button>
            <a asp-page="/SD/Customer/List" class="zqm-btn zqm-btn-back"><i class="bi bi-arrow-left me-1"></i>Back to List</a>
        </div>
    </div>

    <div class="zqm-filter">
        <div class="zqm-section-title"><i class="bi bi-person me-1"></i>Customer Data</div>
        <form method="post" id="editForm">
            <input type="hidden" asp-for="Customer.Id" />
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Customer Code</label><input asp-for="Customer.Code" /></div>
                <div class="zqm-field" style="grid-column:span 2"><label>Customer Name</label><input asp-for="Customer.Name" /></div>
            </div>
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Phone</label><input asp-for="Customer.Phone" /></div>
                <div class="zqm-field"><label>Credit Limit</label><input asp-for="Customer.CreditLimit" type="number" step="0.01" /></div>
                <div class="zqm-field"><label>Payment Terms</label><input asp-for="Customer.PaymentTerms" /></div>
            </div>
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Status</label><select asp-for="Customer.Status"><option value="Active">Active</option><option value="Credit Hold">Credit Hold</option><option value="Inactive">Inactive</option></select></div>
                <div></div><div></div>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
