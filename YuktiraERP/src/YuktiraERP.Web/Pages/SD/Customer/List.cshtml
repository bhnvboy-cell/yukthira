@page
@model YuktiraERP.Web.Pages.SD.Customer.ListModel
@using YuktiraERP.Infrastructure.Data.Entities
@{ ViewData["Title"] = "Customer List"; }
<div class="d-flex justify-content-between align-items-center mb-3">
<h2><i class="bi bi-people me-2"></i>Customers</h2>
<div>
<button type="button" class="btn btn-outline-secondary btn-sm me-2" onclick="document.querySelectorAll('.inline-edit-col').forEach(c=>c.style.display=c.style.display==='none'?'':'none')" title="Toggle inline editing"><i class="bi bi-pencil-square me-1"></i>Inline Edit</button>
<a asp-page="/SD/Customer/Create" class="btn btn-primary"><i class="bi bi-plus me-1"></i>New Customer</a>
</div>
</div>
<div class="card"><div class="card-body">
<div class="table-responsive">
<table class="table table-hover table-sm datatable" id="customerTable">
<thead><tr><th>Code</th><th>Name</th><th class="inline-edit-col" style="display:none">Credit Limit</th><th class="inline-edit-col" style="display:none">Payment Terms</th><th>Phone</th><th>Status</th><th>Actions</th></tr></thead>
<tbody>
@foreach (var c in Model.Customers)
{
<tr data-id="@c.Id" data-entity="CustomerEntity" data-module="SD">
<td>@c.Code</td>
<td data-field="Name">@c.Name</td>
<td class="inline-edit-col" style="display:none" data-field="CreditLimit" data-type="number">@c.CreditLimit.ToString("C2")</td>
<td class="inline-edit-col" style="display:none" data-field="PaymentTerms">@c.PaymentTerms</td>
<td data-field="Phone">@c.Phone</td>
<td><span class="badge bg-@(c.Status=="Active"?"success":"secondary")">@c.Status</span></td>
<td class="actions-cell">
<a asp-page="/SD/Customer/Edit" asp-route-id="@c.Id" class="bi bi-pencil me-2 text-decoration-none text-warning"></a>
<a asp-page="/SD/Customer/Display" asp-route-id="@c.Id" class="bi bi-eye text-decoration-none text-info"></a>
</td>
</tr>
}
</tbody></table>
</div></div></div>
@section Scripts {
<script src="~/js/inline-edit.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    InlineEdit.initTable(document.getElementById('customerTable'));
});
</script>
}
