@page
@model YuktiraERP.Web.Pages.SD.Customer.ListModel
@{ ViewData["Title"] = "Customer List"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><i class="bi bi-people me-2"></i>Customer List</h3>
            <span class="badge">@Model.Customers.Count records</span>
        </div>
        <div class="actions">
            <a asp-page="/SD/Customer/Create" class="zqm-btn" style="background:#4caf50;border-color:#4caf50"><i class="bi bi-plus-circle me-1"></i>New Customer</a>
            <a asp-page="/SD/Index" class="zqm-btn zqm-btn-back"><i class="bi bi-arrow-left me-1"></i>Back</a>
        </div>
    </div>

    <div class="zqm-filter">
        <div class="zqm-section-title"><i class="bi bi-funnel me-1"></i>Search</div>
        <div class="zqm-row cols-3">
            <div class="zqm-field"><label>Customer Code</label><input id="searchCode" placeholder="Filter by code..." oninput="filterTable()" /></div>
            <div class="zqm-field"><label>Customer Name</label><input id="searchName" placeholder="Filter by name..." oninput="filterTable()" /></div>
            <div class="zqm-field"><label>Status</label><select id="searchStatus" onchange="filterTable()"><option value="">All</option><option value="Active">Active</option><option value="Inactive">Inactive</option><option value="Credit Hold">Credit Hold</option></select></div>
        </div>
    </div>

    <div class="zqm-results">
        <div class="zqm-results-header"><h4>Customers</h4><span class="count" id="resultCount">@Model.Customers.Count items</span></div>
        <div class="zqm-table-wrap">
            <table class="zqm-table" id="customerTable">
                <thead><tr><th>Code</th><th>Name</th><th>Credit Limit</th><th>Payment Terms</th><th>Phone</th><th>Status</th><th>Actions</th></tr></thead>
                <tbody>
                    @foreach (var c in Model.Customers)
                    {
                        <tr data-code="@c.Code" data-name="@c.Name" data-status="@c.Status">
                            <td style="font-weight:600;color:#1565c0">@c.Code</td>
                            <td>@c.Name</td>
                            <td>@c.CreditLimit.ToString("C2")</td>
                            <td>@c.PaymentTerms</td>
                            <td>@c.Phone</td>
                            <td><span class="zqm-badge @(c.Status=="Active"?"passed":c.Status=="Credit Hold"?"warning":"closed")">@c.Status</span></td>
                            <td>
                                <a asp-page="/SD/Customer/Display" asp-route-id="@c.Id" class="zqm-act" title="View"><i class="bi bi-eye"></i></a>
                                <a asp-page="/SD/Customer/Edit" asp-route-id="@c.Id" class="zqm-act" title="Edit"><i class="bi bi-pencil"></i></a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Customers.Any()) { <tr><td colspan="7" class="zqm-empty"><i class="bi bi-inbox"></i><div>No customers found</div></td></tr> }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
function filterTable() {
    var code = document.getElementById('searchCode').value.toLowerCase();
    var name = document.getElementById('searchName').value.toLowerCase();
    var status = document.getElementById('searchStatus').value;
    var rows = document.querySelectorAll('#customerTable tbody tr[data-code]');
    var count = 0;
    rows.forEach(function(r) {
        var match = (!code || r.dataset.code.toLowerCase().indexOf(code) > -1) &&
                    (!name || r.dataset.name.toLowerCase().indexOf(name) > -1) &&
                    (!status || r.dataset.status === status);
        r.style.display = match ? '' : 'none';
        if (match) count++;
    });
    document.getElementById('resultCount').textContent = count + ' items';
}
</script>
