@page
@model YuktiraERP.Web.Pages.SD.Customer.DisplayModel
@{ ViewData["Title"] = "Customer Details"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><i class="bi bi-eye me-2"></i>Customer Details</h3>
            <span class="badge">@Model.Customer.Code</span>
        </div>
        <div class="actions">
            <a asp-page="/SD/Customer/Edit" asp-route-id="@Model.Customer.Id" class="zqm-btn" style="background:#ff9800;border-color:#ff9800"><i class="bi bi-pencil me-1"></i>Edit</a>
            <a asp-page="/SD/Customer/List" class="zqm-btn zqm-btn-back"><i class="bi bi-arrow-left me-1"></i>Back</a>
        </div>
    </div>

    <div class="zqm-results">
        <div class="zqm-results-header"><h4>General Information</h4></div>
        <div style="padding:16px">
            <div class="zqm-row cols-3">
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Customer Code</label><div class="zqm-ro" style="font-weight:600;color:#1565c0">@Model.Customer.Code</div></div>
                <div style="grid-column:span 2"><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Customer Name</label><div class="zqm-ro" style="font-weight:600">@Model.Customer.Name</div></div>
            </div>
            <div class="zqm-row cols-3" style="margin-top:8px">
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Phone</label><div class="zqm-ro">@Model.Customer.Phone</div></div>
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Credit Limit</label><div class="zqm-ro" style="font-weight:600">@Model.Customer.CreditLimit.ToString("C2")</div></div>
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Payment Terms</label><div class="zqm-ro">@Model.Customer.PaymentTerms</div></div>
            </div>
            <div class="zqm-row cols-3" style="margin-top:8px">
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Status</label><div class="zqm-ro"><span class="zqm-badge @(Model.Customer.Status=="Active"?"passed":Model.Customer.Status=="Credit Hold"?"warning":"closed")">@Model.Customer.Status</span></div></div>
                <div></div><div></div>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
