@page
@model YuktiraERP.Web.Pages.SD.Billing.EditModel
@{ ViewData["Title"] = "Edit Billing Document"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><i class="bi bi-pencil me-2"></i>Edit Billing Document</h3>
            <span class="badge">@Model.Invoice.DocumentNumber</span>
        </div>
        <div class="actions">
            <button type="submit" form="editForm" class="zqm-btn" style="background:#4caf50;border-color:#4caf50"><i class="bi bi-check-circle me-1"></i>Update</button>
            <a asp-page="/SD/Billing/List" class="zqm-btn zqm-btn-back"><i class="bi bi-arrow-left me-1"></i>Back to List</a>
        </div>
    </div>

    <div class="zqm-filter">
        <div class="zqm-section-title"><i class="bi bi-receipt me-1"></i>Billing Data</div>
        <form method="post" id="editForm">
            <input type="hidden" asp-for="Invoice.Id" />
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Document Number</label><input asp-for="Invoice.DocumentNumber" /></div>
                <div class="zqm-field"><label>SO Number</label><input asp-for="Invoice.SoNumber" /></div>
                <div class="zqm-field"><label>Date</label><input asp-for="Invoice.Date" type="datetime-local" /></div>
            </div>
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Customer Name</label><input asp-for="Invoice.CustomerName" /></div>
                <div class="zqm-field"><label>Amount</label><input asp-for="Invoice.Amount" type="number" step="0.01" /></div>
                <div class="zqm-field"><label>Status</label><select asp-for="Invoice.Status"><option value="Unpaid">Unpaid</option><option value="Paid">Paid</option><option value="Overdue">Overdue</option></select></div>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
