@page
@model YuktiraERP.Web.Pages.SD.Billing.ListModel
@{ ViewData["Title"] = "Billing Documents"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><svg class="bi bi-list-ul me-2" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-list-ul"></use></svg>Billing Documents</h3>
            <span class="badge">@Model.Items.Count records</span>
        </div>
        <div class="actions">
            <a asp-page="/SD/Billing/Create" class="zqm-btn" style="background:#4caf50;border-color:#4caf50"><svg class="bi bi-plus-circle me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-plus-circle"></use></svg>New Billing Document</a>
            <a asp-page="/SD/Index" class="zqm-btn zqm-btn-back"><svg class="bi bi-arrow-left me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-arrow-left"></use></svg>Back</a>
        </div>
    </div>

    <div class="zqm-filter">
        <div class="zqm-section-title"><svg class="bi bi-funnel me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-funnel"></use></svg>Search</div>
        <div class="zqm-row cols-3">
            <div class="zqm-field"><label>Billing #</label><input id="searchNumber" placeholder="Filter by number..." oninput="filterTable()" /></div>
            <div class="zqm-field"><label>Customer</label><input id="searchCustomer" placeholder="Filter by customer..." oninput="filterTable()" /></div>
            <div class="zqm-field"><label>Status</label><select id="searchStatus" onchange="filterTable()"><option value="">All</option><option value="Unpaid">Unpaid</option><option value="Paid">Paid</option><option value="Overdue">Overdue</option></select></div>
        </div>
    </div>

    <div class="zqm-results">
        <div class="zqm-results-header"><h4>Billing Documents</h4><span class="count" id="resultCount">@Model.Items.Count items</span></div>
        <div class="zqm-table-wrap">
            <table class="zqm-table" id="billingTable">
                <thead><tr><th>Billing #</th><th>Date</th><th>SO Reference</th><th>Customer</th><th>Amount</th><th>Status</th><th>Actions</th></tr></thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr data-number="@item.DocumentNumber" data-customer="@item.CustomerName" data-status="@item.Status">
                            <td style="font-weight:600;color:#1565c0">@item.DocumentNumber</td>
                            <td>@item.Date.ToString("yyyy-MM-dd")</td>
                            <td>@item.SoNumber</td>
                            <td>@item.CustomerName</td>
                            <td>@item.Amount.ToString("C2")</td>
                            <td><span class="zqm-badge @(item.Status=="Paid"?"passed":item.Status=="Overdue"?"failed":"info")">@item.Status</span></td>
                            <td>
                                <a href="/SD/Billing/Display?id=@item.Id" class="zqm-act" title="View"><svg class="bi bi-eye" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-eye"></use></svg></a>
                                <a href="/SD/Billing/Edit?id=@item.Id" class="zqm-act" title="Edit"><svg class="bi bi-pencil" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-pencil"></use></svg></a>
                                <form method="post" asp-page-handler="Delete" style="display:inline" onsubmit="return confirm('Delete this record?')">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="zqm-act" style="color:#c62828;border-color:#ffcdd2" title="Delete"><svg class="bi bi-trash" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-trash"></use></svg></button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Items.Any()) { <tr><td colspan="7" class="zqm-empty"><svg class="bi bi-inbox" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-inbox"></use></svg><div>No billing documents found</div></td></tr> }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
function filterTable() {
    var num = document.getElementById('searchNumber').value.toLowerCase();
    var cust = document.getElementById('searchCustomer').value.toLowerCase();
    var status = document.getElementById('searchStatus').value;
    var rows = document.querySelectorAll('#billingTable tbody tr[data-number]');
    var count = 0;
    rows.forEach(function(r) {
        var match = (!num || r.dataset.number.toLowerCase().indexOf(num) > -1) &&
                    (!cust || r.dataset.customer.toLowerCase().indexOf(cust) > -1) &&
                    (!status || r.dataset.status === status);
        r.style.display = match ? '' : 'none';
        if (match) count++;
    });
    document.getElementById('resultCount').textContent = count + ' items';
}
</script>
