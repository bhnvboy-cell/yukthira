@page
@model YuktiraERP.Web.Pages.SD.Billing.CreateModel
@{ ViewData["Title"] = "New Billing Document"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><svg class="bi bi-plus-circle me-2" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-plus-circle"></use></svg>New Billing Document</h3>
            <span class="badge">Manual</span>
        </div>
        <div class="actions">
            <button type="submit" form="createForm" class="zqm-btn" style="background:#4caf50;border-color:#4caf50"><svg class="bi bi-check-circle me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-check-circle"></use></svg>Save</button>
            <button type="button" class="zqm-btn" onclick="document.getElementById('createForm').reset()"><svg class="bi bi-x-circle me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-x-circle"></use></svg>Clear</button>
            <a asp-page="/SD/Billing/List" class="zqm-btn zqm-btn-back"><svg class="bi bi-arrow-left me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-arrow-left"></use></svg>Back</a>
        </div>
    </div>

    <div class="zqm-filter">
        <div class="zqm-section-title"><svg class="bi bi-receipt me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-receipt"></use></svg>Billing Header</div>
        <form method="post" id="createForm">
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>SO Number <span style="color:#c62828">*</span></label><input asp-for="Invoice.SoNumber" placeholder="SO-2024-..." required /></div>
                <div class="zqm-field"><label>Customer Name <span style="color:#c62828">*</span></label><input asp-for="Invoice.CustomerName" placeholder="Customer name" required /></div>
                <div class="zqm-field"><label>Date</label><input asp-for="Invoice.Date" type="date" /></div>
            </div>
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Amount <span style="color:#c62828">*</span></label><input asp-for="Invoice.Amount" type="number" step="0.01" min="0" placeholder="0.00" required /></div>
                <div class="zqm-field"><label>Status</label><select asp-for="Invoice.Status"><option value="Unpaid">Unpaid</option><option value="Paid">Paid</option><option value="Overdue">Overdue</option></select></div>
                <div></div>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
