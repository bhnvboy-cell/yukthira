@page
@model YuktiraERP.Web.Pages.SD.SalesOrder.EditModel
@{ ViewData["Title"] = "Edit Sales Order"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><i class="bi bi-pencil me-2"></i>Edit Sales Order</h3>
            <span class="badge">@Model.Order.OrderNumber</span>
        </div>
        <div class="actions">
            <button type="submit" form="editForm" class="zqm-btn" style="background:#4caf50;border-color:#4caf50"><i class="bi bi-check-circle me-1"></i>Update</button>
            <a asp-page="/SD/SalesOrder/List" class="zqm-btn zqm-btn-back"><i class="bi bi-arrow-left me-1"></i>Back to List</a>
        </div>
    </div>

    <div class="zqm-filter">
        <div class="zqm-section-title"><i class="bi bi-file-text me-1"></i>Sales Order Data</div>
        <form method="post" id="editForm">
            <input type="hidden" asp-for="Order.Id" />
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Order Number</label><input asp-for="Order.OrderNumber" /></div>
                <div class="zqm-field"><label>Customer Name</label><input asp-for="Order.CustomerName" /></div>
                <div class="zqm-field"><label>Order Date</label><input asp-for="Order.OrderDate" type="date" /></div>
            </div>
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Item Count</label><input asp-for="Order.ItemCount" type="number" /></div>
                <div class="zqm-field"><label>Amount</label><input asp-for="Order.Amount" type="number" step="0.01" /></div>
                <div class="zqm-field"><label>Status</label><select asp-for="Order.Status"><option value="Draft">Draft</option><option value="Confirmed">Confirmed</option><option value="Pending">Pending</option><option value="In Production">In Production</option><option value="Shipped">Shipped</option><option value="Completed">Completed</option><option value="Cancelled">Cancelled</option></select></div>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
