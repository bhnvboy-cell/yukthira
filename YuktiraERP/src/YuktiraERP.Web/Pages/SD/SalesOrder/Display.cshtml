@page
@model YuktiraERP.Web.Pages.SD.SalesOrder.DisplayModel
@{ ViewData["Title"] = "Sales Order Details"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><i class="bi bi-eye me-2"></i>Sales Order Details</h3>
            <span class="badge">@Model.Order.OrderNumber</span>
        </div>
        <div class="actions">
            <a asp-page="/SD/SalesOrder/Edit" asp-route-id="@Model.Order.Id" class="zqm-btn" style="background:#ff9800;border-color:#ff9800"><i class="bi bi-pencil me-1"></i>Edit</a>
            <a asp-page="/SD/SalesOrder/List" class="zqm-btn zqm-btn-back"><i class="bi bi-arrow-left me-1"></i>Back</a>
        </div>
    </div>

    <div class="zqm-results">
        <div class="zqm-results-header"><h4>Order Information</h4></div>
        <div style="padding:16px">
            <div class="zqm-row cols-3">
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Order Number</label><div class="zqm-ro" style="font-weight:600;color:#1565c0">@Model.Order.OrderNumber</div></div>
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Customer</label><div class="zqm-ro" style="font-weight:600">@Model.Order.CustomerName</div></div>
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Order Date</label><div class="zqm-ro">@Model.Order.OrderDate.ToString("yyyy-MM-dd")</div></div>
            </div>
            <div class="zqm-row cols-3" style="margin-top:8px">
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Items</label><div class="zqm-ro" style="font-weight:600">@Model.Order.ItemCount</div></div>
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Amount</label><div class="zqm-ro" style="font-weight:700;font-size:1.05rem">@Model.Order.Amount.ToString("C2")</div></div>
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Status</label><div class="zqm-ro"><span class="zqm-badge @(Model.Order.Status=="Completed"?"passed":Model.Order.Status=="Confirmed"||Model.Order.Status=="Pending"?"info":Model.Order.Status=="Cancelled"?"failed":"warning")">@Model.Order.Status</span></div></div>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
