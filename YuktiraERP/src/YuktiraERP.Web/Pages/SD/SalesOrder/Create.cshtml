@page
@model YuktiraERP.Web.Pages.SD.SalesOrder.CreateModel
@{ ViewData["Title"] = "Create Sales Order"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><i class="bi bi-receipt me-2"></i>Create Sales Order</h3>
            <span class="badge">VA01</span>
        </div>
        <div class="actions">
            <button type="submit" form="createForm" class="zqm-btn" style="background:#4caf50;border-color:#4caf50"><i class="bi bi-check-circle me-1"></i>Save Sales Order</button>
            <button type="button" class="zqm-btn" onclick="document.getElementById('createForm').reset()"><i class="bi bi-x-circle me-1"></i>Clear</button>
            <a asp-page="/SD/Index" class="zqm-btn zqm-btn-back"><i class="bi bi-arrow-left me-1"></i>Back</a>
        </div>
    </div>

    <div class="zqm-filter">
        <form method="post" id="createForm">
            <input type="hidden" asp-for="Order.Status" value="Pending" />

            <div class="zqm-tabs" id="soTabs">
                <button type="button" class="zqm-tab-btn active" data-tab="tab-header"><i class="bi bi-person me-1"></i>Sold-To / Header</button>
                <button type="button" class="zqm-tab-btn" data-tab="tab-items"><i class="bi bi-list-ul me-1"></i>Items <span class="zqm-badge info" style="margin-left:4px" id="lineCountBadge">0</span></button>
                <button type="button" class="zqm-tab-btn" data-tab="tab-org"><i class="bi bi-diagram-3 me-1"></i>Organization</button>
            </div>

            <!-- Tab: Header -->
            <div class="zqm-tab-panel active" id="tab-header" style="padding-top:12px">
                <div class="zqm-section-title"><i class="bi bi-person me-1"></i>Customer Information</div>
                <div class="zqm-row cols-3">
                    <div class="zqm-field"><label>Order Number</label><input value="Auto-generated" readonly style="background:#f0f0f0" /></div>
                    <div class="zqm-field"><label>Order Date</label><input asp-for="Order.OrderDate" type="date" /></div>
                    <div class="zqm-field"><label>Sold-To Party <span style="color:#c62828">*</span></label><input asp-for="Order.CustomerName" placeholder="Customer name or code" required /></div>
                </div>
                <div class="zqm-section-title" style="margin-top:12px"><i class="bi bi-geo-alt me-1"></i>Ship-To & Bill-To</div>
                <div class="zqm-row cols-3">
                    <div class="zqm-field"><label>Ship-To Party</label><input type="text" placeholder="Ship-to address" /></div>
                    <div class="zqm-field"><label>Bill-To Party</label><input type="text" placeholder="Bill-to address" /></div>
                    <div class="zqm-field"><label>Payment Terms</label><select><option value="Net 30">Net 30</option><option value="Net 45">Net 45</option><option value="Net 60">Net 60</option><option value="Due on Receipt">Due on Receipt</option><option value="2/10 Net 30">2/10 Net 30</option></select></div>
                </div>
            </div>

            <!-- Tab: Items -->
            <div class="zqm-tab-panel" id="tab-items" style="padding-top:12px">
                <div class="zqm-section-title"><i class="bi bi-list-ul me-1"></i>Sales Order Items</div>
                <div class="zqm-table-wrap">
                    <table class="zqm-table" id="soLineTable">
                        <thead>
                            <tr><th>#</th><th>Material</th><th>Description</th><th>Plant</th><th>SLOC</th><th>Qty</th><th>UOM</th><th>Unit Price</th><th>Line Total</th><th></th></tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.LineItems.Count; i++)
                            {
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td><input asp-for="LineItems[i].MaterialName" style="width:100%;padding:5px 8px;border:1px solid #ccc;border-radius:3px;font-size:0.82rem" placeholder="MAT-001" class="line-material" /></td>
                                    <td><input type="text" style="width:100%;padding:5px 8px;border:1px solid #ccc;border-radius:3px;font-size:0.82rem" placeholder="Description" /></td>
                                    <td><input type="text" style="width:100%;padding:5px 8px;border:1px solid #ccc;border-radius:3px;font-size:0.82rem" value="1000" /></td>
                                    <td><input type="text" style="width:100%;padding:5px 8px;border:1px solid #ccc;border-radius:3px;font-size:0.82rem" value="SL01" /></td>
                                    <td><input asp-for="LineItems[i].Quantity" type="number" step="0.01" min="0" style="width:100%;padding:5px 8px;border:1px solid #ccc;border-radius:3px;font-size:0.82rem" class="line-qty" /></td>
                                    <td><select asp-for="LineItems[i].UOM" style="width:100%;padding:5px 8px;border:1px solid #ccc;border-radius:3px;font-size:0.82rem"><option>EA</option><option>KG</option><option>LB</option><option>M</option><option>L</option></select></td>
                                    <td><input asp-for="LineItems[i].UnitPrice" type="number" step="0.01" min="0" style="width:100%;padding:5px 8px;border:1px solid #ccc;border-radius:3px;font-size:0.82rem" class="line-price" /></td>
                                    <td class="line-total" style="font-weight:600">0.00</td>
                                    <td><button type="button" class="zqm-act" style="color:#c62828;border-color:#ffcdd2" onclick="this.closest('tr').remove()"><i class="bi bi-x"></i></button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div style="margin-top:8px;display:flex;justify-content:space-between;align-items:center">
                    <button type="button" class="zqm-btn" onclick="addLine()"><i class="bi bi-plus me-1"></i>Add Line</button>
                    <div style="font-size:0.82rem;color:#666">Lines: <span class="line-count">0</span> &nbsp;|&nbsp; Net Value: <strong class="grand-total">0.00</strong></div>
                </div>
            </div>

            <!-- Tab: Organization -->
            <div class="zqm-tab-panel" id="tab-org" style="padding-top:12px">
                <div class="zqm-section-title"><i class="bi bi-diagram-3 me-1"></i>Sales Area</div>
                <div class="zqm-row cols-3">
                    <div class="zqm-field"><label>Sales Organization</label><select><option value="SO01">SO01 - Domestic Sales</option><option value="SO02">SO02 - Export Sales</option></select></div>
                    <div class="zqm-field"><label>Distribution Channel</label><select><option value="10">10 - Direct Sales</option><option value="20">20 - Wholesale</option><option value="30">30 - Retail</option><option value="40">40 - E-Commerce</option></select></div>
                    <div class="zqm-field"><label>Division</label><select><option value="01">01 - Main Division</option><option value="02">02 - Secondary</option></select></div>
                </div>
                <div class="zqm-section-title" style="margin-top:12px"><i class="bi bi-truck me-1"></i>Shipping & Delivery</div>
                <div class="zqm-row cols-3">
                    <div class="zqm-field"><label>Incoterms</label><select><option value="FOB">FOB - Free on Board</option><option value="CIF">CIF - Cost, Insurance & Freight</option><option value="EXW">EXW - Ex Works</option><option value="DDP">DDP - Delivered Duty Paid</option></select></div>
                    <div class="zqm-field"><label>Shipping Point</label><select><option value="SP01">SP01 - Main Warehouse</option><option value="SP02">SP02 - Dock 1</option></select></div>
                    <div class="zqm-field"><label>Delivery Priority</label><select><option value="Normal">Normal</option><option value="High">High</option><option value="Urgent">Urgent</option></select></div>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
document.querySelectorAll('#soTabs .zqm-tab-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
        document.querySelectorAll('#soTabs .zqm-tab-btn').forEach(function(b) { b.classList.remove('active'); });
        document.querySelectorAll('#createForm .zqm-tab-panel').forEach(function(p) { p.classList.remove('active'); });
        btn.classList.add('active');
        document.getElementById(btn.dataset.tab).classList.add('active');
    });
});

function addLine() {
    var tbody = document.querySelector('#soLineTable tbody');
    var idx = tbody.rows.length;
    var s = 'padding:5px 8px;border:1px solid #ccc;border-radius:3px;font-size:0.82rem;width:100%';
    var row = '<tr><td>' + (idx+1) + '</td>' +
        '<td><input name="LineItems['+idx+'].MaterialName" style="'+s+'" class="line-material" /></td>' +
        '<td><input type="text" style="'+s+'" /></td>' +
        '<td><input type="text" style="'+s+'" value="1000" /></td>' +
        '<td><input type="text" style="'+s+'" value="SL01" /></td>' +
        '<td><input name="LineItems['+idx+'].Quantity" type="number" step="0.01" min="0" style="'+s+'" class="line-qty" /></td>' +
        '<td><select name="LineItems['+idx+'].UOM" style="'+s+'"><option>EA</option><option>KG</option><option>LB</option><option>M</option><option>L</option></select></td>' +
        '<td><input name="LineItems['+idx+'].UnitPrice" type="number" step="0.01" min="0" style="'+s+'" class="line-price" /></td>' +
        '<td class="line-total" style="font-weight:600">0.00</td>' +
        '<td><button type="button" class="zqm-act" style="color:#c62828;border-color:#ffcdd2" onclick="this.closest(\'tr\').remove()"><i class="bi bi-x"></i></button></td></tr>';
    tbody.insertAdjacentHTML('beforeend', row);
    updateCounts();
}

function updateCounts() {
    var rows = document.querySelectorAll('#soLineTable tbody tr');
    document.getElementById('lineCountBadge').textContent = rows.length;
    document.querySelector('.line-count').textContent = rows.length;
    var total = 0;
    rows.forEach(function(r) {
        var qty = parseFloat(r.querySelector('.line-qty')?.value) || 0;
        var price = parseFloat(r.querySelector('.line-price')?.value) || 0;
        var lineTotal = qty * price;
        r.querySelector('.line-total').textContent = lineTotal.toFixed(2);
        total += lineTotal;
    });
    document.querySelector('.grand-total').textContent = total.toFixed(2);
}

document.addEventListener('input', function(e) {
    if (e.target.classList.contains('line-qty') || e.target.classList.contains('line-price')) {
        updateCounts();
    }
});
updateCounts();
</script>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
