@page
@model YuktiraERP.Web.Pages.SD.Inquiry.EditModel
@{ ViewData["Title"] = "Edit Inquiry"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-warning text-dark"><h5 class="mb-0"><i class="bi bi-pencil me-2"></i>Edit Inquiry</h5></div>
<div class="card-body">
<form method="post">
<input type="hidden" asp-for="Inquiry.Id" />
<div class="row mb-3"><div class="col-md-6"><label asp-for="Inquiry.InquiryNumber" class="form-label"></label><input asp-for="Inquiry.InquiryNumber" class="form-control" type="text" /></div><div class="col-md-6"><label asp-for="Inquiry.Date" class="form-label"></label><input asp-for="Inquiry.Date" class="form-control" type="datetime-local" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="Inquiry.CustomerName" class="form-label"></label><input asp-for="Inquiry.CustomerName" class="form-control" type="text" /></div><div class="col-md-6"><label asp-for="Inquiry.Description" class="form-label"></label><input asp-for="Inquiry.Description" class="form-control" type="text" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="Inquiry.Status" class="form-label"></label><input asp-for="Inquiry.Status" class="form-control" type="text" /></div><div class="col-md-6"></div></div>
<div class="d-flex gap-2"><button type="submit" class="btn btn-warning"><i class="bi bi-save me-1"></i>Update</button><a href="/SD/Inquiry/List" class="btn btn-outline-secondary"><i class="bi bi-x me-1"></i>Cancel</a></div>
</form>
</div></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

