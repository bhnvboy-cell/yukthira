@page
@model YuktiraERP.Web.Pages.SD.Quotation.EditModel
@{ ViewData["Title"] = "Edit Quotation"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><i class="bi bi-pencil me-2"></i>Edit Quotation</h3>
            <span class="badge">@Model.Quote.QuoteNumber</span>
        </div>
        <div class="actions">
            <button type="submit" form="editForm" class="zqm-btn" style="background:#4caf50;border-color:#4caf50"><i class="bi bi-check-circle me-1"></i>Update</button>
            <a asp-page="/SD/Quotation/List" class="zqm-btn zqm-btn-back"><i class="bi bi-arrow-left me-1"></i>Back to List</a>
        </div>
    </div>

    <div class="zqm-filter">
        <div class="zqm-section-title"><i class="bi bi-file-earmark-text me-1"></i>Quotation Data</div>
        <form method="post" id="editForm">
            <input type="hidden" asp-for="Quote.Id" />
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Quote Number</label><input asp-for="Quote.QuoteNumber" /></div>
                <div class="zqm-field"><label>Date</label><input asp-for="Quote.Date" type="datetime-local" /></div>
                <div class="zqm-field"><label>Valid Until</label><input asp-for="Quote.ValidUntil" type="datetime-local" /></div>
            </div>
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Customer Name</label><input asp-for="Quote.CustomerName" /></div>
                <div class="zqm-field"><label>Amount</label><input asp-for="Quote.Amount" type="number" step="0.01" /></div>
                <div class="zqm-field"><label>Status</label><select asp-for="Quote.Status"><option value="Draft">Draft</option><option value="Sent">Sent</option><option value="Accepted">Accepted</option><option value="Rejected">Rejected</option><option value="Expired">Expired</option></select></div>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
