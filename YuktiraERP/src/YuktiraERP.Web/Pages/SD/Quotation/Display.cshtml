@page
@model YuktiraERP.Web.Pages.SD.Quotation.DisplayModel
@{ ViewData["Title"] = "Quotation Details"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><i class="bi bi-eye me-2"></i>Quotation Details</h3>
            <span class="badge">@Model.Quote.QuoteNumber</span>
        </div>
        <div class="actions">
            <a href="/SD/Quotation/Edit?id=@Model.Quote.Id" class="zqm-btn" style="background:#ff9800;border-color:#ff9800"><i class="bi bi-pencil me-1"></i>Edit</a>
            <a asp-page="/SD/Quotation/List" class="zqm-btn zqm-btn-back"><i class="bi bi-arrow-left me-1"></i>Back</a>
        </div>
    </div>

    <div class="zqm-results">
        <div class="zqm-results-header"><h4>Quotation Information</h4></div>
        <div style="padding:16px">
            <div class="zqm-row cols-3">
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Quote Number</label><div class="zqm-ro" style="font-weight:600;color:#1565c0">@Model.Quote.QuoteNumber</div></div>
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Customer</label><div class="zqm-ro" style="font-weight:600">@Model.Quote.CustomerName</div></div>
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Date</label><div class="zqm-ro">@Model.Quote.Date.ToString("yyyy-MM-dd")</div></div>
            </div>
            <div class="zqm-row cols-3" style="margin-top:8px">
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Amount</label><div class="zqm-ro" style="font-weight:700;font-size:1.05rem">@Model.Quote.Amount.ToString("C2")</div></div>
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Valid Until</label><div class="zqm-ro">@Model.Quote.ValidUntil.ToString("yyyy-MM-dd")</div></div>
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Status</label><div class="zqm-ro"><span class="zqm-badge @(Model.Quote.Status=="Draft"||Model.Quote.Status=="Sent"?"info":Model.Quote.Status=="Accepted"?"passed":Model.Quote.Status=="Rejected"?"failed":"closed")">@Model.Quote.Status</span></div></div>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
