@page
@model YuktiraERP.Web.Pages.SD.Quotation.DisplayModel
@using YuktiraERP.Infrastructure.Data.Entities
@{ ViewData["Title"] = "Quotation Details"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-info text-white"><h5 class="mb-0"><i class="bi bi-eye me-2"></i>Quotation Details</h5></div>
<div class="card-body">
<dl class="row mb-0"><dt class="col-sm-4">QuoteNumber</dt><dd class="col-sm-8">@(Model.Quote.QuoteNumber)</dd><dt class="col-sm-4">Date</dt><dd class="col-sm-8">@(Model.Quote.Date)</dd><dt class="col-sm-4">CustomerName</dt><dd class="col-sm-8">@(Model.Quote.CustomerName)</dd><dt class="col-sm-4">Amount</dt><dd class="col-sm-8">@(Model.Quote.Amount)</dd><dt class="col-sm-4">ValidUntil</dt><dd class="col-sm-8">@(Model.Quote.ValidUntil)</dd><dt class="col-sm-4">Status</dt><dd class="col-sm-8">@(Model.Quote.Status)</dd></dl>
</div>
<div class="card-footer">
<a href="/SD/Quotation/List" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
<a href="/SD/Quotation/Edit?id=@(Model.Quote.Id)" class="btn btn-warning"><i class="bi bi-pencil me-1"></i>Edit</a>
</div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

