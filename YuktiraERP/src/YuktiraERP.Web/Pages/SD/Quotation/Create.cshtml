@page
@model YuktiraERP.Web.Pages.SD.Quotation.CreateModel
@{ ViewData["Title"] = "New Quotation"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><i class="bi bi-plus-circle me-2"></i>New Quotation</h3>
            <span class="badge">Manual</span>
        </div>
        <div class="actions">
            <button type="submit" form="createForm" class="zqm-btn" style="background:#4caf50;border-color:#4caf50"><i class="bi bi-check-circle me-1"></i>Save</button>
            <button type="button" class="zqm-btn" onclick="document.getElementById('createForm').reset()"><i class="bi bi-x-circle me-1"></i>Clear</button>
            <a asp-page="/SD/Quotation/List" class="zqm-btn zqm-btn-back"><i class="bi bi-arrow-left me-1"></i>Back</a>
        </div>
    </div>

    <div class="zqm-filter">
        <div class="zqm-section-title"><i class="bi bi-file-earmark-text me-1"></i>Quotation Header</div>
        <form method="post" id="createForm">
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Customer Name <span style="color:#c62828">*</span></label><input asp-for="Quote.CustomerName" placeholder="Customer name" required /></div>
                <div class="zqm-field"><label>Date</label><input asp-for="Quote.Date" type="date" /></div>
                <div class="zqm-field"><label>Valid Until</label><input asp-for="Quote.ValidUntil" type="date" /></div>
            </div>
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Amount <span style="color:#c62828">*</span></label><input asp-for="Quote.Amount" type="number" step="0.01" min="0" placeholder="0.00" required /></div>
                <div class="zqm-field"><label>Status</label><select asp-for="Quote.Status"><option value="Draft">Draft</option><option value="Sent">Sent</option><option value="Accepted">Accepted</option><option value="Rejected">Rejected</option></select></div>
                <div></div>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
