@page
@model YuktiraERP.Web.Pages.SD.IndexModel
@using YuktiraERP.Web.ViewModels
@{
    ViewData["Title"] = "Sales & Distribution";

    var allCustomers = Model.Customers;
    var allOrders = Model.SalesOrders;
    var allInquiries = Model.Inquiries;
    var allQuotations = Model.Quotations;
    var allDeliveries = Model.Deliveries;
    var allBilling = Model.BillingDocuments;

    var vm = new ModuleLayoutViewModel
    {
        ModuleTitle = "Sales & Distribution",
        ModuleCode = "SD",
        Kpis = new List<KpiCard>
        {
            new() { Label = "Customers", Value = allCustomers.Count.ToString(), Subtext = "Registered accounts", Type = "blue" },
            new() { Label = "Inquiries", Value = allInquiries.Count.ToString(), Subtext = "Open inquiries", Type = "teal" },
            new() { Label = "Quotations", Value = allQuotations.Count.ToString(), Subtext = "Sent to customers", Type = "amber" },
            new() { Label = "Sales Orders", Value = allOrders.Count.ToString(), Subtext = "Active orders", Type = "green" },
            new() { Label = "Deliveries", Value = allDeliveries.Count.ToString(), Subtext = "In transit", Type = "purple" },
            new() { Label = "Billing Docs", Value = allBilling.Count.ToString(), Subtext = "Invoices & credits", Type = "red" }
        },
        Tabs = new List<TabItem>
        {
            new() { Key = "customers", Label = "Customers", Count = allCustomers.Count,
                PrimaryAction = new PrimaryAction { Label = "Create Customer", Href = "/SD/Customer/Create", Icon = "bi-plus-lg" } },
            new() { Key = "inquiries", Label = "Inquiries", Count = allInquiries.Count,
                PrimaryAction = new PrimaryAction { Label = "Create Inquiry", Href = "/SD/Inquiry/Create", Icon = "bi-plus-lg" } },
            new() { Key = "quotations", Label = "Quotations", Count = allQuotations.Count,
                PrimaryAction = new PrimaryAction { Label = "Create Quotation", Href = "/SD/Quotation/Create", Icon = "bi-plus-lg" } },
            new() { Key = "salesorders", Label = "Sales Orders", Count = allOrders.Count,
                PrimaryAction = new PrimaryAction { Label = "Create Sales Order", Href = "/SD/SalesOrder/Create", Icon = "bi-plus-lg" } },
            new() { Key = "deliveries", Label = "Deliveries", Count = allDeliveries.Count,
                PrimaryAction = new PrimaryAction { Label = "Create Delivery", Href = "/SD/Delivery/Create", Icon = "bi-plus-lg" } },
            new() { Key = "billing", Label = "Billing", Count = allBilling.Count,
                PrimaryAction = new PrimaryAction { Label = "Create Billing Document", Href = "/SD/Billing/Create", Icon = "bi-plus-lg" } }
        },
        ActiveTab = "customers",
        GridTabs = new List<GridTab>
        {
            new()
            {
                Key = "customers",
                Columns = new List<GridColumn>
                {
                    new() { Key = "code", Label = "Customer #", Align = "left" },
                    new() { Key = "name", Label = "Name", Align = "left" },
                    new() { Key = "creditLimit", Label = "Credit Limit", Type = "currency", Align = "right" },
                    new() { Key = "paymentTerms", Label = "Payment Terms", Align = "center" },
                    new() { Key = "phone", Label = "Phone", Align = "left" },
                    new() { Key = "status", Label = "Status", Type = "status", Align = "center" }
                },
                Rows = allCustomers.Select(c => new Dictionary<string, string?>
                {
                    { "id", c.Id.ToString() },
                    { "code", c.Code },
                    { "name", c.Name },
                    { "creditLimit", c.CreditLimit.ToString() },
                    { "paymentTerms", c.PaymentTerms },
                    { "phone", c.Phone },
                    { "status", c.Status }
                }).ToList(),
                ViewHref = r => $"/SD/Customer/Display?id={r["id"]}",
                EditHref = r => $"/SD/Customer/Edit?id={r["id"]}"
            },
            new()
            {
                Key = "inquiries",
                Columns = new List<GridColumn>
                {
                    new() { Key = "inquiryNumber", Label = "Inquiry #", Align = "left" },
                    new() { Key = "customerName", Label = "Customer", Align = "left" },
                    new() { Key = "description", Label = "Description", Align = "left" },
                    new() { Key = "status", Label = "Status", Type = "status", Align = "center" },
                    new() { Key = "date", Label = "Date", Type = "date", Align = "left" }
                },
                Rows = allInquiries.Select(i => new Dictionary<string, string?>
                {
                    { "id", i.Id.ToString() },
                    { "inquiryNumber", i.InquiryNumber },
                    { "customerName", i.CustomerName },
                    { "description", i.Description },
                    { "status", i.Status },
                    { "date", i.Date.ToString("yyyy-MM-dd") }
                }).ToList(),
                ViewHref = r => $"/SD/Inquiry/Display?id={r["id"]}",
                EditHref = r => $"/SD/Inquiry/Edit?id={r["id"]}"
            },
            new()
            {
                Key = "quotations",
                Columns = new List<GridColumn>
                {
                    new() { Key = "quoteNumber", Label = "Quotation #", Align = "left" },
                    new() { Key = "customerName", Label = "Customer", Align = "left" },
                    new() { Key = "amount", Label = "Amount", Type = "currency", Align = "right" },
                    new() { Key = "validUntil", Label = "Valid Until", Type = "date", Align = "left" },
                    new() { Key = "status", Label = "Status", Type = "status", Align = "center" },
                    new() { Key = "date", Label = "Date", Type = "date", Align = "left" }
                },
                Rows = allQuotations.Select(q => new Dictionary<string, string?>
                {
                    { "id", q.Id.ToString() },
                    { "quoteNumber", q.QuoteNumber },
                    { "customerName", q.CustomerName },
                    { "amount", q.Amount.ToString() },
                    { "validUntil", q.ValidUntil.ToString("yyyy-MM-dd") },
                    { "status", q.Status },
                    { "date", q.Date.ToString("yyyy-MM-dd") }
                }).ToList(),
                ViewHref = r => $"/SD/Quotation/Display?id={r["id"]}",
                EditHref = r => $"/SD/Quotation/Edit?id={r["id"]}"
            },
            new()
            {
                Key = "salesorders",
                Columns = new List<GridColumn>
                {
                    new() { Key = "orderNumber", Label = "SO Number", Align = "left" },
                    new() { Key = "customerName", Label = "Customer", Align = "left" },
                    new() { Key = "itemCount", Label = "Items", Align = "right" },
                    new() { Key = "amount", Label = "Amount", Type = "currency", Align = "right" },
                    new() { Key = "status", Label = "Status", Type = "status", Align = "center" },
                    new() { Key = "orderDate", Label = "Order Date", Type = "date", Align = "left" }
                },
                Rows = allOrders.Select(o => new Dictionary<string, string?>
                {
                    { "id", o.Id.ToString() },
                    { "orderNumber", o.OrderNumber },
                    { "customerName", o.CustomerName },
                    { "itemCount", o.ItemCount.ToString() },
                    { "amount", o.Amount.ToString() },
                    { "status", o.Status },
                    { "orderDate", o.OrderDate.ToString("yyyy-MM-dd") }
                }).ToList(),
                ViewHref = r => $"/SD/SalesOrder/Display?id={r["id"]}",
                EditHref = r => $"/SD/SalesOrder/Edit?id={r["id"]}"
            },
            new()
            {
                Key = "deliveries",
                Columns = new List<GridColumn>
                {
                    new() { Key = "deliveryNumber", Label = "Delivery #", Align = "left" },
                    new() { Key = "soNumber", Label = "SO Reference", Align = "left" },
                    new() { Key = "customerName", Label = "Customer", Align = "left" },
                    new() { Key = "status", Label = "Status", Type = "status", Align = "center" },
                    new() { Key = "date", Label = "Date", Type = "date", Align = "left" }
                },
                Rows = allDeliveries.Select(d => new Dictionary<string, string?>
                {
                    { "id", d.Id.ToString() },
                    { "deliveryNumber", d.DeliveryNumber },
                    { "soNumber", d.SoNumber },
                    { "customerName", d.CustomerName },
                    { "status", d.Status },
                    { "date", d.Date.ToString("yyyy-MM-dd") }
                }).ToList(),
                ViewHref = r => $"/SD/Delivery/Display?id={r["id"]}",
                EditHref = r => $"/SD/Delivery/Edit?id={r["id"]}"
            },
            new()
            {
                Key = "billing",
                Columns = new List<GridColumn>
                {
                    new() { Key = "documentNumber", Label = "Billing #", Align = "left" },
                    new() { Key = "soNumber", Label = "SO Reference", Align = "left" },
                    new() { Key = "customerName", Label = "Customer", Align = "left" },
                    new() { Key = "amount", Label = "Amount", Type = "currency", Align = "right" },
                    new() { Key = "status", Label = "Status", Type = "status", Align = "center" },
                    new() { Key = "date", Label = "Date", Type = "date", Align = "left" }
                },
                Rows = allBilling.Select(b => new Dictionary<string, string?>
                {
                    { "id", b.Id.ToString() },
                    { "documentNumber", b.DocumentNumber },
                    { "soNumber", b.SoNumber },
                    { "customerName", b.CustomerName },
                    { "amount", b.Amount.ToString() },
                    { "status", b.Status },
                    { "date", b.Date.ToString("yyyy-MM-dd") }
                }).ToList(),
                ViewHref = r => $"/SD/Billing/Display?id={r["id"]}",
                EditHref = r => $"/SD/Billing/Edit?id={r["id"]}"
            }
        }
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/module-layout.css" asp-append-version="true" />
}

<partial name="_ModuleLayout" model="vm" />

@section Scripts {
    <script src="~/js/module-layout.js" asp-append-version="true"></script>
}
