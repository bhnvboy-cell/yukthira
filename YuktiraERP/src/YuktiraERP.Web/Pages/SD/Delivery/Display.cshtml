@page
@model YuktiraERP.Web.Pages.SD.Delivery.DisplayModel
@using YuktiraERP.Infrastructure.Data.Entities
@{ ViewData["Title"] = "Delivery Details"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-info text-white"><h5 class="mb-0"><i class="bi bi-eye me-2"></i>Delivery Details</h5></div>
<div class="card-body">
<dl class="row mb-0"><dt class="col-sm-4">DeliveryNumber</dt><dd class="col-sm-8">@(Model.Delivery.DeliveryNumber)</dd><dt class="col-sm-4">Date</dt><dd class="col-sm-8">@(Model.Delivery.Date)</dd><dt class="col-sm-4">SoNumber</dt><dd class="col-sm-8">@(Model.Delivery.SoNumber)</dd><dt class="col-sm-4">CustomerName</dt><dd class="col-sm-8">@(Model.Delivery.CustomerName)</dd><dt class="col-sm-4">Status</dt><dd class="col-sm-8">@(Model.Delivery.Status)</dd></dl>
</div>
<div class="card-footer">
<a href="/SD/Delivery/List" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
<a href="/SD/Delivery/Edit?id=@(Model.Delivery.Id)" class="btn btn-warning"><i class="bi bi-pencil me-1"></i>Edit</a>
</div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

