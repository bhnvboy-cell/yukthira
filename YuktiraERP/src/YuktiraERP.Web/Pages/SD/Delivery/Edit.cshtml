@page
@model YuktiraERP.Web.Pages.SD.Delivery.EditModel
@{ ViewData["Title"] = "Edit Delivery"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><i class="bi bi-pencil me-2"></i>Edit Delivery</h3>
            <span class="badge">@Model.Delivery.DeliveryNumber</span>
        </div>
        <div class="actions">
            <button type="submit" form="editForm" class="zqm-btn" style="background:#4caf50;border-color:#4caf50"><i class="bi bi-check-circle me-1"></i>Update</button>
            <a asp-page="/SD/Delivery/List" class="zqm-btn zqm-btn-back"><i class="bi bi-arrow-left me-1"></i>Back to List</a>
        </div>
    </div>

    <div class="zqm-filter">
        <div class="zqm-section-title"><i class="bi bi-truck me-1"></i>Delivery Data</div>
        <form method="post" id="editForm">
            <input type="hidden" asp-for="Delivery.Id" />
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Delivery Number</label><input asp-for="Delivery.DeliveryNumber" /></div>
                <div class="zqm-field"><label>SO Number</label><input asp-for="Delivery.SoNumber" /></div>
                <div class="zqm-field"><label>Date</label><input asp-for="Delivery.Date" type="datetime-local" /></div>
            </div>
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Customer Name</label><input asp-for="Delivery.CustomerName" /></div>
                <div class="zqm-field"><label>Status</label><select asp-for="Delivery.Status"><option value="Picked">Picked</option><option value="Packed">Packed</option><option value="Shipped">Shipped</option><option value="Delivered">Delivered</option></select></div>
                <div></div>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
