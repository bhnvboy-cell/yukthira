@page
@model YuktiraERP.Web.Pages.QM.UsageDecision.EditModel
@{ ViewData["Title"] = "Edit UsageDecision"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-warning text-dark"><h5 class="mb-0"><i class="bi bi-pencil me-2"></i>Edit UsageDecision</h5></div>
<div class="card-body">
<form method="post">
<input type="hidden" asp-for="Decision.Id" />
<div class="row mb-3"><div class="col-md-6"><label asp-for="Decision.DecisionId" class="form-label"></label><input asp-for="Decision.DecisionId" class="form-control" type="text" /></div><div class="col-md-6"><label asp-for="Decision.LotNumber" class="form-label"></label><input asp-for="Decision.LotNumber" class="form-control" type="text" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="Decision.MaterialName" class="form-label"></label><input asp-for="Decision.MaterialName" class="form-control" type="text" /></div><div class="col-md-6"><label asp-for="Decision.Decision" class="form-label"></label><input asp-for="Decision.Decision" class="form-control" type="text" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="Decision.Notes" class="form-label"></label><input asp-for="Decision.Notes" class="form-control" type="text" /></div><div class="col-md-6"><label asp-for="Decision.DecisionDate" class="form-label"></label><input asp-for="Decision.DecisionDate" class="form-control" type="datetime-local" /></div></div>
<div class="d-flex gap-2"><button type="submit" class="btn btn-warning"><i class="bi bi-save me-1"></i>Update</button><a href="/QM/UsageDecision/List" class="btn btn-outline-secondary"><i class="bi bi-x me-1"></i>Cancel</a></div>
</form>
</div></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

