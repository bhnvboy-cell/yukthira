@page "{id:Guid}"
@model YuktiraERP.Web.Pages.QM.UsageDecision.DisplayModel
@{ ViewData["Title"] = "Usage Decision Details"; }
<link rel="stylesheet" href="~/css/enterprise-form.css" />
<div class="ent-form-wrapper">
    <div class="ent-form-header"><h3><svg class="bi bi-check2-circle me-2" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-check2-circle"></use></svg>Usage Decision Details</h3><span class="badge">QM</span></div>
    <div class="ent-form-tabs">
        <button type="button" class="ent-form-tab active" onclick="showTab(this,'tab-ref')"><svg class="bi bi-link tab-icon" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-link"></use></svg> Reference</button>
        <button type="button" class="ent-form-tab" onclick="showTab(this,'tab-decision')"><svg class="bi bi-hammer tab-icon" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-hammer"></use></svg> Decision</button>
    </div>
    <div class="ent-form-panel active" id="tab-ref">
        <div class="ent-section"><div class="ent-section-header"><svg class="bi bi-link" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-link"></use></svg> Reference Data</div>
            <div class="ent-field-grid ent-grid-3">
                <div class="ent-field"><label>Decision ID</label><div class="ent-readonly">@Model.Decision.DecisionId</div></div>
                <div class="ent-field"><label>Lot Number</label><div class="ent-readonly">@Model.Decision.LotNumber</div></div>
                <div class="ent-field"><label>Material</label><div class="ent-readonly">@Model.Decision.MaterialName</div></div>
            </div>
            <div class="ent-field-grid ent-grid-3">
                <div class="ent-field"><label>Inspector</label><div class="ent-readonly">@Model.Decision.InspectorID</div></div>
                <div class="ent-field"><label>Decision Date</label><div class="ent-readonly">@Model.Decision.DecisionDate.ToString("dd MMM yyyy")</div></div>
                <div class="ent-field"><label>Quality Score</label><div class="ent-readonly">@Model.Decision.QualityScore</div></div>
            </div>
        </div>
    </div>
    <div class="ent-form-panel" id="tab-decision">
        <div class="ent-section"><div class="ent-section-header"><svg class="bi bi-hammer" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-hammer"></use></svg> Decision Details</div>
            <div class="ent-field-grid ent-grid-3">
                <div class="ent-field"><label>UD Code</label><div class="ent-readonly"><span class="qm-badge @(Model.Decision.UDCode=="Accepted"?"success":Model.Decision.UDCode=="Rejected"?"rejected":"warning")">@Model.Decision.UDCode</span></div></div>
                <div class="ent-field"><label>Decision</label><div class="ent-readonly">@Model.Decision.Decision</div></div>
            </div>
            <div class="ent-field-grid ent-grid-3">
                <div class="ent-field"><label>Unrestricted</label><div class="ent-readonly">@Model.Decision.UnrestrictedStock</div></div>
                <div class="ent-field"><label>Blocked</label><div class="ent-readonly">@Model.Decision.BlockedStock</div></div>
                <div class="ent-field"><label>Scrap</label><div class="ent-readonly">@Model.Decision.ScrapQuantity</div></div>
            </div>
        </div>
    </div>
    <div class="ent-form-actions">
        <a asp-page="/QM/Index" class="ent-btn ent-btn-secondary"><svg class="bi bi-arrow-left me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-arrow-left"></use></svg> Back</a>
        <a asp-page="/QM/UsageDecision/Edit" asp-route-id="@Model.Decision.Id" class="ent-btn ent-btn-primary"><svg class="bi bi-pencil me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-pencil"></use></svg> Edit</a>
    </div>
</div>
