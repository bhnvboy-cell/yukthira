@page "{id:Guid}"
@model YuktiraERP.Web.Pages.QM.InspectionResult.DisplayModel
@{ ViewData["Title"] = "Inspection Result Details"; }
<link rel="stylesheet" href="~/css/enterprise-form.css" />
<div class="ent-form-wrapper">
    <div class="ent-form-header"><h3><i class="bi bi-clipboard-data me-2"></i>Inspection Result Details</h3><span class="badge">QM</span></div>
    <div class="ent-form-tabs">
        <button type="button" class="ent-form-tab active" onclick="showTab(this,'tab-ref')"><i class="bi bi-link tab-icon"></i> Reference</button>
        <button type="button" class="ent-form-tab" onclick="showTab(this,'tab-params')"><i class="bi bi-rulers tab-icon"></i> Parameters</button>
    </div>
    <div class="ent-form-panel active" id="tab-ref">
        <div class="ent-section"><div class="ent-section-header"><i class="bi bi-link"></i> Reference Data</div>
            <div class="ent-field-grid ent-grid-3">
                <div class="ent-field"><label>Result ID</label><div class="ent-readonly">@Model.Result.ResultId</div></div>
                <div class="ent-field"><label>Lot Number</label><div class="ent-readonly">@Model.Result.LotNumber</div></div>
                <div class="ent-field"><label>Batch #</label><div class="ent-readonly">@Model.Result.BatchNumber</div></div>
            </div>
            <div class="ent-field-grid ent-grid-3">
                <div class="ent-field"><label>Evaluation</label><div class="ent-readonly"><span class="qm-badge @(Model.Result.Evaluation=="Pass"?"passed":"rejected")">@Model.Result.Evaluation</span></div></div>
                <div class="ent-field"><label>Status</label><div class="ent-readonly"><span class="qm-badge @(Model.Result.Status=="Passed"?"passed":"rejected")">@Model.Result.Status</span></div></div>
            </div>
        </div>
    </div>
    <div class="ent-form-panel" id="tab-params">
        <div class="ent-section"><div class="ent-section-header"><i class="bi bi-rulers"></i> Measurement Parameters</div>
            <div class="ent-field-grid ent-grid-3">
                <div class="ent-field"><label>Characteristic</label><div class="ent-readonly">@Model.Result.Characteristic</div></div>
                <div class="ent-field"><label>Unit</label><div class="ent-readonly">@Model.Result.Unit</div></div>
                <div class="ent-field"><label>Specification</label><div class="ent-readonly">@Model.Result.Specification</div></div>
            </div>
            <div class="ent-field-grid ent-grid-3">
                <div class="ent-field"><label>Target Min</label><div class="ent-readonly">@Model.Result.TargetMin</div></div>
                <div class="ent-field"><label>Target Max</label><div class="ent-readonly">@Model.Result.TargetMax</div></div>
                <div class="ent-field"><label>Measured Value</label><div class="ent-readonly">@Model.Result.MeasuredValue</div></div>
            </div>
        </div>
    </div>
    <div class="ent-form-actions">
        <a asp-page="/QM/Index" class="ent-btn ent-btn-secondary"><i class="bi bi-arrow-left me-1"></i> Back</a>
        <a asp-page="/QM/InspectionResult/Edit" asp-route-id="@Model.Result.Id" class="ent-btn ent-btn-primary"><i class="bi bi-pencil me-1"></i> Edit</a>
    </div>
</div>
