@page
@model YuktiraERP.Web.Pages.QM.InspectionResult.DisplayModel
@using YuktiraERP.Infrastructure.Data.Entities
@{ ViewData["Title"] = "InspectionResult Details"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-info text-white"><h5 class="mb-0"><i class="bi bi-eye me-2"></i>InspectionResult Details</h5></div>
<div class="card-body">
<dl class="row mb-0"><dt class="col-sm-4">ResultId</dt><dd class="col-sm-8">@(Model.Result.ResultId)</dd><dt class="col-sm-4">LotNumber</dt><dd class="col-sm-8">@(Model.Result.LotNumber)</dd><dt class="col-sm-4">Characteristic</dt><dd class="col-sm-8">@(Model.Result.Characteristic)</dd><dt class="col-sm-4">Result</dt><dd class="col-sm-8">@(Model.Result.Result)</dd><dt class="col-sm-4">Specification</dt><dd class="col-sm-8">@(Model.Result.Specification)</dd><dt class="col-sm-4">Status</dt><dd class="col-sm-8">@(Model.Result.Status)</dd></dl>
</div>
<div class="card-footer">
<a href="/QM/InspectionResult/List" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
<a href="/QM/InspectionResult/Edit?id=@(Model.Result.Id)" class="btn btn-warning"><i class="bi bi-pencil me-1"></i>Edit</a>
</div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

