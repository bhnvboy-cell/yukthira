@page
@model YuktiraERP.Web.Pages.QM.InspectionResult.EditModel
@{ ViewData["Title"] = "Edit InspectionResult"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-warning text-dark"><h5 class="mb-0"><i class="bi bi-pencil me-2"></i>Edit InspectionResult</h5></div>
<div class="card-body">
<form method="post">
<input type="hidden" asp-for="Result.Id" />
<div class="row mb-3"><div class="col-md-6"><label asp-for="Result.ResultId" class="form-label"></label><input asp-for="Result.ResultId" class="form-control" type="text" /></div><div class="col-md-6"><label asp-for="Result.LotNumber" class="form-label"></label><input asp-for="Result.LotNumber" class="form-control" type="text" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="Result.Characteristic" class="form-label"></label><input asp-for="Result.Characteristic" class="form-control" type="text" /></div><div class="col-md-6"><label asp-for="Result.Result" class="form-label"></label><input asp-for="Result.Result" class="form-control" type="text" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="Result.Specification" class="form-label"></label><input asp-for="Result.Specification" class="form-control" type="text" /></div><div class="col-md-6"><label asp-for="Result.Status" class="form-label"></label><input asp-for="Result.Status" class="form-control" type="text" /></div></div>
<div class="d-flex gap-2"><button type="submit" class="btn btn-warning"><i class="bi bi-save me-1"></i>Update</button><a href="/QM/InspectionResult/List" class="btn btn-outline-secondary"><i class="bi bi-x me-1"></i>Cancel</a></div>
</form>
</div></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

