@page "{id:Guid}"
@model YuktiraERP.Web.Pages.QM.InspectionResult.EditModel
@{ ViewData["Title"] = "Edit Inspection Result"; }
<link rel="stylesheet" href="~/css/enterprise-form.css" />
<div class="ent-form-wrapper">
    <div class="ent-form-header"><h3><i class="bi bi-clipboard-data me-2"></i>Edit Inspection Result</h3><span class="badge">QM</span></div>
    <form method="post">
        <input type="hidden" asp-for="Result.Id" />
        <div class="ent-form-tabs">
            <button type="button" class="ent-form-tab active" onclick="showTab(this,'tab-ref')"><i class="bi bi-link tab-icon"></i> Lot Reference</button>
            <button type="button" class="ent-form-tab" onclick="showTab(this,'tab-params')"><i class="bi bi-rulers tab-icon"></i> Parameters</button>
        </div>
        <div class="ent-form-panel active" id="tab-ref">
            <div class="ent-section"><div class="ent-section-header"><i class="bi bi-link"></i> Reference Data</div>
                <div class="ent-field-grid ent-grid-3">
                    <div class="ent-field"><label>Result ID</label><input asp-for="Result.ResultId" class="ent-input" readonly /></div>
                    <div class="ent-field"><label>Lot Number</label><input asp-for="Result.LotNumber" class="ent-input" /></div>
                    <div class="ent-field"><label>Batch #</label><input asp-for="Result.BatchNumber" class="ent-input" /></div>
                </div>
                <div class="ent-field-grid ent-grid-3">
                    <div class="ent-field"><label>Inspector ID</label><input asp-for="Result.InspectorID" class="ent-input" /></div>
                    <div class="ent-field"><label>Evaluation</label><select asp-for="Result.Evaluation" class="ent-select"><option>Pass</option><option>Fail</option></select></div>
                    <div class="ent-field"><label>Status</label><select asp-for="Result.Status" class="ent-select"><option>Passed</option><option>Failed</option><option>Pending</option></select></div>
                </div>
            </div>
        </div>
        <div class="ent-form-panel" id="tab-params">
            <div class="ent-section"><div class="ent-section-header"><i class="bi bi-rulers"></i> Measurement Parameters</div>
                <div class="ent-field-grid ent-grid-3">
                    <div class="ent-field"><label>Characteristic</label><input asp-for="Result.Characteristic" class="ent-input" /></div>
                    <div class="ent-field"><label>Unit</label><select asp-for="Result.Unit" class="ent-select"><option>%</option><option>mg/kg</option><option>pH</option><option>°Brix</option><option>°Bé</option><option>g/L</option><option>mPa·s</option><option>mm</option><option>° Lovibond</option><option>EU</option><option>CFU</option></select></div>
                    <div class="ent-field"><label>Specification</label><input asp-for="Result.Specification" class="ent-input" /></div>
                </div>
                <div class="ent-field-grid ent-grid-3">
                    <div class="ent-field"><label>Target Min</label><input asp-for="Result.TargetMin" class="ent-input" /></div>
                    <div class="ent-field"><label>Target Max</label><input asp-for="Result.TargetMax" class="ent-input" /></div>
                    <div class="ent-field"><label>Measured Value</label><input asp-for="Result.MeasuredValue" class="ent-input" /></div>
                </div>
                <div class="ent-field"><label>Notes</label><textarea asp-for="Result.InspectorNotes" class="ent-input" rows="2"></textarea></div>
            </div>
        </div>
        <div class="ent-form-actions"><a asp-page="/QM/Index" class="ent-btn ent-btn-secondary"><i class="bi bi-arrow-left me-1"></i> Back</a><button type="submit" class="ent-btn ent-btn-primary"><i class="bi bi-check-circle me-1"></i> Save Changes</button></div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
