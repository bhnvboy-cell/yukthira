@page
@model YuktiraERP.Web.Pages.QM.InspectionResult.CreateModel
@{ ViewData["Title"] = "Record Inspection Results"; }
<div class="ent-form-wrapper">
    <div class="ent-form-header">
        <h2><i class="bi bi-clipboard-data me-2"></i>Record Inspection Results</h2>
        <div class="ent-form-header-actions">
            <button type="submit" form="resultForm" class="btn btn-primary"><i class="bi bi-save me-1"></i>Save</button>
            <a asp-page="/QM/Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </div>
    <div class="ent-form-tabs" id="resultTabs">
        <button type="button" class="ent-tab active" data-tab="tabRef">Lot Reference</button>
        <button type="button" class="ent-tab" data-tab="tabParams">Parameters & Measurements</button>
    </div>
    <form id="resultForm" method="post">
        <div class="ent-form-panel active" data-panel="tabRef">
            <div class="ent-section">
                <div class="ent-section-title"><i class="bi bi-clipboard-check"></i> Inspection Lot Reference</div>
                <div class="ent-field-grid ent-grid-3">
                    <div class="ent-field">
                        <label asp-for="Result.ResultId" class="ent-label required">Result ID</label>
                        <input asp-for="Result.ResultId" class="ent-input" required />
                    </div>
                    <div class="ent-field">
                        <label asp-for="Result.LotNumber" class="ent-label required">Inspection Lot #</label>
                        <input asp-for="Result.LotNumber" class="ent-input" required />
                    </div>
                    <div class="ent-field">
                        <label asp-for="Result.BatchNumber" class="ent-label">Batch Number</label>
                        <input asp-for="Result.BatchNumber" class="ent-input" />
                    </div>
                </div>
                <div class="ent-field-grid ent-grid-3">
                    <div class="ent-field">
                        <label asp-for="Result.InspectorID" class="ent-label">Inspector ID</label>
                        <input asp-for="Result.InspectorID" class="ent-input" />
                    </div>
                    <div class="ent-field">
                        <label asp-for="Result.Status" class="ent-label">Result Status</label>
                        <select asp-for="Result.Status" class="ent-select">
                            <option>Passed</option>
                            <option>Failed</option>
                            <option>Pending</option>
                        </select>
                    </div>
                    <div class="ent-field">
                        <label asp-for="Result.Evaluation" class="ent-label">Evaluation</label>
                        <select asp-for="Result.Evaluation" class="ent-select">
                            <option>Pass</option>
                            <option>Fail</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="ent-form-panel" data-panel="tabParams" style="display:none">
            <div class="ent-section">
                <div class="ent-section-title"><i class="bi bi-rulers"></i> Characteristic & Specification Limits</div>
                <div class="ent-field-grid ent-grid-3">
                    <div class="ent-field">
                        <label asp-for="Result.Characteristic" class="ent-label required">Characteristic</label>
                        <input asp-for="Result.Characteristic" class="ent-input" required />
                    </div>
                    <div class="ent-field">
                        <label asp-for="Result.Unit" class="ent-label">Unit</label>
                        <select asp-for="Result.Unit" class="ent-select">
                            <option value="mm">mm</option>
                            <option value="cm">cm</option>
                            <option value="m">m</option>
                            <option value="kg">kg</option>
                            <option value="g">g</option>
                            <option value="N">N</option>
                            <option value="MPa">MPa</option>
                            <option value="psi">psi</option>
                            <option value="%">%</option>
                            <option value="°C">°C</option>
                            <option value="pH">pH</option>
                        </select>
                    </div>
                    <div class="ent-field">
                        <label asp-for="Result.Specification" class="ent-label">Specification</label>
                        <input asp-for="Result.Specification" class="ent-input" />
                    </div>
                </div>
                <div class="ent-field-grid ent-grid-3">
                    <div class="ent-field">
                        <label asp-for="Result.TargetMin" class="ent-label">Target Minimum</label>
                        <input asp-for="Result.TargetMin" class="ent-input" type="number" step="0.001" />
                    </div>
                    <div class="ent-field">
                        <label asp-for="Result.TargetMax" class="ent-label">Target Maximum</label>
                        <input asp-for="Result.TargetMax" class="ent-input" type="number" step="0.001" />
                    </div>
                    <div class="ent-field">
                        <label asp-for="Result.MeasuredValue" class="ent-label required">Measured Value</label>
                        <input asp-for="Result.MeasuredValue" class="ent-input" type="number" step="0.001" required />
                    </div>
                </div>
            </div>
            <div class="ent-section">
                <div class="ent-section-title"><i class="bi bi-journal-text"></i> Inspector Notes</div>
                <div class="ent-field-grid ent-grid-1">
                    <div class="ent-field">
                        <label asp-for="Result.InspectorNotes" class="ent-label">Notes</label>
                        <textarea asp-for="Result.InspectorNotes" class="ent-input" rows="3"></textarea>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
