@page "{id:Guid}"
@model YuktiraERP.Web.Pages.QM.InspectionPlan.DisplayModel
@{ ViewData["Title"] = "Inspection Plan Details"; }
<link rel="stylesheet" href="~/css/enterprise-form.css" />
<div class="ent-form-wrapper">
    <div class="ent-form-header"><h3><i class="bi bi-journal-text me-2"></i>Inspection Plan Details</h3><span class="badge">QM</span></div>
    <div class="ent-section"><div class="ent-section-header"><i class="bi bi-tag"></i> Plan Information</div>
        <div class="ent-field-grid ent-grid-3">
            <div class="ent-field"><label>Plan ID</label><div class="ent-readonly">@Model.Plan.PlanId</div></div>
            <div class="ent-field"><label>Material</label><div class="ent-readonly">@Model.Plan.MaterialName</div></div>
            <div class="ent-field"><label>Status</label><div class="ent-readonly"><span class="qm-badge @(Model.Plan.Status=="Active"?"success":"warning")">@Model.Plan.Status</span></div></div>
        </div>
        <div class="ent-field-grid ent-grid-3">
            <div class="ent-field"><label>Characteristic</label><div class="ent-readonly">@Model.Plan.Characteristic</div></div>
            <div class="ent-field"><label>Method</label><div class="ent-readonly">@Model.Plan.Method</div></div>
            <div class="ent-field"><label>Frequency</label><div class="ent-readonly">@Model.Plan.Frequency</div></div>
        </div>
    </div>
    <div class="ent-form-actions">
        <a asp-page="/QM/Index" class="ent-btn ent-btn-secondary"><i class="bi bi-arrow-left me-1"></i> Back</a>
        <a asp-page="/QM/InspectionPlan/Edit" asp-route-id="@Model.Plan.Id" class="ent-btn ent-btn-primary"><i class="bi bi-pencil me-1"></i> Edit</a>
    </div>
</div>
