            </div>
        </div>
        <div class="qm-table-wrap">
            <table class="qm-table" id="grid-plans">
                <thead><tr>
                    <th style="width:40px"><input type="checkbox" class="qm-chk select-all" data-grid="plans" /></th>
                    <th>Plan ID</th><th>Material</th><th>Characteristic</th><th>Method</th><th>Frequency</th><th>Status</th>
                    <th style="width:80px">Actions</th>
                </tr></thead>
                <tbody>
                    @foreach (var p in Model.InspectionPlans)
                    {
                        <tr data-grid-row="plans">
