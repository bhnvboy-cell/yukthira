</div>

@section Styles {
    <link rel="stylesheet" href="~/css/module-layout.css" asp-append-version="true" />
}

@section Scripts {
    <script>
    (function(){
        var root = document.querySelector('[data-module-root="qm"]');
        if(!root) return;

        root.querySelectorAll('.qm-tab').forEach(function(tab){
            tab.addEventListener('click', function(){
                var key = this.getAttribute('data-tab');
                root.querySelectorAll('.qm-tab').forEach(function(t){t.classList.remove('active')});
                this.classList.add('active');
                root.querySelectorAll('.qm-panel').forEach(function(p){
                    p.style.display = p.getAttribute('data-panel')===key?'':'none';
                    p.classList.toggle('active', p.getAttribute('data-panel')===key);
                });
            });
        });

        root.querySelectorAll('.select-all').forEach(function(cb){
            cb.addEventListener('change', function(){
                var grid = this.getAttribute('data-grid');
                var cbs = root.querySelectorAll('.row-check[data-grid="'+grid+'"]');
                cbs.forEach(function(c){c.checked = cb.checked});
                updateInfo(grid);
            });
        });
        root.querySelectorAll('.row-check').forEach(function(cb){
            cb.addEventListener('change', function(){
                updateInfo(this.getAttribute('data-grid'));
            });
        });

        function updateInfo(grid){
            var cbs = root.querySelectorAll('.row-check[data-grid="'+grid+'"]');
            var checked = Array.from(cbs).filter(function(c){return c.checked}).length;
            var info = document.getElementById(grid+'-info');
            if(info) info.textContent = checked>0?checked+' of '+cbs.length+' selected':cbs.length+' records';
            var del = document.getElementById(grid+'-delete-selected');
            if(del) del.style.display = checked>0?'inline-flex':'none';
        }

        root.querySelectorAll('.grid-search').forEach(function(input){
            input.addEventListener('input', function(){
                var panel = this.closest('.qm-panel');
                if(!panel) return;
                var q = this.value.toLowerCase();
                panel.querySelectorAll('tbody tr').forEach(function(tr){
                    if(tr.querySelector('th')) return;
                    tr.style.display = tr.textContent.toLowerCase().indexOf(q)===-1?'none':'';
                });
            });
        });

        window.exportGrid = function(grid){
            var table = document.getElementById('grid-'+grid);
            if(!table) return;
            var csv = [];
            table.querySelectorAll('tr').forEach(function(tr){
                var row = [];
                tr.querySelectorAll('th,td').forEach(function(cell){
                    if(cell.querySelector('input[type=checkbox]')) return;
                    row.push('"'+cell.textContent.trim().replace(/"/g,'""')+'"');
                });
                csv.push(row.join(','));
            });
            var blob = new Blob([csv.join('\n')],{type:'text/csv'});
            var a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = 'qm-'+grid+'-export.csv';
            a.click();
        };
    })();
    </script>
}
