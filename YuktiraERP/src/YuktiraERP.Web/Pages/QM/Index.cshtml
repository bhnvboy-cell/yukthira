                            <td><strong>@p.PlanId</strong></td><td>@p.MaterialName</td><td>@p.Characteristic</td>
                            <td>@p.Method</td><td>@p.Frequency</td>
                            <td><span class="qm-badge @(p.Status=="Active"?"success":"warning")">@p.Status</span></td>
                            <td><a asp-page="/QM/InspectionPlan/Edit" asp-route-id="@p.Id" class="qm-act" title="Edit"><i class="bi bi-pencil"></i></a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="qm-footer"><span>Total: @Model.InspectionPlans.Count plans</span><div></div></div>
    </div>

    <!-- ═══ TAB: Certificates ═══ -->
    <div class="qm-panel" data-panel="coa" style="display:none">
        <div class="qm-grid-toolbar">
            <div class="search-box"><i class="bi bi-search"></i><input type="text" placeholder="Search certificates by customer..." class="grid-search" data-target="coa" /></div>
            <div class="qm-grid-actions">
                <span class="qm-grid-info" id="coa-info">Showing @Model.Certificates.Count records</span>
                <a asp-page="/QM/COA/Create" class="btn-g primary"><i class="bi bi-plus"></i> New</a>
                <button class="btn-g" onclick="exportGrid('coa')"><i class="bi bi-download"></i> Export</button>
            </div>
        </div>
        <div class="qm-table-wrap">
            <table class="qm-table" id="grid-coa">
                <thead><tr>
                    <th style="width:40px"><input type="checkbox" class="qm-chk select-all" data-grid="coa" /></th>
                    <th>COA #</th><th>Inspection Lot</th><th>Material</th><th>Batch #</th><th>Customer</th>
                    <th>Result</th><th>Issued By</th><th>Date</th><th>Status</th><th style="width:80px">Actions</th>
                </tr></thead>
                <tbody>
                    @foreach (var c in Model.Certificates)
                    {
                        <tr data-grid-row="coa">
                            <td><input type="checkbox" class="qm-chk row-check" data-grid="coa" /></td>
                            <td><strong>@c.COANumber</strong></td><td>@c.InspectionLotNumber</td><td>@c.MaterialCode</td>
                            <td>@c.BatchNumber</td><td>@c.CustomerName</td>
                            <td><span class="qm-badge @(c.OverallResult=="Passed"?"success":"rejected")">@c.OverallResult</span></td>
                            <td>@c.IssuedBy</td><td>@c.IssueDate.ToString("dd MMM yyyy")</td>
                            <td><span class="qm-badge @(c.Status=="Issued"?"success":"warning")">@c.Status</span></td>
                            <td><a asp-page="/QM/COA/Edit" asp-route-id="@c.Id" class="qm-act" title="Edit"><i class="bi bi-pencil"></i></a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="qm-footer"><span>Total: @Model.Certificates.Count certificates</span><div></div></div>
    </div>

    <!-- ═══ TAB: ZQM Suite ═══ -->
    <div class="qm-panel" data-panel="zqm" style="display:none">
        <div style="padding:20px;background:#fafafa;border-bottom:1px solid #e0e0e0">
            <h4 style="margin:0 0 4px;color:#0d47a1"><i class="bi bi-gear-wide-connected me-2"></i>ZQM Transaction Suite</h4>
            <p style="margin:0;font-size:0.85rem;color:#666">Advanced quality management backend services with frontend UI</p>
        </div>
        <div class="zqm-grid">
            <a asp-page="/QM/ZqmSuite/AutoLotGenerator" class="zqm-card">
                <span class="zqm-status ready">ACTIVE</span>
                <div class="zqm-icon blue"><i class="bi bi-clipboard-plus"></i></div>
