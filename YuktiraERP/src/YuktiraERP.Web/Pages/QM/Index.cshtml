            </a>
            <a asp-page="/QM/ZqmSuite/LabCalculator" class="zqm-card">
                <span class="zqm-status ready">ACTIVE</span>
                <div class="zqm-icon blue"><i class="bi bi-calculator"></i></div>
                <div class="zqm-code">ZQM08</div>
