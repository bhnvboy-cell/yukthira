                <p>Post usage decisions with automatic stock movements and quality scoring</p>
            </a>
            <a asp-page="/QM/Inspection/ReverseUD" class="zqm-card">
                <span class="zqm-status ready">ACTIVE</span>
                <div class="zqm-icon red"><i class="bi bi-arrow-counterclockwise"></i></div>
                <div class="zqm-code">ZQM04</div>
                <h5>UD Reversal Engine</h5>
                <p>Reverse usage decisions with stock reversal (Mvt 322) and audit trail</p>
            </a>
            <a asp-page="/QM/ZqmSuite/HandlingUnit" class="zqm-card">
                <span class="zqm-status ready">ACTIVE</span>
                <div class="zqm-icon teal"><i class="bi bi-box-seam"></i></div>
                <div class="zqm-code">ZQM05</div>
                <h5>Handling Unit Manager</h5>
                <p>Create, manage and release handling units for quality inspection packaging</p>
            </a>
            <a asp-page="/QM/ZqmSuite/QaWorklist" class="zqm-card">
                <span class="zqm-status ready">ACTIVE</span>
                <div class="zqm-icon purple"><i class="bi bi-list-task"></i></div>
                <div class="zqm-code">ZQM06</div>
