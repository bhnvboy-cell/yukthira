            </a>
            <a asp-page="/QM/ZqmSuite/ResultsWorkbench" class="zqm-card">
                <span class="zqm-status ready">ACTIVE</span>
                <div class="zqm-icon green"><i class="bi bi-clipboard-check"></i></div>
                <div class="zqm-code">ZQM02</div>
                <h5>Results Recording Workbench</h5>
                <p>Record characteristic results with spec evaluation and tolerance checking</p>
            </a>
            <a asp-page="/QM/ZqmSuite/UsageDecision" class="zqm-card">
                <span class="zqm-status ready">ACTIVE</span>
                <div class="zqm-icon amber"><i class="bi bi-gavel"></i></div>
                <div class="zqm-code">ZQM03</div>
