@page "{id:Guid}"
@model YuktiraERP.Web.Pages.QM.COA.DisplayModel
@{ ViewData["Title"] = "Certificate of Analysis Details"; }
<link rel="stylesheet" href="~/css/enterprise-form.css" />
<div class="ent-form-wrapper">
    <div class="ent-form-header"><h3><svg class="bi bi-file-earmark-check me-2" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-file-earmark-check"></use></svg>Certificate of Analysis</h3><span class="badge">QM</span></div>
    <div class="ent-form-tabs">
        <button type="button" class="ent-form-tab active" onclick="showTab(this,'tab-general')"><svg class="bi bi-info-circle tab-icon" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-info-circle"></use></svg> General</button>
        <button type="button" class="ent-form-tab" onclick="showTab(this,'tab-customer')"><svg class="bi bi-person tab-icon" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-person"></use></svg> Customer</button>
    </div>
    <div class="ent-form-panel active" id="tab-general">
        <div class="ent-section"><div class="ent-section-header"><svg class="bi bi-tag" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-tag"></use></svg> Certificate Details</div>
            <div class="ent-field-grid ent-grid-3">
                <div class="ent-field"><label>COA #</label><div class="ent-readonly">@Model.Certificate.COANumber</div></div>
                <div class="ent-field"><label>Inspection Lot #</label><div class="ent-readonly">@Model.Certificate.InspectionLotNumber</div></div>
                <div class="ent-field"><label>Status</label><div class="ent-readonly"><span class="qm-badge @(Model.Certificate.Status=="Issued"?"success":"warning")">@Model.Certificate.Status</span></div></div>
            </div>
            <div class="ent-field-grid ent-grid-3">
                <div class="ent-field"><label>Material Code</label><div class="ent-readonly">@Model.Certificate.MaterialCode</div></div>
                <div class="ent-field"><label>Material Name</label><div class="ent-readonly">@Model.Certificate.MaterialName</div></div>
                <div class="ent-field"><label>Batch #</label><div class="ent-readonly">@Model.Certificate.BatchNumber</div></div>
            </div>
            <div class="ent-field-grid ent-grid-3">
                <div class="ent-field"><label>Plant</label><div class="ent-readonly">@Model.Certificate.Plant</div></div>
                <div class="ent-field"><label>Overall Result</label><div class="ent-readonly"><span class="qm-badge @(Model.Certificate.OverallResult=="Passed"?"success":"rejected")">@Model.Certificate.OverallResult</span></div></div>
                <div class="ent-field"><label>Remarks</label><div class="ent-readonly">@Model.Certificate.Remarks</div></div>
            </div>
        </div>
    </div>
    <div class="ent-form-panel" id="tab-customer">
        <div class="ent-section"><div class="ent-section-header"><svg class="bi bi-person" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-person"></use></svg> Customer & Issuance</div>
            <div class="ent-field-grid ent-grid-3">
                <div class="ent-field"><label>Customer Name</label><div class="ent-readonly">@Model.Certificate.CustomerName</div></div>
                <div class="ent-field"><label>Customer PO #</label><div class="ent-readonly">@Model.Certificate.CustomerPO</div></div>
                <div class="ent-field"><label>Issued By</label><div class="ent-readonly">@Model.Certificate.IssuedBy</div></div>
            </div>
            <div class="ent-field"><label>Issue Date</label><div class="ent-readonly">@Model.Certificate.IssueDate.ToString("dd MMM yyyy")</div></div>
        </div>
    </div>
    <div class="ent-form-actions">
        <a asp-page="/QM/Index" class="ent-btn ent-btn-secondary"><svg class="bi bi-arrow-left me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-arrow-left"></use></svg> Back</a>
        <a asp-page="/QM/COA/Edit" asp-route-id="@Model.Certificate.Id" class="ent-btn ent-btn-primary"><svg class="bi bi-pencil me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-pencil"></use></svg> Edit</a>
    </div>
</div>
