@page
@model YuktiraERP.Web.Pages.QM.ZqmSuite.CertificateOfAnalysisModel
@{ ViewData["Title"] = "ZQM09 - Certificate of Analysis"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><i class="bi bi-file-earmark-medical me-2"></i>Certificate of Analysis</h3>
            <span class="badge">ZQM09</span>
        </div>
        <div class="actions">
            <button type="button" class="zqm-btn" onclick="generateCoa()"><i class="bi bi-file-earmark-check me-1"></i>Generate CoA</button>
            <button type="button" class="zqm-btn" onclick="loadHistory()"><i class="bi bi-clock-history me-1"></i>History</button>
            <a asp-page="/QM/Index" class="zqm-btn zqm-btn-back"><i class="bi bi-arrow-left me-1"></i>Back</a>
        </div>
    </div>

    <div class="zqm-filter">
        <div class="zqm-tabs">
            <button class="zqm-tab-btn active" onclick="switchTab(this,'tab-gen')"><i class="bi bi-file-earmark-plus"></i> Generate CoA</button>
            <button class="zqm-tab-btn" onclick="switchTab(this,'tab-history')"><i class="bi bi-clock-history"></i> CoA History</button>
        </div>

        <div class="zqm-tab-panel active" id="tab-gen">
            <div style="padding:16px">
                <div class="zqm-row cols-4">
                    <div class="zqm-field"><label>Inspection Lot #</label><input id="coa-lot" placeholder="e.g. IL-20260001" /></div>
                    <div class="zqm-field"><label>Customer Code</label><input id="coa-cust-code" /></div>
                    <div class="zqm-field"><label>Customer Name</label><input id="coa-cust-name" /></div>
                    <div class="zqm-field"><label>Generated By</label><input id="coa-gen-by" value="superadmin" /></div>
                </div>
                <div class="zqm-row cols-3">
                    <div class="zqm-field"><label>Delivery Note #</label><input id="coa-delivery" /></div>
                    <div class="zqm-field"><label>Movement Doc #</label><input id="coa-movement" /></div>
                </div>
            </div>
        </div>

        <div class="zqm-tab-panel" id="tab-history">
            <div style="padding:16px"><p style="color:#666;margin:0">Click History button to load previously generated certificates</p></div>
        </div>
    </div>

    <div id="alertBox" class="zqm-alert"></div>

    <div class="zqm-results" id="genResult" style="display:none">
        <div class="zqm-results-header"><h4><i class="bi bi-file-earmark-check me-1"></i>Generated Certificate</h4></div>
        <div class="zqm-table-wrap">
            <table class="zqm-table"><thead><tr><th>Field</th><th>Value</th></tr></thead><tbody>
                <tr><td><strong>Certificate #</strong></td><td id="resCoaNumber">-</td></tr>
                <tr><td><strong>Overall Result</strong></td><td id="resResult">-</td></tr>
                <tr><td><strong>Status</strong></td><td id="resStatus">-</td></tr>
                <tr><td><strong>Characteristics</strong></td><td id="resChars">-</td></tr>
                <tr><td><strong>Generated At</strong></td><td id="resTime">-</td></tr>
            </tbody></table>
        </div>
    </div>

    <div class="zqm-results" id="histSection" style="display:none">
        <div class="zqm-results-header"><h4><i class="bi bi-clock-history me-1"></i>CoA History</h4><span class="count" id="histCount"></span></div>
        <div class="zqm-table-wrap"><table class="zqm-table"><thead><tr><th>Certificate #</th><th>Lot</th><th>Customer</th><th>Total Chars</th><th>Passed</th><th>Failed</th><th>Result</th><th>Generated</th></tr></thead><tbody id="histBody"></tbody></table></div>
    </div>
</div>

@section Scripts {
<script>
function show(msg, type) { var el = document.getElementById('alertBox'); el.style.display = 'block'; el.className = 'zqm-alert ' + type; el.textContent = msg; }
function switchTab(btn, id) {
    btn.closest('.zqm-filter').querySelectorAll('.zqm-tab-btn').forEach(function(t){t.classList.remove('active')});
    btn.classList.add('active');
    btn.closest('.zqm-filter').querySelectorAll('.zqm-tab-panel').forEach(function(p){p.classList.remove('active');p.style.display='none'});
    var p = document.getElementById(id); if(p){p.classList.add('active');p.style.display='';}
}
async function generateCoa() {
    var body = JSON.stringify({ inspectionLotNumber:document.getElementById('coa-lot').value, customerCode:document.getElementById('coa-cust-code').value, customerName:document.getElementById('coa-cust-name').value, deliveryNoteNumber:document.getElementById('coa-delivery').value, movementDocumentNumber:document.getElementById('coa-movement').value, generatedBy:document.getElementById('coa-gen-by').value });
    try {
        var r = await fetch('/api/v1/zqm/coa/generate', { method:'POST', headers:{'Content-Type':'application/json'}, body:body });
        if (r.ok) {
            var d = await r.json();
            document.getElementById('resCoaNumber').textContent = d.coaNumber || d.certificateNumber || d.id || '-';
            var resCls = d.overallResult==='Passed' ? 'passed' : 'failed';
            document.getElementById('resResult').innerHTML = '<span class="zqm-badge '+resCls+'">'+(d.overallResult||'-')+'</span>';
            document.getElementById('resStatus').innerHTML = '<span class="zqm-badge completed">'+(d.status||'Generated')+'</span>';
            document.getElementById('resChars').textContent = (d.totalCharacteristics||0) + ' total | ' + (d.passedCharacteristics||0) + ' passed | ' + (d.failedCharacteristics||0) + ' failed';
            document.getElementById('resTime').textContent = d.generatedAt || new Date().toLocaleString();
            document.getElementById('genResult').style.display = '';
            show('CoA generated successfully', 'success');
        } else { show('Error: ' + await r.text(), 'error'); }
    } catch (e) { show('Error: ' + e.message, 'error'); }
}
async function loadHistory() {
    try {
        var r = await fetch('/api/v1/zqm/coa/logs');
        if (r.ok) {
            var data = await r.json();
            if (Array.isArray(data) && data.length) {
                var tbody = document.getElementById('histBody');
                tbody.innerHTML = '';
                data.forEach(function(c) {
                    var resCls = c.overallResult==='Passed' ? 'passed' : 'failed';
                    tbody.innerHTML += '<tr><td><strong>'+(c.coaNumber||c.certificateNumber||c.id||'')+'</strong></td><td>'+(c.inspectionLotNumber||'')+'</td><td>'+(c.customerName||'')+'</td><td>'+(c.totalCharacteristics||0)+'</td><td>'+(c.passedCharacteristics||0)+'</td><td>'+(c.failedCharacteristics||0)+'</td><td><span class="zqm-badge '+resCls+'">'+(c.overallResult||'')+'</span></td><td>'+(c.generatedAt||c.issueDate||'')+'</td></tr>';
                });
                document.getElementById('histCount').textContent = data.length + ' certificates';
                document.getElementById('histSection').style.display = '';
            } else { show('No CoA history found', 'info'); }
        } else { show('Error: ' + await r.text(), 'error'); }
    } catch (e) { show('Error: ' + e.message, 'error'); }
}
</script>
}
