@page
@model YuktiraERP.Web.Pages.QM.ZqmSuite.NonConformanceCapaModel
@{ ViewData["Title"] = "ZQM07 - Non-Conformance & CAPA"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><i class="bi bi-exclamation-triangle me-2"></i>Non-Conformance & CAPA</h3>
            <span class="badge">ZQM07</span>
        </div>
        <div class="actions">
            <button type="button" class="zqm-btn" onclick="createNC()"><i class="bi bi-plus-circle me-1"></i>Create NC</button>
            <button type="button" class="zqm-btn" onclick="createCapa()"><i class="bi bi-plus-circle me-1"></i>Create CAPA</button>
            <a asp-page="/QM/Index" class="zqm-btn zqm-btn-back"><i class="bi bi-arrow-left me-1"></i>Back</a>
        </div>
    </div>

    <div class="zqm-filter">
        <div class="zqm-tabs">
            <button class="zqm-tab-btn active" onclick="switchTab(this,'tab-nc')"><i class="bi bi-exclamation-triangle"></i> Create NC</button>
            <button class="zqm-tab-btn" onclick="switchTab(this,'tab-capa')"><i class="bi bi-shield-check"></i> Create CAPA</button>
            <button class="zqm-tab-btn" onclick="switchTab(this,'tab-nc-list')"><i class="bi bi-list-ul"></i> NC List</button>
            <button class="zqm-tab-btn" onclick="switchTab(this,'tab-capa-list')"><i class="bi bi-list-ul"></i> CAPA List</button>
        </div>

        <div class="zqm-tab-panel active" id="tab-nc">
            <div style="padding:16px">
                <div class="zqm-row cols-4">
                    <div class="zqm-field"><label>NC Type</label><select id="nc-type"><option>Internal</option><option>External</option><option>Supplier</option></select></div>
                    <div class="zqm-field"><label>Severity</label><select id="nc-severity"><option>Low</option><option>Medium</option><option selected>High</option><option>Critical</option></select></div>
                    <div class="zqm-field"><label>Priority</label><select id="nc-priority"><option>Low</option><option selected>Medium</option><option>High</option><option>Critical</option></select></div>
                    <div class="zqm-field"><label>Material Code</label><input id="nc-material" /></div>
                </div>
                <div class="zqm-row cols-4">
                    <div class="zqm-field"><label>Plant</label><select id="nc-plant"><option>1000</option><option>2000</option><option>3000</option></select></div>
                    <div class="zqm-field"><label>Batch #</label><input id="nc-batch" /></div>
                    <div class="zqm-field"><label>Lot #</label><input id="nc-lot" /></div>
                    <div class="zqm-field"><label>Quantity</label><input id="nc-qty" type="number" step="0.01" /></div>
                </div>
                <div class="zqm-row cols-4">
                    <div class="zqm-field"><label>Defect Code</label><input id="nc-defect-code" /></div>
                    <div class="zqm-field"><label>Defect Group</label><input id="nc-defect-group" /></div>
                    <div class="zqm-field"><label>Detected By</label><input id="nc-detected" /></div>
                    <div class="zqm-field"><label>Assigned To</label><input id="nc-assigned" /></div>
                </div>
                <div class="zqm-row cols-3">
                    <div class="zqm-field"><label>Root Cause Category</label><select id="nc-root-cause"><option>Process</option><option>Material</option><option>Equipment</option><option>Human Error</option><option>Design</option></select></div>
                    <div class="zqm-field"><label>Due Date</label><input id="nc-due" type="date" /></div>
                    <div class="zqm-field"><label>Estimated Cost</label><input id="nc-cost" type="number" step="0.01" /></div>
                </div>
                <div class="zqm-field"><label>Description</label><textarea id="nc-desc" rows="2"></textarea></div>
            </div>
        </div>

        <div class="zqm-tab-panel" id="tab-capa">
            <div style="padding:16px">
                <div class="zqm-row cols-4">
                    <div class="zqm-field"><label>CAPA Type</label><select id="capa-type"><option>Corrective</option><option>Preventive</option></select></div>
                    <div class="zqm-field"><label>Related NC #</label><input id="capa-nc" /></div>
                    <div class="zqm-field"><label>Title</label><input id="capa-title" /></div>
                    <div class="zqm-field"><label>Responsible</label><input id="capa-responsible" /></div>
                </div>
                <div class="zqm-row cols-3">
                    <div class="zqm-field"><label>Planned Date</label><input id="capa-date" type="date" /></div>
                    <div class="zqm-field"><label>Verification Method</label><select id="capa-verify"><option>Audit</option><option>Inspection</option><option>Testing</option><option>Review</option></select></div>
                </div>
                <div class="zqm-row cols-2">
                    <div class="zqm-field"><label>Description</label><textarea id="capa-desc" rows="2"></textarea></div>
                    <div class="zqm-field"><label>Root Cause</label><textarea id="capa-root" rows="2"></textarea></div>
                </div>
                <div class="zqm-row cols-2">
                    <div class="zqm-field"><label>Corrective Action</label><textarea id="capa-corrective" rows="2"></textarea></div>
                    <div class="zqm-field"><label>Preventive Action</label><textarea id="capa-preventive" rows="2"></textarea></div>
                </div>
            </div>
        </div>

        <div class="zqm-tab-panel" id="tab-nc-list">
            <div style="padding:12px 16px">
                <div class="zqm-row cols-3">
                    <div class="zqm-field"><label>Filter by Status</label><select id="nc-filter"><option value="">All</option><option>OPEN</option><option>IN_PROGRESS</option><option>CONTAINMENT</option><option>CLOSED</option></select></div>
                </div>
                <button class="zqm-btn" style="background:#1565c0;color:#fff;border-color:#1565c0;margin-top:8px" onclick="loadNCList()"><i class="bi bi-search me-1"></i>Load NCs</button>
            </div>
        </div>

        <div class="zqm-tab-panel" id="tab-capa-list">
            <div style="padding:12px 16px">
                <div class="zqm-row cols-3">
                    <div class="zqm-field"><label>Filter by Status</label><select id="capa-filter"><option value="">All</option><option>OPEN</option><option>IN_PROGRESS</option><option>COMPLETED</option><option>VERIFIED</option></select></div>
                </div>
                <button class="zqm-btn" style="background:#1565c0;color:#fff;border-color:#1565c0;margin-top:8px" onclick="loadCapaList()"><i class="bi bi-search me-1"></i>Load CAPAs</button>
            </div>
        </div>
    </div>

    <div id="alertBox" class="zqm-alert"></div>

    <div class="zqm-results" id="listSection" style="display:none">
        <div class="zqm-results-header"><h4 id="listTitle"><i class="bi bi-table me-1"></i>Results</h4><span class="count" id="resultCount"></span></div>
        <div class="zqm-table-wrap"><table class="zqm-table"><thead id="listHead"></thead><tbody id="listBody"></tbody></table></div>
    </div>
</div>

@section Scripts {
<script>
function show(msg, type) { var el = document.getElementById('alertBox'); el.style.display = 'block'; el.className = 'zqm-alert ' + type; el.textContent = msg; }
function switchTab(btn, id) {
    btn.closest('.zqm-filter').querySelectorAll('.zqm-tab-btn').forEach(function(t){t.classList.remove('active')});
    btn.classList.add('active');
    btn.closest('.zqm-filter').querySelectorAll('.zqm-tab-panel').forEach(function(p){p.classList.remove('active');p.style.display='none'});
    var p = document.getElementById(id); if(p){p.classList.add('active');p.style.display='';}
}
async function api(url, opts) { try { var r = await fetch(url, Object.assign({headers:{'Content-Type':'application/json'}}, opts||{})); return {ok:r.ok, data:r.ok ? await r.json().catch(()=>({})) : await r.text()}; } catch(e) { return {ok:false, data:e.message}; } }
function renderList(title, head, rows) {
    document.getElementById('listTitle').innerHTML = '<i class="bi bi-table me-1"></i>' + title;
    document.getElementById('listHead').innerHTML = '<tr>' + head.map(function(h){return '<th>'+h+'</th>'}).join('') + '</tr>';
    document.getElementById('listBody').innerHTML = rows.map(function(r){return '<tr>' + r.map(function(c){return '<td>'+c+'</td>'}).join('') + '</tr>'}).join('');
    document.getElementById('resultCount').textContent = rows.length + ' records';
    document.getElementById('listSection').style.display = '';
}
async function createNC() {
    var body = JSON.stringify({ ncType:document.getElementById('nc-type').value, severity:document.getElementById('nc-severity').value, priority:document.getElementById('nc-priority').value, materialCode:document.getElementById('nc-material').value, plant:document.getElementById('nc-plant').value, batchNumber:document.getElementById('nc-batch').value, lotNumber:document.getElementById('nc-lot').value, quantity:parseFloat(document.getElementById('nc-qty').value)||0, defectCode:document.getElementById('nc-defect-code').value, defectGroup:document.getElementById('nc-defect-group').value, detectedBy:document.getElementById('nc-detected').value, assignedTo:document.getElementById('nc-assigned').value, rootCauseCategory:document.getElementById('nc-root-cause').value, dueDate:document.getElementById('nc-due').value, estimatedCost:parseFloat(document.getElementById('nc-cost').value)||0, description:document.getElementById('nc-desc').value, userId:'superadmin' });
    var r = await api('/api/v1/zqm/non-conformance', {method:'POST', body:body});
    show(r.ok ? 'NC created: ' + (r.data.ncNumber||r.data.id||'OK') : 'Error: ' + r.data, r.ok ? 'success' : 'error');
}
async function createCapa() {
    var body = JSON.stringify({ capaType:document.getElementById('capa-type').value, relatedNcNumber:document.getElementById('capa-nc').value, title:document.getElementById('capa-title').value, description:document.getElementById('capa-desc').value, rootCause:document.getElementById('capa-root').value, correctiveAction:document.getElementById('capa-corrective').value, preventiveAction:document.getElementById('capa-preventive').value, responsible:document.getElementById('capa-responsible').value, plannedDate:document.getElementById('capa-date').value, verificationMethod:document.getElementById('capa-verify').value, userId:'superadmin' });
    var r = await api('/api/v1/zqm/capa', {method:'POST', body:body});
    show(r.ok ? 'CAPA created: ' + (r.data.capaNumber||r.data.id||'OK') : 'Error: ' + r.data, r.ok ? 'success' : 'error');
}
async function loadNCList() {
    var status = document.getElementById('nc-filter').value;
    var url = '/api/v1/zqm/non-conformances' + (status ? '?status=' + status : '');
    var r = await api(url);
    if (r.ok && Array.isArray(r.data)) {
        renderList('Non-Conformances', ['NC #','Type','Severity','Material','Plant','Lot','Status','Actions'], r.data.map(function(n){return [n.ncNumber||n.id||'',n.ncType||'',n.severity||'',n.materialCode||'',n.plant||'',n.lotNumber||'','<span class="zqm-badge '+(n.status==='OPEN'?'open':n.status==='CLOSED'?'completed':'in-progress')+'">'+(n.status||'')+'</span>','<button class="zqm-act" onclick="containment(\''+n.id+'\')"><i class="bi bi-shield-check"></i></button>']}));
    } else { show('No NCs found', 'info'); }
}
async function loadCapaList() {
    var status = document.getElementById('capa-filter').value;
    var url = '/api/v1/zqm/capas' + (status ? '?status=' + status : '');
    var r = await api(url);
    if (r.ok && Array.isArray(r.data)) {
        renderList('CAPAs', ['CAPA #','Type','Title','Related NC','Status','Actions'], r.data.map(function(c){return [c.capaNumber||c.id||'',c.capaType||'',c.title||'',c.relatedNcNumber||'','<span class="zqm-badge '+(c.status==='COMPLETED'?'completed':c.status==='VERIFIED'?'passed':'open')+'">'+(c.status||'')+'</span>','<button class="zqm-act" onclick="completeCapa(\''+c.id+'\')"><i class="bi bi-check-circle"></i></button>']}));
    } else { show('No CAPAs found', 'info'); }
}
async function containment(ncId) {
    var r = await api('/api/v1/zqm/non-conformance/' + ncId + '/containment', {method:'POST'});
    show(r.ok ? 'Containment activated' : 'Error: ' + r.data, r.ok ? 'success' : 'error');
}
async function completeCapa(cId) {
    var r = await api('/api/v1/zqm/capa/' + cId + '/complete?userId=superadmin&notes=Completed', {method:'POST'});
    show(r.ok ? 'CAPA completed' : 'Error: ' + r.data, r.ok ? 'success' : 'error');
}
</script>
}
