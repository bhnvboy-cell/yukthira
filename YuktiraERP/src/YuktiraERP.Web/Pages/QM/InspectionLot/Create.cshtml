@page
@model YuktiraERP.Web.Pages.QM.InspectionLot.CreateModel
@{ ViewData["Title"] = "Create Inspection Lot"; }

<div class="ent-form-wrapper">
    <div class="ent-org-banner">
        <div class="banner-icon"><i class="bi bi-clipboard-check"></i></div>
        <div class="banner-info">
            <h5>Create Inspection Lot</h5>
            <span>QA01 — Quality Inspection Lot</span>
        </div>
        <div class="banner-meta">
            Plant: 1000<br />Inspection Type: 01
        </div>
    </div>

    <form method="post">
        <input type="hidden" asp-for="Lot.Status" value="Pending" />

        <div class="ent-form-tabs">
            <button type="button" class="ent-form-tab active" data-tab="lotdata">
                <i class="bi bi-clipboard tab-icon"></i> Lot Data
            </button>
            <button type="button" class="ent-form-tab" data-tab="inspection">
                <i class="bi bi-search tab-icon"></i> Inspection Parameters
            </button>
            <button type="button" class="ent-form-tab" data-tab="samples">
                <i class="bi bi-droplet tab-icon"></i> Sample & Decision
            </button>
        </div>

        <!-- ═══ TAB: Lot Data ═══ -->
        <div class="ent-form-panel active" data-panel="lotdata">
            <div class="ent-section">
                <div class="ent-section-header"><i class="bi bi-clipboard"></i><h6>Lot Identification</h6></div>
                <div class="ent-field-grid cols-3">
                    <div class="ent-field">
                        <label>Lot Number</label>
                        <input class="form-control" value="Auto-generated" readonly />
                    </div>
                    <div class="ent-field">
                        <label>Inspection Type <span class="required">*</span></label>
                        <select class="form-select">
                            <option value="01">01 — Goods Receipt Inspection</option>
                            <option value="02">02 — In-Process Inspection</option>
                            <option value="04">04 — Final Inspection</option>
                            <option value="05">05 — Stock Transfer Inspection</option>
                            <option value="08">08 — Source Inspection</option>
                            <option value="09">09 — Delivery Inspection</option>
                        </select>
                    </div>
                    <div class="ent-field">
                        <label>Plant <span class="required">*</span></label>
                        <select class="form-select">
                            <option value="1000">1000 — Main Plant</option>
                            <option value="2000">2000 — Secondary Plant</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="ent-section">
                <div class="ent-section-header"><i class="bi bi-box"></i><h6>Material Information</h6></div>
                <div class="ent-field-grid cols-3">
                    <div class="ent-field">
                        <label>Material Name <span class="required">*</span></label>
                        <input asp-for="Lot.MaterialName" class="form-control" placeholder="Material description" />
                    </div>
                    <div class="ent-field">
                        <label>Batch Number</label>
                        <input type="text" class="form-control" placeholder="e.g. B-2026-001" />
                    </div>
                    <div class="ent-field">
                        <label>Quantity <span class="required">*</span></label>
                        <input asp-for="Lot.Quantity" class="form-control" type="number" step="0.01" min="0" />
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══ TAB: Inspection Parameters ═══ -->
        <div class="ent-form-panel" data-panel="inspection">
            <div class="ent-section">
                <div class="ent-section-header"><i class="bi bi-search"></i><h6>Inspection Plan & Scope</h6></div>
                <div class="ent-field-grid cols-3">
                    <div class="ent-field">
                        <label>Inspection Plan ID</label>
                        <select class="form-select">
                            <option value="">-- Select --</option>
                            <option value="QP-001">QP-001 — Raw Material Incoming</option>
                            <option value="QP-002">QP-002 — In-Process Check</option>
                            <option value="QP-003">QP-003 — Finished Good Final</option>
                            <option value="QP-004">QP-004 — Packaging Material</option>
                        </select>
                    </div>
                    <div class="ent-field">
                        <label>Assigned Inspector</label>
                        <select class="form-select">
                            <option value="">-- Select --</option>
                            <option value="INS-01">INS-01 — Dr. Smith</option>
                            <option value="INS-02">INS-02 — Dr. Patel</option>
                            <option value="INS-03">INS-03 — Dr. Kim</option>
                        </select>
                    </div>
                    <div class="ent-field">
                        <label>Scope (%)</label>
                        <input type="number" class="form-control" min="0" max="100" step="1" value="100" />
                    </div>
                </div>
            </div>
            <div class="ent-section">
                <div class="ent-section-header"><i class="bi bi-rulers"></i><h6>Characteristics</h6></div>
                <div class="ent-field-grid cols-3">
                    <div class="ent-field">
                        <label>Characteristic 1</label>
                        <input type="text" class="form-control" placeholder="e.g. Dimensional" />
                    </div>
                    <div class="ent-field">
                        <label>Characteristic 2</label>
                        <input type="text" class="form-control" placeholder="e.g. Visual" />
                    </div>
                    <div class="ent-field">
                        <label>Characteristic 3</label>
                        <input type="text" class="form-control" placeholder="e.g. Chemical" />
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══ TAB: Sample & Decision ═══ -->
        <div class="ent-form-panel" data-panel="samples">
            <div class="ent-section">
                <div class="ent-section-header"><i class="bi bi-droplet"></i><h6>Sampling</h6></div>
                <div class="ent-field-grid cols-3">
                    <div class="ent-field">
                        <label>Sample Size</label>
                        <input type="number" class="form-control" min="0" step="1" placeholder="e.g. 10" />
                    </div>
                    <div class="ent-field">
                        <label>Sampling Procedure</label>
                        <select class="form-select">
                            <option value="Fixed">Fixed Sample Size</option>
                            <option value="Random">Random Sampling</option>
                            <option value="Stratified">Stratified Sampling</option>
                        </select>
                    </div>
                    <div class="ent-field">
                        <label>Acceptance Number (Ac)</label>
                        <input type="number" class="form-control" min="0" value="0" />
                    </div>
                </div>
            </div>
            <div class="ent-section">
                <div class="ent-section-header"><i class="bi bi-check2-circle"></i><h6>Initial Results</h6></div>
                <div class="ent-field-grid cols-3">
                    <div class="ent-field">
                        <label>Inspected Qty</label>
                        <input asp-for="Lot.Inspected" class="form-control" type="number" min="0" value="0" />
                    </div>
                    <div class="ent-field">
                        <label>Passed Qty</label>
                        <input asp-for="Lot.Passed" class="form-control" type="number" min="0" value="0" />
                    </div>
                    <div class="ent-field">
                        <label>Failed Qty</label>
                        <input asp-for="Lot.Failed" class="form-control" type="number" min="0" value="0" />
                    </div>
                </div>
            </div>
            <div class="ent-section">
                <div class="ent-section-header"><i class="bi bi-toggle-on"></i><h6>Status</h6></div>
                <div class="ent-field-grid cols-2">
                    <div class="ent-field">
                        <label>Lot Status</label>
                        <select asp-for="Lot.Status" class="form-select">
                            <option value="Pending">Pending</option>
                            <option value="In Progress">In Progress</option>
                            <option value="Accepted">Accepted</option>
                            <option value="Rejected">Rejected</option>
                        </select>
                    </div>
                    <div class="ent-field">
                        <label>Stock Proposal</label>
                        <select class="form-select">
                            <option value="Unrestricted">Unrestricted Use</option>
                            <option value="Quality Hold">Quality Hold</option>
                            <option value="Blocked">Blocked Stock</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="ent-form-footer">
            <div class="footer-info">
                <i class="bi bi-shield-check me-1"></i>Inspection lot auto-numbered via QM/QA
            </div>
            <div class="footer-actions">
                <a asp-page="/QM/Index" class="btn btn-outline-secondary"><i class="bi bi-x me-1"></i>Cancel</a>
                <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Save Inspection Lot</button>
            </div>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
