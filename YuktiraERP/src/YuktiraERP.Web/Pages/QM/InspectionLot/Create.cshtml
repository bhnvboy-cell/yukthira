@page
@model YuktiraERP.Web.Pages.QM.InspectionLot.CreateModel
@{ ViewData["Title"] = "Create Inspection Lot"; }
<div class="ent-form-wrapper">
    <div class="ent-form-header">
        <h2><i class="bi bi-clipboard-plus me-2"></i>Create Inspection Lot</h2>
        <div class="ent-form-header-actions">
            <button type="submit" form="inspLotForm" class="btn btn-primary"><i class="bi bi-save me-1"></i>Save</button>
            <a asp-page="/QM/Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </div>
    <div class="ent-form-tabs" id="lotTabs">
        <button type="button" class="ent-tab active" data-tab="tabGeneral">General Data</button>
        <button type="button" class="ent-tab" data-tab="tabSource">Reference & Source</button>
        <button type="button" class="ent-tab" data-tab="tabSample">Sampling & Inspection</button>
    </div>
    <form id="inspLotForm" method="post">
        <div class="ent-form-panel active" data-panel="tabGeneral">
            <div class="ent-section">
                <div class="ent-section-title"><i class="bi bi-info-circle"></i> Lot Identification</div>
                <div class="ent-field-grid ent-grid-3">
                    <div class="ent-field">
                        <label asp-for="Lot.LotNumber" class="ent-label required">Inspection Lot Number</label>
                        <input asp-for="Lot.LotNumber" class="ent-input" required />
                    </div>
                    <div class="ent-field">
                        <label asp-for="Lot.InspectionType" class="ent-label">Inspection Type</label>
                        <select asp-for="Lot.InspectionType" class="ent-select">
                            <option value="01">01 - Goods Receipt Inspection</option>
                            <option value="02">02 - In-Process Inspection</option>
                            <option value="03">03 - Final Inspection</option>
                            <option value="04">04 - Source Inspection</option>
                            <option value="05">05 - Stock Transfer Inspection</option>
                            <option value="06">06 - Production Completion</option>
                            <option value="08">08 - Network Activity Inspection</option>
                        </select>
                    </div>
                    <div class="ent-field">
                        <label asp-for="Lot.Status" class="ent-label">Status</label>
                        <select asp-for="Lot.Status" class="ent-select">
                            <option>Created</option>
                            <option>In Testing</option>
                            <option>Completed</option>
                            <option>UD Made</option>
                            <option>Closed</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="ent-section">
                <div class="ent-section-title"><i class="bi bi-box-seam"></i> Material & Plant</div>
                <div class="ent-field-grid ent-grid-3">
                    <div class="ent-field">
                        <label asp-for="Lot.MaterialCode" class="ent-label required">Material Code</label>
                        <input asp-for="Lot.MaterialCode" class="ent-input" required />
                    </div>
                    <div class="ent-field">
                        <label asp-for="Lot.MaterialName" class="ent-label">Material Description</label>
                        <input asp-for="Lot.MaterialName" class="ent-input" />
                    </div>
                    <div class="ent-field">
                        <label asp-for="Lot.Plant" class="ent-label">Plant</label>
                        <select asp-for="Lot.Plant" class="ent-select">
                            <option value="1000">1000 - Manufacturing Plant</option>
                            <option value="2000">2000 - Warehouse Plant</option>
                            <option value="3000">3000 - Quality Plant</option>
                        </select>
                    </div>
                </div>
                <div class="ent-field-grid ent-grid-3">
                    <div class="ent-field">
                        <label asp-for="Lot.StorageLocation" class="ent-label">Storage Location</label>
                        <input asp-for="Lot.StorageLocation" class="ent-input" />
                    </div>
                    <div class="ent-field">
                        <label asp-for="Lot.BatchNumber" class="ent-label">Batch Number</label>
                        <input asp-for="Lot.BatchNumber" class="ent-input" />
                    </div>
                    <div class="ent-field">
                        <label asp-for="Lot.BaseUOM" class="ent-label">Base Unit of Measure</label>
                        <select asp-for="Lot.BaseUOM" class="ent-select">
                            <option value="EA">EA - Each</option>
                            <option value="KG">KG - Kilogram</option>
                            <option value="L">L - Liter</option>
                            <option value="M">M - Meter</option>
                            <option value="PC">PC - Piece</option>
                            <option value="SET">SET - Set</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="ent-form-panel" data-panel="tabSource" style="display:none">
            <div class="ent-section">
                <div class="ent-section-title"><i class="bi bi-link-45deg"></i> Reference Data</div>
                <div class="ent-field-grid ent-grid-2">
                    <div class="ent-field">
                        <label asp-for="Lot.ReferenceOrderNumber" class="ent-label">Reference Order Number</label>
                        <input asp-for="Lot.ReferenceOrderNumber" class="ent-input" />
                    </div>
                    <div class="ent-field">
                        <label asp-for="Lot.InspectionPlanID" class="ent-label">Inspection Plan ID</label>
                        <input asp-for="Lot.InspectionPlanID" class="ent-input" />
                    </div>
                </div>
            </div>
        </div>
        <div class="ent-form-panel" data-panel="tabSample" style="display:none">
            <div class="ent-section">
                <div class="ent-section-title"><i class="bi bi-layers"></i> Sampling</div>
                <div class="ent-field-grid ent-grid-3">
                    <div class="ent-field">
                        <label asp-for="Lot.Quantity" class="ent-label">Lot Quantity</label>
                        <input asp-for="Lot.Quantity" class="ent-input" type="number" />
                    </div>
                    <div class="ent-field">
                        <label asp-for="Lot.SampleSize" class="ent-label">Sample Size</label>
                        <input asp-for="Lot.SampleSize" class="ent-input" type="number" />
                    </div>
                    <div class="ent-field">
                        <label asp-for="Lot.AssignedInspector" class="ent-label">Assigned Inspector</label>
                        <input asp-for="Lot.AssignedInspector" class="ent-input" />
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
