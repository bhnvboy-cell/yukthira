@page "{id:Guid}"
@model YuktiraERP.Web.Pages.QM.InspectionLot.DisplayModel
@{ ViewData["Title"] = "Inspection Lot Details"; }
<link rel="stylesheet" href="~/css/enterprise-form.css" />
<div class="ent-form-wrapper">
    <div class="ent-form-header"><h3><svg class="bi bi-clipboard-check me-2" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-clipboard-check"></use></svg>Inspection Lot Details</h3><span class="badge">QM</span></div>
    <div class="ent-form-tabs">
        <button type="button" class="ent-form-tab active" onclick="showTab(this,'tab-general')"><svg class="bi bi-info-circle tab-icon" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-info-circle"></use></svg> General</button>
        <button type="button" class="ent-form-tab" onclick="showTab(this,'tab-material')"><svg class="bi bi-box tab-icon" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-box"></use></svg> Material & Plant</button>
        <button type="button" class="ent-form-tab" onclick="showTab(this,'tab-inspection')"><svg class="bi bi-search tab-icon" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-search"></use></svg> Inspection</button>
    </div>
    <div class="ent-form-panel active" id="tab-general">
        <div class="ent-section"><div class="ent-section-header"><svg class="bi bi-tag" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-tag"></use></svg> Lot Identification</div>
            <div class="ent-field-grid ent-grid-3">
                <div class="ent-field"><label>Lot Number</label><div class="ent-readonly">@Model.Lot.LotNumber</div></div>
                <div class="ent-field"><label>Inspection Type</label><div class="ent-readonly"><span class="qm-badge info">@Model.Lot.InspectionType</span></div></div>
                <div class="ent-field"><label>Status</label><div class="ent-readonly"><span class="qm-badge @(Model.Lot.Status=="Created"?"created":Model.Lot.Status=="In Testing"?"testing":Model.Lot.Status=="UD Made"?"ud-made":"closed")">@Model.Lot.Status</span></div></div>
            </div>
        </div>
    </div>
    <div class="ent-form-panel" id="tab-material">
        <div class="ent-section"><div class="ent-section-header"><svg class="bi bi-box" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-box"></use></svg> Material & Plant</div>
            <div class="ent-field-grid ent-grid-3">
                <div class="ent-field"><label>Material Code</label><div class="ent-readonly">@Model.Lot.MaterialCode</div></div>
                <div class="ent-field"><label>Material Name</label><div class="ent-readonly">@Model.Lot.MaterialName</div></div>
                <div class="ent-field"><label>Plant</label><div class="ent-readonly">@Model.Lot.Plant</div></div>
            </div>
            <div class="ent-field-grid ent-grid-3">
                <div class="ent-field"><label>Storage Location</label><div class="ent-readonly">@Model.Lot.StorageLocation</div></div>
                <div class="ent-field"><label>Batch Number</label><div class="ent-readonly">@Model.Lot.BatchNumber</div></div>
                <div class="ent-field"><label>Base UOM</label><div class="ent-readonly">@Model.Lot.BaseUOM</div></div>
            </div>
        </div>
    </div>
    <div class="ent-form-panel" id="tab-inspection">
        <div class="ent-section"><div class="ent-section-header"><svg class="bi bi-search" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-search"></use></svg> Inspection Data</div>
            <div class="ent-field-grid ent-grid-3">
                <div class="ent-field"><label>Quantity</label><div class="ent-readonly">@Model.Lot.Quantity</div></div>
                <div class="ent-field"><label>Sample Size</label><div class="ent-readonly">@Model.Lot.SampleSize</div></div>
                <div class="ent-field"><label>Inspector</label><div class="ent-readonly">@Model.Lot.AssignedInspector</div></div>
            </div>
        </div>
    </div>
    <div class="ent-form-actions">
        <a asp-page="/QM/Index" class="ent-btn ent-btn-secondary"><svg class="bi bi-arrow-left me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-arrow-left"></use></svg> Back</a>
        <a asp-page="/QM/InspectionLot/Edit" asp-route-id="@Model.Lot.Id" class="ent-btn ent-btn-primary"><svg class="bi bi-pencil me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-pencil"></use></svg> Edit</a>
    </div>
</div>
