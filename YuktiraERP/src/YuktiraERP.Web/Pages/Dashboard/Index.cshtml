@page
@model YuktiraERP.Web.Pages.Dashboard.IndexModel
@inject IStringLocalizer<SharedResources> L
@{
    ViewData["Title"] = L["Home"] + " - " + L["AppTitle"];
}

<div class="welcome-bar">
    <div>
        <h1>@L["WelcomeBack"] @(User.Identity?.Name ?? "User")</h1>
        <p>@L["SelectModule"]</p>
    </div>
    <div class="live-indicator" id="liveIndicator" title="@L["RealTimeActivity"]">
        <span class="live-dot"></span> @L["Live"]
    </div>
</div>

<div class="kpi-grid" id="kpiGrid">
    <div class="kpi-card color-green" style="cursor:default">
        <div class="kpi-top">
            <div class="kpi-icon"><svg class="bi bi-boxes" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-boxes"></use></svg></div>
            <span class="kpi-trend flat"><svg class="bi bi-dash" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-dash"></use></svg>0%</span>
        </div>
        <div class="kpi-value">--</div>
        <div class="kpi-label">Loading...</div>
    </div>
    <div class="kpi-card color-green" style="cursor:default">
        <div class="kpi-top">
            <div class="kpi-icon"><svg class="bi bi-cart3" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-cart3"></use></svg></div>
            <span class="kpi-trend flat">--</span>
        </div>
        <div class="kpi-value">--</div>
        <div class="kpi-label">Loading...</div>
    </div>
    <div class="kpi-card color-green" style="cursor:default">
        <div class="kpi-top">
            <div class="kpi-icon"><svg class="bi bi-gear" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-gear"></use></svg></div>
            <span class="kpi-trend flat">--</span>
        </div>
        <div class="kpi-value">--</div>
        <div class="kpi-label">Loading...</div>
    </div>
    <div class="kpi-card color-green" style="cursor:default">
        <div class="kpi-top">
            <div class="kpi-icon"><svg class="bi bi-clipboard-check" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-clipboard-check"></use></svg></div>
            <span class="kpi-trend flat">--</span>
        </div>
        <div class="kpi-value">--</div>
        <div class="kpi-label">Loading...</div>
    </div>
    <div class="kpi-card color-green" style="cursor:default">
        <div class="kpi-top">
            <div class="kpi-icon"><svg class="bi bi-clipboard2-pulse" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-clipboard2-pulse"></use></svg></div>
            <span class="kpi-trend flat">--</span>
        </div>
        <div class="kpi-value">--</div>
        <div class="kpi-label">Loading...</div>
    </div>
</div>

<div class="realtime-panel" id="realtimePanel" style="display:none">
    <div class="realtime-header">
        <svg class="bi bi-broadcast" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-broadcast"></use></svg> Real-Time Activity
        <button class="realtime-close" onclick="document.getElementById('realtimePanel').style.display='none'">&times;</button>
    </div>
    <div class="realtime-body" id="realtimeBody">
        <div class="realtime-empty">Waiting for live updates...</div>
    </div>
</div>

<div class="quick-actions">
    @foreach (var qa in Model.QuickActions)
    {
        <a href="@qa.Url" class="quick-action" title="@qa.Name">
            <div class="qa-icon" style="background:@qa.Color"><svg class="bi @qa.Icon" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#@qa.Icon"></use></svg></div>
            <span class="qa-label">@qa.Name</span>
        </a>
    }
</div>

<div class="tile-search">
    <svg class="bi bi-search search-icon" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-search"></use></svg>
    <input type="text" id="tileSearch" class="form-control" placeholder="Search modules by name, code, or category..." autocomplete="off">
</div>

<div class="category-filters" id="categoryFilters">
    <button class="category-filter active" data-cat="all">All <span class="count">@Model.Modules.Count</span></button>
    @foreach (var group in Model.Modules.GroupBy(m => m.Category))
    {
        <button class="category-filter" data-cat="@group.Key">@group.Key <span class="count">@group.Count()</span></button>
    }
</div>

<div id="favoritesSection" class="tile-section" style="display:none">
    <div class="tile-section-title"><svg class="bi bi-star-fill text-warning" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-star-fill"></use></svg> Pinned Modules</div>
    <div class="tile-grid" id="favoritesGrid"></div>
</div>

<div id="recentSection" class="tile-section" style="display:none">
    <div class="tile-section-title"><svg class="bi bi-clock-history" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-clock-history"></use></svg> Recently Used</div>
    <div class="mini-tile-grid" id="recentGrid"></div>
</div>

@foreach (var group in Model.Modules.GroupBy(m => m.Category))
{
    <div class="tile-section" data-category="@group.Key">
        <div class="tile-group-header">
            <div class="group-icon" style="background:@Model.CategoryColor(group.Key)"><svg class="bi @Model.CategoryIcon(group.Key)" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#@Model.CategoryIcon(group.Key)"></use></svg></div>
            <span class="group-label">@group.Key</span>
            <span class="group-count">@group.Count() modules</span>
        </div>
        <div class="tile-grid">
            @foreach (var m in group)
            {
                <a href="@m.Url" class="tile-card" data-code="@m.Code" data-name="@m.Name" data-category="@m.Category" data-color="@m.Color">
                    <div class="tile-icon" style="background:@m.Color"><svg class="bi @m.Icon" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#@m.Icon"></use></svg></div>
                    <div class="tile-label">@m.Code</div>
                    <div class="tile-sub">@m.Name</div>
                    <button class="tile-fav" data-code="@m.Code" title="Pin module"><svg class="bi bi-star" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-star"></use></svg></button>
                </a>
            }
        </div>
    </div>
}

@section Scripts {
<script>
    // â”€â”€ KPI Cards load â”€â”€
    (function() {
        var kpiGrid = document.getElementById('kpiGrid');
        if (!kpiGrid) return;
        fetch('/api/v1/kpi/dashboard')
            .then(function(r) { return r.json(); })
            .then(function(kpis) {
                if (!kpis || !kpis.length) return;
                var html = '';
                kpis.forEach(function(k) {
                    var trendIcon = k.trend === 'up' ? 'bi-arrow-up' : k.trend === 'down' ? 'bi-arrow-down' : 'bi-dash';
                    var alertHtml = k.alertMessage ? '<div class="kpi-alert"><svg class="bi bi-exclamation-triangle" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-exclamation-triangle"></use></svg> ' + k.alertMessage + '</div>' : '';
                    html += '<a href="' + k.drillDownUrl + '" class="kpi-card color-' + k.color + '" title="View ' + k.label + ' details">';
                    html += '<div class="kpi-top">';
        html += '<div class="kpi-icon"><svg class="bi ' + k.icon + '" aria-hidden="true"><use href="/images/sprite.svg#' + k.icon + '"></use></svg></div>';
                html += '<span class="kpi-trend ' + k.trend + '"><svg class="bi ' + trendIcon + '" aria-hidden="true"><use href="/images/sprite.svg#' + trendIcon + '"></use></svg> ' + k.trendLabel + '</span>';
                    html += '</div>';
                    html += '<div class="kpi-value">' + k.displayValue + '</div>';
                    html += '<div class="kpi-label">' + k.label + '</div>';
                    html += alertHtml;
                    html += '</a>';
                });
                kpiGrid.innerHTML = html;
            });
    })();

    // â”€â”€ KPI Badges on tiles â”€â”€
    (function() {
        fetch('/api/v1/kpi/module-badges')
            .then(function(r) { return r.json(); })
            .then(function(badges) {
                if (!badges || !badges.length) return;
                badges.forEach(function(b) {
                    var tiles = document.querySelectorAll('.tile-card[data-code="' + b.moduleCode + '"]');
                    tiles.forEach(function(tile) {
                        var badge = document.createElement('div');
                        badge.className = 'kpi-badge ' + b.color;
                        var trendIcon = b.trend === 'up' ? '&#9650;' : b.trend === 'down' ? '&#9660;' : '';
                        badge.innerHTML = b.value + (trendIcon ? ' <span class="badge-trend">' + trendIcon + '</span>' : '');
                        tile.appendChild(badge);
                    });
                });
            });
    })();

    // â”€â”€ Tile favorites (localStorage) â”€â”€
    var FAV_KEY = 'yuktira_favorites';
    var RECENT_KEY = 'yuktira_recent';

    function getFavorites() {
        try { return JSON.parse(localStorage.getItem(FAV_KEY)) || []; } catch(e) { return []; }
    }
    function setFavorites(arr) {
        localStorage.setItem(FAV_KEY, JSON.stringify(arr));
    }
    function getRecent() {
        try { return JSON.parse(localStorage.getItem(RECENT_KEY)) || []; } catch(e) { return []; }
    }
    function setRecent(arr) {
        localStorage.setItem(RECENT_KEY, JSON.stringify(arr.slice(0, 5)));
    }

    function addRecent(code) {
        var arr = getRecent().filter(function(c) { return c !== code; });
        arr.unshift(code);
        setRecent(arr);
    }

    function isFav(code) {
        return getFavorites().indexOf(code) !== -1;
    }

    function toggleFav(code) {
        var arr = getFavorites();
        var idx = arr.indexOf(code);
        if (idx === -1) { arr.push(code); } else { arr.splice(idx, 1); }
        setFavorites(arr);
        renderFavorites();
        renderFavButtons();
    }

    function renderFavButtons() {
        var favs = getFavorites();
        document.querySelectorAll('.tile-fav').forEach(function(btn) {
            var code = btn.getAttribute('data-code');
            if (favs.indexOf(code) !== -1) {
                btn.classList.add('active');
                var sv = btn.querySelector('svg');
                if (sv) { sv.setAttribute('class', 'bi bi-star-fill'); sv.querySelector('use').setAttribute('href', '/images/sprite.svg#bi-star-fill'); }
            } else {
                btn.classList.remove('active');
                var sv2 = btn.querySelector('svg');
                if (sv2) { sv2.setAttribute('class', 'bi bi-star'); sv2.querySelector('use').setAttribute('href', '/images/sprite.svg#bi-star'); }
            }
        });
    }

    function renderFavorites() {
        var favs = getFavorites();
        var section = document.getElementById('favoritesSection');
        var grid = document.getElementById('favoritesGrid');
        if (!favs.length) { section.style.display = 'none'; return; }
        section.style.display = '';
        var html = '';
        var META_KEY = 'yuktira_fav_meta';
        var meta = {};
        try { meta = JSON.parse(localStorage.getItem(META_KEY)) || {}; } catch(e) {}
        favs.forEach(function(code) {
            // Try on-page tile first, then metadata from localStorage
            var tile = document.querySelector('.tile-card[data-code="' + code + '"]');
            if (tile) {
                html += tile.outerHTML;
            } else if (meta[code]) {
                var m = meta[code];
                var moduleColors = { MM:'#4f46e5', SD:'#0891b2', PP:'#7c3aed', QM:'#059669', FI:'#dc2626', CO:'#ea580c', HR:'#2563eb', WM:'#6b21a8', CRM:'#0d9488', LIMS:'#4338ca', BI:'#be185d', PS:'#1d4ed8', PM:'#b45309', AI:'#6d28d9', WF:'#0f766e', PLG:'#9333ea' };
                var bgColor = moduleColors[m.module] || '#4f46e5';
                html += '<a href="' + m.route + '" class="tile-card" data-code="' + m.code + '">';
                html += '<div class="tile-icon" style="background:' + bgColor + '"><svg class="bi ' + m.icon + '" aria-hidden="true"><use href="/images/sprite.svg#' + m.icon + '"></use></svg></div>';
                html += '<div class="tile-label">' + m.code + '</div>';
                html += '<div class="tile-sub">' + m.name + '</div>';
                html += '</a>';
            }
        });
        grid.innerHTML = html;
        grid.querySelectorAll('.tile-card').forEach(function(card) {
            card.addEventListener('click', function() {
                addRecent(this.getAttribute('data-code'));
            });
        });
    }

    function renderRecent() {
        var recents = getRecent();
        var section = document.getElementById('recentSection');
        var grid = document.getElementById('recentGrid');
        if (!recents.length) { section.style.display = 'none'; return; }
        section.style.display = '';
        var html = '';
        recents.forEach(function(code) {
            var tile = document.querySelector('.tile-card[data-code="' + code + '"]');
            if (tile) {
                var bg = tile.querySelector('.tile-icon').style.background;
                var iconSvg = tile.querySelector('.tile-icon svg');
                var icon = iconSvg ? iconSvg.getAttribute('class') : 'bi bi-grid-3x3-gap';
                var iconId = (icon.match(/bi-[a-z0-9-]+/) || [''])[0];
                var name = tile.getAttribute('data-name');
                var url = tile.getAttribute('href');
                var cat = tile.getAttribute('data-category');
                html += '<a href="' + url + '" class="mini-tile-card" data-code="' + code + '" data-name="' + name + '" data-category="' + cat + '">';
                html += '<div class="mini-icon" style="background:' + bg + '"><svg class="' + icon + '" aria-hidden="true"><use href="/images/sprite.svg#' + iconId + '"></use></svg></div>';
                html += '<div><div class="mini-label">' + code + '</div><div class="mini-sub">' + name + '</div></div>';
                html += '</a>';
            }
        });
        grid.innerHTML = html;
        grid.querySelectorAll('.mini-tile-card').forEach(function(card) {
            card.addEventListener('click', function() {
                addRecent(this.getAttribute('data-code'));
            });
        });
    }

    // â”€â”€ Fuzzy match â”€â”€
    function fuzzyMatch(text, query) {
        if (!query) return true;
        text = text.toLowerCase();
        query = query.toLowerCase().trim();
        if (text.indexOf(query) !== -1) return true;
        var qi = 0;
        for (var i = 0; i < text.length && qi < query.length; i++) {
            if (text[i] === query[qi]) qi++;
        }
        return qi === query.length;
    }

    function escapeRegex(str) {
        return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    }

    function highlightText(text, query) {
        if (!query || !query.trim()) return text;
        var escaped = escapeRegex(query.trim());
        var re = new RegExp('(' + escaped.split('').join('.*?') + '|' + escaped + ')', 'gi');
        return text.replace(re, '<mark class="highlight">$1</mark>');
    }

    // â”€â”€ Tile search + filter â”€â”€
    var currentCategory = 'all';

    function filterTiles(val) {
        var q = val.toLowerCase().trim();
        var hasQuery = q.length > 0;

        document.querySelectorAll('.tile-section[data-category]').forEach(function(section) {
            var cat = section.getAttribute('data-category');
            var matchesCat = currentCategory === 'all' || cat === currentCategory;
            var visibleCount = 0;

            section.querySelectorAll('.tile-card').forEach(function(card) {
                var code = (card.getAttribute('data-code') || '').toLowerCase();
                var name = (card.getAttribute('data-name') || '').toLowerCase();
                var catAttr = (card.getAttribute('data-category') || '').toLowerCase();

                var matchesSearch = !hasQuery ||
                    fuzzyMatch(code, q) ||
                    fuzzyMatch(name, q) ||
                    fuzzyMatch(catAttr, q);

                if (matchesCat && matchesSearch) {
                    card.style.display = '';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }

                var sub = card.querySelector('.tile-sub');
                if (sub && hasQuery) {
                    var origName = card.getAttribute('data-name');
                    var qq = q;
                    if (fuzzyMatch(origName, qq)) {
                        sub.innerHTML = highlightText(origName, qq);
                    } else {
                        sub.textContent = origName;
                    }
                } else if (sub) {
                    sub.textContent = card.getAttribute('data-name');
                }

                var label = card.querySelector('.tile-label');
                if (label && hasQuery) {
                    var origCode = card.getAttribute('data-code');
                    if (fuzzyMatch(origCode, qq || q)) {
                        label.innerHTML = highlightText(origCode, qq || q);
                    } else {
                        label.textContent = origCode;
                    }
                }
            });

            if (matchesCat && visibleCount === 0) {
                section.style.display = 'none';
            } else if (matchesCat) {
                section.style.display = '';
            }
        });

        document.querySelectorAll('#favoritesGrid .tile-card, #recentGrid .mini-tile-card').forEach(function(card) {
            var code = (card.getAttribute('data-code') || '').toLowerCase();
            var name = (card.getAttribute('data-name') || '').toLowerCase();
            if (!hasQuery || fuzzyMatch(code, q) || fuzzyMatch(name, q)) {
                card.style.display = '';
            } else {
                card.style.display = 'none';
            }
        });
    }

    // â”€â”€ Category filter chips â”€â”€
    document.querySelectorAll('.category-filter').forEach(function(btn) {
        btn.addEventListener('click', function() {
            document.querySelectorAll('.category-filter').forEach(function(b) { b.classList.remove('active'); });
            this.classList.add('active');
            currentCategory = this.getAttribute('data-cat');
            var searchVal = document.getElementById('tileSearch').value;
            filterTiles(searchVal);
        });
    });

    // â”€â”€ Search input â”€â”€
    $('#tileSearch').on('input', function() { filterTiles(this.value); });

    // â”€â”€ Tile click â†’ track recent â”€â”€
    document.querySelectorAll('.tile-card').forEach(function(card) {
        card.addEventListener('click', function() {
            addRecent(this.getAttribute('data-code'));
        });
    });

    // â”€â”€ Fav buttons â”€â”€
    document.querySelectorAll('.tile-fav').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
            e.preventDefault(); e.stopPropagation();
            toggleFav(this.getAttribute('data-code'));
        });
    });

    // â”€â”€ Init â”€â”€
    renderFavorites();
    renderRecent();
    renderFavButtons();

    // â”€â”€ SignalR Real-Time Dashboard â”€â”€
    (function() {
        var connection = new signalR.HubConnectionBuilder()
            .withUrl('/hubs/dashboard')
            .withAutomaticReconnect([0, 2000, 5000, 10000])
            .build();

        var panel = document.getElementById('realtimePanel');
        var body = document.getElementById('realtimeBody');
        var indicator = document.getElementById('liveIndicator');
        var eventCount = 0;

        connection.on('DashboardUpdate', function(data) {
            if (!panel) return;
            panel.style.display = '';
            if (indicator) indicator.classList.add('connected');
            var empty = body.querySelector('.realtime-empty');
            if (empty) empty.remove();

            var item = document.createElement('div');
            item.className = 'realtime-item';
            var time = new Date(data.timestamp).toLocaleTimeString();
            item.innerHTML = '<span class="rt-time">' + time + '</span>' +
                '<span class="rt-msg">Materials: ' + data.materials +
                ' | Stock: â‚¹' + (data.stockValue || 0).toLocaleString() +
                ' | Revenue: â‚¹' + (data.totalRevenue || 0).toLocaleString() +
                ' | Open Orders: ' + data.openOrders +
                ' | QM Pass: ' + data.qmPassRate + '%</span>';
            body.insertBefore(item, body.firstChild);
            eventCount++;
            if (eventCount > 50) { body.removeChild(body.lastChild); }
        });

        connection.on('StockChange', function(data) {
            addRealtimeEvent('ðŸ“¦ Stock: ' + data.materialName + ' changed from ' + data.oldQuantity + ' to ' + data.newQuantity, 'warning');
        });

        connection.on('OrderUpdate', function(data) {
            addRealtimeEvent('ðŸ“‹ ' + data.orderType + ' ' + data.orderNumber + ' â†’ ' + data.status, 'info');
        });

        connection.on('ProductionUpdate', function(data) {
            addRealtimeEvent('ðŸ­ Production ' + data.orderNumber + ': ' + data.status + ' (' + data.progress + '%)', 'info');
        });

        connection.on('QualityAlert', function(data) {
            addRealtimeEvent('âœ… Quality Lot ' + data.lotNumber + ': ' + data.result, 'success');
        });

        connection.on('SoxViolation', function(data) {
            addRealtimeEvent('ðŸš¨ SOX Violation: ' + data.violationType + ' by ' + data.userId + ' [' + data.severity + ']', 'danger');
        });

        connection.on('AnomalyDetected', function(data) {
            addRealtimeEvent('âš ï¸ Anomaly: ' + data.anomalyType + ' in ' + data.entityName, 'warning');
        });

        function addRealtimeEvent(msg, type) {
            if (!panel) return;
            panel.style.display = '';
            if (indicator) indicator.classList.add('connected');
            var empty = body.querySelector('.realtime-empty');
            if (empty) empty.remove();

            var item = document.createElement('div');
            item.className = 'realtime-item rt-' + type;
            var time = new Date().toLocaleTimeString();
            item.innerHTML = '<span class="rt-time">' + time + '</span><span class="rt-msg">' + msg + '</span>';
            body.insertBefore(item, body.firstChild);
            eventCount++;
            if (eventCount > 50) { body.removeChild(body.lastChild); }
        }

        connection.start().catch(function() {
            if (indicator) indicator.classList.remove('connected');
        });

        // Periodic dashboard refresh via SignalR
        setInterval(function() {
            if (connection.state === signalR.HubConnectionState.Connected) {
                connection.invoke('RequestDashboardUpdate').catch(function() {});
            }
        }, 30000);
    })();
</script>
}
