@page
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "AdminOrAbove")]
@{
    ViewData["Title"] = "Administration";
}
<h2><svg class="bi bi-gear-wide me-2" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-gear-wide"></use></svg>Administration</h2>
<div class="row g-3 mt-2">
    <div class="col-md-3"><a asp-page="/Admin/Users" class="text-decoration-none"><div class="card text-center p-3 h-100"><svg class="bi bi-people display-6 text-primary" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-people"></use></svg><h6 class="mt-2">User Management</h6></div></a></div>
    <div class="col-md-3"><a asp-page="/Admin/Plugins" class="text-decoration-none"><div class="card text-center p-3 h-100"><svg class="bi bi-puzzle display-6 text-primary" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-puzzle"></use></svg><h6 class="mt-2">Plugin Manager</h6></div></a></div>
    <div class="col-md-3"><a asp-page="/Admin/SystemConfig" class="text-decoration-none"><div class="card text-center p-3 h-100"><svg class="bi bi-sliders display-6 text-primary" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-sliders"></use></svg><h6 class="mt-2">System Config</h6></div></a></div>
    <div class="col-md-3"><a asp-page="/Admin/Tenants" class="text-decoration-none"><div class="card text-center p-3 h-100"><svg class="bi bi-building display-6 text-primary" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-building"></use></svg><h6 class="mt-2">Tenant Management</h6></div></a></div>
    <div class="col-md-3"><a asp-page="/Admin/DataSync" class="text-decoration-none"><div class="card text-center p-3 h-100"><svg class="bi bi-arrow-left-right display-6 text-primary" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-arrow-left-right"></use></svg><h6 class="mt-2">Data Sync</h6></div></a></div>
    <div class="col-md-3"><a asp-page="/Admin/RoleManager" class="text-decoration-none"><div class="card text-center p-3 h-100"><svg class="bi bi-shield-lock display-6 text-primary" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-shield-lock"></use></svg><h6 class="mt-2">Role Manager</h6></div></a></div>
    <div class="col-md-3"><a asp-page="/Admin/MdgGovernance" class="text-decoration-none"><div class="card text-center p-3 h-100"><svg class="bi bi-diagram-3 display-6 text-primary" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-diagram-3"></use></svg><h6 class="mt-2">MDG Governance</h6></div></a></div>
    <div class="col-md-3"><a asp-page="/Admin/EdiWorkbench" class="text-decoration-none"><div class="card text-center p-3 h-100"><svg class="bi bi-arrow-left-right display-6 text-primary" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-arrow-left-right"></use></svg><h6 class="mt-2">EDI Workbench</h6></div></a></div>
    <div class="col-md-3"><a asp-page="/Admin/CurrencyRates" class="text-decoration-none"><div class="card text-center p-3 h-100"><svg class="bi bi-currency-dollar display-6 text-primary" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-currency-dollar"></use></svg><h6 class="mt-2">Exchange Rates</h6></div></a></div>
    <div class="col-md-3"><a asp-page="/Admin/AccessMatrix" class="text-decoration-none"><div class="card text-center p-3 h-100"><svg class="bi bi-grid-3x3-gap display-6 text-primary" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-grid-3x3-gap"></use></svg><h6 class="mt-2">Access Matrix</h6></div></a></div>
    <div class="col-md-3"><a asp-page="/Admin/TCodeAuthorization" class="text-decoration-none"><div class="card text-center p-3 h-100"><svg class="bi bi-key display-6 text-primary" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-key"></use></svg><h6 class="mt-2">T-Code Authorization</h6></div></a></div>
    <div class="col-md-3"><a asp-page="/Admin/AuthTrace" class="text-decoration-none"><div class="card text-center p-3 h-100"><svg class="bi bi-clock-history display-6 text-primary" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-clock-history"></use></svg><h6 class="mt-2">Authorization Trace</h6></div></a></div>
    <div class="col-md-3"><a asp-page="/Admin/RoleWorkbench" class="text-decoration-none"><div class="card text-center p-3 h-100"><svg class="bi bi-list-check display-6 text-primary" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-list-check"></use></svg><h6 class="mt-2">Role &amp; T-Code Workbench</h6></div></a></div>
    <div class="col-md-3"><a asp-page="/Admin/SoxCompliance" class="text-decoration-none"><div class="card text-center p-3 h-100"><svg class="bi bi-shield-check display-6 text-primary" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-shield-check"></use></svg><h6 class="mt-2">SOX Compliance</h6></div></a></div>
    <div class="col-md-3"><a asp-page="/Dashboard/DynamicCanvas" class="text-decoration-none"><div class="card text-center p-3 h-100"><svg class="bi bi-palette display-6 text-primary" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-palette"></use></svg><h6 class="mt-2">Dynamic Dashboard</h6></div></a></div>
    <div class="col-md-3"><a asp-page="/Admin/WorkflowDesigner" class="text-decoration-none"><div class="card text-center p-3 h-100"><svg class="bi bi-kanban display-6 text-primary" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-kanban"></use></svg><h6 class="mt-2">Workflow Designer</h6></div></a></div>
</div>
