@page "{id:guid}"
@model YuktiraERP.Web.Pages.PM.Equipment.DisplayModel
@{
    ViewData["Title"] = "Display Equipment";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-tools me-2"></i>Equipment: @Model.Equipment.EquipmentCode</h2>
    <a asp-page="/PM/Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back</a>
</div>
<div class="card"><div class="card-body">
    <table class="table table-bordered">
        <tr><th style="width:200px">Equipment Code</th><td>@Model.Equipment.EquipmentCode</td></tr>
        <tr><th>Name</th><td>@Model.Equipment.Name</td></tr>
        <tr><th>Type</th><td>@Model.Equipment.Type</td></tr>
        <tr><th>Location</th><td>@Model.Equipment.Location</td></tr>
        <tr><th>Department</th><td>@Model.Equipment.Department</td></tr>
        <tr><th>Status</th><td><span class="badge @(Model.Equipment.Status=="Operational"?"bg-success":"bg-warning")">@Model.Equipment.Status</span></td></tr>
    </table>
</div></div>
