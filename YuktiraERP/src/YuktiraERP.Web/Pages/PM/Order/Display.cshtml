@page
@model YuktiraERP.Web.Pages.PM.Order.DisplayModel
@using YuktiraERP.Infrastructure.Data.Entities
@{ ViewData["Title"] = "MaintenanceOrder Details"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-info text-white"><h5 class="mb-0"><i class="bi bi-eye me-2"></i>MaintenanceOrder Details</h5></div>
<div class="card-body">
<dl class="row mb-0"><dt class="col-sm-4">OrderNumber</dt><dd class="col-sm-8">@(Model.Order.OrderNumber)</dd><dt class="col-sm-4">EquipmentCode</dt><dd class="col-sm-8">@(Model.Order.EquipmentCode)</dd><dt class="col-sm-4">Description</dt><dd class="col-sm-8">@(Model.Order.Description)</dd><dt class="col-sm-4">Priority</dt><dd class="col-sm-8">@(Model.Order.Priority)</dd><dt class="col-sm-4">ScheduledStartDate</dt><dd class="col-sm-8">@(Model.Order.ScheduledStartDate)</dd><dt class="col-sm-4">CompletedDate</dt><dd class="col-sm-8">@(Model.Order.CompletedDate)</dd><dt class="col-sm-4">Cost</dt><dd class="col-sm-8">@(Model.Order.Cost)</dd><dt class="col-sm-4">Status</dt><dd class="col-sm-8">@(Model.Order.Status)</dd></dl>
</div>
<div class="card-footer">
<a href="/PM/Order/List" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
<a href="/PM/Order/Edit?id=@(Model.Order.Id)" class="btn btn-warning"><i class="bi bi-pencil me-1"></i>Edit</a>
</div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

