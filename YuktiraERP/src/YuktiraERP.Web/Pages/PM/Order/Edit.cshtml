@page
@model YuktiraERP.Web.Pages.PM.Order.EditModel
@{ ViewData["Title"] = "Edit MaintenanceOrder"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-warning text-dark"><h5 class="mb-0"><i class="bi bi-pencil me-2"></i>Edit MaintenanceOrder</h5></div>
<div class="card-body">
<form method="post">
<input type="hidden" asp-for="Order.Id" />
<div class="row mb-3"><div class="col-md-6"><label asp-for="Order.OrderNumber" class="form-label"></label><input asp-for="Order.OrderNumber" class="form-control" type="text" /></div><div class="col-md-6"><label asp-for="Order.EquipmentCode" class="form-label"></label><input asp-for="Order.EquipmentCode" class="form-control" type="text" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="Order.Description" class="form-label"></label><input asp-for="Order.Description" class="form-control" type="text" /></div><div class="col-md-6"><label asp-for="Order.Priority" class="form-label"></label><input asp-for="Order.Priority" class="form-control" type="text" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="Order.ScheduledStartDate" class="form-label"></label><input asp-for="Order.ScheduledStartDate" class="form-control" type="datetime-local" /></div><div class="col-md-6"><label asp-for="Order.CompletedDate" class="form-label"></label><input asp-for="Order.CompletedDate" class="form-control" type="datetime-local" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="Order.Cost" class="form-label"></label><input asp-for="Order.Cost" class="form-control" type="number" step="0.01" /></div><div class="col-md-6"><label asp-for="Order.Status" class="form-label"></label><input asp-for="Order.Status" class="form-control" type="text" /></div></div>
<div class="d-flex gap-2"><button type="submit" class="btn btn-warning"><i class="bi bi-save me-1"></i>Update</button><a href="/PM/Order/List" class="btn btn-outline-secondary"><i class="bi bi-x me-1"></i>Cancel</a></div>
</form>
</div></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

