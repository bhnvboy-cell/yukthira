@page
@model YuktiraERP.Web.Pages.PM.Spares.CreateModel
@{ ViewData["Title"] = "Issue Spares"; }
<div class="ent-form-wrapper">
    <div class="ent-form-header">
        <h2><i class="bi bi-box-seam me-2"></i>Issue Spares & Parts</h2>
        <div class="ent-form-header-actions">
            <button type="submit" form="spareForm" class="btn btn-primary"><i class="bi bi-save me-1"></i>Save</button>
            <a asp-page="/PM/Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </div>
    <div class="ent-form-tabs" id="spareTabs">
        <button type="button" class="ent-tab active" data-tab="tabRef">Reference</button>
        <button type="button" class="ent-tab" data-tab="tabMaterial">Material Details</button>
    </div>
    <form id="spareForm" method="post">
        <div class="ent-form-panel active" data-panel="tabRef">
            <div class="ent-section">
                <div class="ent-section-title"><i class="bi bi-link-45deg"></i> Order & Equipment Reference</div>
                <div class="ent-field-grid ent-grid-3">
                    <div class="ent-field">
                        <label asp-for="Spare.MaterialCode" class="ent-label required">Material Code</label>
                        <input asp-for="Spare.MaterialCode" class="ent-input" required />
                    </div>
                    <div class="ent-field">
                        <label asp-for="Spare.MaterialName" class="ent-label required">Material Name</label>
                        <input asp-for="Spare.MaterialName" class="ent-input" required />
                    </div>
                    <div class="ent-field">
                        <label asp-for="Spare.OrderNumber" class="ent-label">Maintenance Order #</label>
                        <input asp-for="Spare.OrderNumber" class="ent-input" />
                    </div>
                </div>
                <div class="ent-field-grid ent-grid-3">
                    <div class="ent-field">
                        <label asp-for="Spare.EquipmentCode" class="ent-label">Equipment ID</label>
                        <input asp-for="Spare.EquipmentCode" class="ent-input" />
                    </div>
                    <div class="ent-field">
                        <label asp-for="Spare.Plant" class="ent-label">Plant</label>
                        <select asp-for="Spare.Plant" class="ent-select">
                            <option value="1000">1000</option>
                            <option value="2000">2000</option>
                            <option value="3000">3000</option>
                        </select>
                    </div>
                    <div class="ent-field">
                        <label asp-for="Spare.StorageLocation" class="ent-label">Storage Location</label>
                        <input asp-for="Spare.StorageLocation" class="ent-input" />
                    </div>
                </div>
            </div>
        </div>
        <div class="ent-form-panel" data-panel="tabMaterial" style="display:none">
            <div class="ent-section">
                <div class="ent-section-title"><i class="bi bi-box"></i> Material & Quantity</div>
                <div class="ent-field-grid ent-grid-3">
                    <div class="ent-field">
                        <label asp-for="Spare.RequiredQuantity" class="ent-label">Required Quantity</label>
                        <input asp-for="Spare.RequiredQuantity" class="ent-input" type="number" step="0.01" />
                    </div>
                    <div class="ent-field">
                        <label asp-for="Spare.IssuedQuantity" class="ent-label">Issued Quantity</label>
                        <input asp-for="Spare.IssuedQuantity" class="ent-input" type="number" step="0.01" />
                    </div>
                    <div class="ent-field">
                        <label asp-for="Spare.UOM" class="ent-label">Unit of Measure</label>
                        <select asp-for="Spare.UOM" class="ent-select">
                            <option>EA</option>
                            <option>KG</option>
                            <option>L</option>
                            <option>M</option>
                            <option>SET</option>
                        </select>
                    </div>
                </div>
                <div class="ent-field-grid ent-grid-3">
                    <div class="ent-field">
                        <label asp-for="Spare.UnitPrice" class="ent-label">Unit Price</label>
                        <input asp-for="Spare.UnitPrice" class="ent-input" type="number" step="0.01" />
                    </div>
                    <div class="ent-field">
                        <label asp-for="Spare.Description" class="ent-label">Description</label>
                        <input asp-for="Spare.Description" class="ent-input" />
                    </div>
                    <div class="ent-field">
                        <label asp-for="Spare.Status" class="ent-label">Status</label>
                        <select asp-for="Spare.Status" class="ent-select">
                            <option>Reserved</option>
                            <option>Issued</option>
                            <option>Returned</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
