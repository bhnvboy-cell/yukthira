@page
@model YuktiraERP.Web.Pages.PM.Plan.DisplayModel
@using YuktiraERP.Infrastructure.Data.Entities
@{ ViewData["Title"] = "MaintenancePlan Details"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-info text-white"><h5 class="mb-0"><i class="bi bi-eye me-2"></i>MaintenancePlan Details</h5></div>
<div class="card-body">
<dl class="row mb-0"><dt class="col-sm-4">PlanCode</dt><dd class="col-sm-8">@(Model.Plan.PlanCode)</dd><dt class="col-sm-4">Name</dt><dd class="col-sm-8">@(Model.Plan.Name)</dd><dt class="col-sm-4">EquipmentCode</dt><dd class="col-sm-8">@(Model.Plan.EquipmentCode)</dd><dt class="col-sm-4">Frequency</dt><dd class="col-sm-8">@(Model.Plan.Frequency)</dd><dt class="col-sm-4">TaskDescription</dt><dd class="col-sm-8">@(Model.Plan.TaskDescription)</dd><dt class="col-sm-4">EstimatedHours</dt><dd class="col-sm-8">@(Model.Plan.EstimatedHours)</dd><dt class="col-sm-4">Status</dt><dd class="col-sm-8">@(Model.Plan.Status)</dd></dl>
</div>
<div class="card-footer">
<a href="/PM/Plan/List" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
<a href="/PM/Plan/Edit?id=@(Model.Plan.Id)" class="btn btn-warning"><i class="bi bi-pencil me-1"></i>Edit</a>
</div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

