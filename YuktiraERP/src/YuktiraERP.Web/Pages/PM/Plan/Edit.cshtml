@page
@model YuktiraERP.Web.Pages.PM.Plan.EditModel
@{ ViewData["Title"] = "Edit MaintenancePlan"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-warning text-dark"><h5 class="mb-0"><i class="bi bi-pencil me-2"></i>Edit MaintenancePlan</h5></div>
<div class="card-body">
<form method="post">
<input type="hidden" asp-for="Plan.Id" />
<div class="row mb-3"><div class="col-md-6"><label asp-for="Plan.PlanCode" class="form-label"></label><input asp-for="Plan.PlanCode" class="form-control" type="text" /></div><div class="col-md-6"><label asp-for="Plan.Name" class="form-label"></label><input asp-for="Plan.Name" class="form-control" type="text" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="Plan.EquipmentCode" class="form-label"></label><input asp-for="Plan.EquipmentCode" class="form-control" type="text" /></div><div class="col-md-6"><label asp-for="Plan.Frequency" class="form-label"></label><input asp-for="Plan.Frequency" class="form-control" type="text" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="Plan.TaskDescription" class="form-label"></label><input asp-for="Plan.TaskDescription" class="form-control" type="text" /></div><div class="col-md-6"><label asp-for="Plan.EstimatedHours" class="form-label"></label><input asp-for="Plan.EstimatedHours" class="form-control" type="number" step="0.01" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="Plan.Status" class="form-label"></label><input asp-for="Plan.Status" class="form-control" type="text" /></div><div class="col-md-6"></div></div>
<div class="d-flex gap-2"><button type="submit" class="btn btn-warning"><i class="bi bi-save me-1"></i>Update</button><a href="/PM/Plan/List" class="btn btn-outline-secondary"><i class="bi bi-x me-1"></i>Cancel</a></div>
</form>
</div></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

