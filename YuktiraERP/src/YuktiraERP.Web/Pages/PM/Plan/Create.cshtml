@page
@model YuktiraERP.Web.Pages.PM.Plan.CreateModel
@{ ViewData["Title"] = "Create Maintenance Plan"; }
<div class="ent-form-wrapper">
    <div class="ent-form-header">
        <h2><i class="bi bi-calendar-check me-2"></i>Create Maintenance Plan</h2>
        <div class="ent-form-header-actions">
            <button type="submit" form="planForm" class="btn btn-primary"><i class="bi bi-save me-1"></i>Save</button>
            <a asp-page="/PM/Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </div>
    <div class="ent-form-tabs" id="planTabs">
        <button type="button" class="ent-tab active" data-tab="tabGeneral">General Data</button>
        <button type="button" class="ent-tab" data-tab="tabSchedule">Scheduling & Frequency</button>
    </div>
    <form id="planForm" method="post">
        <div class="ent-form-panel active" data-panel="tabGeneral">
            <div class="ent-section">
                <div class="ent-section-title"><i class="bi bi-info-circle"></i> Plan Identification</div>
                <div class="ent-field-grid ent-grid-3">
                    <div class="ent-field">
                        <label asp-for="Plan.PlanCode" class="ent-label required">Plan Number</label>
                        <input asp-for="Plan.PlanCode" class="ent-input" required placeholder="MP-00001" />
                    </div>
                    <div class="ent-field">
                        <label asp-for="Plan.Name" class="ent-label required">Plan Description</label>
                        <input asp-for="Plan.Name" class="ent-input" required />
                    </div>
                    <div class="ent-field">
                        <label asp-for="Plan.PlanCategory" class="ent-label">Category</label>
                        <select asp-for="Plan.PlanCategory" class="ent-select">
                            <option>Time-Based</option>
                            <option>Usage-Based</option>
                            <option>Condition-Based</option>
                            <option>Project-Based</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="ent-section">
                <div class="ent-section-title"><i class="bi bi-gear"></i> Object Assignment</div>
                <div class="ent-field-grid ent-grid-3">
                    <div class="ent-field">
                        <label asp-for="Plan.EquipmentCode" class="ent-label">Equipment ID</label>
                        <input asp-for="Plan.EquipmentCode" class="ent-input" />
                    </div>
                    <div class="ent-field">
                        <label asp-for="Plan.FunctionalLocationCode" class="ent-label">Functional Location</label>
                        <input asp-for="Plan.FunctionalLocationCode" class="ent-input" />
                    </div>
                    <div class="ent-field">
                        <label asp-for="Plan.WorkCenter" class="ent-label">Work Center</label>
                        <input asp-for="Plan.WorkCenter" class="ent-input" />
                    </div>
                </div>
                <div class="ent-field-grid ent-grid-2">
                    <div class="ent-field">
                        <label asp-for="Plan.TaskDescription" class="ent-label">Task Description</label>
                        <textarea asp-for="Plan.TaskDescription" class="ent-input" rows="2"></textarea>
                    </div>
                    <div class="ent-field">
                        <label asp-for="Plan.MaintPlannerGroup" class="ent-label">Planner Group</label>
                        <input asp-for="Plan.MaintPlannerGroup" class="ent-input" />
                    </div>
                </div>
            </div>
        </div>
        <div class="ent-form-panel" data-panel="tabSchedule" style="display:none">
            <div class="ent-section">
                <div class="ent-section-title"><i class="bi bi-calendar3"></i> Frequency & Scheduling</div>
                <div class="ent-field-grid ent-grid-3">
                    <div class="ent-field">
                        <label asp-for="Plan.Frequency" class="ent-label">Frequency</label>
                        <select asp-for="Plan.Frequency" class="ent-select">
                            <option>Daily</option>
                            <option>Weekly</option>
                            <option selected>Monthly</option>
                            <option>Quarterly</option>
                            <option>Yearly</option>
                        </select>
                    </div>
                    <div class="ent-field">
                        <label asp-for="Plan.EstimatedHours" class="ent-label">Estimated Hours</label>
                        <input asp-for="Plan.EstimatedHours" class="ent-input" type="number" step="0.5" />
                    </div>
                    <div class="ent-field">
                        <label asp-for="Plan.NextDueDate" class="ent-label">Next Due Date</label>
                        <input asp-for="Plan.NextDueDate" class="ent-input" type="date" />
                    </div>
                </div>
                <div class="ent-field-grid ent-grid-2">
                    <div class="ent-field">
                        <label asp-for="Plan.Status" class="ent-label">Status</label>
                        <select asp-for="Plan.Status" class="ent-select">
                            <option>Active</option>
                            <option>Inactive</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
