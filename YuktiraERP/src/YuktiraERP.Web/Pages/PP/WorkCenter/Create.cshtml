@page
@model YuktiraERP.Web.Pages.PP.WorkCenter.CreateModel
@{ ViewData["Title"] = "Create Work Center"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><i class="bi bi-building me-2"></i>Create Work Center</h3>
            <span class="badge">CR01</span>
        </div>
        <div class="actions">
            <button type="submit" form="createForm" class="zqm-btn" style="background:#4caf50;border-color:#4caf50"><i class="bi bi-save me-1"></i>Save Work Center</button>
            <button type="button" class="zqm-btn" onclick="document.getElementById('createForm').reset()"><i class="bi bi-x-circle me-1"></i>Clear</button>
            <a asp-page="/PP/WorkCenter/List" class="zqm-btn zqm-btn-back"><i class="bi bi-arrow-left me-1"></i>Back</a>
        </div>
    </div>

    <div class="zqm-filter">
        <form method="post" id="createForm">
            <input type="hidden" asp-for="WorkCenter.Status" value="Active" />

            <div class="zqm-tabs" id="wcTabs">
                <button type="button" class="zqm-tab-btn active" data-tab="tab-identification"><i class="bi bi-building me-1"></i>Identification</button>
                <button type="button" class="zqm-tab-btn" data-tab="tab-capacity"><i class="bi bi-speedometer me-1"></i>Capacity & Scheduling</button>
                <button type="button" class="zqm-tab-btn" data-tab="tab-costing"><i class="bi bi-currency-dollar me-1"></i>Costing</button>
            </div>

            <!-- Tab: Identification -->
            <div class="zqm-tab-panel active" id="tab-identification" style="padding-top:12px">
                <div class="zqm-section-title"><i class="bi bi-building me-1"></i>Work Center Details</div>
                <div class="zqm-row cols-3">
                    <div class="zqm-field"><label>Work Center Code</label><input value="Auto-generated" readonly style="background:#f0f0f0" /></div>
                    <div class="zqm-field"><label>Name <span style="color:#c62828">*</span></label><input asp-for="WorkCenter.Name" placeholder="e.g., CNC Machining Center" /><span asp-validation-for="WorkCenter.Name" style="color:#c62828;font-size:0.72rem"></span></div>
                    <div class="zqm-field"><label>Category</label><select asp-for="WorkCenter.WorkCenterCategory"><option value="Machine">Machine</option><option value="Labor">Labor</option><option value="Crew">Crew</option><option value="Pool">Capacity Pool</option></select></div>
                </div>
                <div class="zqm-row cols-3">
                    <div class="zqm-field"><label>Department <span style="color:#c62828">*</span></label><input asp-for="WorkCenter.Department" placeholder="e.g., Manufacturing" /><span asp-validation-for="WorkCenter.Department" style="color:#c62828;font-size:0.72rem"></span></div>
                    <div class="zqm-field"><label>Cost Center</label><input asp-for="WorkCenter.CostCenter" placeholder="e.g., CC-4000" /></div>
                    <div class="zqm-field"><label>Responsible Person</label><input asp-for="WorkCenter.ResponsiblePerson" placeholder="Work center supervisor" /></div>
                </div>
                <div class="zqm-row cols-3">
                    <div class="zqm-field"><label>Status</label><select asp-for="WorkCenter.Status"><option value="Active">Active</option><option value="Maintenance">Under Maintenance</option><option value="Inactive">Inactive</option></select></div>
                </div>
            </div>

            <!-- Tab: Capacity & Scheduling -->
            <div class="zqm-tab-panel" id="tab-capacity" style="padding-top:12px">
                <div class="zqm-section-title"><i class="bi bi-speedometer me-1"></i>Capacity Parameters</div>
                <div class="zqm-row cols-3">
                    <div class="zqm-field"><label>Capacity per Shift <span style="color:#c62828">*</span></label><input asp-for="WorkCenter.CapacityPerShift" type="number" min="0" step="1" /><span asp-validation-for="WorkCenter.CapacityPerShift" style="color:#c62828;font-size:0.72rem"></span></div>
                    <div class="zqm-field"><label>Shifts per Day</label><select asp-for="WorkCenter.ShiftsPerDay"><option value="1">1 Shift</option><option value="2">2 Shifts</option><option value="3">3 Shifts</option></select></div>
                    <div class="zqm-field"><label>Capacity per Day</label><input value="0" readonly style="background:#f0f0f0" /><small style="color:#888;font-size:0.72rem">Calculated: Shifts x Capacity/Shift</small></div>
                </div>
                <div class="zqm-section-title" style="margin-top:12px"><i class="bi bi-clock me-1"></i>Standard Times</div>
                <div class="zqm-row cols-3">
                    <div class="zqm-field"><label>Machine Time (hrs)</label><input asp-for="WorkCenter.MachineTimeHrs" type="number" min="0" step="0.1" value="0" /></div>
                    <div class="zqm-field"><label>Labor Time (hrs)</label><input asp-for="WorkCenter.LaborTimeHrs" type="number" min="0" step="0.1" value="0" /></div>
                    <div class="zqm-field"><label>Queue Time (hrs)</label><input type="number" min="0" step="0.1" value="0" /></div>
                </div>
            </div>

            <!-- Tab: Costing -->
            <div class="zqm-tab-panel" id="tab-costing" style="padding-top:12px">
                <div class="zqm-section-title"><i class="bi bi-currency-dollar me-1"></i>Cost Rates</div>
                <div style="background:#f5f5f5;border-radius:6px;padding:14px;border:1px dashed #ccc">
                    <p style="color:#888;margin:0;font-size:0.83rem"><i class="bi bi-info-circle me-1"></i> Cost rates are configured in the Cost Center accounting module. Work center costing rates inherit from the assigned Cost Center. Activity-based costing rates can be maintained in the Activity Type master data.</p>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    document.querySelectorAll('.zqm-tab-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var tab = this.getAttribute('data-tab');
            document.querySelectorAll('.zqm-tab-btn').forEach(function(b) { b.classList.remove('active'); });
            document.querySelectorAll('.zqm-tab-panel').forEach(function(p) { p.classList.remove('active'); });
            this.classList.add('active');
            document.getElementById(tab).classList.add('active');
        });
    });
    </script>
}
