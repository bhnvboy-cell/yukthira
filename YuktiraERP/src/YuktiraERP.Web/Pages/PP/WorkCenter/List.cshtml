@page
@model YuktiraERP.Web.Pages.PP.WorkCenter.ListModel
@{ ViewData["Title"] = "Work Center List"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><i class="bi bi-building me-2"></i>Work Center List</h3>
            <span class="badge">@Model.Items.Count records</span>
        </div>
        <div class="actions">
            <a asp-page="/PP/WorkCenter/Create" class="zqm-btn" style="background:#4caf50;border-color:#4caf50"><i class="bi bi-plus-circle me-1"></i>New Work Center</a>
            <a asp-page="/PP/Index" class="zqm-btn zqm-btn-back"><i class="bi bi-arrow-left me-1"></i>Back</a>
        </div>
    </div>

    <div class="zqm-filter">
        <div class="zqm-section-title"><i class="bi bi-funnel me-1"></i>Search</div>
        <div class="zqm-row cols-3">
            <div class="zqm-field"><label>Code</label><input id="searchCode" placeholder="Filter by code..." oninput="filterTable()" /></div>
            <div class="zqm-field"><label>Name</label><input id="searchName" placeholder="Filter by name..." oninput="filterTable()" /></div>
            <div class="zqm-field"><label>Status</label><select id="searchStatus" onchange="filterTable()"><option value="">All</option><option value="Active">Active</option><option value="Maintenance">Maintenance</option><option value="Inactive">Inactive</option></select></div>
        </div>
    </div>

    <div class="zqm-results">
        <div class="zqm-results-header"><h4>Work Centers</h4><span class="count" id="resultCount">@Model.Items.Count items</span></div>
        <div class="zqm-table-wrap">
            <table class="zqm-table" id="wcTable">
                <thead>
                    <tr><th>Code</th><th>Name</th><th>Category</th><th>Department</th><th>Cost Center</th><th>Capacity/Shift</th><th>Shifts/Day</th><th>Capacity/Day</th><th>Status</th><th>Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr data-code="@item.Code" data-name="@item.Name" data-status="@item.Status">
                            <td style="font-weight:600;color:#1565c0">@item.Code</td>
                            <td>@item.Name</td>
                            <td>@item.WorkCenterCategory</td>
                            <td>@item.Department</td>
                            <td>@item.CostCenter</td>
                            <td>@item.CapacityPerShift</td>
                            <td>@item.ShiftsPerDay</td>
                            <td>@item.CapacityPerDay</td>
                            <td><span class="zqm-badge @(item.Status=="Active"?"passed":item.Status=="Maintenance"?"warning":"failed")">@item.Status</span></td>
                            <td>
                                <a asp-page="/PP/WorkCenter/Display" asp-route-id="@item.Id" class="zqm-act" title="View"><i class="bi bi-eye"></i></a>
                                <a asp-page="/PP/WorkCenter/Edit" asp-route-id="@item.Id" class="zqm-act" title="Edit"><i class="bi bi-pencil"></i></a>
                                <form method="post" asp-page-handler="Delete" style="display:inline" onsubmit="return confirm('Delete this work center?')">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="zqm-act" title="Delete" style="color:#c62828"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Items.Any()) { <tr><td colspan="10" class="zqm-empty"><i class="bi bi-building"></i><div>No work centers found</div></td></tr> }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
function filterTable() {
    var code = document.getElementById('searchCode').value.toLowerCase();
    var name = document.getElementById('searchName').value.toLowerCase();
    var status = document.getElementById('searchStatus').value;
    var rows = document.querySelectorAll('#wcTable tbody tr[data-code]');
    var count = 0;
    rows.forEach(function(r) {
        var match = (!code || r.dataset.code.toLowerCase().indexOf(code) > -1) &&
                    (!name || r.dataset.name.toLowerCase().indexOf(name) > -1) &&
                    (!status || r.dataset.status === status);
        r.style.display = match ? '' : 'none';
        if (match) count++;
    });
    document.getElementById('resultCount').textContent = count + ' items';
}
</script>
