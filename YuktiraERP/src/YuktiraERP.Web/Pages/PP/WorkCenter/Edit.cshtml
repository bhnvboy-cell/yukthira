@page
@model YuktiraERP.Web.Pages.PP.WorkCenter.EditModel
@{ ViewData["Title"] = "Edit Work Center"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><i class="bi bi-pencil me-2"></i>Edit Work Center</h3>
            <span class="badge">@Model.WorkCenter.Code</span>
        </div>
        <div class="actions">
            <button type="submit" form="editForm" class="zqm-btn" style="background:#4caf50;border-color:#4caf50"><i class="bi bi-check-circle me-1"></i>Update</button>
            <a asp-page="/PP/WorkCenter/List" class="zqm-btn zqm-btn-back"><i class="bi bi-arrow-left me-1"></i>Back to List</a>
        </div>
    </div>

    <div class="zqm-filter">
        <div class="zqm-section-title"><i class="bi bi-building me-1"></i>Work Center Data</div>
        <form method="post" id="editForm">
            <input type="hidden" asp-for="WorkCenter.Id" />
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Code</label><input asp-for="WorkCenter.Code" /></div>
                <div class="zqm-field"><label>Name</label><input asp-for="WorkCenter.Name" /></div>
                <div class="zqm-field"><label>Category</label><select asp-for="WorkCenter.WorkCenterCategory"><option value="Machine">Machine</option><option value="Labor">Labor</option><option value="Crew">Crew</option><option value="Pool">Capacity Pool</option></select></div>
            </div>
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Department</label><input asp-for="WorkCenter.Department" /></div>
                <div class="zqm-field"><label>Cost Center</label><input asp-for="WorkCenter.CostCenter" /></div>
                <div class="zqm-field"><label>Responsible Person</label><input asp-for="WorkCenter.ResponsiblePerson" /></div>
            </div>
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Capacity per Shift</label><input asp-for="WorkCenter.CapacityPerShift" type="number" step="1" /></div>
                <div class="zqm-field"><label>Shifts per Day</label><select asp-for="WorkCenter.ShiftsPerDay"><option value="1">1</option><option value="2">2</option><option value="3">3</option></select></div>
                <div class="zqm-field"><label>Status</label><select asp-for="WorkCenter.Status"><option value="Active">Active</option><option value="Maintenance">Maintenance</option><option value="Inactive">Inactive</option></select></div>
            </div>
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Machine Time (hrs)</label><input asp-for="WorkCenter.MachineTimeHrs" type="number" step="0.1" /></div>
                <div class="zqm-field"><label>Labor Time (hrs)</label><input asp-for="WorkCenter.LaborTimeHrs" type="number" step="0.1" /></div>
                <div class="zqm-field"><label>Capacity per Day</label><input asp-for="WorkCenter.CapacityPerDay" type="number" step="1" /></div>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
