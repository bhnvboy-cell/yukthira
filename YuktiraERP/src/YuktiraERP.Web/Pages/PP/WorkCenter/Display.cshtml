@page
@model YuktiraERP.Web.Pages.PP.WorkCenter.DisplayModel
@{ ViewData["Title"] = "Work Center Details"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><i class="bi bi-eye me-2"></i>Work Center Details</h3>
            <span class="badge">@Model.WorkCenter.Code</span>
        </div>
        <div class="actions">
            <a asp-page="/PP/WorkCenter/Edit" asp-route-id="@Model.WorkCenter.Id" class="zqm-btn" style="background:#ff9800;border-color:#ff9800"><i class="bi bi-pencil me-1"></i>Edit</a>
            <a asp-page="/PP/WorkCenter/List" class="zqm-btn zqm-btn-back"><i class="bi bi-arrow-left me-1"></i>Back</a>
        </div>
    </div>

    <div class="zqm-results">
        <div class="zqm-results-header"><h4>Work Center Information</h4></div>
        <div style="padding:16px">
            <div class="zqm-section-title"><i class="bi bi-building me-1"></i>Identification</div>
            <div class="zqm-row cols-3">
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Code</label><div class="zqm-ro" style="font-weight:600;color:#1565c0">@Model.WorkCenter.Code</div></div>
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Name</label><div class="zqm-ro" style="font-weight:600">@Model.WorkCenter.Name</div></div>
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Category</label><div class="zqm-ro">@Model.WorkCenter.WorkCenterCategory</div></div>
            </div>
            <div class="zqm-row cols-3" style="margin-top:8px">
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Department</label><div class="zqm-ro">@Model.WorkCenter.Department</div></div>
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Cost Center</label><div class="zqm-ro">@Model.WorkCenter.CostCenter</div></div>
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Responsible Person</label><div class="zqm-ro">@Model.WorkCenter.ResponsiblePerson</div></div>
            </div>
            <div class="zqm-section-title" style="margin-top:16px"><i class="bi bi-speedometer me-1"></i>Capacity & Scheduling</div>
            <div class="zqm-row cols-3">
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Capacity per Shift</label><div class="zqm-ro" style="font-weight:600">@Model.WorkCenter.CapacityPerShift</div></div>
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Shifts per Day</label><div class="zqm-ro">@Model.WorkCenter.ShiftsPerDay</div></div>
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Capacity per Day</label><div class="zqm-ro" style="font-weight:600">@Model.WorkCenter.CapacityPerDay</div></div>
            </div>
            <div class="zqm-row cols-3" style="margin-top:8px">
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Machine Time (hrs)</label><div class="zqm-ro">@Model.WorkCenter.MachineTimeHrs</div></div>
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Labor Time (hrs)</label><div class="zqm-ro">@Model.WorkCenter.LaborTimeHrs</div></div>
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Status</label><div class="zqm-ro"><span class="zqm-badge @(Model.WorkCenter.Status=="Active"?"passed":Model.WorkCenter.Status=="Maintenance"?"warning":"failed")">@Model.WorkCenter.Status</span></div></div>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
