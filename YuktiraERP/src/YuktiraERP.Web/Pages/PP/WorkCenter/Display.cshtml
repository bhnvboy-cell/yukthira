@page
@model YuktiraERP.Web.Pages.PP.WorkCenter.DisplayModel
@using YuktiraERP.Infrastructure.Data.Entities
@{ ViewData["Title"] = "WorkCenter Details"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-info text-white"><h5 class="mb-0"><i class="bi bi-eye me-2"></i>WorkCenter Details</h5></div>
<div class="card-body">
<dl class="row mb-0"><dt class="col-sm-4">Code</dt><dd class="col-sm-8">@(Model.WorkCenter.Code)</dd><dt class="col-sm-4">Name</dt><dd class="col-sm-8">@(Model.WorkCenter.Name)</dd><dt class="col-sm-4">Department</dt><dd class="col-sm-8">@(Model.WorkCenter.Department)</dd><dt class="col-sm-4">CapacityPerShift</dt><dd class="col-sm-8">@(Model.WorkCenter.CapacityPerShift)</dd><dt class="col-sm-4">Status</dt><dd class="col-sm-8">@(Model.WorkCenter.Status)</dd></dl>
</div>
<div class="card-footer">
<a href="/PP/WorkCenter/List" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
<a href="/PP/WorkCenter/Edit?id=@(Model.WorkCenter.Id)" class="btn btn-warning"><i class="bi bi-pencil me-1"></i>Edit</a>
</div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

