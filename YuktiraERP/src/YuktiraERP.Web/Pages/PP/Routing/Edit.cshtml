@page
@model YuktiraERP.Web.Pages.PP.Routing.EditModel
@{ ViewData["Title"] = "Edit ProductionRouting"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-warning text-dark"><h5 class="mb-0"><i class="bi bi-pencil me-2"></i>Edit ProductionRouting</h5></div>
<div class="card-body">
<form method="post">
<input type="hidden" asp-for="Routing.Id" />
<div class="row mb-3"><div class="col-md-6"><label asp-for="Routing.RoutingId" class="form-label"></label><input asp-for="Routing.RoutingId" class="form-control" type="text" /></div><div class="col-md-6"><label asp-for="Routing.ProductName" class="form-label"></label><input asp-for="Routing.ProductName" class="form-control" type="text" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="Routing.OperationNo" class="form-label"></label><input asp-for="Routing.OperationNo" class="form-control" type="number" /></div><div class="col-md-6"><label asp-for="Routing.WorkCenter" class="form-label"></label><input asp-for="Routing.WorkCenter" class="form-control" type="text" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="Routing.SetupTimeHrs" class="form-label"></label><input asp-for="Routing.SetupTimeHrs" class="form-control" type="number" step="0.01" /></div><div class="col-md-6"><label asp-for="Routing.RunTimeHrs" class="form-label"></label><input asp-for="Routing.RunTimeHrs" class="form-control" type="number" step="0.01" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="Routing.Status" class="form-label"></label><input asp-for="Routing.Status" class="form-control" type="text" /></div><div class="col-md-6"></div></div>
<div class="d-flex gap-2"><button type="submit" class="btn btn-warning"><i class="bi bi-save me-1"></i>Update</button><a href="/PP/Routing/List" class="btn btn-outline-secondary"><i class="bi bi-x me-1"></i>Cancel</a></div>
</form>
</div></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

