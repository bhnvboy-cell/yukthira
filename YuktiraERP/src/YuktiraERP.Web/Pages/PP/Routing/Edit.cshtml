@page
@model YuktiraERP.Web.Pages.PP.Routing.EditModel
@{ ViewData["Title"] = "Edit Production Routing"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><i class="bi bi-pencil me-2"></i>Edit Production Routing</h3>
            <span class="badge">@Model.Routing.RoutingId</span>
        </div>
        <div class="actions">
            <button type="submit" form="editForm" class="zqm-btn" style="background:#4caf50;border-color:#4caf50"><i class="bi bi-check-circle me-1"></i>Update</button>
            <a asp-page="/PP/Routing/List" class="zqm-btn zqm-btn-back"><i class="bi bi-arrow-left me-1"></i>Back to List</a>
        </div>
    </div>

    <div class="zqm-filter">
        <div class="zqm-section-title"><i class="bi bi-diagram-3 me-1"></i>Routing Data</div>
        <form method="post" id="editForm">
            <input type="hidden" asp-for="Routing.Id" />
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Routing ID</label><input asp-for="Routing.RoutingId" /></div>
                <div class="zqm-field"><label>Routing Group</label><input asp-for="Routing.RoutingGroup" /></div>
                <div class="zqm-field"><label>Group Counter</label><input asp-for="Routing.RoutingGroupCounter" type="number" /></div>
            </div>
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Product Name</label><input asp-for="Routing.ProductName" /></div>
                <div class="zqm-field"><label>Control Key</label><select asp-for="Routing.ControlKey"><option value="PP01">PP01</option><option value="PP02">PP02</option><option value="PP03">PP03</option><option value="PP04">PP04</option></select></div>
                <div class="zqm-field"><label>Status</label><select asp-for="Routing.Status"><option value="Active">Active</option><option value="Inactive">Inactive</option></select></div>
            </div>
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Operation No</label><input asp-for="Routing.OperationNo" type="number" /></div>
                <div class="zqm-field"><label>Operation Description</label><input asp-for="Routing.OperationDescription" /></div>
                <div class="zqm-field"><label>Work Center</label><input asp-for="Routing.WorkCenter" /></div>
            </div>
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Setup Time (hrs)</label><input asp-for="Routing.SetupTimeHrs" type="number" step="0.01" /></div>
                <div class="zqm-field"><label>Machine Time (hrs)</label><input asp-for="Routing.MachineTimeHrs" type="number" step="0.01" /></div>
                <div class="zqm-field"><label>Labor Time (hrs)</label><input asp-for="Routing.LaborTimeHrs" type="number" step="0.01" /></div>
            </div>
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Run Time (hrs)</label><input asp-for="Routing.RunTimeHrs" type="number" step="0.01" /></div>
                <div class="zqm-field"><label>Queue Time (hrs)</label><input asp-for="Routing.QueueTimeHrs" type="number" step="0.01" /></div>
                <div class="zqm-field"><label>Scrap %</label><input asp-for="Routing.ScrapPercent" type="number" step="0.1" /></div>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
