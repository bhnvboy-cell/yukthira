@page
@model YuktiraERP.Web.Pages.PP.Routing.CreateModel
@{ ViewData["Title"] = "Create Production Routing"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><i class="bi bi-diagram-3 me-2"></i>Create Production Routing</h3>
            <span class="badge">CA01</span>
        </div>
        <div class="actions">
            <button type="submit" form="createForm" class="zqm-btn" style="background:#4caf50;border-color:#4caf50"><i class="bi bi-save me-1"></i>Save Routing</button>
            <button type="button" class="zqm-btn" onclick="document.getElementById('createForm').reset()"><i class="bi bi-x-circle me-1"></i>Clear</button>
            <a asp-page="/PP/Routing/List" class="zqm-btn zqm-btn-back"><i class="bi bi-arrow-left me-1"></i>Back</a>
        </div>
    </div>

    <div class="zqm-filter">
        <form method="post" id="createForm">
            <input type="hidden" asp-for="Routing.Status" value="Active" />

            <div class="zqm-tabs" id="rtTabs">
                <button type="button" class="zqm-tab-btn active" data-tab="tab-header"><i class="bi bi-info-circle me-1"></i>Routing Header</button>
                <button type="button" class="zqm-tab-btn" data-tab="tab-operation"><i class="bi bi-gear me-1"></i>Operation Detail</button>
                <button type="button" class="zqm-tab-btn" data-tab="tab-times"><i class="bi bi-clock me-1"></i>Standard Times</button>
            </div>

            <!-- Tab: Routing Header -->
            <div class="zqm-tab-panel active" id="tab-header" style="padding-top:12px">
                <div class="zqm-section-title"><i class="bi bi-info-circle me-1"></i>Routing Identification</div>
                <div class="zqm-row cols-3">
                    <div class="zqm-field"><label>Routing ID</label><input value="Auto-generated" readonly style="background:#f0f0f0" /></div>
                    <div class="zqm-field"><label>Routing Group</label><input asp-for="Routing.RoutingGroup" placeholder="e.g., MECH" /></div>
                    <div class="zqm-field"><label>Group Counter</label><input asp-for="Routing.RoutingGroupCounter" type="number" min="1" value="1" /></div>
                </div>
                <div class="zqm-row cols-3">
                    <div class="zqm-field"><label>Material Description <span style="color:#c62828">*</span></label><input asp-for="Routing.ProductName" placeholder="Material this routing applies to" /><span asp-validation-for="Routing.ProductName" style="color:#c62828;font-size:0.72rem"></span></div>
                    <div class="zqm-field"><label>Control Key</label><select asp-for="Routing.ControlKey"><option value="PP01">PP01 — Standard</option><option value="PP02">PP02 — With Confirmation</option><option value="PP03">PP03 — With Costing</option><option value="PP04">PP04 — Automatic</option></select></div>
                    <div class="zqm-field"><label>Status</label><select asp-for="Routing.Status"><option value="Active">Active</option><option value="Inactive">Inactive</option></select></div>
                </div>
            </div>

            <!-- Tab: Operation Detail -->
            <div class="zqm-tab-panel" id="tab-operation" style="padding-top:12px">
                <div class="zqm-section-title"><i class="bi bi-gear me-1"></i>Operation Details</div>
                <div class="zqm-row cols-3">
                    <div class="zqm-field"><label>Operation Number <span style="color:#c62828">*</span></label><input asp-for="Routing.OperationNo" type="number" min="10" step="10" value="10" /><span asp-validation-for="Routing.OperationNo" style="color:#c62828;font-size:0.72rem"></span></div>
                    <div class="zqm-field"><label>Operation Description</label><input asp-for="Routing.OperationDescription" placeholder="e.g., CNC Turning" /></div>
                    <div class="zqm-field"><label>Work Center <span style="color:#c62828">*</span></label><input asp-for="Routing.WorkCenter" placeholder="e.g., WC-01" /><span asp-validation-for="Routing.WorkCenter" style="color:#c62828;font-size:0.72rem"></span></div>
                </div>
            </div>

            <!-- Tab: Standard Times -->
            <div class="zqm-tab-panel" id="tab-times" style="padding-top:12px">
                <div class="zqm-section-title"><i class="bi bi-clock me-1"></i>Standard Times</div>
                <div class="zqm-row cols-3">
                    <div class="zqm-field"><label>Setup Time (hrs) <span style="color:#c62828">*</span></label><input asp-for="Routing.SetupTimeHrs" type="number" min="0" step="0.1" /><span asp-validation-for="Routing.SetupTimeHrs" style="color:#c62828;font-size:0.72rem"></span></div>
                    <div class="zqm-field"><label>Machine Time (hrs)</label><input asp-for="Routing.MachineTimeHrs" type="number" min="0" step="0.1" value="0" /></div>
                    <div class="zqm-field"><label>Labor Time (hrs)</label><input asp-for="Routing.LaborTimeHrs" type="number" min="0" step="0.1" value="0" /></div>
                </div>
                <div class="zqm-row cols-3">
                    <div class="zqm-field"><label>Run Time (hrs) <span style="color:#c62828">*</span></label><input asp-for="Routing.RunTimeHrs" type="number" min="0" step="0.1" /><span asp-validation-for="Routing.RunTimeHrs" style="color:#c62828;font-size:0.72rem"></span></div>
                    <div class="zqm-field"><label>Queue Time (hrs)</label><input asp-for="Routing.QueueTimeHrs" type="number" min="0" step="0.1" value="0" /></div>
                    <div class="zqm-field"><label>Scrap %</label><input asp-for="Routing.ScrapPercent" type="number" min="0" max="100" step="0.1" value="0" /></div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    document.querySelectorAll('.zqm-tab-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var tab = this.getAttribute('data-tab');
            document.querySelectorAll('.zqm-tab-btn').forEach(function(b) { b.classList.remove('active'); });
            document.querySelectorAll('.zqm-tab-panel').forEach(function(p) { p.classList.remove('active'); });
            this.classList.add('active');
            document.getElementById(tab).classList.add('active');
        });
    });
    </script>
}
