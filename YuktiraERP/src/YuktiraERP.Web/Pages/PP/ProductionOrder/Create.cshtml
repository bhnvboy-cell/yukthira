@page
@model YuktiraERP.Web.Pages.PP.ProductionOrder.CreateModel
@{ ViewData["Title"] = "Create Production Order"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><i class="bi bi-gear-wide-connected me-2"></i>Create Production Order</h3>
            <span class="badge">CO01</span>
        </div>
        <div class="actions">
            <button type="submit" form="createForm" class="zqm-btn" style="background:#4caf50;border-color:#4caf50"><i class="bi bi-save me-1"></i>Save Production Order</button>
            <button type="button" class="zqm-btn" onclick="document.getElementById('createForm').reset()"><i class="bi bi-x-circle me-1"></i>Clear</button>
            <a asp-page="/PP/Index" class="zqm-btn zqm-btn-back"><i class="bi bi-arrow-left me-1"></i>Back</a>
        </div>
    </div>

    <div class="zqm-filter">
        <form method="post" id="createForm">
            <input type="hidden" asp-for="Order.Status" value="PLANNED" />

            <div class="zqm-tabs" id="poTabs">
                <button type="button" class="zqm-tab-btn active" data-tab="tab-header"><i class="bi bi-gear me-1"></i>Order Header</button>
                <button type="button" class="zqm-tab-btn" data-tab="tab-materials"><i class="bi bi-box-seam me-1"></i>Materials & BOM</button>
                <button type="button" class="zqm-tab-btn" data-tab="tab-scheduling"><i class="bi bi-calendar3 me-1"></i>Scheduling & Capacity</button>
            </div>

            <!-- Tab: Order Header -->
            <div class="zqm-tab-panel active" id="tab-header" style="padding-top:12px">
                <div class="zqm-section-title"><i class="bi bi-gear me-1"></i>Order Type & Identification</div>
                <div class="zqm-row cols-3">
                    <div class="zqm-field"><label>Order Number</label><input value="Auto-generated" readonly style="background:#f0f0f0" /></div>
                    <div class="zqm-field"><label>Order Type <span style="color:#c62828">*</span></label><select asp-for="Order.OrderType"><option value="PP01">PP01 — Standard Production</option><option value="PP02">PP02 — Process Manufacturing</option><option value="REWORK">REWORK — Rework Order</option><option value="PILOT">PILOT — Pilot / Trial</option></select></div>
                    <div class="zqm-field"><label>Priority</label><select><option value="Normal">Normal</option><option value="High">High</option><option value="Urgent">Urgent</option></select></div>
                </div>
                <div class="zqm-section-title" style="margin-top:12px"><i class="bi bi-box-seam me-1"></i>Material & Quantity</div>
                <div class="zqm-row cols-3">
                    <div class="zqm-field"><label>Material Code <span style="color:#c62828">*</span></label><input asp-for="Order.MaterialCode" placeholder="e.g., FG-10001" /><span asp-validation-for="Order.MaterialCode" style="color:#c62828;font-size:0.72rem"></span></div>
                    <div class="zqm-field"><label>Material Description <span style="color:#c62828">*</span></label><input asp-for="Order.ProductName" placeholder="Finished good description" /><span asp-validation-for="Order.ProductName" style="color:#c62828;font-size:0.72rem"></span></div>
                    <div class="zqm-field"><label>Target Quantity <span style="color:#c62828">*</span></label><input asp-for="Order.Quantity" type="number" min="1" step="1" /><span asp-validation-for="Order.Quantity" style="color:#c62828;font-size:0.72rem"></span></div>
                </div>
                <div class="zqm-row cols-3">
                    <div class="zqm-field"><label>Base UOM</label><select asp-for="Order.BaseUOM"><option value="EA">EA — Each</option><option value="KG">KG — Kilogram</option><option value="L">L — Liter</option><option value="M">M — Meter</option><option value="LB">LB — Pound</option><option value="BOX">BOX — Box</option></select></div>
                    <div class="zqm-field"><label>Plant</label><select asp-for="Order.Plant"><option value="1000">1000 — Manufacturing Plant</option><option value="2000">2000 — Assembly Plant</option></select></div>
                    <div class="zqm-field"><label>Storage Location</label><select asp-for="Order.StorageLocation"><option value="RM01">RM01 — Raw Material</option><option value="FG01">FG01 — Finished Goods</option><option value="SFG01">SFG01 — Semi-Finished</option></select></div>
                </div>
                <div class="zqm-section-title" style="margin-top:12px"><i class="bi bi-person me-1"></i>MRP Controller</div>
                <div class="zqm-row cols-3">
                    <div class="zqm-field"><label>MRP Controller</label><input asp-for="Order.MRPController" placeholder="e.g., PC01" /></div>
                    <div class="zqm-field"><label>Batch Number</label><input asp-for="Order.BatchNo" placeholder="Optional batch" /></div>
                    <div class="zqm-field"><label>Status</label><input value="PLANNED" readonly style="background:#f0f0f0" /></div>
                </div>
            </div>

            <!-- Tab: Materials & BOM -->
            <div class="zqm-tab-panel" id="tab-materials" style="padding-top:12px">
                <div class="zqm-section-title"><i class="bi bi-box-seam me-1"></i>BOM & Routing Reference</div>
                <div class="zqm-row cols-3">
                    <div class="zqm-field"><label>BOM Reference</label><select asp-for="Order.BOMId" asp-items="Model.BOMOptions"><option value="">-- Select BOM --</option></select></div>
                    <div class="zqm-field"><label>Routing Reference</label><select asp-for="Order.RoutingId" asp-items="Model.RoutingOptions"><option value="">-- Select Routing --</option></select></div>
                    <div class="zqm-field"><label>Work Center</label><select asp-for="Order.StorageLocation"><option value="">-- Select --</option><option value="WC-01">WC-01 — Assembly Line 1</option><option value="WC-02">WC-02 — Assembly Line 2</option><option value="WC-03">WC-03 — CNC Machining</option></select></div>
                </div>
                <div class="zqm-section-title" style="margin-top:12px"><i class="bi bi-list-check me-1"></i>Component Reservation List</div>
                <div style="background:#f5f5f5;border-radius:6px;padding:14px;border:1px dashed #ccc">
                    <p style="color:#888;margin:0;font-size:0.83rem"><i class="bi bi-info-circle me-1"></i> Components will be auto-resolved from BOM after order release. Manual reservations can be added after creation.</p>
                </div>
                <div class="zqm-section-title" style="margin-top:12px"><i class="bi bi-currency-dollar me-1"></i>Cost Estimate</div>
                <div class="zqm-row cols-3">
                    <div class="zqm-field"><label>Planned Cost</label><input asp-for="Order.PlannedCost" type="number" min="0" step="0.01" /></div>
                    <div class="zqm-field"><label>Actual Cost</label><input asp-for="Order.ActualCost" readonly value="0" style="background:#f0f0f0" /></div>
                    <div class="zqm-field"><label>Cost Variance</label><input value="0" readonly style="background:#f0f0f0" /></div>
                </div>
            </div>

            <!-- Tab: Scheduling & Capacity -->
            <div class="zqm-tab-panel" id="tab-scheduling" style="padding-top:12px">
                <div class="zqm-section-title"><i class="bi bi-calendar3 me-1"></i>Production Dates</div>
                <div class="zqm-row cols-3">
                    <div class="zqm-field"><label>Scheduled Start Date <span style="color:#c62828">*</span></label><input asp-for="Order.StartDate" type="date" /></div>
                    <div class="zqm-field"><label>Scheduled Finish Date <span style="color:#c62828">*</span></label><input asp-for="Order.EndDate" type="date" /></div>
                    <div class="zqm-field"><label>Scheduling Type</label><select><option value="Forward">Forward Scheduling</option><option value="Backward">Backward Scheduling</option><option value="Manual">Manual Scheduling</option></select></div>
                </div>
                <div class="zqm-section-title" style="margin-top:12px"><i class="bi bi-speedometer2 me-1"></i>Capacity & Yield</div>
                <div class="zqm-row cols-3">
                    <div class="zqm-field"><label>Planned Yield (%)</label><input type="number" min="0" max="100" value="100" step="0.1" /></div>
                    <div class="zqm-field"><label>Scrap Quantity</label><input asp-for="Order.ScrapQty" type="number" min="0" value="0" step="1" /></div>
                    <div class="zqm-field"><label>Shift</label><select><option value="All">All Shifts</option><option value="1">Shift 1 (Morning)</option><option value="2">Shift 2 (Afternoon)</option><option value="3">Shift 3 (Night)</option></select></div>
                </div>
                <div class="zqm-section-title" style="margin-top:12px"><i class="bi bi-list-check me-1"></i>Routing Operations List</div>
                <div style="background:#f5f5f5;border-radius:6px;padding:14px;border:1px dashed #ccc">
                    <p style="color:#888;margin:0;font-size:0.83rem"><i class="bi bi-info-circle me-1"></i> Operations will be copied from the selected Routing upon order release.</p>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    document.querySelectorAll('.zqm-tab-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var tab = this.getAttribute('data-tab');
            document.querySelectorAll('.zqm-tab-btn').forEach(function(b) { b.classList.remove('active'); });
            document.querySelectorAll('.zqm-tab-panel').forEach(function(p) { p.classList.remove('active'); });
            this.classList.add('active');
            document.getElementById(tab).classList.add('active');
        });
    });
    </script>
}
