@page
@model YuktiraERP.Web.Pages.PP.ProductionOrder.DisplayModel
@{ ViewData["Title"] = "Production Order Details"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><i class="bi bi-eye me-2"></i>Production Order Details</h3>
            <span class="badge">@Model.ProdOrder.OrderNumber</span>
        </div>
        <div class="actions">
            <a asp-page="/PP/ProductionOrder/Edit" asp-route-id="@Model.ProdOrder.Id" class="zqm-btn" style="background:#ff9800;border-color:#ff9800"><i class="bi bi-pencil me-1"></i>Edit</a>
            <a asp-page="/PP/Index" class="zqm-btn zqm-btn-back"><i class="bi bi-arrow-left me-1"></i>Back</a>
        </div>
    </div>

    <div class="zqm-results">
        <div class="zqm-results-header"><h4>Order Information</h4></div>
        <div style="padding:16px">
            <div class="zqm-section-title"><i class="bi bi-gear me-1"></i>Order Header</div>
            <div class="zqm-row cols-3">
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Order Number</label><div class="zqm-ro" style="font-weight:600;color:#1565c0">@Model.ProdOrder.OrderNumber</div></div>
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Product Name</label><div class="zqm-ro" style="font-weight:600">@Model.ProdOrder.ProductName</div></div>
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Material Code</label><div class="zqm-ro">@Model.ProdOrder.MaterialCode</div></div>
            </div>
            <div class="zqm-row cols-3" style="margin-top:8px">
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Quantity</label><div class="zqm-ro" style="font-weight:600">@Model.ProdOrder.Quantity</div></div>
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Start Date</label><div class="zqm-ro">@Model.ProdOrder.StartDate.ToString("dd MMM yyyy")</div></div>
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">End Date</label><div class="zqm-ro">@Model.ProdOrder.EndDate.ToString("dd MMM yyyy")</div></div>
            </div>
            <div class="zqm-row cols-3" style="margin-top:8px">
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Status</label><div class="zqm-ro"><span class="zqm-badge @(Model.ProdOrder.Status=="PLANNED"?"info":Model.ProdOrder.Status=="RELEASED"?"warning":Model.ProdOrder.Status=="IN_PROGRESS"?"purple":Model.ProdOrder.Status=="COMPLETED"?"passed":Model.ProdOrder.Status=="TECO"?"closed":"failed")">@Model.ProdOrder.Status</span></div></div>
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Plant</label><div class="zqm-ro">@Model.ProdOrder.Plant</div></div>
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Storage Location</label><div class="zqm-ro">@Model.ProdOrder.StorageLocation</div></div>
            </div>
            <div class="zqm-row cols-3" style="margin-top:8px">
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Base UOM</label><div class="zqm-ro">@Model.ProdOrder.BaseUOM</div></div>
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Order Type</label><div class="zqm-ro">@Model.ProdOrder.OrderType</div></div>
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Planned Cost</label><div class="zqm-ro">@Model.ProdOrder.PlannedCost</div></div>
            </div>
            <div class="zqm-row cols-3" style="margin-top:8px">
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">MRP Controller</label><div class="zqm-ro">@Model.ProdOrder.MRPController</div></div>
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Batch Number</label><div class="zqm-ro">@Model.ProdOrder.BatchNo</div></div>
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Actual Cost</label><div class="zqm-ro">@Model.ProdOrder.ActualCost</div></div>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
