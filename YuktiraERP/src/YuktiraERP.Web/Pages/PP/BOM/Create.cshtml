@page
@model YuktiraERP.Web.Pages.PP.BOM.CreateModel
@{ ViewData["Title"] = "Create Bill of Materials"; }

<div class="ent-form-wrapper">
    <div class="ent-org-banner">
        <div class="banner-icon"><i class="bi bi-box-seam"></i></div>
        <div class="banner-info">
            <h5>Create Bill of Materials</h5>
            <span>CS01 — BOM Builder (SAP PP)</span>
        </div>
        <div class="banner-meta">
            Plant: 1000<br />Auto-numbered
        </div>
    </div>

    <form method="post">
        <input type="hidden" asp-for="Bom.Status" value="Active" />

        <div class="ent-form-tabs">
            <button type="button" class="ent-form-tab active" data-tab="header">
                <i class="bi bi-info-circle tab-icon"></i> BOM Header
            </button>
            <button type="button" class="ent-form-tab" data-tab="components">
                <i class="bi bi-list-nested tab-icon"></i> Component Detail
            </button>
            <button type="button" class="ent-form-tab" data-tab="validity">
                <i class="bi bi-calendar-range tab-icon"></i> Validity
            </button>
        </div>

        <!-- ═══ TAB: BOM Header ═══ -->
        <div class="ent-form-panel active" data-panel="header">
            <div class="ent-section">
                <div class="ent-section-header"><i class="bi bi-info-circle"></i><h6>BOM Identification</h6></div>
                <div class="ent-field-grid cols-3">
                    <div class="ent-field">
                        <label>BOM ID</label>
                        <input class="form-control" value="Auto-generated" readonly style="background:#f8fafc" />
                    </div>
                    <div class="ent-field">
                        <label>Material Code (Parent) <span class="required">*</span></label>
                        <input asp-for="Bom.MaterialCode" class="form-control" placeholder="e.g., FG-10001" />
                        <span asp-validation-for="Bom.MaterialCode" class="text-danger"></span>
                    </div>
                    <div class="ent-field">
                        <label>Material Description <span class="required">*</span></label>
                        <input asp-for="Bom.ProductName" class="form-control" placeholder="Parent material description" />
                        <span asp-validation-for="Bom.ProductName" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="ent-section">
                <div class="ent-section-header"><i class="bi bi-sliders"></i><h6>BOM Configuration</h6></div>
                <div class="ent-field-grid cols-3">
                    <div class="ent-field">
                        <label>BOM Usage <span class="required">*</span></label>
                        <select asp-for="Bom.BOMUsage" class="form-select">
                            <option value="Production">Production</option>
                            <option value="Engineering">Engineering</option>
                            <option value="Costing">Costing</option>
                            <option value="Plant Maintenance">Plant Maintenance</option>
                        </select>
                    </div>
                    <div class="ent-field">
                        <label>Base Quantity</label>
                        <input asp-for="Bom.BaseQuantity" class="form-control" type="number" min="0.01" step="0.01" value="1" />
                    </div>
                    <div class="ent-field">
                        <label>UOM</label>
                        <select asp-for="Bom.UOM" class="form-select">
                            <option value="EA">EA — Each</option>
                            <option value="KG">KG — Kilogram</option>
                            <option value="L">L — Liter</option>
                            <option value="M">M — Meter</option>
                            <option value="LB">LB — Pound</option>
                            <option value="BOX">BOX — Box</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══ TAB: Component Detail ═══ -->
        <div class="ent-form-panel" data-panel="components">
            <div class="ent-section">
                <div class="ent-section-header"><i class="bi bi-list-nested"></i><h6>Component Information</h6></div>
                <div class="ent-field-grid cols-3">
                    <div class="ent-field">
                        <label>Component Code <span class="required">*</span></label>
                        <input asp-for="Bom.ComponentCode" class="form-control" placeholder="e.g., RM-20001" />
                        <span asp-validation-for="Bom.ComponentCode" class="text-danger"></span>
                    </div>
                    <div class="ent-field">
                        <label>Component Description <span class="required">*</span></label>
                        <input asp-for="Bom.ComponentName" class="form-control" placeholder="Component name" />
                        <span asp-validation-for="Bom.ComponentName" class="text-danger"></span>
                    </div>
                    <div class="ent-field">
                        <label>Item Category</label>
                        <select asp-for="Bom.ItemCategory" class="form-select">
                            <option value="L">L — Stock Item</option>
                            <option value="N">N — Non-Stock Item</option>
                            <option value="R">R — Variable Size Item</option>
                            <option value="T">T — Text Item</option>
                        </select>
                    </div>
                </div>
                <div class="ent-field-grid cols-3">
                    <div class="ent-field">
                        <label>Component Quantity <span class="required">*</span></label>
                        <input asp-for="Bom.Quantity" class="form-control" type="number" min="0.001" step="0.001" />
                        <span asp-validation-for="Bom.Quantity" class="text-danger"></span>
                    </div>
                    <div class="ent-field">
                        <label>Component Scrap %</label>
                        <input asp-for="Bom.ComponentScrap" class="form-control" type="number" min="0" max="100" step="0.1" value="0" />
                    </div>
                    <div class="ent-field">
                        <label>Status</label>
                        <select asp-for="Bom.Status" class="form-select">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══ TAB: Validity ═══ -->
        <div class="ent-form-panel" data-panel="validity">
            <div class="ent-section">
                <div class="ent-section-header"><i class="bi bi-calendar-range"></i><h6>Validity Period</h6></div>
                <div class="ent-field-grid cols-3">
                    <div class="ent-field">
                        <label>Valid From <span class="required">*</span></label>
                        <input asp-for="Bom.ValidFrom" class="form-control" type="date" />
                    </div>
                    <div class="ent-field">
                        <label>Valid To <span class="required">*</span></label>
                        <input asp-for="Bom.ValidTo" class="form-control" type="date" />
                    </div>
                    <div class="ent-field">
                        <label>Plant</label>
                        <input class="form-control" value="1000" readonly style="background:#f8fafc" />
                    </div>
                </div>
                <div style="background:var(--bg-secondary,#f8fafc);border-radius:8px;padding:1rem;border:1px dashed var(--border-color,#e2e8f0);margin-top:1rem">
                    <p class="text-muted mb-0" style="font-size:0.85rem"><i class="bi bi-info-circle me-1"></i> BOM validity defines the date range during which this BOM is active for production. BOMs outside this range will not be selected for new production orders.</p>
                </div>
            </div>
        </div>

        <div class="ent-form-footer">
            <div class="footer-info">
                <i class="bi bi-shield-check me-1"></i>BOM auto-numbered, status set to Active
            </div>
            <div class="footer-actions">
                <a asp-page="/PP/Index" class="btn btn-outline-secondary"><i class="bi bi-x me-1"></i>Cancel</a>
                <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Save BOM</button>
            </div>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
