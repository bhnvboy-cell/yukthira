@page
@model YuktiraERP.Web.Pages.PP.BOM.EditModel
@{ ViewData["Title"] = "Edit Bill of Material"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><i class="bi bi-pencil me-2"></i>Edit Bill of Material</h3>
            <span class="badge">@Model.Bom.BomId</span>
        </div>
        <div class="actions">
            <button type="submit" form="editForm" class="zqm-btn" style="background:#4caf50;border-color:#4caf50"><i class="bi bi-check-circle me-1"></i>Update</button>
            <a asp-page="/PP/Index" class="zqm-btn zqm-btn-back"><i class="bi bi-arrow-left me-1"></i>Back to List</a>
        </div>
    </div>

    <div class="zqm-filter">
        <div class="zqm-section-title"><i class="bi bi-box-seam me-1"></i>BOM Data</div>
        <form method="post" id="editForm">
            <input type="hidden" asp-for="Bom.Id" />
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>BOM ID</label><input asp-for="Bom.BomId" /></div>
                <div class="zqm-field"><label>Material Code</label><input asp-for="Bom.MaterialCode" /></div>
                <div class="zqm-field"><label>Product Name</label><input asp-for="Bom.ProductName" /></div>
            </div>
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Component Code</label><input asp-for="Bom.ComponentCode" /></div>
                <div class="zqm-field"><label>Component Name</label><input asp-for="Bom.ComponentName" /></div>
                <div class="zqm-field"><label>Quantity</label><input asp-for="Bom.Quantity" type="number" step="0.001" /></div>
            </div>
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>UOM</label><select asp-for="Bom.UOM"><option value="EA">EA</option><option value="KG">KG</option><option value="L">L</option><option value="M">M</option><option value="LB">LB</option><option value="BOX">BOX</option></select></div>
                <div class="zqm-field"><label>BOM Usage</label><select asp-for="Bom.BOMUsage"><option value="Production">Production</option><option value="Engineering">Engineering</option><option value="Costing">Costing</option></select></div>
                <div class="zqm-field"><label>Status</label><select asp-for="Bom.Status"><option value="Active">Active</option><option value="Inactive">Inactive</option></select></div>
            </div>
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Valid From</label><input asp-for="Bom.ValidFrom" type="date" /></div>
                <div class="zqm-field"><label>Valid To</label><input asp-for="Bom.ValidTo" type="date" /></div>
                <div class="zqm-field"><label>Component Scrap %</label><input asp-for="Bom.ComponentScrap" type="number" step="0.1" /></div>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
