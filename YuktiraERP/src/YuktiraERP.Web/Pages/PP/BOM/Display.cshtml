@page
@model YuktiraERP.Web.Pages.PP.BOM.DisplayModel
@{ ViewData["Title"] = "Bill of Material Details"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><i class="bi bi-eye me-2"></i>Bill of Material Details</h3>
            <span class="badge">@Model.Bom.BomId</span>
        </div>
        <div class="actions">
            <a asp-page="/PP/BOM/Edit" asp-route-id="@Model.Bom.Id" class="zqm-btn" style="background:#ff9800;border-color:#ff9800"><i class="bi bi-pencil me-1"></i>Edit</a>
            <a asp-page="/PP/Index" class="zqm-btn zqm-btn-back"><i class="bi bi-arrow-left me-1"></i>Back</a>
        </div>
    </div>

    <div class="zqm-results">
        <div class="zqm-results-header"><h4>BOM Information</h4></div>
        <div style="padding:16px">
            <div class="zqm-section-title"><i class="bi bi-info-circle me-1"></i>BOM Header</div>
            <div class="zqm-row cols-3">
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">BOM ID</label><div class="zqm-ro" style="font-weight:600;color:#1565c0">@Model.Bom.BomId</div></div>
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Material Code</label><div class="zqm-ro">@Model.Bom.MaterialCode</div></div>
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Product Name</label><div class="zqm-ro" style="font-weight:600">@Model.Bom.ProductName</div></div>
            </div>
            <div class="zqm-row cols-3" style="margin-top:8px">
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">BOM Usage</label><div class="zqm-ro">@Model.Bom.BOMUsage</div></div>
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Base Quantity</label><div class="zqm-ro">@Model.Bom.BaseQuantity</div></div>
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">UOM</label><div class="zqm-ro">@Model.Bom.UOM</div></div>
            </div>
            <div class="zqm-section-title" style="margin-top:16px"><i class="bi bi-list-nested me-1"></i>Component</div>
            <div class="zqm-row cols-3">
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Component Code</label><div class="zqm-ro">@Model.Bom.ComponentCode</div></div>
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Component Name</label><div class="zqm-ro" style="font-weight:600">@Model.Bom.ComponentName</div></div>
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Quantity</label><div class="zqm-ro">@Model.Bom.Quantity</div></div>
            </div>
            <div class="zqm-section-title" style="margin-top:16px"><i class="bi bi-calendar-range me-1"></i>Validity</div>
            <div class="zqm-row cols-3">
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Valid From</label><div class="zqm-ro">@Model.Bom.ValidFrom.ToString("dd MMM yyyy")</div></div>
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Valid To</label><div class="zqm-ro">@Model.Bom.ValidTo.ToString("dd MMM yyyy")</div></div>
                <div><label style="font-size:0.68rem;font-weight:600;color:#888;text-transform:uppercase">Status</label><div class="zqm-ro"><span class="zqm-badge @(Model.Bom.Status=="Active"?"passed":"warning")">@Model.Bom.Status</span></div></div>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
