@page
@model YuktiraERP.Web.Pages.PP.Plan.EditModel
@{ ViewData["Title"] = "Edit ProductionPlan"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-warning text-dark"><h5 class="mb-0"><i class="bi bi-pencil me-2"></i>Edit ProductionPlan</h5></div>
<div class="card-body">
<form method="post">
<input type="hidden" asp-for="Plan.Id" />
<div class="row mb-3"><div class="col-md-6"><label asp-for="Plan.PlanId" class="form-label"></label><input asp-for="Plan.PlanId" class="form-control" type="text" /></div><div class="col-md-6"><label asp-for="Plan.ProductName" class="form-label"></label><input asp-for="Plan.ProductName" class="form-control" type="text" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="Plan.Quantity" class="form-label"></label><input asp-for="Plan.Quantity" class="form-control" type="number" step="0.01" /></div><div class="col-md-6"><label asp-for="Plan.StartDate" class="form-label"></label><input asp-for="Plan.StartDate" class="form-control" type="datetime-local" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="Plan.EndDate" class="form-label"></label><input asp-for="Plan.EndDate" class="form-control" type="datetime-local" /></div><div class="col-md-6"><label asp-for="Plan.Status" class="form-label"></label><input asp-for="Plan.Status" class="form-control" type="text" /></div></div>
<div class="d-flex gap-2"><button type="submit" class="btn btn-warning"><i class="bi bi-save me-1"></i>Update</button><a href="/PP/Plan/List" class="btn btn-outline-secondary"><i class="bi bi-x me-1"></i>Cancel</a></div>
</form>
</div></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

