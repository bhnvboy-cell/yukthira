@page
@model YuktiraERP.Web.Pages.PP.Plan.EditModel
@{ ViewData["Title"] = "Edit Production Plan"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><i class="bi bi-pencil me-2"></i>Edit Production Plan</h3>
            <span class="badge">@Model.Plan.PlanId</span>
        </div>
        <div class="actions">
            <button type="submit" form="editForm" class="zqm-btn" style="background:#4caf50;border-color:#4caf50"><i class="bi bi-check-circle me-1"></i>Update</button>
            <a asp-page="/PP/Plan/List" class="zqm-btn zqm-btn-back"><i class="bi bi-arrow-left me-1"></i>Back to List</a>
        </div>
    </div>

    <div class="zqm-filter">
        <div class="zqm-section-title"><i class="bi bi-calendar-range me-1"></i>Plan Data</div>
        <form method="post" id="editForm">
            <input type="hidden" asp-for="Plan.Id" />
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Plan ID</label><input asp-for="Plan.PlanId" /></div>
                <div class="zqm-field"><label>Product Name</label><input asp-for="Plan.ProductName" /></div>
                <div class="zqm-field"><label>Quantity</label><input asp-for="Plan.Quantity" type="number" step="1" /></div>
            </div>
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Start Date</label><input asp-for="Plan.StartDate" type="date" /></div>
                <div class="zqm-field"><label>End Date</label><input asp-for="Plan.EndDate" type="date" /></div>
                <div class="zqm-field"><label>Status</label><select asp-for="Plan.Status"><option value="Planned">Planned</option><option value="Released">Released</option><option value="In Progress">In Progress</option><option value="Completed">Completed</option></select></div>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
