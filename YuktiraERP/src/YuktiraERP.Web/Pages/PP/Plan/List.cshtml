@page
@model YuktiraERP.Web.Pages.PP.Plan.ListModel
@{ ViewData["Title"] = "Production Plans"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><svg class="bi bi-calendar-range me-2" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-calendar-range"></use></svg>Production Plans</h3>
            <span class="badge">@Model.Items.Count records</span>
        </div>
        <div class="actions">
            <a asp-page="/PP/Plan/Create" class="zqm-btn" style="background:#4caf50;border-color:#4caf50"><svg class="bi bi-plus-circle me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-plus-circle"></use></svg>New Plan</a>
            <a asp-page="/PP/Index" class="zqm-btn zqm-btn-back"><svg class="bi bi-arrow-left me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-arrow-left"></use></svg>Back</a>
        </div>
    </div>

    <div class="zqm-filter">
        <div class="zqm-section-title"><svg class="bi bi-funnel me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-funnel"></use></svg>Search</div>
        <div class="zqm-row cols-3">
            <div class="zqm-field"><label>Plan ID</label><input id="searchPlanId" placeholder="Filter by plan ID..." oninput="filterTable()" /></div>
            <div class="zqm-field"><label>Product</label><input id="searchProduct" placeholder="Filter by product..." oninput="filterTable()" /></div>
            <div class="zqm-field"><label>Status</label><select id="searchStatus" onchange="filterTable()"><option value="">All</option><option value="Planned">Planned</option><option value="Released">Released</option><option value="In Progress">In Progress</option><option value="Completed">Completed</option></select></div>
        </div>
    </div>

    <div class="zqm-results">
        <div class="zqm-results-header"><h4>Plans</h4><span class="count" id="resultCount">@Model.Items.Count items</span></div>
        <div class="zqm-table-wrap">
            <table class="zqm-table" id="planTable">
                <thead>
                    <tr><th>Plan ID</th><th>Product</th><th>Quantity</th><th>Start Date</th><th>End Date</th><th>Status</th><th>Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr data-pid="@item.PlanId" data-product="@item.ProductName" data-status="@item.Status">
                            <td style="font-weight:600;color:#1565c0">@item.PlanId</td>
                            <td>@item.ProductName</td>
                            <td>@item.Quantity</td>
                            <td>@item.StartDate.ToString("dd MMM yyyy")</td>
                            <td>@item.EndDate.ToString("dd MMM yyyy")</td>
                            <td><span class="zqm-badge @(item.Status=="Completed"?"passed":item.Status=="Released"?"info":item.Status=="In Progress"?"warning":"created")">@item.Status</span></td>
                            <td>
                                <a asp-page="/PP/Plan/Display" asp-route-id="@item.Id" class="zqm-act" title="View"><svg class="bi bi-eye" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-eye"></use></svg></a>
                                <a asp-page="/PP/Plan/Edit" asp-route-id="@item.Id" class="zqm-act" title="Edit"><svg class="bi bi-pencil" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-pencil"></use></svg></a>
                                <form method="post" asp-page-handler="Delete" style="display:inline" onsubmit="return confirm('Delete this plan?')">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="zqm-act" title="Delete" style="color:#c62828"><svg class="bi bi-trash" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-trash"></use></svg></button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Items.Any()) { <tr><td colspan="7" class="zqm-empty"><svg class="bi bi-calendar-range" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-calendar-range"></use></svg><div>No production plans found</div></td></tr> }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
function filterTable() {
    var pid = document.getElementById('searchPlanId').value.toLowerCase();
    var prod = document.getElementById('searchProduct').value.toLowerCase();
    var status = document.getElementById('searchStatus').value;
    var rows = document.querySelectorAll('#planTable tbody tr[data-pid]');
    var count = 0;
    rows.forEach(function(r) {
        var match = (!pid || r.dataset.pid.toLowerCase().indexOf(pid) > -1) &&
                    (!prod || r.dataset.product.toLowerCase().indexOf(prod) > -1) &&
                    (!status || r.dataset.status === status);
        r.style.display = match ? '' : 'none';
        if (match) count++;
    });
    document.getElementById('resultCount').textContent = count + ' items';
}
</script>
