@page
@model YuktiraERP.Web.Pages.PP.Plan.CreateModel
@{ ViewData["Title"] = "Create Production Plan"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><i class="bi bi-calendar-range me-2"></i>Create Production Plan</h3>
            <span class="badge">New</span>
        </div>
        <div class="actions">
            <button type="submit" form="createForm" class="zqm-btn" style="background:#4caf50;border-color:#4caf50"><i class="bi bi-save me-1"></i>Save Plan</button>
            <button type="button" class="zqm-btn" onclick="document.getElementById('createForm').reset()"><i class="bi bi-x-circle me-1"></i>Clear</button>
            <a asp-page="/PP/Plan/List" class="zqm-btn zqm-btn-back"><i class="bi bi-arrow-left me-1"></i>Back</a>
        </div>
    </div>

    <div class="zqm-filter">
        <div class="zqm-section-title"><i class="bi bi-calendar-range me-1"></i>Production Plan Data</div>
        <form method="post" id="createForm">
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Plan ID</label><input asp-for="Plan.PlanId" placeholder="e.g., PLAN-001" /></div>
                <div class="zqm-field"><label>Product Name <span style="color:#c62828">*</span></label><input asp-for="Plan.ProductName" placeholder="Material or product name" /><span asp-validation-for="Plan.ProductName" style="color:#c62828;font-size:0.72rem"></span></div>
                <div class="zqm-field"><label>Quantity <span style="color:#c62828">*</span></label><input asp-for="Plan.Quantity" type="number" min="1" step="1" /><span asp-validation-for="Plan.Quantity" style="color:#c62828;font-size:0.72rem"></span></div>
            </div>
            <div class="zqm-row cols-3">
                <div class="zqm-field"><label>Start Date</label><input asp-for="Plan.StartDate" type="date" /></div>
                <div class="zqm-field"><label>End Date</label><input asp-for="Plan.EndDate" type="date" /></div>
                <div class="zqm-field"><label>Status</label><select asp-for="Plan.Status"><option value="Planned">Planned</option><option value="Released">Released</option><option value="In Progress">In Progress</option><option value="Completed">Completed</option></select></div>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
