@page
@model YuktiraERP.Web.Pages.PP.MrpStockModel
@{ ViewData["Title"] = "MRP Stock/Requirements (MD04)"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><i class="bi bi-clipboard-data me-2"></i>MRP Stock / Requirements (MD04)</h3>
            <span class="badge">@Model.MaterialAnalysis.Count materials</span>
        </div>
        <div class="actions">
            <a asp-page="/PP/MrpRun" class="zqm-btn"><i class="bi bi-play-circle me-1"></i>Run MRP</a>
            <a asp-page="/PP/Index" class="zqm-btn zqm-btn-back"><i class="bi bi-arrow-left me-1"></i>Back</a>
        </div>
    </div>

    <div class="zqm-results">
        @if (Model.MaterialAnalysis.Any())
        {
            <div class="zqm-results-header"><h4>Material Stock Analysis</h4><span class="count">@Model.MaterialAnalysis.Count materials</span></div>
            <div class="zqm-table-wrap">
                <table class="zqm-table">
                    <thead>
                        <tr><th>Code</th><th>Material</th><th>Type</th><th>Current Stock</th><th>Safety Stock</th><th>Open POs</th><th>Open Production</th><th>Reserved</th><th>Net Requirement</th><th>Action</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model.MaterialAnalysis)
                        {
                            <tr style="@(m.NetRequirement>0?"background:#fff8e1":"")">
                                <td style="font-weight:600;color:#1565c0">@m.MaterialCode</td>
                                <td style="font-weight:600">@m.MaterialName</td>
                                <td><span class="zqm-badge info">@m.MaterialType</span></td>
                                <td>@m.CurrentStock.ToString("N2")</td>
                                <td>@m.SafetyStock.ToString("N2")</td>
                                <td>@m.OpenPOQty.ToString("N2")</td>
                                <td>@m.OpenProductionQty.ToString("N2")</td>
                                <td>@m.ReservedQty.ToString("N2")</td>
                                <td style="font-weight:700;color:@(m.NetRequirement>0?"#c62828":"#2e7d32")">@m.NetRequirement.ToString("N2")</td>
                                <td><small style="color:#666">@m.SuggestedAction</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="zqm-empty" style="padding:48px"><i class="bi bi-clipboard-data"></i><div>No active materials found in the system.</div></div>
        }
    </div>
</div>
