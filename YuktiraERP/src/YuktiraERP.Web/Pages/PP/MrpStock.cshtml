@page
@model YuktiraERP.Web.Pages.PP.MrpStockModel
@{ ViewData["Title"] = "MRP Stock/Requirements (MD04)"; }
<h2><i class="bi bi-clipboard-data me-2"></i>MRP Stock / Requirements</h2>

@if (Model.MaterialAnalysis.Any())
{
<div class="card mt-3">
<div class="card-header"><h6 class="mb-0"><i class="bi bi-box-seam me-1"></i>Material Stock Analysis - @Model.MaterialAnalysis.Count materials</h6></div>
<div class="card-body">
<div class="table-responsive">
<table class="table table-sm table-hover">
<thead class="table-dark">
<tr>
<th>Code</th><th>Material</th><th>Type</th><th>Current Stock</th><th>Safety Stock</th>
<th>Open POs</th><th>Open Production</th><th>Reserved</th><th>Net Requirement</th><th>Action</th>
</tr>
</thead>
<tbody>
@foreach (var m in Model.MaterialAnalysis)
{
<tr class="@(m.NetRequirement > 0 ? "table-warning" : "")">
<td>@m.MaterialCode</td>
<td>@m.MaterialName</td>
<td><span class="badge bg-secondary">@m.MaterialType</span></td>
<td>@m.CurrentStock.ToString("N2")</td>
<td>@m.SafetyStock.ToString("N2")</td>
<td>@m.OpenPOQty.ToString("N2")</td>
<td>@m.OpenProductionQty.ToString("N2")</td>
<td>@m.ReservedQty.ToString("N2")</td>
<td><strong class="@(m.NetRequirement > 0 ? "text-danger" : "text-success")">@m.NetRequirement.ToString("N2")</strong></td>
<td><small>@m.SuggestedAction</small></td>
</tr>
}
</tbody></table>
</div>
</div></div>
}
else
{
<div class="alert alert-info mt-3">No active materials found in the system.</div>
}
