@page
@model YuktiraERP.Web.Pages.PP.IndexModel
@using YuktiraERP.Infrastructure.Data.Entities
@{
    ViewData["Title"] = "Production Planning";
}
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><i class="bi bi-gear-wide-connected me-2"></i>Production Planning</h3>
            <span class="badge">PP</span>
        </div>
        <div class="actions">
            <a asp-page="/PP/ProductionOrder/Create" class="zqm-btn" style="background:#4caf50;border-color:#4caf50"><i class="bi bi-plus-circle me-1"></i>Create Prod Order</a>
            <a asp-page="/PP/BOM/Create" class="zqm-btn"><i class="bi bi-plus-circle me-1"></i>Create BOM</a>
            <a asp-page="/PP/WorkCenter/Create" class="zqm-btn"><i class="bi bi-plus-circle me-1"></i>Create Work Center</a>
            <a asp-page="/PP/Routing/Create" class="zqm-btn"><i class="bi bi-plus-circle me-1"></i>Create Routing</a>
            <a asp-page="/PP/Confirmation/Create" class="zqm-btn"><i class="bi bi-check-circle me-1"></i>Confirm Production</a>
            <a asp-page="/PP/MrpRun" class="zqm-btn"><i class="bi bi-lightning me-1"></i>Execute MRP Run</a>
        </div>
    </div>

    <div class="zqm-filter" style="border-radius:0;padding:16px 20px">
        <div class="zqm-section-title"><i class="bi bi-speedometer2 me-1"></i>Key Performance Indicators</div>
        <div class="zqm-row cols-5">
            <div style="background:#e3f2fd;padding:14px;border-radius:6px;text-align:center;border:1px solid #bbdefb">
                <div style="font-size:1.4rem;font-weight:700;color:#1565c0">@Model.ActiveOrderCount</div>
                <div style="font-size:0.7rem;color:#666;text-transform:uppercase;letter-spacing:0.5px;margin-top:2px">Active Orders</div>
            </div>
            <div style="background:#fff3e0;padding:14px;border-radius:6px;text-align:center;border:1px solid #ffe0b2">
                <div style="font-size:1.4rem;font-weight:700;color:#e65100">@(Model.CapacityUtilization)%</div>
                <div style="font-size:0.7rem;color:#666;text-transform:uppercase;letter-spacing:0.5px;margin-top:2px">Capacity Utilization</div>
            </div>
            <div style="background:#e8f5e9;padding:14px;border-radius:6px;text-align:center;border:1px solid #c8e6c9">
                <div style="font-size:1.4rem;font-weight:700;color:#2e7d32">@Model.ConfirmationsTodayCount</div>
                <div style="font-size:0.7rem;color:#666;text-transform:uppercase;letter-spacing:0.5px;margin-top:2px">Confirmations Today</div>
            </div>
            <div style="background:#ffcdd2;padding:14px;border-radius:6px;text-align:center;border:1px solid #ef9a9a">
                <div style="font-size:1.4rem;font-weight:700;color:#c62828">@Model.MaterialShortageCount</div>
                <div style="font-size:0.7rem;color:#666;text-transform:uppercase;letter-spacing:0.5px;margin-top:2px">Material Shortage Alerts</div>
            </div>
            <div style="background:#e0f2f1;padding:14px;border-radius:6px;text-align:center;border:1px solid #b2dfdb">
                <div style="font-size:1.4rem;font-weight:700;color:#00695c">@(Model.OnTimeRate)%</div>
                <div style="font-size:0.7rem;color:#666;text-transform:uppercase;letter-spacing:0.5px;margin-top:2px">On-Time Completion</div>
            </div>
        </div>
    </div>

    <div class="zqm-tabs" id="ppTabs">
        <button type="button" class="zqm-tab-btn active" data-tab="prodorders"><i class="bi bi-gear"></i> Production Orders <span class="zqm-badge info" style="margin-left:4px">@Model.ProductionOrders.Count</span></button>
        <button type="button" class="zqm-tab-btn" data-tab="bom"><i class="bi bi-box-seam"></i> BOM <span class="zqm-badge info" style="margin-left:4px">@Model.BillOfMaterials.Count</span></button>
        <button type="button" class="zqm-tab-btn" data-tab="workcenters"><i class="bi bi-building"></i> Work Centers <span class="zqm-badge info" style="margin-left:4px">@Model.WorkCenters.Count</span></button>
        <button type="button" class="zqm-tab-btn" data-tab="routings"><i class="bi bi-diagram-3"></i> Routings <span class="zqm-badge info" style="margin-left:4px">@Model.Routings.Count</span></button>
        <button type="button" class="zqm-tab-btn" data-tab="mrp"><i class="bi bi-cpu"></i> MRP Run</button>
        <button type="button" class="zqm-tab-btn" data-tab="confirmations"><i class="bi bi-check2-square"></i> Order Confirmation <span class="zqm-badge info" style="margin-left:4px">@Model.Confirmations.Count</span></button>
    </div>

    <!-- TAB: Production Orders -->
    <div class="zqm-tab-panel active" data-panel="prodorders">
        <div class="zqm-results" style="border-radius:0 0 6px 6px">
            <div class="zqm-results-header"><h4>Production Orders</h4><span class="count">@Model.ProductionOrders.Count items</span></div>
            <div class="zqm-table-wrap">
                <table class="zqm-table">
                    <thead>
                        <tr>
                            <th>Order #</th>
                            <th>Material Code</th>
                            <th>Material Description</th>
                            <th>Target Qty</th>
                            <th>Confirmed Qty</th>
                            <th>Start Date</th>
                            <th>Finish Date</th>
                            <th>Work Center</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ProductionOrders.Any())
                        {
                            @foreach (var o in Model.ProductionOrders)
                            {
                                var confirmedQty = o.YieldQty;
                                <tr>
                                    <td style="font-weight:600;color:#1565c0">@o.OrderNumber</td>
                                    <td>@o.MaterialCode</td>
                                    <td>@o.ProductName</td>
                                    <td>@o.Quantity @o.BaseUOM</td>
                                    <td>@confirmedQty</td>
                                    <td>@o.StartDate.ToString("dd MMM yyyy")</td>
                                    <td>@o.EndDate.ToString("dd MMM yyyy")</td>
                                    <td>@o.StorageLocation</td>
                                    <td><span class="zqm-badge @(o.Status=="PLANNED"?"info":o.Status=="RELEASED"?"warning":o.Status=="IN_PROGRESS"?"purple":o.Status=="COMPLETED"?"passed":o.Status=="TECO"?"closed":"failed")">@o.Status</span></td>
                                    <td>
                                        <a asp-page="/PP/ProductionOrder/Edit" asp-route-id="@o.Id" class="zqm-act" title="Edit"><i class="bi bi-pencil"></i></a>
                                        <a asp-page="/PP/ProductionOrder/Display" asp-route-id="@o.Id" class="zqm-act" title="View"><i class="bi bi-eye"></i></a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="10" class="zqm-empty"><i class="bi bi-gear"></i><div>No production orders found</div></td></tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="zqm-footer"><div>Showing @Model.ProductionOrders.Count orders</div></div>
        </div>
    </div>

    <!-- TAB: BOM -->
    <div class="zqm-tab-panel" data-panel="bom">
        <div class="zqm-results" style="border-radius:0 0 6px 6px">
            <div class="zqm-results-header"><h4>Bill of Materials</h4><span class="count">@Model.BillOfMaterials.Count items</span></div>
            <div class="zqm-table-wrap">
                <table class="zqm-table">
                    <thead>
                        <tr>
                            <th>BOM ID</th>
                            <th>Material Code</th>
                            <th>Product</th>
                            <th>Component</th>
                            <th>Comp. Code</th>
                            <th>Qty</th>
                            <th>UOM</th>
                            <th>Usage</th>
                            <th>Scrap %</th>
                            <th>Valid From</th>
                            <th>Valid To</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.BillOfMaterials.Any())
                        {
                            @foreach (var b in Model.BillOfMaterials)
                            {
                                <tr>
                                    <td style="font-weight:600;color:#1565c0">@b.BomId</td>
                                    <td>@b.MaterialCode</td>
                                    <td>@b.ProductName</td>
                                    <td>@b.ComponentName</td>
                                    <td>@b.ComponentCode</td>
                                    <td>@b.Quantity</td>
                                    <td>@b.UOM</td>
                                    <td>@b.BOMUsage</td>
                                    <td>@b.ComponentScrap%</td>
                                    <td>@b.ValidFrom.ToString("dd MMM yyyy")</td>
                                    <td>@b.ValidTo.ToString("dd MMM yyyy")</td>
                                    <td><span class="zqm-badge @(b.Status=="Active"?"passed":"warning")">@b.Status</span></td>
                                    <td>
                                        <a asp-page="/PP/BOM/Edit" asp-route-id="@b.Id" class="zqm-act" title="Edit"><i class="bi bi-pencil"></i></a>
                                        <a asp-page="/PP/BOM/Display" asp-route-id="@b.Id" class="zqm-act" title="View"><i class="bi bi-eye"></i></a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="13" class="zqm-empty"><i class="bi bi-box-seam"></i><div>No BOMs found</div></td></tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="zqm-footer"><div>Showing @Model.BillOfMaterials.Count BOMs</div></div>
        </div>
    </div>

    <!-- TAB: Work Centers -->
    <div class="zqm-tab-panel" data-panel="workcenters">
        <div class="zqm-results" style="border-radius:0 0 6px 6px">
            <div class="zqm-results-header"><h4>Work Centers</h4><span class="count">@Model.WorkCenters.Count items</span></div>
            <div class="zqm-table-wrap">
                <table class="zqm-table">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Department</th>
                            <th>Cost Center</th>
                            <th>Capacity/Shift</th>
                            <th>Shifts/Day</th>
                            <th>Capacity/Day</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.WorkCenters.Any())
                        {
                            @foreach (var w in Model.WorkCenters)
                            {
                                <tr>
                                    <td style="font-weight:600;color:#1565c0">@w.Code</td>
                                    <td>@w.Name</td>
                                    <td>@w.WorkCenterCategory</td>
                                    <td>@w.Department</td>
                                    <td>@w.CostCenter</td>
                                    <td>@w.CapacityPerShift</td>
                                    <td>@w.ShiftsPerDay</td>
                                    <td>@w.CapacityPerDay</td>
                                    <td><span class="zqm-badge @(w.Status=="Active"?"passed":w.Status=="Maintenance"?"warning":"failed")">@w.Status</span></td>
                                    <td>
                                        <a asp-page="/PP/WorkCenter/Edit" asp-route-id="@w.Id" class="zqm-act" title="Edit"><i class="bi bi-pencil"></i></a>
                                        <a asp-page="/PP/WorkCenter/Display" asp-route-id="@w.Id" class="zqm-act" title="View"><i class="bi bi-eye"></i></a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="10" class="zqm-empty"><i class="bi bi-building"></i><div>No work centers found</div></td></tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="zqm-footer"><div>Showing @Model.WorkCenters.Count work centers</div></div>
        </div>
    </div>

    <!-- TAB: Routings -->
    <div class="zqm-tab-panel" data-panel="routings">
        <div class="zqm-results" style="border-radius:0 0 6px 6px">
            <div class="zqm-results-header"><h4>Production Routings</h4><span class="count">@Model.Routings.Count items</span></div>
            <div class="zqm-table-wrap">
                <table class="zqm-table">
                    <thead>
                        <tr>
                            <th>Routing ID</th>
                            <th>Group</th>
                            <th>Product</th>
                            <th>Op #</th>
                            <th>Description</th>
                            <th>Work Center</th>
                            <th>Setup (hrs)</th>
                            <th>Machine (hrs)</th>
                            <th>Labor (hrs)</th>
                            <th>Scrap %</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Routings.Any())
                        {
                            @foreach (var r in Model.Routings)
                            {
                                <tr>
                                    <td style="font-weight:600;color:#1565c0">@r.RoutingId</td>
                                    <td>@r.RoutingGroup</td>
                                    <td>@r.ProductName</td>
                                    <td>@r.OperationNo</td>
                                    <td>@r.OperationDescription</td>
                                    <td>@r.WorkCenter</td>
                                    <td>@r.SetupTimeHrs</td>
                                    <td>@r.MachineTimeHrs</td>
                                    <td>@r.LaborTimeHrs</td>
                                    <td>@r.ScrapPercent%</td>
                                    <td><span class="zqm-badge @(r.Status=="Active"?"passed":"warning")">@r.Status</span></td>
                                    <td>
                                        <a asp-page="/PP/Routing/Edit" asp-route-id="@r.Id" class="zqm-act" title="Edit"><i class="bi bi-pencil"></i></a>
                                        <a asp-page="/PP/Routing/Display" asp-route-id="@r.Id" class="zqm-act" title="View"><i class="bi bi-eye"></i></a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="12" class="zqm-empty"><i class="bi bi-diagram-3"></i><div>No routings found</div></td></tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="zqm-footer"><div>Showing @Model.Routings.Count routings</div></div>
        </div>
    </div>

    <!-- TAB: MRP Run -->
    <div class="zqm-tab-panel" data-panel="mrp">
        <div class="zqm-results" style="border-radius:0 0 6px 6px;padding:20px">
            <div class="zqm-section-title"><i class="bi bi-cpu me-1"></i>Material Requirements Planning</div>
            <div class="zqm-row cols-3">
                <a asp-page="/PP/MrpRun" style="background:#e3f2fd;padding:20px;border-radius:8px;text-decoration:none;color:inherit;border:1px solid #bbdefb;display:block;transition:all 0.2s">
                    <div style="font-size:1.5rem;margin-bottom:6px;color:#1565c0"><i class="bi bi-play-circle"></i></div>
                    <div style="font-weight:700;font-size:0.9rem;color:#1a237e">MD01 — MRP Run</div>
                    <div style="font-size:0.78rem;color:#666;margin-top:4px">Run material requirements planning</div>
                </a>
                <a asp-page="/PP/Mrp" style="background:#fff3e0;padding:20px;border-radius:8px;text-decoration:none;color:inherit;border:1px solid #ffe0b2;display:block;transition:all 0.2s">
                    <div style="font-size:1.5rem;margin-bottom:6px;color:#e65100"><i class="bi bi-cpu"></i></div>
                    <div style="font-weight:700;font-size:0.9rem;color:#1a237e">MRP & Capacity Planning</div>
                    <div style="font-size:0.78rem;color:#666;margin-top:4px">BOM explosion and capacity leveling</div>
                </a>
                <a asp-page="/PP/MrpStock" style="background:#e8f5e9;padding:20px;border-radius:8px;text-decoration:none;color:inherit;border:1px solid #c8e6c9;display:block;transition:all 0.2s">
                    <div style="font-size:1.5rem;margin-bottom:6px;color:#2e7d32"><i class="bi bi-clipboard-data"></i></div>
                    <div style="font-weight:700;font-size:0.9rem;color:#1a237e">MD04 — Stock/Requirements</div>
                    <div style="font-size:0.78rem;color:#666;margin-top:4px">Material stock and requirements list</div>
                </a>
            </div>
        </div>
    </div>

    <!-- TAB: Order Confirmation -->
    <div class="zqm-tab-panel" data-panel="confirmations">
        <div class="zqm-results" style="border-radius:0 0 6px 6px">
            <div class="zqm-results-header"><h4>Order Confirmations</h4><span class="count">@Model.Confirmations.Count items</span></div>
            <div class="zqm-table-wrap">
                <table class="zqm-table">
                    <thead>
                        <tr>
                            <th>Confirmation #</th>
                            <th>Prod Order #</th>
                            <th>Operation #</th>
                            <th>Yield Qty</th>
                            <th>Scrap Qty</th>
                            <th>Setup (hrs)</th>
                            <th>Machine (hrs)</th>
                            <th>Labor (hrs)</th>
                            <th>Backflush</th>
                            <th>Confirmed By</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Confirmations.Any())
                        {
                            @foreach (var c in Model.Confirmations)
                            {
                                <tr>
                                    <td style="font-weight:600;color:#1565c0">@c.ConfirmationNumber</td>
                                    <td>@c.ProductionOrderNumber</td>
                                    <td>@c.OperationNumber</td>
                                    <td>@c.YieldQuantity</td>
                                    <td>@c.ScrapQuantity</td>
                                    <td>@c.ActualSetupTime</td>
                                    <td>@c.ActualMachineTime</td>
                                    <td>@c.ActualLaborTime</td>
                                    <td><span class="zqm-badge @(c.BackflushGoodsIssue?"passed":"info")">@(c.BackflushGoodsIssue?"Yes":"No")</span></td>
                                    <td>@c.ConfirmedBy</td>
                                    <td>@c.ConfirmationDate.ToString("dd MMM yyyy")</td>
                                    <td><span class="zqm-badge @(c.Status=="Confirmed"?"passed":"warning")">@c.Status</span></td>
                                    <td>
                                        <a href="javascript:void(0)" class="zqm-act" title="View"><i class="bi bi-eye"></i></a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="13" class="zqm-empty"><i class="bi bi-check2-square"></i><div>No confirmations found</div></td></tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="zqm-footer"><div>Showing @Model.Confirmations.Count confirmations</div></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
    document.querySelectorAll('.zqm-tab-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var tab = this.getAttribute('data-tab');
            document.querySelectorAll('.zqm-tab-btn').forEach(function(b) { b.classList.remove('active'); });
            document.querySelectorAll('.zqm-tab-panel').forEach(function(p) { p.classList.remove('active'); });
            this.classList.add('active');
            document.querySelector('.zqm-tab-panel[data-panel="' + tab + '"]').classList.add('active');
        });
    });
    </script>
}
