@page
@model YuktiraERP.Web.Pages.PP.MrpModel
@using YuktiraERP.Core.Interfaces
@{ ViewData["Title"] = "MRP & Capacity Planning"; }
<link rel="stylesheet" href="~/css/zqm-classic.css" />

<div class="zqm">
    <div class="zqm-toolbar">
        <div style="display:flex;align-items:center;gap:10px">
            <h3><i class="bi bi-cpu me-2"></i>MRP & Capacity Planning</h3>
            <span class="badge">MRP</span>
        </div>
        <div class="actions">
            <a asp-page="/PP/MrpRun" class="zqm-btn" style="background:#4caf50;border-color:#4caf50"><i class="bi bi-play-circle me-1"></i>Run MRP</a>
            <a asp-page="/PP/Index" class="zqm-btn zqm-btn-back"><i class="bi bi-arrow-left me-1"></i>Back</a>
        </div>
    </div>

    <div class="zqm-tabs">
        <button type="button" class="zqm-tab-btn @(Model.Tab=="mrp"||string.IsNullOrEmpty(Model.Tab)?"active":"")" data-tab="mrp"><i class="bi bi-diagram-3 me-1"></i>MRP Explosion</button>
        <button type="button" class="zqm-tab-btn @(Model.Tab=="capacity"?"active":"")" data-tab="capacity"><i class="bi bi-speedometer me-1"></i>Capacity Load</button>
        <button type="button" class="zqm-tab-btn @(Model.Tab=="forecast"?"active":"")" data-tab="forecast"><i class="bi bi-graph-up me-1"></i>Forecast & Safety Stock</button>
    </div>

    <!-- TAB: MRP Explosion -->
    <div class="zqm-tab-panel @(Model.Tab=="mrp"||string.IsNullOrEmpty(Model.Tab)?"active":"")" data-panel="mrp">
        <div class="zqm-filter" style="border-radius:0">
            <div class="zqm-section-title"><i class="bi bi-diagram-3 me-1"></i>BOM Explosion</div>
            <form method="post" asp-page-handler="Explode">
                <div class="zqm-row cols-4">
                    <div class="zqm-field"><label>Product</label><select asp-for="ProductName" asp-items="@(new SelectList(Model.Products))"><option value="">-- Select --</option></select></div>
                    <div class="zqm-field"><label>Quantity</label><input asp-for="Quantity" type="number" min="1" /></div>
                    <div class="zqm-field" style="display:flex;align-items:end;gap:6px;padding-bottom:1px"><button type="submit" class="zqm-btn" style="background:#1565c0;border-color:#1565c0"><i class="bi bi-calculator me-1"></i>Explode BOM</button></div>
                </div>
            </form>
        </div>

        <div class="zqm-results" style="border-radius:0 0 6px 6px">
            @if (Model.Suggestions.Any())
            {
                <div class="zqm-results-header"><h4>MRP Requirements</h4><span class="count">@Model.Suggestions.Count items</span></div>
                <div class="zqm-table-wrap">
                    <table class="zqm-table">
                        <thead><tr><th>Component</th><th>Material Code</th><th>Gross Req</th><th>On Hand</th><th>Safety Stock</th><th>Net Req</th><th>Order Type</th><th>Action</th></tr></thead>
                        <tbody>
                            @foreach (var r in Model.Suggestions)
                            {
                                var isShort = r.ShortageQty > 0;
                                <tr style="@(isShort?"background:#fff8e1":"")">
                                    <td style="font-weight:600">@r.MaterialName</td>
                                    <td>@r.MaterialCode</td>
                                    <td>@r.TotalDemand.ToString("N0")</td>
                                    <td>@r.CurrentStock.ToString("N0")</td>
                                    <td>@(r.OpenPoQty > 0 ? r.OpenPoQty.ToString("N0") : "--")</td>
                                    <td style="font-weight:700;color:@(isShort?"#c62828":"#2e7d32")">@r.ShortageQty.ToString("N0")</td>
                                    <td><span class="zqm-badge @(r.SuggestionType=="PURCHASE"?"info":"passed")">@r.SuggestionType</span></td>
                                    <td>
                                        @if (isShort)
                                        {
                                            <button class="zqm-btn" style="font-size:0.75rem;padding:3px 8px;background:#1565c0;border-color:#1565c0" onclick="alert('Create @r.SuggestionType order for @r.SuggestedQty')"><i class="bi bi-plus me-1"></i>Order @r.SuggestedQty.ToString("N0")</button>
                                        }
                                        else
                                        {
                                            <span class="zqm-badge passed"><i class="bi bi-check-circle me-1"></i>Covered</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="zqm-alert info" style="display:block"><i class="bi bi-info-circle me-1"></i>Select a product and quantity above, then click "Explode BOM" to see material requirements.</div>
            }

            @if (Model.StockAlerts.Any(a => a.CurrentStock <= a.ReorderPoint))
            {
                <div style="padding:12px 16px"><div class="zqm-section-title" style="color:#c62828;border-bottom-color:#ffcdd2"><i class="bi bi-exclamation-triangle me-1"></i>Stock Shortage Alerts</div></div>
                <div class="zqm-table-wrap">
                    <table class="zqm-table">
                        <thead><tr><th>Material</th><th>Stock</th><th>Reorder Point</th><th>Safety Stock</th><th>Status</th></tr></thead>
                        <tbody>
                            @foreach (var a in Model.StockAlerts.Where(a => a.CurrentStock <= a.ReorderPoint))
                            {
                                <tr style="background:#fff8e1">
                                    <td style="font-weight:600">@a.MaterialName</td>
                                    <td>@a.CurrentStock.ToString("N0")</td>
                                    <td>@a.ReorderPoint.ToString("N0")</td>
                                    <td>@a.SafetyStock.ToString("N0")</td>
                                    <td><span class="zqm-badge failed">REORDER</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- TAB: Capacity Load -->
    <div class="zqm-tab-panel @(Model.Tab=="capacity"?"active":"")" data-panel="capacity">
        <div class="zqm-results" style="border-radius:0 0 6px 6px">
            @if (Model.CapacityLoads.Any())
            {
                <div class="zqm-results-header"><h4>Work Center Load Summary</h4><span class="count">@Model.CapacityLoads.Count work centers</span></div>
                <div class="zqm-table-wrap">
                    <table class="zqm-table">
                        <thead><tr><th>Work Center</th><th>Code</th><th>Department</th><th>Available (hrs)</th><th>Required (hrs)</th><th>Load %</th><th>Operations</th><th>Status</th></tr></thead>
                        <tbody>
                            @foreach (var wc in Model.CapacityLoads)
                            {
                                var pct = wc.LoadPercent;
                                <tr>
                                    <td style="font-weight:600">@wc.Name</td>
                                    <td>@wc.Code</td>
                                    <td>@wc.Department</td>
                                    <td>@wc.AvailableHours.ToString("N1")</td>
                                    <td>@wc.RequiredHours.ToString("N1")</td>
                                    <td style="font-weight:700;color:@(pct>100?"#c62828":pct>80?"#e65100":"#2e7d32")">@pct.ToString("F1")%</td>
                                    <td>@wc.OperationCount</td>
                                    <td><span class="zqm-badge @(pct>100?"failed":pct>80?"warning":"passed")">@(pct>100?"Overloaded":pct>80?"Near Capacity":"Available")</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="zqm-empty" style="padding:40px"><i class="bi bi-speedometer"></i><div>No work center load data available. Create work centers, routings, and production orders first.</div></div>
            }
        </div>
    </div>

    <!-- TAB: Forecast & Safety Stock -->
    <div class="zqm-tab-panel @(Model.Tab=="forecast"?"active":"")" data-panel="forecast">
        <div class="zqm-filter" style="border-radius:0">
            <div class="zqm-section-title"><i class="bi bi-graph-up me-1"></i>Demand Forecast</div>
            <form method="post" asp-page-handler="Forecast">
                <div class="zqm-row cols-4">
                    <div class="zqm-field"><label>Material</label><select name="materialId" asp-items="@(new SelectList(Model.Products))"><option value="">-- Select --</option></select></div>
                    <div class="zqm-field"><label>Forecast Model</label><select asp-for="ForecastModel"><option value="MovingAverage">Moving Average</option><option value="WeightedMovingAverage">Weighted Moving Average</option><option value="ExponentialSmoothing">Exponential Smoothing</option><option value="LinearRegression">Linear Regression</option><option value="SeasonalDecomposition">Seasonal Decomposition</option></select></div>
                    <div class="zqm-field" style="display:flex;align-items:end;gap:6px;padding-bottom:1px"><button type="submit" class="zqm-btn" style="background:#1565c0;border-color:#1565c0"><i class="bi bi-graph-up me-1"></i>Forecast</button></div>
                </div>
            </form>
        </div>

        <div class="zqm-results" style="border-radius:0 0 6px 6px">
            @if (Model.Forecast != null)
            {
                <div class="zqm-results-header">
                    <h4>@Model.Forecast.MaterialName — @Model.Forecast.ModelName</h4>
                    <span class="count">Next: <strong>@Model.Forecast.NextPeriodForecast.ToString("N0")</strong> &middot; R²: @Model.Forecast.RSquare.ToString("F3") &middot; MAPE: @Model.Forecast.Mape.ToString("F1")%</span>
                </div>
                <div class="zqm-table-wrap">
                    <table class="zqm-table">
                        <thead><tr><th>Period</th><th>Historical</th><th>Forecast</th></tr></thead>
                        <tbody>
                            @for (int i = 0; i < Model.Forecast.PeriodLabels.Count; i++)
                            {
                                var hist = i < Model.Forecast.HistoricalDemand.Count ? Model.Forecast.HistoricalDemand[i].ToString("N0") : "--";
                                var fcast = i >= Model.Forecast.HistoricalDemand.Count - Model.Forecast.ForecastedDemand.Count
                                    && (i - Model.Forecast.HistoricalDemand.Count + Model.Forecast.ForecastedDemand.Count) >= 0
                                    && (i - Model.Forecast.HistoricalDemand.Count + Model.Forecast.ForecastedDemand.Count) < Model.Forecast.ForecastedDemand.Count
                                    ? Model.Forecast.ForecastedDemand[i - Model.Forecast.HistoricalDemand.Count + Model.Forecast.ForecastedDemand.Count].ToString("N0")
                                    : "--";
                                <tr style="@(i >= Model.Forecast.HistoricalDemand.Count - Model.Forecast.ForecastedDemand.Count ? "background:#e3f2fd" : "")">
                                    <td>@Model.Forecast.PeriodLabels[i]</td>
                                    <td>@hist</td>
                                    <td style="font-weight:600;color:#1565c0">@fcast</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div style="padding:12px 16px"><div class="zqm-section-title"><i class="bi bi-shield-check me-1"></i>Safety Stock & Reorder Points</div></div>
            @if (Model.StockAlerts.Any())
            {
                <div class="zqm-table-wrap">
                    <table class="zqm-table">
                        <thead><tr><th>Material</th><th>Avg Demand</th><th>Std Dev</th><th>Safety Stock</th><th>Reorder Point</th><th>Current Stock</th><th>Days of Stock</th><th>Status</th></tr></thead>
                        <tbody>
                            @foreach (var s in Model.StockAlerts)
                            {
                                var isCritical = s.CurrentStock <= s.SafetyStock;
                                var isWarning = s.CurrentStock <= s.ReorderPoint;
                                <tr style="@(isCritical?"background:#ffcdd2":isWarning?"background:#fff8e1":"")">
                                    <td style="font-weight:600">@s.MaterialName <small style="color:#888">(@s.MaterialCode)</small></td>
                                    <td>@s.AverageDemand.ToString("N0")</td>
                                    <td>@s.DemandStdDev.ToString("N1")</td>
                                    <td style="font-weight:700">@s.SafetyStock.ToString("N0")</td>
                                    <td style="font-weight:700">@s.ReorderPoint.ToString("N0")</td>
                                    <td>@s.CurrentStock.ToString("N0")</td>
                                    <td>@s.DaysOfStock.ToString("N1")</td>
                                    <td><span class="zqm-badge @(isCritical?"failed":isWarning?"warning":"passed")">@(isCritical?"Critical":isWarning?"Reorder":"OK")</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="zqm-empty" style="padding:24px"><i class="bi bi-shield-check"></i><div>No safety stock data available.</div></div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
    document.querySelectorAll('.zqm-tab-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var tab = this.getAttribute('data-tab');
            document.querySelectorAll('.zqm-tab-btn').forEach(function(b) { b.classList.remove('active'); });
            document.querySelectorAll('.zqm-tab-panel').forEach(function(p) { p.classList.remove('active'); });
            this.classList.add('active');
            document.querySelector('.zqm-tab-panel[data-panel="' + tab + '"]').classList.add('active');
        });
    });
    </script>
}
