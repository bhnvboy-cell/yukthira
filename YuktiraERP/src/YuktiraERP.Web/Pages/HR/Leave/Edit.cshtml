@page
@model YuktiraERP.Web.Pages.HR.Leave.EditModel
@{ ViewData["Title"] = "Edit LeaveRequest"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-warning text-dark"><h5 class="mb-0"><svg class="bi bi-pencil me-2" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-pencil"></use></svg>Edit LeaveRequest</h5></div>
<div class="card-body">
<form method="post">
<input type="hidden" asp-for="LeaveRequest.Id" />
<div class="row mb-3"><div class="col-md-6"><label asp-for="LeaveRequest.LeaveId" class="form-label"></label><input asp-for="LeaveRequest.LeaveId" class="form-control" type="text" /></div><div class="col-md-6"><label asp-for="LeaveRequest.EmployeeName" class="form-label"></label><input asp-for="LeaveRequest.EmployeeName" class="form-control" type="text" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="LeaveRequest.LeaveType" class="form-label"></label><input asp-for="LeaveRequest.LeaveType" class="form-control" type="text" /></div><div class="col-md-6"><label asp-for="LeaveRequest.StartDate" class="form-label"></label><input asp-for="LeaveRequest.StartDate" class="form-control" type="datetime-local" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="LeaveRequest.EndDate" class="form-label"></label><input asp-for="LeaveRequest.EndDate" class="form-control" type="datetime-local" /></div><div class="col-md-6"><label asp-for="LeaveRequest.Status" class="form-label"></label><input asp-for="LeaveRequest.Status" class="form-control" type="text" /></div></div>
<div class="d-flex gap-2"><button type="submit" class="btn btn-warning"><svg class="bi bi-save me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-save"></use></svg>Update</button><a href="/HR/Leave/List" class="btn btn-outline-secondary"><svg class="bi bi-x me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-x"></use></svg>Cancel</a></div>
</form>
</div></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

