@page
@model YuktiraERP.Web.Pages.HR.Leave.DisplayModel
@using YuktiraERP.Infrastructure.Data.Entities
@{ ViewData["Title"] = "LeaveRequest Details"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-info text-white"><h5 class="mb-0"><i class="bi bi-eye me-2"></i>LeaveRequest Details</h5></div>
<div class="card-body">
<dl class="row mb-0"><dt class="col-sm-4">LeaveId</dt><dd class="col-sm-8">@(Model.LeaveRequest.LeaveId)</dd><dt class="col-sm-4">EmployeeName</dt><dd class="col-sm-8">@(Model.LeaveRequest.EmployeeName)</dd><dt class="col-sm-4">LeaveType</dt><dd class="col-sm-8">@(Model.LeaveRequest.LeaveType)</dd><dt class="col-sm-4">StartDate</dt><dd class="col-sm-8">@(Model.LeaveRequest.StartDate)</dd><dt class="col-sm-4">EndDate</dt><dd class="col-sm-8">@(Model.LeaveRequest.EndDate)</dd><dt class="col-sm-4">Status</dt><dd class="col-sm-8">@(Model.LeaveRequest.Status)</dd></dl>
</div>
<div class="card-footer">
<a href="/HR/Leave/List" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
<a href="/HR/Leave/Edit?id=@(Model.LeaveRequest.Id)" class="btn btn-warning"><i class="bi bi-pencil me-1"></i>Edit</a>
</div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

