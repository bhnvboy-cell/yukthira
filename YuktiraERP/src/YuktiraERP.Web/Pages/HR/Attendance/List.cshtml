@page
@model YuktiraERP.Web.Pages.HR.Attendance.ListModel
@{ ViewData["Title"] = "Attendance List"; }
<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><svg class="bi bi-list-ul me-2" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-list-ul"></use></svg>Attendance Records</h2>
        <a href="/HR/Attendance/Create" class="btn btn-primary btn-sm"><svg class="bi bi-plus-circle me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-plus-circle"></use></svg>New Attendance</a>
    </div>
    <div class="card shadow-sm">
        <div class="card-body p-0" style="overflow-x:auto">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light"><tr><th>AttendanceId</th><th>EmployeeCode</th><th>EmployeeName</th><th>Date</th><th>Status</th><th style="width:160px">Actions</th></tr></thead>
                <tbody>
                    @if (Model.Items.Count == 0) {
                        <tr><td colspan="6" class="text-center text-muted py-4">No records found</td></tr>
                    }
                    @foreach (var item in Model.Items) {
                        <tr>
                            <td>@item.AttendanceId</td><td>@item.EmployeeCode</td><td>@item.EmployeeName</td><td>@item.Date</td><td>@item.Status</td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a href="/HR/Attendance/Display?id=@item.Id" class="btn btn-outline-info" title="View"><svg class="bi bi-eye" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-eye"></use></svg></a>
                                    <a href="/HR/Attendance/Edit?id=@item.Id" class="btn btn-outline-warning" title="Edit"><svg class="bi bi-pencil" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-pencil"></use></svg></a>
                                    <form method="post" asp-page-handler="Delete" style="display:inline" onsubmit="return confirm('Delete this record?')">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-outline-danger" title="Delete"><svg class="bi bi-trash" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-trash"></use></svg></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

