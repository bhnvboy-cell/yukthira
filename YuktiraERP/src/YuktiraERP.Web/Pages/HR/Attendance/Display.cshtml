@page
@model YuktiraERP.Web.Pages.HR.Attendance.DisplayModel
@using YuktiraERP.Infrastructure.Data.Entities
@{ ViewData["Title"] = "Attendance Details"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-info text-white"><h5 class="mb-0"><svg class="bi bi-eye me-2" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-eye"></use></svg>Attendance Details</h5></div>
<div class="card-body">
<dl class="row mb-0"><dt class="col-sm-4">AttendanceId</dt><dd class="col-sm-8">@(Model.Attendance.AttendanceId)</dd><dt class="col-sm-4">EmployeeCode</dt><dd class="col-sm-8">@(Model.Attendance.EmployeeCode)</dd><dt class="col-sm-4">EmployeeName</dt><dd class="col-sm-8">@(Model.Attendance.EmployeeName)</dd><dt class="col-sm-4">Date</dt><dd class="col-sm-8">@(Model.Attendance.Date)</dd><dt class="col-sm-4">Status</dt><dd class="col-sm-8">@(Model.Attendance.Status)</dd></dl>
</div>
<div class="card-footer">
<a href="/HR/Attendance/List" class="btn btn-outline-secondary"><svg class="bi bi-arrow-left me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-arrow-left"></use></svg>Back</a>
<a href="/HR/Attendance/Edit?id=@(Model.Attendance.Id)" class="btn btn-warning"><svg class="bi bi-pencil me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-pencil"></use></svg>Edit</a>
</div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

