@page
@model YuktiraERP.Web.Pages.HR.Payroll.DisplayModel
@using YuktiraERP.Infrastructure.Data.Entities
@{ ViewData["Title"] = "PayrollEntry Details"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-info text-white"><h5 class="mb-0"><i class="bi bi-eye me-2"></i>PayrollEntry Details</h5></div>
<div class="card-body">
<dl class="row mb-0"><dt class="col-sm-4">PayrollId</dt><dd class="col-sm-8">@(Model.Entry.PayrollId)</dd><dt class="col-sm-4">EmployeeName</dt><dd class="col-sm-8">@(Model.Entry.EmployeeName)</dd><dt class="col-sm-4">Period</dt><dd class="col-sm-8">@(Model.Entry.Period)</dd><dt class="col-sm-4">GrossPay</dt><dd class="col-sm-8">@(Model.Entry.GrossPay)</dd><dt class="col-sm-4">Deductions</dt><dd class="col-sm-8">@(Model.Entry.Deductions)</dd><dt class="col-sm-4">NetPay</dt><dd class="col-sm-8">@(Model.Entry.NetPay)</dd><dt class="col-sm-4">Status</dt><dd class="col-sm-8">@(Model.Entry.Status)</dd></dl>
</div>
<div class="card-footer">
<a href="/HR/Payroll/List" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
<a href="/HR/Payroll/Edit?id=@(Model.Entry.Id)" class="btn btn-warning"><i class="bi bi-pencil me-1"></i>Edit</a>
</div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

