@page
@model YuktiraERP.Web.Pages.HR.Appraisal.DisplayModel
@using YuktiraERP.Infrastructure.Data.Entities
@{ ViewData["Title"] = "Appraisal Details"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-info text-white"><h5 class="mb-0"><svg class="bi bi-eye me-2" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-eye"></use></svg>Appraisal Details</h5></div>
<div class="card-body">
<dl class="row mb-0"><dt class="col-sm-4">AppraisalId</dt><dd class="col-sm-8">@(Model.Appraisal.AppraisalId)</dd><dt class="col-sm-4">EmployeeCode</dt><dd class="col-sm-8">@(Model.Appraisal.EmployeeCode)</dd><dt class="col-sm-4">EmployeeName</dt><dd class="col-sm-8">@(Model.Appraisal.EmployeeName)</dd><dt class="col-sm-4">Period</dt><dd class="col-sm-8">@(Model.Appraisal.Period)</dd><dt class="col-sm-4">Rating</dt><dd class="col-sm-8">@(Model.Appraisal.Rating)</dd><dt class="col-sm-4">Comments</dt><dd class="col-sm-8">@(Model.Appraisal.Comments)</dd><dt class="col-sm-4">Status</dt><dd class="col-sm-8">@(Model.Appraisal.Status)</dd></dl>
</div>
<div class="card-footer">
<a href="/HR/Appraisal/List" class="btn btn-outline-secondary"><svg class="bi bi-arrow-left me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-arrow-left"></use></svg>Back</a>
<a href="/HR/Appraisal/Edit?id=@(Model.Appraisal.Id)" class="btn btn-warning"><svg class="bi bi-pencil me-1" aria-hidden="true" focusable="false"><use href="/images/sprite.svg#bi-pencil"></use></svg>Edit</a>
</div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

