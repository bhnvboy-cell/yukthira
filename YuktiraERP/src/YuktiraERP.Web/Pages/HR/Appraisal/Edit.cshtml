@page
@model YuktiraERP.Web.Pages.HR.Appraisal.EditModel
@{ ViewData["Title"] = "Edit Appraisal"; }
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm"><div class="card-header bg-warning text-dark"><h5 class="mb-0"><i class="bi bi-pencil me-2"></i>Edit Appraisal</h5></div>
<div class="card-body">
<form method="post">
<input type="hidden" asp-for="Appraisal.Id" />
<div class="row mb-3"><div class="col-md-6"><label asp-for="Appraisal.AppraisalId" class="form-label"></label><input asp-for="Appraisal.AppraisalId" class="form-control" type="text" /></div><div class="col-md-6"><label asp-for="Appraisal.EmployeeCode" class="form-label"></label><input asp-for="Appraisal.EmployeeCode" class="form-control" type="text" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="Appraisal.EmployeeName" class="form-label"></label><input asp-for="Appraisal.EmployeeName" class="form-control" type="text" /></div><div class="col-md-6"><label asp-for="Appraisal.Period" class="form-label"></label><input asp-for="Appraisal.Period" class="form-control" type="text" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="Appraisal.Rating" class="form-label"></label><input asp-for="Appraisal.Rating" class="form-control" type="number" /></div><div class="col-md-6"><label asp-for="Appraisal.Comments" class="form-label"></label><input asp-for="Appraisal.Comments" class="form-control" type="text" /></div></div><div class="row mb-3"><div class="col-md-6"><label asp-for="Appraisal.Status" class="form-label"></label><input asp-for="Appraisal.Status" class="form-control" type="text" /></div><div class="col-md-6"></div></div>
<div class="d-flex gap-2"><button type="submit" class="btn btn-warning"><i class="bi bi-save me-1"></i>Update</button><a href="/HR/Appraisal/List" class="btn btn-outline-secondary"><i class="bi bi-x me-1"></i>Cancel</a></div>
</form>
</div></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

