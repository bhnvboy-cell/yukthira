@page
@model YuktiraERP.Web.Pages.HR.EmployeeListModel
@using YuktiraERP.Infrastructure.Data.Entities
@{ ViewData["Title"] = "Employee List (PA40)"; }
<div class="d-flex justify-content-between align-items-center mb-3">
<h2><i class="bi bi-people me-2"></i>Employee List</h2>
<div>
<button type="button" class="btn btn-outline-secondary btn-sm me-2" onclick="document.querySelectorAll('.inline-edit-col').forEach(c=>c.style.display=c.style.display==='none'?'':'none')" title="Toggle inline editing"><i class="bi bi-pencil-square me-1"></i>Inline Edit</button>
<a asp-page="/HR/Employee/Create" class="btn btn-primary"><i class="bi bi-plus me-1"></i>New Employee</a>
</div>
</div>
<div class="card"><div class="card-body">
<table class="table table-hover table-sm datatable" id="employeeTable">
<thead><tr><th>Code</th><th>Name</th><th class="inline-edit-col" style="display:none">Department</th><th class="inline-edit-col" style="display:none">Designation</th><th>Mobile</th><th>Status</th><th>Actions</th></tr></thead>
<tbody>
@foreach (var e in Model.Employees)
{
<tr data-id="@e.Id" data-entity="EmployeeEntity" data-module="HR">
<td>@e.Code</td>
<td data-field="Name">@e.Name</td>
<td class="inline-edit-col" style="display:none" data-field="Department">@e.Department</td>
<td class="inline-edit-col" style="display:none" data-field="Designation">@e.Designation</td>
<td data-field="Mobile">@e.Mobile</td>
<td><span class="badge bg-@(e.Status=="Active"?"success":"secondary")">@e.Status</span></td>
<td class="actions-cell">
<a asp-page="/HR/Employee/Edit" asp-route-id="@e.Id" class="bi bi-pencil me-2 text-decoration-none text-warning"></a>
<a asp-page="/HR/Employee/Display" asp-route-id="@e.Id" class="bi bi-eye text-decoration-none text-info"></a>
</td>
</tr>
}
</tbody></table>
</div></div>
@section Scripts {
<script src="~/js/inline-edit.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    InlineEdit.initTable(document.getElementById('employeeTable'));
});
</script>
}
