@page
@model YuktiraERP.Web.Pages.HR.Recruitment.CreateModel
@{ ViewData["Title"] = "Create Job Requisition"; }
<div class="ent-form-wrapper">
    <div class="ent-form-header">
        <h2><i class="bi bi-person-badge me-2"></i>Create Job Requisition</h2>
        <div class="ent-form-header-actions">
            <button type="submit" form="reqForm" class="btn btn-primary"><i class="bi bi-save me-1"></i>Save</button>
            <a asp-page="/HR/Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </div>

    <div class="ent-org-banner">
        <div class="banner-icon"><i class="bi bi-person-badge"></i></div>
        <div class="banner-info">
            <h5>Create Job Requisition</h5>
            <span>Open new position for hiring</span>
        </div>
        <div class="banner-meta">HR Module</div>
    </div>

    <div class="ent-form-tabs" id="reqTabs">
        <button type="button" class="ent-tab active" data-tab="tabPosition">Position Details</button>
        <button type="button" class="ent-tab" data-tab="tabCompensation">Compensation &amp; Timeline</button>
    </div>

    <form id="reqForm" method="post">
        <div class="ent-form-panel active" data-panel="tabPosition">
            <div class="ent-section">
                <div class="ent-section-header"><i class="bi bi-person-badge"></i><h6>Position Information</h6></div>
                <div class="ent-field-grid cols-3">
                    <div class="ent-field">
                        <label asp-for="Recruitment.RequisitionId" class="ent-label">Requisition ID</label>
                        <input asp-for="Recruitment.RequisitionId" class="form-control" readonly placeholder="Auto-generated" />
                    </div>
                    <div class="ent-field">
                        <label asp-for="Recruitment.JobTitle" class="ent-label"><span class="required">*</span> Job Title</label>
                        <input asp-for="Recruitment.JobTitle" class="form-control" required />
                    </div>
                    <div class="ent-field">
                        <label asp-for="Recruitment.Department" class="ent-label">Department</label>
                        <input asp-for="Recruitment.Department" class="form-control" />
                    </div>
                </div>
                <div class="ent-field-grid cols-3">
                    <div class="ent-field">
                        <label asp-for="Recruitment.Position" class="ent-label">Position</label>
                        <input asp-for="Recruitment.Position" class="form-control" />
                    </div>
                    <div class="ent-field">
                        <label asp-for="Recruitment.Headcount" class="ent-label">Headcount</label>
                        <input asp-for="Recruitment.Headcount" class="form-control" type="number" min="1" />
                    </div>
                    <div class="ent-field">
                        <label asp-for="Recruitment.EmploymentType" class="ent-label">Employment Type</label>
                        <select asp-for="Recruitment.EmploymentType" class="form-select">
                            <option>Full-Time</option>
                            <option>Part-Time</option>
                            <option>Contract</option>
                            <option>Intern</option>
                        </select>
                    </div>
                </div>
                <div class="ent-field-grid cols-2">
                    <div class="ent-field">
                        <label asp-for="Recruitment.Priority" class="ent-label">Priority</label>
                        <select asp-for="Recruitment.Priority" class="form-select">
                            <option>Urgent</option>
                            <option>High</option>
                            <option>Normal</option>
                            <option>Low</option>
                        </select>
                    </div>
                    <div class="ent-field">
                        <label asp-for="Recruitment.Status" class="ent-label">Status</label>
                        <select asp-for="Recruitment.Status" class="form-select">
                            <option>Open</option>
                            <option>Closed</option>
                            <option>On Hold</option>
                            <option>Cancelled</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="ent-form-panel" data-panel="tabCompensation" style="display:none">
            <div class="ent-section">
                <div class="ent-section-header"><i class="bi bi-cash-stack"></i><h6>Compensation &amp; Hiring Details</h6></div>
                <div class="ent-field-grid cols-2">
                    <div class="ent-field">
                        <label asp-for="Recruitment.HiringManager" class="ent-label">Hiring Manager</label>
                        <input asp-for="Recruitment.HiringManager" class="form-control" />
                    </div>
                    <div class="ent-field">
                        <label asp-for="Recruitment.TargetDate" class="ent-label">Target Date</label>
                        <input asp-for="Recruitment.TargetDate" class="form-control" type="date" />
                    </div>
                </div>
                <div class="ent-field-grid cols-2">
                    <div class="ent-field">
                        <label asp-for="Recruitment.MinSalary" class="ent-label">Min Salary</label>
                        <input asp-for="Recruitment.MinSalary" class="form-control" type="number" step="0.01" />
                    </div>
                    <div class="ent-field">
                        <label asp-for="Recruitment.MaxSalary" class="ent-label">Max Salary</label>
                        <input asp-for="Recruitment.MaxSalary" class="form-control" type="number" step="0.01" />
                    </div>
                </div>
            </div>
            <div class="ent-section">
                <div class="ent-section-header"><i class="bi bi-sticky"></i><h6>Justification</h6></div>
                <div class="ent-field">
                    <label class="ent-label">Justification</label>
                    <textarea asp-for="Recruitment.Justification" class="form-control" rows="3" placeholder="Provide justification for this position..."></textarea>
                </div>
            </div>
        </div>

        <div class="ent-form-footer">
            <div class="footer-info">Fields marked with <span class="required">*</span> are required</div>
            <div class="footer-actions">
                <a asp-page="/HR/Index" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Save</button>
            </div>
        </div>
    </form>
</div>
@section Styles { <link rel="stylesheet" href="~/css/enterprise-form.css" /> }
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
