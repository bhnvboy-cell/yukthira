<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>YuktiraERP.Mes.Plugin</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\YuktiraERP.Mes.Core\YuktiraERP.Mes.Core.csproj" />
    <ProjectReference Include="..\YuktiraERP.Mes.Infrastructure\YuktiraERP.Mes.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\YuktiraERP.PluginSdk\YuktiraERP.PluginSdk.csproj" />
    <ProjectReference Include="..\..\..\YuktiraERP.Core\YuktiraERP.Core.csproj" />
    <ProjectReference Include="..\..\..\YuktiraERP.Infrastructure\YuktiraERP.Infrastructure.csproj" />
  </ItemGroup>

  <Target Name="DeployToApiPluginsFolder" AfterTargets="Build">
    <PropertyGroup>
      <ApiPluginsDir>..\..\..\YuktiraERP.Api\bin\$(Configuration)\$(TargetFramework)\plugins\</ApiPluginsDir>
    </PropertyGroup>
    <MakeDir Directories="$(ApiPluginsDir)" />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)YuktiraERP.Mes.Core.dll;$(TargetDir)YuktiraERP.Mes.Infrastructure.dll"
          DestinationFolder="$(ApiPluginsDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
